{
  "control_requirements": [
    {
      "name": "Exact native baseline",
      "requirement": "R_native必须归一化旧代码过去30日SIMPLE收益样本协方差（ddof=1），D也来自同一协方差。不得用daily log correlation冒称旧native；若保留logdaily比较，另命名。"
    },
    {
      "name": "Same window and source clock",
      "requirement": "每个00:00决策仅使用前30个已完成UTC日，日收盘收益与同步5分钟收益覆盖完全相同日期。首次Feb1决策使用Jan2–31，所需起点是Jan1真实23:59收盘。R_realized30归一化30日全部outer-products之和，不是平均30个日相关矩阵。目标为接下来完成的UTC日，次日00:00成熟。"
    },
    {
      "name": "PSD convex blend",
      "requirement": "冻结0≤theta≤1；两个R均有限、对称、PSD、单位对角。Ctheta=sqrt(D_native) Rtheta sqrt(D_native)，所有组相同365年化。零/未知对角按预声明共同mask STOP或flat，不得拟合epsilon、隐藏填补或删日期。"
    },
    {
      "name": "One fit and maturity",
      "requirement": "仅拟合一个全局theta，2021Feb1–Dec30决策，所有标签成熟时间<2022Jan1。Feb1使用Jan2–31输入；Dec30决策的标签是实际Dec30 UTC日，Dec31成熟。2022Jan1/July1决策purge，Jan2–Jun30和Jul2–Nov30两个已见诊断块事前固定。拟合前冻结pair权重/loss、退化分母处理与theta clipping；不得依据结果refit/改窗口/grid。"
    },
    {
      "name": "Strong predictive controls",
      "requirement": "nativeR、训练冻结longrunR、last-completed-dayR、pure-realized30R用完全共同joint日期、十个非对角pair和同一成熟次日标签/loss。须事前明确longrun是平均训练日相关矩阵还是归一化训练outer-product总和，两者不同。"
    },
    {
      "name": "Causal and identity verification",
      "requirement": "首fit前核验未来来源扰动不影响此前特征/目标；theta=0恢复nativeC至机器精度；所有比较组协方差对角逐日完全相同；无一天错位；CORE5轴序、CSMOM原始持有方向/周排名事件/可用资产池一致。"
    },
    {
      "name": "Economics control",
      "requirement": "BASE保留原native10%下缩目标。candidate及相关性对照均从同一BASE施加单个0..1额外共同scalar，再执行同一native风险复核；不得重新加杠杆、改方向/排名、分配释放现金或更改eligible mask。所有相对腿比例保留。"
    },
    {
      "name": "Exposure confounding",
      "requirement": "相同caps/native ceiling不等于实际风险匹配。经济门槛打开前预声明训练冻结平均haircut对照；报告实际gross/turnover/费用/资金费/事后固定权重方差及成对尾风险损失。只来自降低暴露的收益属于风险缓解，不能称alpha或已证明联合预测可盈利。"
    },
    {
      "name": "Economic activation",
      "requirement": "BASE已处native风险上限下且禁止再加杠杆；更乐观的相关预测可能完全不改变权重。须记录额外scalar不等于1的日期数及风险预测差异，确认适配器有实际作用，不据此挑窗口。"
    },
    {
      "name": "Finite joint sample",
      "requirement": "不确定性采用事前固定的联合日期成对loss、时间block方案；十个pair和五个资产不是独立实验。既有描述性mean-information ESS不能直接认证未来forecast-test ESS。"
    }
  ],
