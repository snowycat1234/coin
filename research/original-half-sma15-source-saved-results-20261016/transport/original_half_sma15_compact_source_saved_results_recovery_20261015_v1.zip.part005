import half_native_bootstrap
import half_native_common as c

def validate_2023(sidecar,source_identity,calendar):
    if (sidecar.get('schema')!='LEGACY_INTRINSIC_REUSED_QUALIFIED_2023_SOURCE_QUALITY_V1'
            or sidecar.get('year')!=2023 or c.plain(sidecar.get('calendar'))!=list(calendar)
            or sidecar.get('qualified_source_identity')!=source_identity
