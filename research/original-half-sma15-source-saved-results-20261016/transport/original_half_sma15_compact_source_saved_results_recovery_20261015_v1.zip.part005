def decode_saved(preparation_raw,artifacts,year):
    config.source_year(year);prep=entry.validate_preparation_metadata(preparation_raw)
    if type(artifacts) is not dict or set(artifacts)!=set(prep['artifacts']):
        raise ValueError('EXACT_SAVED_ARTIFACT_NAMESPACE_REQUIRED')
    for name,raw in artifacts.items():
        pin=prep['artifacts'][name]
        if type(raw) is not bytes or c.sha(raw)!=pin['SHA256'] or len(raw)!=pin['bytes']:
            raise ValueError('EXACT_SAVED_SOURCE_TARGET_ARTIFACT_BYTES_REQUIRED')
