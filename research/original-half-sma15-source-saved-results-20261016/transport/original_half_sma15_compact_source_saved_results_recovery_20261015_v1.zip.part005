    def __post_init__(self):
        if self._seal is not _SEAL:raise ValueError('ENTRY_OWNED_SOURCE_ONLY_LOADED_HALF_SMA_INPUTS_REQUIRED')
    def validate(self):
        if _LIVE.get(self._token) is not self:raise ValueError('LIVE_SOURCE_ONLY_LOADED_HALF_SMA_INPUTS_REQUIRED')
        arrays,inputs=decode_saved(self.preparation_raw,dict(self.captured_artifacts),self.year)
        for original,checked in ((self.arrays,arrays),(self.source_arrays,inputs)):
            if set(original)!=set(checked):raise ValueError('EXACT_LOADED_ARRAY_NAMESPACE_REQUIRED')
            for key,value in original.items():
