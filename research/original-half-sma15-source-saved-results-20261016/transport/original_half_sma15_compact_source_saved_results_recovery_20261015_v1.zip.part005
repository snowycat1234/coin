from pathlib import Path
import os
import half_native_common as c
import half_finance_gate as gate

SCOPE_SHA='02f3dce3440bdcb54122a081f743a618a945201ff23f31e6783ebbc6e69d126e'
STABLE_REGISTRY_REL=gate.CLAIM_NAMESPACE

def registry_root():return c.ROOT/STABLE_REGISTRY_REL

def claim_path(cell_id):
    import half_source_entry as entry
    if cell_id not in entry.tranche_cells(entry.ALL15):raise ValueError('ONLY_ALL15_LEGACY_FRESH_GENESIS_CLAIMS_REQUIRED')
    return registry_root()/SCOPE_SHA/(cell_id+'.json')

def reserve(*,cell_id,metadata,go):
    import half_process_runtime as r
    import half_source_entry as entry
    if cell_id not in entry.tranche_cells(entry.ALL15):raise ValueError('ONLY_ALL15_LEGACY_FRESH_GENESIS_CLAIMS_REQUIRED')
    if (go.get('separate_fresh_genesis_claim_namespace')!=STABLE_REGISTRY_REL
            or go.get('shared_CS_CPU45_lease')!=gate.SHARED_CPU_LEASE
            or go.get('shared_CPU45_lease_nonblocking') is not True
            or go.get('fresh_genesis_only') is not True or go.get('automatic_retry_authorized') is not False):
        raise ValueError('EXACT_NEW_ORIGINAL_HALF_SMA_FRESH_GENESIS_CLAIM_POLICY_REQUIRED')
    if r._CONTROLLER_LEASE_FD is None or r._SHARED_RESOURCE_LEASE_FD is None:
        raise ValueError('OWN_AND_SHARED_CPU45_CONTROLLER_LEASE_REQUIRED')
    for fd,path in ((r._CONTROLLER_LEASE_FD,registry_root()/SCOPE_SHA/'CONTROLLER_LEASE.lock'),
                    (r._SHARED_RESOURCE_LEASE_FD,r.shared_resource_lease_path())):
        held=os.fstat(fd);canonical=path.stat()
        if (held.st_dev,held.st_ino)!=(canonical.st_dev,canonical.st_ino):raise ValueError('EXACT_LIVE_OWN_AND_SHARED_LEASE_INODES_REQUIRED')
    return r.claim_launch(registry_root(),cell_id=cell_id,manifest_sha256=SCOPE_SHA,metadata=metadata)
