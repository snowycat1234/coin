class SeparateCapabilityTests(unittest.TestCase):
    def test_frozen_source_identity_and_exact_fifteen_single_recipe_cells(self):
        self.assertEqual(entry.code_identity(),'a10cebea5f62fcdf1d15d9efdcbe7691823a94b51faf6064176d6a66dfafafb6')
        self.assertEqual(entry.tranche_years(entry.ALL15),(2023,2024,2025,2021,2022))
        self.assertEqual(len(entry.tranche_cells(entry.ALL15)),15)
        self.assertEqual(config.RECIPES,('STATIC50_HALF_SMA200',))
        for year in (2021,2022,2023,2024,2025):
            self.assertEqual(len([cell for cell in entry.tranche_cells(entry.ALL15) if config.cell_named(cell)['year']==year]),3)
        self.assertEqual(config.source_year(2021)['days'],274)
        self.assertEqual(config.source_year(2024)['days'],366)
    def test_native_scope_and_old_source_scope_do_not_alias(self):
        self.assertIsNot(source_scope.SourcePreparationScope,entry.HalfSmaSourcePreparationScope)
        self.assertFalse(source_scope._LIVE)
        with patch.object(c,'exact',side_effect=AssertionError('NO_BODY_READ')):
            for value in (None,object(),{},entry.HalfSmaSourcePreparationScope):
                with self.assertRaises(ValueError):
                    with source_scope.admit_capture(value,year=2022):pass
                with self.assertRaises(ValueError):native_source.capture_year(2022,value)
            for year in (2020,2026,True,'2022'):
                with self.assertRaises(ValueError):
                    with source_scope.admit_capture(None,year=year):pass
        self.assertFalse(source_scope._LIVE)
    def test_five_year_native_allowlists_are_distinct_from_saved_source_input_scope(self):
        for year,record in entry.contracts()['years'].items():
            saved=set(record['read_files']);native=set(source_scope.contracts()['years'][year]['read_files'])
            self.assertFalse(saved & native)
            self.assertNotEqual(saved,native)
            self.assertFalse(any('TARGETS' in name or 'EXECUTION_CLAIMS' in name or 'ROOT_GO' in name for name in native))
    def test_reviewed_pure_transport_function_bodies_unchanged(self):
        origin=c.ROOT/'original_cs_mom21_D_remaining9_financial_20261015_v1'
        for new,old,names in (
            ('half_native_codec.py','cs_codec.py',('daily_inputs','month_arrays','mark2024','npz')),
            ('half_native_quality.py','cs_quality.py',('original_quality','quality_cells_2022','intervals')),
            ('half_native_source.py','cs_source.py',('funding_events','qualified_terminal_witness_2021','assemble_inputs')),
            ('half_native_source_bridge.py','cs_source_bridge.py',('parse_original_zip','verify_normalized_numeric_bits','capture_2022'))):
            def functions(path):return {n.name:n for n in ast.parse(path.read_text()).body if isinstance(n,ast.FunctionDef)}
            actual,wanted=functions(c.HERE/new),functions(origin/old)
            for name in names:
                node=actual[name]
                if new=='half_native_source.py' and name=='assemble_inputs':
                    dispatch=ast.parse('if year == 2023:\n from half_native_source2023 import assemble_inputs as original2023\n return original2023(year,warm_raw,daily_raw,events_raw,sidecar_raw,months,contract)').body[0]
                    self.assertEqual(ast.dump(node.body[1]),ast.dump(dispatch))
                    node=deepcopy(node);node.body.pop(1)
                self.assertEqual(ast.dump(node),ast.dump(wanted[name]),(new,name))
