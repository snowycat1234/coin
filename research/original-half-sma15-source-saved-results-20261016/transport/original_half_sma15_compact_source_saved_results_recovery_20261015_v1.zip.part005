    with generated.installed_fake_storage() as (contracts,storage):
        artifacts={};years={};cells={};captured={}
        sg,gs,sr,rs=generated.authority()
        for year in entry.tranche_years(entry.ALL15):
            contract=contracts['years'][str(year)]
            raw={name:storage[str(source_c.ROOT/pin['path'])] for name,pin in contract['artifacts'].items()}
            value,arrays,proofs=source_and_targets(year,contract,raw,storage)
            artifacts.update(artifact_set(year,raw,value,arrays,proofs));years[str(year)]=source.year_info(value,arrays)
