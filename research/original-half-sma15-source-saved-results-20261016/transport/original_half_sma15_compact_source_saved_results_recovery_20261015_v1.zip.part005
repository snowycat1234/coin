                    raise ValueError('EXACT_IMMUTABLE_DTYPE_ENDIAN_SHAPE_CBYTES_REQUIRED')
        return True


def load_year(preparation_root,*,expected_preparation_sha256,year,source_go_raw,expected_source_go_sha256,source_review_raw,expected_source_review_sha256):
    config.source_year(year)
    entry.validate_source_authority_metadata(source_go_raw,expected_source_go_sha256,source_review_raw,expected_source_review_sha256)
    from half_sma_source_guard import current_guard
    guard=current_guard()
    if guard is None or not guard.active:raise ValueError('WHOLE_INVOCATION_HALF_SMA_SOURCE_ONLY_GUARD_REQUIRED')
    root=Path(preparation_root).absolute()
    if root.is_symlink() or any(p.is_symlink() for p in root.parents):raise ValueError('ORDINARY_NOFOLLOW_PREPARATION_DIRECTORY_REQUIRED')
    raw=c.exact(root/'PREPARATION.json',expected_preparation_sha256);prep=entry.validate_preparation_metadata(raw)
    if prep['source_stage_GO_SHA256']!=expected_source_go_sha256 or prep['source_review_SHA256']!=expected_source_review_sha256:
