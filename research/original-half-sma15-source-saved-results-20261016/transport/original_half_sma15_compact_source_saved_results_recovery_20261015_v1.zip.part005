    def test_code_dependencies_manifest_and_relative_paths_fail_closed(self):
        record=c.exact_object(c.ordinary(c.HERE/'CODE_MANIFEST.json'));target=next(iter(record['dependencies']));original=c.exact
        def exact(path,*args,**kwargs):
            if str(path)==str(c.ROOT/target):raise ValueError('GENERATED_DEPENDENCY_MUTATION')
            return original(path,*args,**kwargs)
        with patch.object(c,'exact',side_effect=exact):
