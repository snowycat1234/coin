        with tempfile.TemporaryDirectory(dir=c.HERE) as td:
            td=Path(td);p=td/'x.py';p.write_bytes(b'x');link=td/'link';link.symlink_to(p)
            with self.assertRaises(ValueError):c.exact(link,c.sha(b'x'))
            with self.assertRaises(ValueError):c.exact(p,'0'*64)
            with self.assertRaises(ValueError):c.exact(p,c.sha(b'x'),99)
        for name in ('../escape','/abs','a/../b','a\\b','a//b'):
            with self.assertRaises(ValueError):c.relative(name)


class BoundaryTests(unittest.TestCase):
    def forbidden(self,fn,category):
        guard=SourceOnlyGuard(read_paths=generated.read_paths(),write_roots=(c.HERE/'GENERATED_WRITE_ONLY',))
        with self.assertRaises(SourceBoundaryViolation):
            with guard:fn(guard)
        self.assertGreater(guard.attempts[category],0)
        generated.observed_guard_receipts.append(guard.receipt('EXPECTED_NEGATIVE_CONTROL'))
        return guard

    def test_process_network_claim_and_financial_GO_write_blocks(self):
        import subprocess,socket,fcntl
        for fn,category in ((lambda g:subprocess.run(['false']),'process_launches'),
            (lambda g:os.system('false'),'process_launches'),
            (lambda g:socket.getaddrinfo('example.com',443),'network_calls'),
            (lambda g:fcntl.flock(0,fcntl.LOCK_EX),'canonical_financial_claims_or_leases'),
            (lambda g:(c.HERE/'EXECUTION_CLAIMS'/'x').open('w'),'canonical_financial_claims_or_leases'),
            (lambda g:(c.HERE/'GENERATED_WRITE_ONLY'/'FINANCIAL_GO.json').open('w'),'financial_GO_writes'),
            (lambda g:json.dumps(dict(schema='ROOT_FINANCIAL_AUTHORIZATION',financial_execution_authorized=True)),'financial_GO_writes'),
            (lambda g:(c.HERE/'not_allowlisted').read_bytes(),'nonallowlisted_file_reads')):
            self.forbidden(fn,category)

    def test_financial_import_direct_loader_and_foreign_CS_scope_blocks(self):
        for name in ('half_sma_native','run_half_sma','cs_entry','cs_admission','cs_loader','traditional_D_full2022_20261015_v2'):
            self.forbidden(lambda g,name=name:__import__(name),'financial_imports')
        self.forbidden(lambda g:importlib.util.spec_from_file_location('x','/tmp/x.py'),'financial_imports')

    def test_preloaded_captured_finance_provider_and_historical_scope_stop(self):
        for name in ('FakeAccount','FakeSimulator','FakeProvider','FreshHistoricalExecutionScope'):
            fake=types.ModuleType('_generated_boundary');fake.__source_guard_fixture__=True
            setattr(fake,name,type(name,(),{}));sys.modules[fake.__name__]=fake
            try:
                self.forbidden(lambda g:None,'financial_imports')
            finally:sys.modules.pop(fake.__name__,None)

    def test_dynamic_constructor_advance_provider_historical_and_simulator_blockers(self):
        # Register fixture only after clean entry; no actual implementation imported.
        fake=types.ModuleType('_generated_boundary');fake.__source_guard_fixture__=True
        for name,method,category in (('FakeAccount','__init__','financial_constructors'),
            ('FakeAccount','advance_day','financial_account_advance'),
            ('FakeSimulator','__init__','native_simulator_construct_or_advance'),
            ('FakeProvider','__iter__','actual_provider_calls'),
            ('FreshHistoricalExecutionScope','__init__','historical_scope_mints')):
            cls=type(name,(),{method:lambda *a,**k:None});setattr(fake,name,cls)
            def attempt(guard):
                sys.modules[fake.__name__]=fake
                guard._discover_loaded_boundaries()
                getattr(cls,method)(object())
            try:self.forbidden(attempt,category)
            finally:
                sys.modules.pop(fake.__name__,None);delattr(fake,name)

    def test_caught_attempt_remains_fatal_and_scope_mints_stay_zero(self):
        def attempt(guard):
            try:__import__('half_sma_native')
            except SourceBoundaryViolation:pass
        self.forbidden(attempt,'financial_imports')
        self.assertFalse(entry._ACTIVE_SOURCE);self.assertFalse(entry._ACTIVE_RECORDING);self.assertFalse(loader._LIVE)


class AdditionalGuardWriteTests(unittest.TestCase):
    def test_arbitrary_financial_content_chunked_writer_and_outside_writes_block(self):
        with tempfile.TemporaryDirectory(dir=c.HERE) as td:
            td=Path(td)
            guard=SourceOnlyGuard(read_paths=generated.read_paths(),write_roots=(td,))
            with self.assertRaises(SourceBoundaryViolation):
                with guard:
                    with (td/'innocent.txt').open('wb') as stream:
                        stream.write(b'{"financial_execution_authorized":')
                        stream.write(b'true}')
            self.assertEqual(guard.attempts['financial_GO_writes'],1)
            generated.observed_guard_receipts.append(guard.receipt('EXPECTED_NEGATIVE_CHUNKED_FINANCIAL_CONTENT_WRITE'))
            # No complete executable financial JSON was ever written.
            self.assertEqual((td/'innocent.txt').read_bytes(),b'{"financial_execution_authorized":')
            guard=SourceOnlyGuard(read_paths=generated.read_paths(),write_roots=(td,))
            with self.assertRaises(SourceBoundaryViolation):
                with guard:(c.HERE/'OUTSIDE_GENERATED_ROOT.txt').open('w')
            self.assertEqual(guard.attempts['outside_source_writes'],1)
            generated.observed_guard_receipts.append(guard.receipt('EXPECTED_NEGATIVE_OUTSIDE_OR_RAW_WRITE'))
            guard=SourceOnlyGuard(read_paths=generated.read_paths(),write_roots=(td,))
            with self.assertRaises(SourceBoundaryViolation):
                with guard:os.open(td/'raw',os.O_WRONLY|os.O_CREAT)
            self.assertEqual(guard.attempts['outside_source_writes'],1)
            generated.observed_guard_receipts.append(guard.receipt('EXPECTED_NEGATIVE_OUTSIDE_OR_RAW_WRITE'))



if __name__=='__main__':unittest.main()
