def quality_fragment(path,*,install):
    tree=ast.parse(Path(path).read_text());fn=next(n for n in tree.body if isinstance(n,ast.FunctionDef) and n.name=='_construct_case')
    body=[];active=False
    for n in fn.body:
        text=ast.unparse(n)
        if text=='account = sim.account':active=True
        if active:
            if text=='quality.install()' and not install:break
            if text.startswith('if getattr(account.liquidation_callback'):break
            body.append(n)
    assert body and any('intervals =' in ast.unparse(n) for n in body)
    return compile(ast.fix_missing_locations(ast.Module(body=body,type_ignores=[])),'<EXACT_PRODUCTION_QUALITY_CONSTRUCTOR_AST>','exec')


def install_recording_quality(native,sim,guard,intervals,*,original_genuine,cells=(),sidecar='a'*64):
    old=guard.causal_mark_quality_guard
    guard.original_attempt=old.original_attempt
    ns=dict(vars(native),sim=sim,guard=guard,quality_intervals=intervals,
        historical_scope=SimpleNamespace(quality_cells=cells),original_genuine=original_genuine,sidecar=sidecar)
    exec(quality_fragment(c.HERE/'half_native.py',install=True),ns)
    return ns['quality']


def recording_policy(native,path,intervals,*,original_genuine,cells=(),sidecar='a'*64):
    account=SimpleNamespace(marks={symbol:[] for symbol in native.S})
    sim=SimpleNamespace(account=account);guard=SimpleNamespace(sim=sim)
    ns=dict(vars(native),sim=sim,guard=guard,quality_intervals=intervals,
        historical_scope=SimpleNamespace(quality_cells=cells),original_genuine=original_genuine,sidecar=sidecar)
    exec(quality_fragment(path,install=False),ns)
    return ns['quality'],account


class HistoricalQualityTransportTests(unittest.TestCase):
    def test_exact_single_interval_expression_restoration(self):
        def interval(path):
            fn=next(n for n in ast.parse(Path(path).read_text()).body if isinstance(n,ast.FunctionDef) and n.name=='_construct_case')
            return next(n for n in fn.body if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='intervals' for t in n.targets))
        own=interval(c.HERE/'half_native.py');cs=interval(c.ROOT/'original_cs_mom21_D_remaining9_financial_20261015_v1/cs_native.py')
        old=interval(c.ROOT/'legacy_intrinsic_D_remaining24_native_20261015_v1/legacy_native.py')
        self.assertEqual(ast.dump(own),ast.dump(cs));self.assertNotEqual(ast.dump(own),ast.dump(old))

    def test_2024_historical_policy_identity_gap_partial_and_full_recovery(self):
        native=g.native_reference();a,b,prior=1723456980000000,1723457100000000,1723456920000000
        intervals=((a,b,native.S),)
        quality,account=recording_policy(native,c.HERE/'half_native.py',intervals,original_genuine=prior)
        sidecar=dict(year=2024,cells=[],qualified_source_identity='b'*64,arrival_status='UNKNOWN_NOT_CERTIFIED',
            original_source_age_and_arrival_flags_preserved=True,actual_CS_event_impacts='PENDING_CS_SAVED_EXECUTION',
            actual_CS_position_interval_impacts='PENDING_CS_SAVED_EXECUTION_NOT_INHERITED_FROM_D',quality_intervals=c.plain(intervals))
        info=dict(quality_cells_SHA256=c.jsha([]),source_identity='b'*64,source_quality_sidecar_SHA256='a'*64)
        self.assertEqual(quality.identity,saved.quality_identity(sidecar,info,native.V2.quality_module.VERSION))
        old,_=recording_policy(native,c.ROOT/'legacy_intrinsic_D_remaining24_native_20261015_v1/legacy_native.py',intervals,original_genuine=prior)
        self.assertEqual(old.identity['intervals'],[]);self.assertNotEqual(old.identity,quality.identity)
        for symbol in native.S:account.marks[symbol]=[dict(close_us=prior,available_us=prior)]
        self.assertIsNone(quality.quality_witness(a-native.MINUTE))
        self.assertIsNotNone(quality.quality_witness(a));self.assertIsNotNone(quality.quality_witness(b))
        for symbol in native.S[:-1]:account.marks[symbol].append(dict(close_us=b,available_us=b))
        witness=quality.quality_witness(b+native.MINUTE);self.assertIsNotNone(witness)
        self.assertEqual(witness['affected_intervals'][0]['installed_marks'][-1]['symbol'],native.S[-1])
        account.marks[native.S[-1]].append(dict(close_us=b,available_us=b))
        self.assertIsNone(quality.quality_witness(b))

    def test_2022_historical_policy_keeps_intervals_and_all27_typed_cells(self):
        native=g.native_reference();contract=entry.contracts()['years']['2022']['qualified_source_contract']
        points=tuple(tuple(row) for row in contract['exact_mark_absent_open_points_us']);missing=set(points);old=source_quality.original_quality();cells=[]
        for symbol,at in points:
            anchor=at-native.MINUTE
