            original_source_age_and_arrival_flags_preserved=True,actual_CS_event_impacts='PENDING_CS_SAVED_EXECUTION',
            actual_CS_position_interval_impacts='PENDING_CS_SAVED_EXECUTION_NOT_INHERITED_FROM_D',quality_intervals=c.plain(intervals))
        info=dict(quality_cells_SHA256=c.jsha(rows),source_identity='b'*64,source_quality_sidecar_SHA256='a'*64)
        self.assertEqual(quality.identity,saved.quality_identity(sidecar,info,native.V2.quality_module.VERSION))
        self.assertEqual(len(quality.identity['source_clock_cells']),27);self.assertTrue(quality.identity['intervals'])

    def test_recording_historical_install_unknown_before_risk_and_partial_recovery(self):
