                    '--source-review',str(rp),'--source-review-sha',rs,'--cpu','0']
                with patch.object(sys,'argv',argv),patch.object(cli.resource,'setrlimit'),patch.object(cli.signal,'signal'),patch.object(cli.signal,'alarm'),\
                    patch.object(source,'prepare_source_only',side_effect=ValueError('GENERATED_STOP_BEFORE_SOURCE')):
