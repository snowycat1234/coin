import ast
from pathlib import Path
import unittest
import numpy as np
import half_sma_signal as s


def fixture(days=365,start=1672531200000000):
    t=start-199*s.DAY+np.arange(199+days,dtype=np.int64)*s.DAY
    x=np.arange(len(t),dtype=np.float64)
    close=np.column_stack([100*np.exp(.002*np.sin(x*(.13+j*.015))+.0004*np.sin(x*.7+j)+(.0003 if j%2 else -.00015)*x) for j in range(5)])
    return close,t,t.copy(),t[199:]


class Generated(unittest.TestCase):
    def test_exact_source_pins_and_unmodified_AST(self):
        pins=s.verify_sources();self.assertEqual(pins['files']['pinned/targets_original.py']['SHA256'],'87440f27f8ebe56bb5e389e63417f185f1f67733bcaa9f77eb669bfc64b28f84')
        self.assertEqual(pins['files']['pinned/sma_targets_original.py']['SHA256'],'2fbce87ab4f20fca483f122bada86935a6dc03fc8caa5925e738b3fe0d54b13d')
        self.assertFalse(any(isinstance(n,(ast.Import,ast.ImportFrom)) for n in ast.parse(s.originals().weights.__code__.co_filename and 'pass').body))

    def test_all_calendar_lengths_exact_components_tiers(self):
        for days in (274,365,366):
            p,t,a,d=fixture(days);arrays,proofs=s.build_target_grid(p,t,a,d);o=s.originals()
            sw,sg,mean,_=o.weights(t,p,d)
            np.testing.assert_array_equal(arrays['SMA200_10PCT'],sw)
            np.testing.assert_array_equal(arrays['SMA200_DIRECTION'],sg)
            np.testing.assert_array_equal(arrays['SMA200_MEAN'],mean)
            w=.5*arrays['STATIC50_RETARGETED']+.5*sw
            np.testing.assert_array_equal(w,arrays['intrinsic_STATIC50_HALF_SMA200'])
            self.assertEqual(len(proofs),days)
            for tier,gross,vol,asset in s.TIERS:
                out=arrays[s.RECIPE+'_'+tier]
                self.assertTrue(np.all(np.abs(out)<=np.abs(w)+1e-15))
                self.assertLessEqual(float(np.abs(out).sum(1).max()),gross+1e-12)
                self.assertLessEqual(float(np.abs(out).max()),asset+1e-12)
                self.assertTrue(all(x['tiers'][tier]['factor']<=1 for x in proofs))
            self.assertTrue(all(x['original_component_source_closure'] for x in proofs))
            for v in arrays.values():
                self.assertFalse(v.flags.writeable)
                with self.assertRaises(ValueError):v.setflags(write=True)

    def test_original_365_mix_reference_equivalence(self):
        p,t,a,d=fixture();arrays,_=s.build_target_grid(p,t,a,d)
        tree=ast.parse((s.HERE/'pinned/targets_original.py').read_bytes())
        nodes=[n for n in tree.body if isinstance(n,ast.FunctionDef) and n.name in ('clock','validate','mix')]
        from datetime import date,datetime,timezone
        ns=dict(np=np,date=date,datetime=datetime,timezone=timezone,DAY=s.DAY,SYMBOLS=s.SYMBOLS)
        exec(compile(ast.Module(body=nodes,type_ignores=[]),'original_mix_reference','exec'),ns)
        original=ns['mix'](d,s.SYMBOLS,arrays['STATIC50_RETARGETED'],d,s.SYMBOLS,arrays['SMA200_10PCT'],['2023-01-01','2024-01-01'])
        np.testing.assert_array_equal(original,arrays['intrinsic_STATIC50_HALF_SMA200'])

    def test_prefix_poison_future(self):
        p,t,a,d=fixture(366);cut=150
        full,proofs=s.build_target_grid(p,t,a,d)
        prefix,pr=s.build_target_grid(p,t,a,d[:cut])
        poisoned=p.copy();poisoned[t>d[cut-1]]=np.nan
        poisoned[0,0]=p[0,0] # Prefix source preserved literally.
        alt,ar=s.build_target_grid(poisoned,t,a,d[:cut])
        truncated,tr=s.build_target_grid(p[t<=d[cut-1]],t[t<=d[cut-1]],a[t<=d[cut-1]],d[:cut])
        for key in full:
            np.testing.assert_array_equal(prefix[key],full[key][:cut])
            np.testing.assert_array_equal(alt[key],prefix[key]);np.testing.assert_array_equal(truncated[key],prefix[key])
        self.assertEqual(pr,ar);self.assertEqual(pr,tr);self.assertEqual(pr,proofs[:cut])

    def test_mask_warmup_clock_order_fail_closed(self):
        p,t,a,d=fixture(20)
        for value in (np.nan,0.,-1.):
            bad=p.copy();bad[1,2]=value
            with self.assertRaises(ValueError):s.build_target_grid(bad,t,a,d)
        with self.assertRaises(ValueError):s.build_target_grid(p,t,a,t[198:200])
        bad=a.copy();bad[50]+=s.DAY
        with self.assertRaises(ValueError):s.build_target_grid(p,t,bad,d)
        with self.assertRaises(ValueError):s.build_target_grid(p,t,a,d,symbols=s.SYMBOLS[::-1])
        with self.assertRaises(ValueError):s.supported(np.array([('x',)],dtype=[('x','U1')]))

    def test_downward_only_netting_zero_risk_cash(self):
        d=np.arange(274,dtype=np.int64)*s.DAY
        aa=np.tile(np.array([.12,-.12,0,.12,-.12]),(len(d),1));bb=-aa
        cov=np.tile(np.eye(5,dtype=np.float64),(len(d),1,1))
        arrays,proof=s.from_components(d,aa,bb,cov)
        self.assertTrue(np.all(arrays['intrinsic_STATIC50_HALF_SMA200']==0))
        for tier,*_ in s.TIERS:self.assertTrue(np.all(arrays[s.RECIPE+'_'+tier]==0))
        w=np.array([.02,-.01,0,0,0],dtype=np.float64);zero=np.zeros((5,5),dtype=np.float64)
        for tier,*_ in s.TIERS:
            out,p=s.lower_only(w,zero,tier);np.testing.assert_array_equal(out,w);self.assertEqual(p['factor'],1.)

    def test_static_retarget_is_not_raw_quarter_mixture(self):
        p,t,a,d=fixture(30);arrays,proof=s.build_target_grid(p,t,a,d)
        self.assertTrue(any(x['STATIC50_original_retarget']['factor']>1 for x in proof))
        wrong=.5*arrays['STATIC50_OLD_NO_REEXPANSION']+.5*arrays['SMA200_10PCT']
        self.assertFalse(np.array_equal(wrong,arrays['intrinsic_STATIC50_HALF_SMA200']))

if __name__=='__main__':unittest.main(verbosity=2)
