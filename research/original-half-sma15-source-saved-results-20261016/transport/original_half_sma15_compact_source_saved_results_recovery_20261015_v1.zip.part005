            or sidecar.get('funding_rate_unit')!='UNCONFIRMED_PRESERVED_NO_RESCALE'):
        raise ValueError('EXACT_FROZEN_2023_LEGACY_SOURCE_QUALITY_REQUIRED')
    return True
