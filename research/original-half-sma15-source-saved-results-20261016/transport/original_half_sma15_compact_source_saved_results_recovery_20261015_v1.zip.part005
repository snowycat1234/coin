 record=dict(schema='HALF_SMA_INTRINSIC_SOURCE_ONLY_CODE_IDENTITY_V1',status='GENERATED_ONLY_NOT_ACTUAL_ADMISSION',
  files={name:pin(HERE/name) for name in FILES},dependencies=json.loads((HERE/'DEPENDENCY_PINS.json').read_bytes())['files'],
