            ordered_cells=list(entry.tranche_cells(entry.ALL15)),years=years,cells=cells,code_manifest_SHA256=entry.code_identity(),
            scope_manifest_SHA256=entry.manifest_sha(),source_contract_map_SHA256=entry.contract_sha(),source_stage_GO_SHA256=gs,source_review_SHA256=rs,
            artifacts={name:dict(SHA256=c.sha(body),bytes=len(body)) for name,body in artifacts.items()},historical_admission=False,financial_runs=0,
            accounts_created=0,accounts_advanced=0,provider_iterations=0,process_launches=0,canonical_claims_created=0,real_financial_GO_written=0,publication_actions=0)
