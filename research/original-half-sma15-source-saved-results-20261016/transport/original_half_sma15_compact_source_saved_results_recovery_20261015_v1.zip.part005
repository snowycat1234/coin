import argparse
import sys


def main():
    parser=argparse.ArgumentParser();parser.add_argument('--expect-cold-stop',action='store_true')
    args=parser.parse_args()
    cold='encodings.cp437' not in sys.modules
    if not cold:raise AssertionError('FRESH_PROCESS_COLD_CP437_REQUIRED')
    if not args.expect_cold_stop:
        import prepare_half_sma_source  # Exact production entry preload, before guard.
    from io import BytesIO
    import json
    import zipfile
    import numpy as np
    import half_sma_codec as codec
    import half_sma_generated as generated
    from half_sma_source_guard import SourceOnlyGuard
    data=BytesIO();array=BytesIO();np.save(array,np.ones(4,dtype='float64'),allow_pickle=False)
    info=zipfile.ZipInfo('x.npy');info.compress_type=zipfile.ZIP_DEFLATED
    with zipfile.ZipFile(data,'w') as archive:archive.writestr(info,array.getvalue())
    guard=SourceOnlyGuard(read_paths=generated.read_paths())
    done=False;error=None
    try:
        with guard:
            a=codec.npz(data.getvalue(),{'x':((4,),'float64')})
            assert a['x'].tobytes()==np.ones(4).tobytes()
            # Literal bytes, so constructing fixture never prewarms utf_8_sig.
            assert b'\xef\xbb\xbf2023,1\n'.decode('utf-8-sig')=='2023,1\n'
            done=True
    except BaseException as exc:error=type(exc).__name__+':'+str(exc)
    if args.expect_cold_stop:
        assert not done and guard.attempts['financial_imports']==1,(done,guard.attempts,error)
        assert all(v==0 for k,v in guard.attempts.items() if k!='financial_imports')
    else:assert done and error is None and not any(guard.attempts.values()),(done,guard.attempts,error)
    print(json.dumps(dict(schema='HALF_SMA_FRESH_GENERATED_ASCII_FLAG0_DEFLATED_ZIP_AND_BOM_CODEC_V1',
        status='PASS',expected_cold_stop=args.expect_cold_stop,cp437_initially_cold=cold,
        parser_completed=done,ZIP_member_flag_bits=info.flag_bits,ZIP_compression=info.compress_type,
        forbidden_attempts=guard.attempts,error=error,actual_source_reads=0,actual_source_scopes=0,
        financial_runs=0),indent=2))


if __name__=='__main__':main()
PK␀␀␀␀␀␀␀O]ºáþ~å␀␀å␀␀‘␀␀␀original_half_sma15_compact_source_saved_results_recovery_20261015_v1/source/original_half_sma_D_source_20261015_v2/test_cold_original_weights.py"""Fresh-process exact original weights path under the unchanged source guard."""
import argparse
import sys


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--expect-cold-stop', action='store_true')
    args = parser.parse_args()
    initially_cold = 'numpy.testing' not in sys.modules
    if not initially_cold:
        raise AssertionError('FRESH_PROCESS_COLD_NUMPY_TESTING_REQUIRED')
    # The negative isolates precisely the original omission. Both modes retain
    # the existing reviewed ZIP/BOM dependency preload and the unchanged guard.
    import encodings.cp437
    import encodings.utf_8_sig
    if not args.expect_cold_stop:
        import prepare_half_sma_source
        if 'numpy.testing' not in sys.modules:
            raise AssertionError('PRODUCTION_ORIGINAL_WEIGHTS_DEPENDENCY_PRELOAD_REQUIRED')
    import json
    import os
    import numpy as np
    import half_sma_common as c
    import half_sma_entry as entry
    import half_sma_generated as generated
    import half_sma_source as source
    import half_sma_signal
    # Match the production main() original-AST preload before guard entry.
    half_sma_signal.reviewed_signal().originals()
    from half_sma_source_guard import SourceOnlyGuard
    completed = []
    error = None
    with generated.installed_fake_storage() as (contracts, storage):
        go, gs, review, rs = generated.authority()
        reads = generated.read_paths() + [c.ROOT / name
            for contract in contracts['years'].values() for name in contract['read_files']]
        guard = SourceOnlyGuard(read_paths=reads)
        try:
            with guard:
                with entry.admit_source_stage(go, gs, review, rs) as scope:
                    for year in entry.tranche_years(entry.ALL15):
                        captured = source.capture_year(year, scope)
                        arrays, proofs = source.project_targets(captured)
                        expected_days = captured['period']['days']
                        if arrays['SMA200_DIRECTION'].shape != (expected_days, 5):
                            raise AssertionError('EXACT_ORIGINAL_WEIGHTS_PATH_REQUIRED')
                        # Exercise original np.testing assertions plus writer
                        # and identity paths on invented data only.
                        np.testing.assert_array_equal(arrays['decision_us'], captured['decisions'])
                        blob = source.target_blob(arrays)
                        info = source.year_info(captured, arrays)
                        if not blob or len(info['array_identities']) != len(arrays):
                            raise AssertionError('GENERATED_WRITER_AND_IDENTITY_PATH_REQUIRED')
                        completed.append(year)
        except BaseException as exc:
            error = type(exc).__name__ + ':' + str(exc)
            if not args.expect_cold_stop:
                raise
    if args.expect_cold_stop:
        assert not completed and guard.attempts['financial_imports'] == 1, (completed, guard.attempts, error)
        assert all(v == 0 for k, v in guard.attempts.items() if k != 'financial_imports')
    else:
        assert completed == list(entry.tranche_years(entry.ALL15)), (completed, error)
        assert error is None and not any(guard.attempts.values()), (guard.attempts, error)
    assert not entry._ACTIVE_SOURCE and not entry._ACTIVE_RECORDING
    print(json.dumps(dict(schema='HALF_SMA_FRESH_ORIGINAL_WEIGHTS_GENERATED_BOOTSTRAP_V1',
        status='PASS', expected_cold_stop=args.expect_cold_stop,
        numpy_testing_initially_cold=initially_cold, completed_generated_years=completed,
        forbidden_attempts=guard.attempts, error=error,
        CPU_affinity=sorted(os.sched_getaffinity(0)),
        all_TID_affinities=[sorted(os.sched_getaffinity(int(t))) for t in os.listdir('/proc/self/task')],
        actual_source_reads=0, actual_target_artifacts=0, financial_runs=0,
        source_scopes_revoked=not entry._ACTIVE_SOURCE), indent=2, sort_keys=True))


if __name__ == '__main__':
    main()
PK␀␀␀␀␀␀␀O][f+Ð\ ␀␀\ ␀␀‹␀␀␀original_half_sma15_compact_source_saved_results_recovery_20261015_v1/source/original_half_sma_D_source_20261015_v2/test_original_prefix.py"""Generated original-prefix reader, hostile layouts and real Polars writer."""
from io import BytesIO
from copy import deepcopy
from unittest.mock import patch
import unittest
import zipfile
import numpy as np
import pandas as pd
import polars as pl
import half_sma_prefix as prefix
import half_sma_common as c
import half_sma_config as config
import half_sma_codec as codec
import half_sma_generated as generated
import half_sma_signal as signal


def wrapper(member,name='Y2023.npz'):
    b=BytesIO()
    with zipfile.ZipFile(b,'w',compression=zipfile.ZIP_DEFLATED) as z:
        z.writestr(name,member);z.writestr('UNSELECTED_POISON.npy',b'NEVER_OPEN_ME')
    return b.getvalue()


def contract_for(member,year=2023):
    wr=wrapper(member)
    return wr,dict(wrapper=dict(SHA256=c.sha(wr),bytes=len(wr)),member=dict(name='Y2023.npz',SHA256=c.sha(member),bytes=len(member)))


class Prefix(unittest.TestCase):
    def fixture(self,year=2023):
        a=generated.daily(year);t=a['close_available_us'];p=a['close'];extra=200
        pt=t[0]-np.arange(extra,0,-1,dtype=np.int64)*config.DAY
        pp=np.tile(np.array([100,120,140,160,180],dtype=np.float64),(extra,1))
        return np.r_[pt,t,t[-1]+config.DAY,t[-1]+2*config.DAY],np.vstack([pp,p,np.full((2,5),np.nan)])

    def test_only_source_fields_and_causal_row_prefix_numerically_decoded(self):
        for year in (2021,2022,2023,2024,2025):
            t,p=self.fixture(year);member=generated.pack(symbol_order=np.asarray(config.SYMBOLS),close_available_us=t,close=p,UNSELECTED_OBJECT=np.array([object()],dtype=object))
            wr,contract=contract_for(member,year);opened=[];decoded=[];original=zipfile.ZipFile.open;frombuffer=np.frombuffer
            def op(z,name,*args,**kw):
                opened.append(name.filename if isinstance(name,zipfile.ZipInfo) else name);return original(z,name,*args,**kw)
            def fb(raw,dtype=float,*args,**kwargs):
                if np.dtype(dtype)==np.dtype('float64'):decoded.append(len(raw))
                return frombuffer(raw,dtype,*args,**kwargs)
            with patch.object(zipfile.ZipFile,'open',op),patch.object(np,'frombuffer',fb):selected,proof=prefix.select_prefix(wr,contract,year)
            self.assertEqual(opened,['Y2023.npz','symbol_order.npy','close_available_us.npy','close.npy'])
            self.assertEqual(proof['future_close_rows_interpreted'],0)
            self.assertEqual(set(decoded),{proof['selected_rows']*5*8})
            self.assertEqual(selected['clocks'][0],t[0]);self.assertEqual(selected['clocks'][-1],config.source_year(year)['end']-config.DAY)
            self.assertTrue(np.isfinite(selected['close']).all())
            canonical=generated.daily(year);prefix.validate_canonical_parity(selected,dict(clocks=canonical['close_available_us'],close=canonical['close']))

    def test_unsupported_layout_dtype_symbols_and_clock_fail_before_numeric_close(self):
        t,p=self.fixture();order=np.asarray(config.SYMBOLS)
        for key,value in (('close',np.asfortranarray(p)),('close',p.astype('>f8')),('close',np.array(p,dtype=object)),
            ('close_available_us',t.astype('u8')),('symbol_order',order[::-1])):
            arrays=dict(symbol_order=order,close_available_us=t,close=p);arrays[key]=value
            wr,contract=contract_for(generated.pack(**arrays))
            with self.assertRaises(ValueError):prefix.select_prefix(wr,contract,2023)
        for bad in (t.copy(),t.copy()):
            bad[3]=bad[2]
            wr,contract=contract_for(generated.pack(symbol_order=order,close_available_us=bad,close=p))
            with self.assertRaises(ValueError):prefix.select_prefix(wr,contract,2023)
        wr,contract=contract_for(generated.pack(symbol_order=order,close_available_us=t,close=p));bad=deepcopy(contract);bad['member']['SHA256']='0'*64
        with self.assertRaises(ValueError):prefix.select_prefix(wr,bad,2023)

    def test_exact_preloaded_polars_class_is_benign_workspace_spoof_still_blocked(self):
        import sys,types
        from half_sma_source_guard import SourceOnlyGuard,SourceBoundaryViolation
        # The actual installed dependency descriptor is loaded, never invoked.
        from polars.catalog.unity.client import CatalogCredentialProvider
        self.assertTrue(CatalogCredentialProvider.__module__.startswith('polars.'))
        guard=SourceOnlyGuard(read_paths=generated.read_paths())
        with guard:guard.checkpoint('TRUSTED_INSTALLED_POLARS_DESCRIPTOR_ONLY')
        self.assertFalse(any(guard.attempts.values()))
        for name in ('_generated_polars_like','polars.spoofed_workspace'):
            module=types.ModuleType(name);module.__file__=str(c.ROOT/'untrusted_workspace'/'polars'/'provider.py')
            module.CatalogCredentialProvider=type('CatalogCredentialProvider',(),{})
            previous=sys.modules.get(name);sys.modules[name]=module
            try:
                guard=SourceOnlyGuard(read_paths=generated.read_paths())
                with self.assertRaises(SourceBoundaryViolation):
                    with guard:pass
                self.assertEqual(guard.attempts['financial_imports'],1)
            finally:
                if previous is None:sys.modules.pop(name,None)
                else:sys.modules[name]=previous

    def test_fixed_near_equality_proves_prefix_identity_is_required(self):
        rng=np.random.default_rng(47119);old=np.exp(rng.normal(4.5,2,1000));history=rng.uniform(90,110,199)
        at=float(pd.Series(history).mean())
        for _ in range(4):at=np.nextafter(at,-np.inf)
        short=np.r_[history,at];long=np.r_[old,short]
        small=pd.Series(short).rolling(200,min_periods=200).mean().iloc[-1]
        full=pd.Series(long).rolling(200,min_periods=200).mean().iloc[-1]
        self.assertEqual(float(np.sign(at-small)),-1.)
        self.assertEqual(float(np.sign(at-full)),1.)
        # The original producer itself exhibits the difference; no substitute
        # rounding, epsilon, threshold or rolling implementation is introduced.
        o=signal.reviewed_signal().originals()
        for values,expected in ((short,-1.),(long,1.)):
            p=np.tile(values[:,None],(1,5));t=config.utc('2020-01-02')+np.arange(len(values),dtype=np.int64)*config.DAY
            _,direction,_,_=o.weights(t,p,t[-1:]);np.testing.assert_array_equal(direction,np.full((1,5),expected))

    def test_unmodified_original_SMA_generated_reference_tests(self):
        import ast
        from types import SimpleNamespace
        pytest=SimpleNamespace(raises=self.assertRaises)
        pure=signal.reviewed_signal();o=pure.originals()
        path=pure.HERE/'pinned/sma_test_targets_original.py'
        tree=ast.parse(path.read_bytes(),filename=str(path))
        names=('fixture','test_exact_up_down_flat_and_no_lowrisk_upscaling','test_future_changes_do_not_change_past_and_unknown_warmup_rejected','test_high_covariance_only_reduces_raw_and_caps_hold')
        selected=[n for n in tree.body if isinstance(n,ast.FunctionDef) and n.name in names]
        self.assertEqual(tuple(n.name for n in selected),names)
        ns=dict(np=np,pytest=pytest,weights=o.weights,DAY=config.DAY,SYMBOLS=config.SYMBOLS)
        exec(compile(ast.Module(body=selected,type_ignores=[]),str(path),'exec'),ns)
        for name in names[1:]:ns[name]()

    def test_real_polars_writer_and_roundtrip_all_calendar_shapes(self):
        for year in (2021,2023,2024):
            a=generated.daily(year);t=a['close_available_us'];d=t[199:];arrays,_=signal.build_target_grid(a['close'],t,t,d)
            w=arrays[config.RECIPES[0]+'_LOW']
            frame=pl.DataFrame(dict(available_us=np.repeat(d,5),symbol=list(config.SYMBOLS)*len(d),target_weight=w.reshape(-1)))
            self.assertEqual(frame.height,len(d)*5);self.assertEqual(frame.schema['available_us'],pl.Int64)
            raw=frame.write_csv().encode();loaded=pl.read_csv(BytesIO(raw),schema_overrides={'available_us':pl.Int64,'symbol':pl.String,'target_weight':pl.Float64})
            self.assertEqual(loaded.shape,frame.shape);self.assertEqual(loaded['available_us'].to_list(),frame['available_us'].to_list())
            np.testing.assert_allclose(loaded['target_weight'].to_numpy(),w.reshape(-1),rtol=0,atol=0)

if __name__=='__main__':unittest.main(verbosity=2)
