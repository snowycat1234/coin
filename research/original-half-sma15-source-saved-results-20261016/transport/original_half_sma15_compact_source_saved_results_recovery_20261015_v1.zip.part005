    def test_original_D_generic_interval_native_finance_exact_all_tiers(self):
        import importlib.util,sys
        import half_native_generated as g
        from test_half_native import finance
        native=g.native_reference()
        path=c.ROOT/'bounded_native_continuation_guard50_exit_expansion_20261015/expansion.py'
        manifest=c.exact_object((c.HERE/'FINANCIAL_CODE_MANIFEST.json').read_bytes())
        record=manifest['dependencies'][str(path.relative_to(c.ROOT))]
        c.exact(path,record['SHA256'],record['bytes'])
        name='_remaining9_exact_original_D_generic_quality_reference'
        spec=importlib.util.spec_from_file_location(name,path);reference=importlib.util.module_from_spec(spec)
        sys.modules[name]=reference;spec.loader.exec_module(reference)
        with g.generated_fixture(days=1) as fixture:
            targets=g.project_generated(fixture);window,rows,decisions=g._synthetic_window(fixture)
            first=int(decisions[0])+native.MINUTE;intervals=((first,first+2*native.MINUTE,native.S),)
            for tier in config.TIERS:
                new,ng=g.construct_generated_case(targets,tier,quality_intervals=intervals)
                old,og=reference.construct_case(window,rows,decisions,targets.common_tier[tier],
                    generated_scope=native.GENERATED,tier_name=tier,quality_intervals=intervals)
                for sim in (new,old):
                    while sim.cursor<sim.end and sim.stop is None:sim.advance_day()
                self.assertEqual(finance(new.account),finance(old.account))
                self.assertEqual(new.pending,old.pending)
                self.assertEqual(new.result()['minute'].to_numpy().tobytes(),old.result()['minute'].to_numpy().tobytes())
                self.assertEqual(ng.causal_mark_quality_guard.identity,og.causal_mark_quality_guard.identity)
                self.assertGreater(len(new.account.trades),0)
                result=native.case_result(new,ng);result.pop('minute');result['targets']=result['targets'].to_dicts()
                result=native.V2.OWNED.export_tree(result);audit=native.V2.OWNED.export_tree(new.account.snapshot())
                from saved_native_reconciliation import reconcile_saved_native
                proof=reconcile_saved_native(audit,result,expected_continuation_version=native.VERSION)
                self.assertTrue(proof['passed']);self.assertFalse(proof['tolerance_or_epsilon_used'])

