        current_D_result_equivalence_or_target_byte_execution_reuse_authorized=False,
        literal_funding_event_clocks_preserved=True,funding_clock_rounding_authorized=False,funding_rate_rescale_authorized=False,
        saved_targets_rebuilt_during_finance=False,covariance_rebuilt_during_finance=False,
        actual_provider_iteration_authorized=True,account_construction_authorized=True,financial_execution_authorized=True,
        fresh_genesis_only=True,automatic_retry_authorized=False,halted_snapshot_resume_authorized=False,
        internal_margin_transfers_authorized=False,topup_authorized=False,new_capital_authorized=False,debt_forgiveness_authorized=False,
        old_CS_D_or_plain_V3_GO_reused_as_authority=False,old_financial_scope_or_LoadedInputs_reused=False,
        original_half_2023_cells_authorized=True,other_cells_or_holdouts_authorized=False,publication_authorized=False)


def prepared_policy(preparation_raw,audit_details_sha,audit_guard_sha):
    p=source_entry.validate_preparation_metadata(preparation_raw)
    return dict(schema=PREPARED_REVIEW_SCHEMA,status='PASS',**base(preparation_raw),
        preparation_bytes=len(preparation_raw),artifact_pins=p['artifacts'],
        array_identities_by_year={year:info['array_identities'] for year,info in p['years'].items()},
        cell_bindings=p['cells'],audit_details_SHA256=c.digest(audit_details_sha),audit_guard_receipt_SHA256=c.digest(audit_guard_sha),
        exact_saved_target_bits_independently_verified=True,source_lineage_independently_verified=True,
        complete_original_intrinsic_signal_preserved=True,downward_only_tier_ceilings=True,
        target_or_covariance_regeneration_in_finance_authorized=False,native_financial_gate_reviewed=False,
        actual_native_source_capture_reviewed=False,financial_execution_authorized=False)


def prepared_review(preparation_raw,raw,expected_sha):
    r=c.checked_external(raw,expected_sha)
    wanted=prepared_policy(preparation_raw,r.get('audit_details_SHA256'),r.get('audit_guard_receipt_SHA256'))
    if c.canonical(r)!=c.canonical(wanted):
        raise ValueError('EXACT_FUTURE_ALL15_PREPARED_SOURCE_TARGET_ARRAY_BITS_REVIEW_REQUIRED')
    return c.immutable(r)


