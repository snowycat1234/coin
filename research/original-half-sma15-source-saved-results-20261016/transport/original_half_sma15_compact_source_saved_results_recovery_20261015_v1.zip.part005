        if not np.isfinite(value).all() or c.canonical(signal.array_byte_identity(value))!=c.canonical(prep['years'][str(year)]['array_identities'][key]):
            raise ValueError('EXACT_FINITE_TARGET_DTYPE_ENDIAN_SHAPE_RAW_BITS_REQUIRED')
    contract=entry.contracts()['years'][str(year)]
    captured=source.decode_capture(year,{name:artifacts[prefix+name] for name in contract['artifacts']},contract)
    if (arrays['decision_us'].tobytes()!=captured['decisions'].tobytes()
            or c.canonical(c.object_json(artifacts[prefix+'SOURCE_ROWS.json']))!=c.canonical(captured['source_rows'])):
        raise ValueError('EXACT_SAVED_CALENDAR_SOURCE_ROW_PARITY_REQUIRED')
    proof=entry.checked_prefix_metadata(prep['years'][str(year)]['target_prefix_metadata'],year)
    selected=codec.npz(artifacts[prefix+'SOURCE_PREFIX_INPUTS.npz'],dict(close_available_us=((proof['selected_rows'],),'int64'),close=((proof['selected_rows'],5),'float64')))
    for key,value in selected.items():
        identity=proof['clock_identity' if key=='close_available_us' else 'close_identity']
        if c.canonical(signal.array_byte_identity(value))!=c.canonical(identity):raise ValueError('EXACT_SAVED_ORIGINAL_PREFIX_RAW_BITS_REQUIRED')
    from half_sma_prefix import validate_canonical_parity
    validate_canonical_parity(dict(clocks=selected['close_available_us'],close=selected['close']),captured)
    return arrays,dict(close_available_us=captured['clocks'],close=captured['close'])


@dataclass(frozen=True,slots=True)
class LoadedHalfSmaInputs:
    year:int
    preparation_raw:bytes=field(repr=False)
    arrays:object=field(repr=False)
    source_arrays:object=field(repr=False)
    captured_artifacts:object=field(repr=False)
    _token:object=field(repr=False)
