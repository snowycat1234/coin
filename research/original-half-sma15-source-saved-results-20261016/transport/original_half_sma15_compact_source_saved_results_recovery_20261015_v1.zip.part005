␀␀Z
␀␀†␀␀␀original_half_sma15_compact_source_saved_results_recovery_20261015_v1/source/original_half_sma_D_source_20261015_v2/half_sma_config.py"""Fixed thirty-cell half_sma plan; only the all15 have a fresh source-only gate."""
from datetime import datetime, timezone
from types import MappingProxyType

VERSION = 'ORIGINAL_STATIC50_HALF_SMA200_INTRINSIC_LOWER_ONLY_D_V1'
CANDIDATE = 'ORIGINAL_STATIC50_HALF_SMA200_SINGLE_RECIPE_LOWER_ONLY'
RECIPES = ('STATIC50_HALF_SMA200',)
SYMBOLS = ('BTCUSDT', 'ETHUSDT', 'SOLUSDT', 'XRPUSDT', 'DOGEUSDT')
TIERS = ('LOW', 'MID', 'HIGH')
TIER_BUDGETS = MappingProxyType({'LOW': .05, 'MID': .10, 'HIGH': .15})
TIER_GROSS_CAPS = MappingProxyType({'LOW': .30, 'MID': .60, 'HIGH': .90})
DAY = 86_400_000_000
PERIODS = ((2023,'2023-01-01','2024-01-01',365,'FULL_YEAR'),
    (2024,'2024-01-01','2025-01-01',366,'FULL_YEAR'),
    (2025,'2025-01-01','2026-01-01',365,'FULL_YEAR'),
    (2021,'2021-04-02','2022-01-01',274,'PARTIAL_APR2_DEC31'),
    (2022,'2022-01-01','2023-01-01',365,'FULL_YEAR'))


def utc(value):
    return int(datetime.fromisoformat(value).replace(tzinfo=timezone.utc).timestamp()) * 1_000_000


def cells():
    return tuple(dict(cell_id=f'{year}_{recipe}_{tier}_D_INTRINSIC_LOWER_ONLY_V1',
        recipe=recipe, adaptation_version=VERSION, tier=tier, year=year,
        start_UTC=start,end_exclusive_UTC=end,start_us=utc(start),end_exclusive_us=utc(end),
        calendar_days=days,calendar_label=label,annual_volatility_ceiling=TIER_BUDGETS[tier],
        gross_ceiling=TIER_GROSS_CAPS[tier],asset_ceiling=.30,
        preserves_complete_original_intrinsic_signal=True,downward_only=True,
        original_execution_unchanged=False,execution_policy='GUARD50_EXIT_ONLY_CURRENT_D_NO_TOPUP',
        initial_cash_USDT='10000',fresh_independent_wallet_per_cell=True,
        financial_reuse_allowed=False,classification='SEEN_DEVELOPMENT_NOT_UNTOUCHED_OOS')
        for year,start,end,days,label in PERIODS for recipe in RECIPES for tier in TIERS)


def cell_named(cell_id):
    for cell in cells():
        if cell['cell_id'] == cell_id:
            return cell
    raise ValueError('EXACT_HALF_SMA_THIRTY_CELL_MANIFEST_REQUIRED')


def period_named(year):
    if type(year) is not int:
        raise ValueError('EXACT_INTEGER_DEVELOPMENT_YEAR_REQUIRED')
    for y,start,end,days,label in PERIODS:
        if y == year:
            return dict(year=y,start=utc(start),end=utc(end),days=days,label=label,
                        warmup_start=utc(start)-199*DAY)
    raise ValueError('EXACT_FIVE_DEVELOPMENT_PERIODS_REQUIRED')


def source_year(year):
    if type(year) is not int or year not in (2021,2022,2023,2024,2025):
        raise ValueError('ONLY_FIVE_DEV_PERIODS_2021_2022_2023_2024_2025_HOLDOUT_CLOSED')
    return period_named(year)
PK␀␀␀␀␀␀␀O]öþ¢ÿ†R␀␀†R␀␀…␀␀␀original_half_sma15_compact_source_saved_results_recovery_20261015_v1/source/original_half_sma_D_source_20261015_v2/half_sma_entry.py"""Separate half_sma source-only authority. No financial constructor or token exists.

Validators are pure metadata checks. An actual source scope additionally needs a
fresh exact review, a fresh root source GO, and the whole-invocation source guard.
The frozen FIRST6 is excluded; actual all15 capture remains fresh-GO-gated.
"""
from contextlib import contextmanager
from dataclasses import dataclass, field
import half_sma_common as c
import half_sma_config as config

ALL15 = 'ALL15_FIVE_DEV_PERIODS_SINGLE_ORIGINAL_HALF_SMA_ALL_THREE_TIERS'
SOURCE_SCHEMA = 'ROOT_SOURCE_TARGET_HALF_SMA_INTRINSIC_ALL15_V1'
SOURCE_REVIEW_SCHEMA = 'INDEPENDENT_HALF_SMA_INTRINSIC_ALL15_SOURCE_GENERATED_REVIEW_V1'
PREPARATION_SCHEMA = 'PREPARED_HALF_SMA_INTRINSIC_ALL15_SOURCE_TARGET_ONLY_V1'
MANIFEST_NAME = 'FROZEN_FIFTEEN_CELL_MANIFEST.json'
_PURE_CODE_SHA = 'f4e3b8ef15e083f374c6a38f287b543114e8ac2cda5faa50e80f7f3ed8958e8a'
_SOURCE_SEAL, _RECORD_SEAL = object(), object()
_ACTIVE_SOURCE, _ACTIVE_RECORDING = {}, set()


def manifest():
    value = c.exact_object(c.ordinary(c.HERE / MANIFEST_NAME))
    fixed = dict(schema=config.VERSION, candidate=config.CANDIDATE, cell_count=15,
        cells=list(config.cells()),source_checkpoint=ALL15,
        source_enabled_cells=[cell['cell_id'] for cell in config.cells() if True],
        first6_source_entry_enabled=False,financial_entry_implemented=False,
        original_execution_replication=False,financial_reuse_allowed=False)
    if c.canonical(value) != c.canonical(fixed):
        raise ValueError('EXACT_FROZEN_HALF_SMA_THIRTY_CELL_MANIFEST_REQUIRED')
    return value


def manifest_sha():
    manifest()
    return c.sha(c.ordinary(c.HERE / MANIFEST_NAME))


def tranche_cells(tranche):
    if tranche != ALL15:
        raise ValueError('ONLY_ALL15_EXACT_FOUR_YEAR_HALF_SMA_SOURCE_CHECKPOINT_ENABLED')
    return tuple(cell['cell_id'] for cell in config.cells() if True)


def tranche_years(tranche):
    tranche_cells(tranche)
    return tuple(dict.fromkeys(cell['year'] for cell in config.cells() if True))


def contracts():
    raw = c.ordinary(c.HERE/'SOURCE_CONTRACT_MAP.json')
    value = c.exact_object(raw)
    if (set(value.get('years',{})) != {'2021','2022','2023','2024','2025'}
            or value.get('schema') != 'ORIGINAL_HALF_SMA_ALL15_SAVED_SOURCE_CAPTURE_MAP_V1'):
        raise ValueError('EXACT_SEPARATE_ALL15_FOUR_YEAR_SOURCE_CONTRACT_REQUIRED')
    # CODE_MANIFEST binds this file's exact bytes before admission.
    return value


def contract_sha():
    contracts()
    return c.sha(c.ordinary(c.HERE/'SOURCE_CONTRACT_MAP.json'))


def code_identity():
    raw = c.ordinary(c.HERE/'CODE_MANIFEST.json')
    record = c.exact_object(raw)
    if record.get('schema') != 'HALF_SMA_INTRINSIC_SOURCE_ONLY_CODE_IDENTITY_V1':
        raise ValueError('EXACT_HALF_SMA_SOURCE_CODE_MANIFEST_REQUIRED')
    for name,pin in record['files'].items():
        c.exact(c.HERE/c.relative(name),pin['SHA256'],pin['bytes'])
    pins = c.exact_object(c.ordinary(c.HERE/'DEPENDENCY_PINS.json'))['files']
    if c.canonical(record['dependencies']) != c.canonical(pins):
        raise ValueError('EXACT_REVIEWED_HALF_SMA_SOURCE_DEPENDENCIES_REQUIRED')
    for name,pin in pins.items():
        path=c.ROOT/c.relative(name)
        if path.suffix not in ('.py','.json','.md','.txt'):
            raise ValueError('CODE_METADATA_DEPENDENCY_ONLY')
        c.exact(path,pin['SHA256'],pin['bytes'])
    return c.sha(raw)


def review_policy(tranche):
    return dict(schema=SOURCE_REVIEW_SCHEMA,status='PASS',candidate=config.CANDIDATE,
        adaptation_version=config.VERSION,tranche=tranche,ordered_cells=list(tranche_cells(tranche)),
        years=list(tranche_years(tranche)),code_manifest_SHA256=code_identity(),
        scope_manifest_SHA256=manifest_sha(),source_contract_map_SHA256=contract_sha(),
        pure_signal_code_manifest_SHA256=_PURE_CODE_SHA,I01_unsupported_dtype_gate_reviewed=True,
        source_native_financial_approval=False,old_CS_core_D_or_half_sma_baseline_authority_reused=False)


def source_policy(tranche,review_sha):
    return dict(schema=SOURCE_SCHEMA,status='APPROVED_SOURCE_TARGET_ONLY',
        action='PREPARE_EXACT_'+tranche+'_HALF_SMA_SOURCE_TARGETS_ONLY',
        candidate=config.CANDIDATE,adaptation_version=config.VERSION,tranche=tranche,
        ordered_cells=list(tranche_cells(tranche)),years=list(tranche_years(tranche)),
        code_manifest_SHA256=code_identity(),scope_manifest_SHA256=manifest_sha(),
        source_contract_map_SHA256=contract_sha(),independent_review_SHA256=c.digest(review_sha),
        pure_signal_code_manifest_SHA256=_PURE_CODE_SHA,
        source_identities={str(year):contracts()['years'][str(year)]['source_identity'] for year in tranche_years(tranche)},
        canonical_source_capture_authorized=True,target_generation_authorized=True,
        first6_cells_source_authorized=False,old_CS_core_D_or_half_sma_baseline_authority_reused=False,
        historical_execution_authorized=False,financial_execution_authorized=False,
        account_construction_authorized=False,provider_iteration_authorized=False,
        process_launch_authorized=False,canonical_claims_authorized=False,
        financial_GO_authorized=False,publication_authorized=False,downloads_authorized=False,
        source_limits=dict(CPU=0,CPU_seconds=900,wall_seconds=1800,AS_bytes=3000000000,
            output_bytes=1073741824,process_count=1,numerical_pools=1))


def validate_source_authority_metadata(go_raw,expected_go_sha256,review_raw,expected_review_sha256):
    go=c.checked_external(go_raw,expected_go_sha256)
    review=c.checked_external(review_raw,expected_review_sha256)
    if go.get('tranche') != ALL15:
        raise ValueError('ONLY_ALL15_EXACT_FOUR_YEAR_HALF_SMA_SOURCE_CHECKPOINT_ENABLED')
    if c.canonical(review) != c.canonical(review_policy(ALL15)):
        raise ValueError('EXACT_NEW_INDEPENDENT_HALF_SMA_SOURCE_REVIEW_REQUIRED')
    if c.canonical(go) != c.canonical(source_policy(ALL15,expected_review_sha256)):
        raise ValueError('EXACT_NEW_ROOT_HALF_SMA_SOURCE_ONLY_AUTHORITY_REQUIRED')
    return c.immutable(dict(policy=go,root_go_SHA256=expected_go_sha256,review_SHA256=expected_review_sha256))


@dataclass(frozen=True,slots=True)
class HalfSmaSourcePreparationScope:
    tranche:str
    source_go_sha256:str
    review_sha256:str
    raw_go:bytes=field(repr=False)
    raw_review:bytes=field(repr=False)
    _code:str=field(repr=False)
    _token:object=field(repr=False)
    _seal:object=field(repr=False)

    def __post_init__(self):
        if self._seal is not _SOURCE_SEAL:
            raise ValueError('FRESH_SEPARATE_HALF_SMA_SOURCE_SCOPE_SEAL_REQUIRED')

    def validate_current(self,*,year=None):
        if _ACTIVE_SOURCE.get(self._token) is not self or self._code != code_identity():
            raise ValueError('LIVE_CURRENT_HALF_SMA_SOURCE_SCOPE_REQUIRED')
        validate_source_authority_metadata(self.raw_go,self.source_go_sha256,self.raw_review,self.review_sha256)
        if year is not None:
            config.source_year(year)
        from half_sma_source_guard import current_guard
        guard=current_guard()
        if guard is None or not guard.active:
            raise ValueError('WHOLE_INVOCATION_HALF_SMA_SOURCE_ONLY_GUARD_REQUIRED')
        guard.checkpoint('SOURCE_SCOPE_CHECK')
        return True

    def read_source(self,year,name,expected_sha256,expected_bytes=None):
        self.validate_current(year=year)
        name=c.relative(name)
        pin=contracts()['years'][str(year)]['read_files'].get(name)
        if (pin is None or pin['SHA256'] != expected_sha256
                or expected_bytes is not None and (type(expected_bytes) is not int or expected_bytes != pin['bytes'])):
            raise ValueError('EXACT_HALF_SMA_QUALIFIED_SAVED_SOURCE_READ_ALLOWLIST_REQUIRED')
        return c.exact(c.ROOT/name,expected_sha256,pin['bytes'])


@contextmanager
def admit_source_stage(go_raw,expected_go_sha256,review_raw,expected_review_sha256):
    value=validate_source_authority_metadata(go_raw,expected_go_sha256,review_raw,expected_review_sha256)
    from half_sma_source_guard import current_guard
    guard=current_guard()
    if guard is None or not guard.active:
        raise ValueError('WHOLE_INVOCATION_HALF_SMA_SOURCE_ONLY_GUARD_REQUIRED')
    token=object()
    scope=HalfSmaSourcePreparationScope(value['policy']['tranche'],expected_go_sha256,expected_review_sha256,
        go_raw,review_raw,code_identity(),token,_SOURCE_SEAL)
    _ACTIVE_SOURCE[token]=scope
    try:
        scope.validate_current()
        yield scope
    finally:
        _ACTIVE_SOURCE.pop(token,None)


def array_specs(year):
    days=config.source_year(year)['days']
    return dict(decision_us=((days,),'int64'),annual_covariance=((days,5,5),'float64'),
        **{'intrinsic_'+recipe:((days,5),'float64') for recipe in config.RECIPES},
        **{name:((days,5),'float64') for name in ('STATIC50_RETARGETED','SMA200_10PCT','SMA200_DIRECTION','SMA200_MEAN','STATIC50_OLD_NO_REEXPANSION')},
        **{recipe+'_'+tier:((days,5),'float64') for recipe in config.RECIPES for tier in config.TIERS})


def checked_array_identities(identities,year):
    import numpy as np
    if type(identities) is not dict or set(identities) != set(array_specs(year)):
        raise ValueError('EXACT_INTRINSIC_TARGET_COVARIANCE_ARRAY_NAMESPACE_REQUIRED')
    for key,(shape,dtype) in array_specs(year).items():
        identity=identities[key]
        if (type(identity) is not dict or set(identity) != {'dtype','shape','order','raw_bytes_SHA256','descriptor_and_bytes_SHA256'}
                or identity['dtype'] != np.dtype(dtype).str or identity['shape'] != list(shape) or identity['order']!='C'):
            raise ValueError('EXACT_PLAIN_DTYPE_ENDIAN_SHAPE_CBYTES_ARRAY_IDENTITY_REQUIRED')
        c.digest(identity['raw_bytes_SHA256']);c.digest(identity['descriptor_and_bytes_SHA256'])
    return identities


def checked_prefix_metadata(value,year):
    import numpy as np
    period=config.source_year(year);pc=contracts()['years'][str(year)]['original_target_prefix']
    fields={'schema','year','original_wrapper_SHA256','original_member_SHA256','original_member_name','stored_rows','selected_rows',
        'first_source_clock_us','last_source_clock_us','first_excluded_clock_us','prefix_first_row_retained','source_fields',
        'unselected_numerical_arrays_interpreted','future_close_rows_interpreted','clock_identity','close_identity','source_admitted','financial_authorized'}
    if (type(value) is not dict or set(value)!=fields or value['schema']!='EXACT_ORIGINAL_CAUSAL_SUPPLIED_PREFIX_SELECTION_V1'
        or type(value['year']) is not int or value['year']!=year
        or value['original_wrapper_SHA256']!=pc['wrapper']['SHA256'] or value['original_member_SHA256']!=pc['member']['SHA256']
        or value['original_member_name']!=pc['member']['name'] or type(value['stored_rows']) is not int
        or type(value['selected_rows']) is not int or not period['days']+199<=value['selected_rows']<=value['stored_rows']<=4096
        or type(value['first_source_clock_us']) is not int or value['first_source_clock_us']<config.utc('2020-01-01')
        or value['last_source_clock_us']!=period['end']-config.DAY
        or value['last_source_clock_us']-value['first_source_clock_us']!=(value['selected_rows']-1)*config.DAY
        or value['prefix_first_row_retained'] is not True
        or value['source_fields']!=['symbol_order','close_available_us','close']
        or value['unselected_numerical_arrays_interpreted'] is not False or value['future_close_rows_interpreted']!=0
        or value['source_admitted'] is not False or value['financial_authorized'] is not False):
        raise ValueError('EXACT_ORIGINAL_FULL_CAUSAL_PREFIX_SELECTION_METADATA_REQUIRED')
    if value['first_excluded_clock_us'] is not None and (type(value['first_excluded_clock_us']) is not int or value['first_excluded_clock_us']<=value['last_source_clock_us']):
        raise ValueError('EXACT_ORIGINAL_CLOCK_PREFIX_BOUNDARY_REQUIRED')
    for key,shape,dtype in (('clock_identity',[value['selected_rows']],'int64'),('close_identity',[value['selected_rows'],5],'float64')):
        identity=value[key]
        if (type(identity) is not dict or set(identity)!={'dtype','shape','order','raw_bytes_SHA256','descriptor_and_bytes_SHA256'}
            or identity['dtype']!=np.dtype(dtype).str or identity['shape']!=shape or identity['order']!='C'):
            raise ValueError('EXACT_ORIGINAL_PREFIX_ARRAY_IDENTITY_REQUIRED')
        c.digest(identity['raw_bytes_SHA256']);c.digest(identity['descriptor_and_bytes_SHA256'])
    return value


def binding_from_info(cell,info,source_go_sha,source_review_sha):
    if cell.get('cell_id') not in tranche_cells(ALL15) or c.canonical(cell)!=c.canonical(config.cell_named(cell['cell_id'])):
        raise ValueError('EXACT_ALL15_HALF_SMA_CELL_DESCRIPTOR_REQUIRED')
    contract=contracts()['years'][str(cell['year'])]; key=cell['recipe']+'_'+cell['tier']
    identities=checked_array_identities(info['array_identities'],cell['year'])
    return dict(schema='EXACT_HALF_SMA_INTRINSIC_CELL_SOURCE_TARGET_BINDING_V1',
        cell_id=cell['cell_id'],recipe=cell['recipe'],adaptation_version=config.VERSION,
        year=cell['year'],tier=cell['tier'],calendar=[cell['start_us'],cell['end_exclusive_us']],
        code_manifest_SHA256=code_identity(),scope_manifest_SHA256=manifest_sha(),
        source_contract_map_SHA256=contract_sha(),source_identity=contract['source_identity'],
        source_contract_SHA256=c.jsha(contract),pure_signal_code_manifest_SHA256=_PURE_CODE_SHA,
        source_stage_GO_SHA256=c.digest(source_go_sha),source_review_SHA256=c.digest(source_review_sha),
        source_rows_SHA256=info['source_rows_SHA256'],funding_events_SHA256=info['funding_events_SHA256'],
        source_inputs_SHA256=info['source_inputs_SHA256'],
        source_quality_sidecar_SHA256=info['source_quality_sidecar_SHA256'],quality_cells_SHA256=contract['source_metadata']['quality_cells_SHA256'],
        provider_months=[[rec['path'],rec['start'],rec['count'],rec['hash'],rec['size'],rec['lo'],rec['hi']] for rec in contract['qualified_source_contract']['months']],
        decision_identity=identities['decision_us'],covariance_identity=identities['annual_covariance'],
        original_intrinsic_identity=identities['intrinsic_'+cell['recipe']],selected_target_identity=identities[key],
        target_prefix_metadata=checked_prefix_metadata(info['target_prefix_metadata'],cell['year']),
        preserves_complete_original_intrinsic_signal=True,downward_only=True,
        original_execution_unchanged=False,financial_reuse_allowed=False,
        cost='BASE27',policy_variant='GUARD50_EXIT_ONLY')


def year_metadata(year):
    period=config.source_year(year);contract=contracts()['years'][str(year)]
    original=contract['source_metadata']
    return dict(source_identity=contract['source_identity'],source_contract_SHA256=c.jsha(contract),
        days=period['days'],calendar=[period['start'],period['end']],
        quality_cells_SHA256=original['quality_cells_SHA256'],
        provider_months_source=original['provider_months_source'],
        saved_source_preparation_SHA256=contract['saved_preparation']['SHA256'],
        qualified_source_contract_SHA256=c.jsha(contract['qualified_source_contract']),
        source_rows_SHA256=original['source_rows_SHA256'],funding_events_SHA256=original['funding_events_SHA256'],
        source_quality_sidecar_SHA256=contract['artifacts']['MINUTE_MARK_PROVENANCE.json']['SHA256'],
        source_inputs_SHA256=contract['artifacts']['SOURCE_INPUTS.npz']['SHA256'],
        all_half_sma_position_and_event_impacts_pending=True,
        original_source_age_and_arrival_flags_preserved=True,
        actual_half_sma_native_outcomes_inferred=False,
        source_completion_is_not_arrival_certification=True,
        evidence_limits=contract['evidence_limits'])


def validate_preparation_metadata(raw):
    value=c.exact_object(raw);ordered=tranche_cells(value.get('tranche'));years=tranche_years(value['tranche'])
    fixed=dict(schema=PREPARATION_SCHEMA,candidate=config.CANDIDATE,adaptation_version=config.VERSION,
        ordered_cells=list(ordered),code_manifest_SHA256=code_identity(),scope_manifest_SHA256=manifest_sha(),
        source_contract_map_SHA256=contract_sha(),historical_admission=False,financial_runs=0,
        accounts_created=0,accounts_advanced=0,provider_iterations=0,process_launches=0,
        canonical_claims_created=0,real_financial_GO_written=0,publication_actions=0)
