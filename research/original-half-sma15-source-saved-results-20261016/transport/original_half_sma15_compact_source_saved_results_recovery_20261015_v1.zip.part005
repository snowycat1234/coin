            cells.append(old.QualityCell(symbol,at,at+native.MINUTE,at+native.MINUTE,'123.125',anchor,
                anchor+native.MINUTE,anchor+native.MINUTE,anchor+native.MINUTE,anchor+native.MINUTE,'c'*64,'GENERATED_ONLY_ANCHOR'))
        cells=tuple(cells);old.validate_quality_binding(cells,expected_missing_cells=points)
        intervals=source_quality.intervals(cells)
