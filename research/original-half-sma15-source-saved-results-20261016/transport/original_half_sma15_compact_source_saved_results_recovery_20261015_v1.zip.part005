SOURCE_CODE_SHA256='a10cebea5f62fcdf1d15d9efdcbe7691823a94b51faf6064176d6a66dfafafb6'
REVIEW_SCHEMA='INDEPENDENT_ORIGINAL_HALF_SMA_ALL15_FINANCIAL_ADMISSION_V1'
