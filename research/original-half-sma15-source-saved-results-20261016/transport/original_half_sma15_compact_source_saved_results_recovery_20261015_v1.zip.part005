    if c.canonical(r)!=c.canonical(native_policy(r.get('generated_resource_probe_SHA256'))):
        raise ValueError('EXACT_SEPARATE_LEGACY_NATIVE_GENERATED_REVIEW_REQUIRED')
    return c.immutable(r)


def review_policy(preparation_raw,prepared_review_sha,native_review_sha):
    return dict(base(preparation_raw),schema=REVIEW_SCHEMA,status='PASS',
        prepared_source_target_review_SHA256=c.digest(prepared_review_sha),native_generated_review_SHA256=c.digest(native_review_sha),
        native_financial_gate_reviewed=True,financial_execution_authorized=False,
        real_CLI_generated_GO_guard_integration_reviewed=True,shared_CPU45_lease_exclusion_reviewed=True,
        separate_legacy_fresh_genesis_claims_reviewed=True,old_CS_D_or_plain_V3_GO_reused_as_authority=False,
        original_half_2023_cells_authorized=True,other_cells_or_holdouts_authorized=False)


def validate(preparation_raw,go_raw,expected_go_sha,review_raw,expected_review_sha,
             prepared_review_raw,expected_prepared_review_sha,native_review_raw,expected_native_review_sha):
    prepared_review(preparation_raw,prepared_review_raw,expected_prepared_review_sha)
    native_review(native_review_raw,expected_native_review_sha)
    r=c.checked_external(review_raw,expected_review_sha)
