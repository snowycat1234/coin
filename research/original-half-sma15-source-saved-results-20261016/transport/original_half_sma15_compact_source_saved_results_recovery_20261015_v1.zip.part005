def code_identity():
    here=Path(__file__).resolve().parent
    if c.HERE!=here or Path(source_entry.__file__).resolve()!=half_native_bootstrap.SOURCE/'half_sma_entry.py':
        raise ValueError('EXACT_NEW_FINANCE_AND_FROZEN_SOURCE_MODULE_IDENTITIES_REQUIRED')
    if source_entry.code_identity()!=SOURCE_CODE_SHA256:raise ValueError('FROZEN_LEGACY_SOURCE_IDENTITY_CHANGED')
    raw=c.ordinary(here/'FINANCIAL_CODE_MANIFEST.json');m=c.exact_object(raw)
    if (set(m)!={'schema','status','source_code_manifest_SHA256','files','dependencies','runtime_dependency_exclusions'}
            or m['schema']!='ADDITIVE_ORIGINAL_HALF_SMA_ALL15_NATIVE_FINANCIAL_CODE_V1'
            or m['source_code_manifest_SHA256']!=SOURCE_CODE_SHA256
            or m['runtime_dependency_exclusions']!=['CS_FAILED_CLAIMS','CS_SUPERSESSION_PACKETS','CS_ROOT_GO','PLAIN_V3_ROOT_GO']):
        raise ValueError('EXACT_LEGACY_FINANCIAL_CODE_MANIFEST_REQUIRED')
    for name,pin in m['files'].items():c.exact(here/c.relative(name),pin['SHA256'],pin['bytes'])
    for name,pin in m['dependencies'].items():c.exact(c.ROOT/c.relative(name),pin['SHA256'],pin['bytes'])
    return c.sha(raw)


def base(preparation_raw):
    p=source_entry.validate_preparation_metadata(preparation_raw)
    return dict(candidate=config.CANDIDATE,adaptation_version=config.VERSION,pure_signal_code_manifest_SHA256='f4e3b8ef15e083f374c6a38f287b543114e8ac2cda5faa50e80f7f3ed8958e8a',source_code_manifest_SHA256=SOURCE_CODE_SHA256,financial_code_manifest_SHA256=code_identity(),
        scope_manifest_SHA256=source_entry.manifest_sha(),source_contract_map_SHA256=source_entry.contract_sha(),
        tranche=source_entry.ALL15,ordered_cells=list(source_entry.tranche_cells(source_entry.ALL15)),years=list(source_entry.tranche_years(source_entry.ALL15)),
        preparation_SHA256=c.sha(preparation_raw),source_stage_GO_SHA256=p['source_stage_GO_SHA256'],
        source_independent_review_SHA256=p['source_review_SHA256'],
        per_cell_input_binding_SHA256={k:v['input_binding_SHA256'] for k,v in p['cells'].items()})


def policy(preparation_raw,review_sha,prepared_review_sha,native_review_sha,worker_cpus):
    if type(worker_cpus) is not list or worker_cpus!=[4,5] or any(type(x) is not int for x in worker_cpus):
        raise ValueError('EXACT_MAX2_DISTINCT_CPU4_5_WORKERS_REQUIRED')
    return dict(base(preparation_raw),schema=GO_SCHEMA,status='APPROVED_FRESH_EXACT_ALL15',
        action='RUN_FRESH_ORIGINAL_STATIC50_HALF_SMA200_ALL15_FIVE_DEV_PERIODS_CURRENT_D_ONLY',
        requested_worker_count=2,worker_CPUs=[4,5],resource_limits=dict(per_case_wall_seconds=600,per_case_CPU_seconds=600,
            per_case_RSS_stop_bytes=2000000000,per_case_AS_bytes=4000000000,per_case_output_bytes=250000000,
            aggregate_live_worker_RSS_stop_bytes=3500000000,compute_pool_threads_max=1),
        global_inherited_flock_required=True,permanent_cross_output_cell_claim_required=True,
        separate_fresh_genesis_claim_namespace=CLAIM_NAMESPACE,shared_CS_CPU45_lease=SHARED_CPU_LEASE,
        shared_CPU45_lease_nonblocking=True,other_controller_overlap_authorized=False,
        target_financial_independent_review_SHA256=c.digest(review_sha),
        prepared_source_target_review_SHA256=c.digest(prepared_review_sha),native_generated_review_SHA256=c.digest(native_review_sha),
        policy_variant='GUARD50_EXIT_ONLY',cost='BASE27',initial_cash_USDT='10000',free_cash_floor_USDT='1000',
        isolated_margin_ceiling_USDT='8500',quantity_profile_SHA256='94b2238b25ed345a24a1fa148c6f35523b8efe9bf47496958028844432cb8ebf',
        source_recapture='EXACT_REVIEWED_FIVE_YEAR_NATIVE_FRAMES_UNCHANGED_SOURCE_GUARD_BEFORE_FINANCE_IMPORT',
