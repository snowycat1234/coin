PK␀␀␀␀␀␀␀O]Õ†c)Û,␀␀Û,␀␀„␀␀␀original_half_sma15_compact_source_saved_results_recovery_20261015_v1/source/original_half_sma_signal_20261015_v1/half_sma_signal.py"""Original equal-half arithmetic and exact complete component-source ASTs.

No research runner is imported. Original STATIC50 is risk-retargeted BEFORE the
literal half-sum. The original pandas SMA feature and downscale-only target producer are isolated
from their pinned source. This pure math module cannot authorize historical
source/target preparation or financial execution.
"""
from __future__ import annotations
import ast
from pathlib import Path
from types import SimpleNamespace
import hashlib
import json
import numpy as np
import pandas as pd

HERE = Path(__file__).absolute().parent
DAY = 86_400_000_000
SYMBOLS = ('BTCUSDT','ETHUSDT','SOLUSDT','XRPUSDT','DOGEUSDT')
RECIPE = 'STATIC50_HALF_SMA200'
VERSION = 'ORIGINAL_HALF_SMA_INTRINSIC_LOWER_ONLY_GENERATED_V1'
TIERS = (('LOW',.30,.05,.30),('MID',.60,.10,.30),('HIGH',.90,.15,.30))


def sha(raw): return hashlib.sha256(raw).hexdigest()


def ordinary(path):
    path = Path(path).absolute()
    if path.is_symlink() or any(p.is_symlink() for p in path.parents) or not path.is_file():
        raise ValueError('ORDINARY_PINNED_SOURCE_CODE_REQUIRED')
    return path.read_bytes()


def verify_sources():
    pinmap = json.loads(ordinary(HERE/'SOURCE_PINS.json'))
    for name,pin in pinmap['files'].items():
        rel=Path(name)
        if rel.is_absolute() or '..' in rel.parts or rel.parts[0]!='pinned':
            raise ValueError('PINNED_LOCAL_CODE_NAMESPACE_REQUIRED')
        raw=ordinary(HERE/rel)
        blob=hashlib.sha1(b'blob '+str(len(raw)).encode()+b'\0'+raw).hexdigest()
        if len(raw)!=pin['bytes'] or sha(raw)!=pin['SHA256'] or blob!=pin['GitBlobSHA1']:
            raise ValueError('EXACT_ORIGINAL_SOURCE_BYTES_CHANGED:'+name)
    return pinmap


def originals():
    verify_sources()
    ns=dict(np=np,pd=pd,DAY=DAY,DAY_US=DAY,WEEK_US=7*DAY,
        ANCHOR_US=1704067200000000,SYMBOLS=SYMBOLS,
        EXPERTS=('SMA200_SIGNED','CSMOM21_CORE5','HOLD','CASH'),
        ARMS=('CS_MATCHED','VOL_MATCHED','STATIC50'),
        ANNUAL_BUDGET=.10,ASSET_CAP=.30,GROSS_CAP=.60)
    selections=(('public_sma_perpetual.py',('require','symbol_order','signed_risk_weights')),
        ('portfolio.py',('market_neutral',)),
        ('public_cross_section_momentum.py',('public_targets',)),
        ('joint_expert_information.py',('signed_intents',)),
        ('match_core.py',('match',)),('risk_budget.py',('scale','allocate')))
    for filename,names in selections:
        path=HERE/'pinned/sources/reference'/filename
        tree=ast.parse(ordinary(path),filename=str(path))
        selected=[n for n in tree.body if isinstance(n,ast.FunctionDef) and n.name in names]
        if tuple(n.name for n in selected)!=names:raise ValueError('EXACT_ORIGINAL_FUNCTION_INVENTORY_REQUIRED')
        exec(compile(ast.Module(body=selected,type_ignores=[]),str(path),'exec'),ns)
    path=HERE/'pinned/sma_targets_original.py'
    tree=ast.parse(ordinary(path),filename=str(path))
    selected=[n for n in tree.body if isinstance(n,ast.FunctionDef) and n.name=='weights']
    if len(selected)!=1:raise ValueError('EXACT_ORIGINAL_SMA_WEIGHTS_FUNCTION_REQUIRED')
    exec(compile(ast.Module(body=selected,type_ignores=[]),str(path),'exec'),ns)
    feature_nodes=[n for n in selected[0].body if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id in ('mean','signal') for t in n.targets)]
    if len(feature_nodes)!=2:raise ValueError('EXACT_ORIGINAL_SMA_FEATURE_ASSIGNMENTS_REQUIRED')
    feature_code=compile(ast.Module(body=feature_nodes,type_ignores=[]),str(path),'exec')
    # Isolate only the exact original arithmetic expression. The legacy mix()
    # validator is intentionally retained as a separate 365-day reference;
    # calendar generalization below is explicit new admission wrapper code.
    path=HERE/'pinned/targets_original.py';tree=ast.parse(ordinary(path),filename=str(path))
    mix=next(n for n in tree.body if isinstance(n,ast.FunctionDef) and n.name=='mix')
    expression=next(n.value for n in mix.body if isinstance(n,ast.Assign)
        and any(isinstance(t,ast.Name) and t.id=='result' for t in n.targets))
    ns['_half_sum_code']=compile(ast.Expression(body=expression),str(path),'eval')
    names=('scale','allocate','signed_intents','match','public_targets','signed_risk_weights','weights')
    return SimpleNamespace(**{name:ns[name] for name in names},half_sum_code=ns['_half_sum_code'],feature_code=feature_code)


def supported(value,dtype=None):
    a=np.asarray(value)
    if (a.dtype.fields is not None or a.dtype.subdtype is not None or a.dtype.hasobject
        or (a.dtype.kind,a.dtype.itemsize) not in (('b',1),('i',8),('f',8))):
        raise ValueError('PLAIN_BOOL_INT64_FLOAT64_ONLY')
    if dtype is not None and a.dtype!=np.dtype(dtype):raise ValueError('EXACT_ARRAY_DTYPE_REQUIRED')
    return a


def immutable(value):
    a=supported(value)
    return np.frombuffer(a.tobytes(order='C'),dtype=a.dtype).reshape(a.shape)


def array_byte_identity(value):
    a=supported(value);descriptor=dict(dtype=a.dtype.str,shape=list(a.shape),order='C')
    header=json.dumps(descriptor,sort_keys=True,separators=(',',':')).encode()
    return dict(**descriptor,raw_bytes_SHA256=sha(a.tobytes(order='C')),
        descriptor_and_bytes_SHA256=sha(header+b'\0'+a.tobytes(order='C')))


def clock(value):
    a=supported(value,'int64')
    if a.ndim!=1 or not len(a) or np.any(a<0) or np.any(a%DAY) or np.any(np.diff(a)!=DAY):
        raise ValueError('COMPLETE_UTC_DAILY_INT64_CLOCK_REQUIRED')
    return a


def covariance_checked(value):
    a=supported(value,'float64')
    if a.shape!=(5,5) or not np.isfinite(a).all() or not np.allclose(a,a.T,rtol=0,atol=1e-14):
        raise ValueError('FINITE_SYMMETRIC_ORDERED_CORE5_COVARIANCE_REQUIRED')
    if np.linalg.eigvalsh(a).min() < -1e-12:raise ValueError('NON_PSD_COVARIANCE')
    return a


def lower_only(weight,covariance,tier_name):
    try:_,gross_ceiling,vol_ceiling,asset_ceiling=next(t for t in TIERS if t[0]==tier_name)
    except StopIteration:raise ValueError('EXACT_FIXED_TIER_REQUIRED') from None
    w=supported(weight,'float64');c=covariance_checked(covariance)
    if (w.shape!=(5,) or not np.isfinite(w).all() or np.abs(w).max()>.30+1e-12
        or np.abs(w).sum()>.60+1e-12):raise ValueError('FINITE_ORIGINAL_INTRINSIC_ENVELOPE_REQUIRED')
    gross=float(np.abs(w).sum());largest=float(np.abs(w).max());variance=float(w@c@w)
    if variance < -1e-15 or not np.isfinite(variance):raise ValueError('NONNEGATIVE_ORIGINAL_COVARIANCE_RISK_REQUIRED')
    sigma=float(np.sqrt(max(0.,variance)))
    factor=min(1.,vol_ceiling/sigma if sigma>0 else 1.,gross_ceiling/gross if gross>0 else 1.,asset_ceiling/largest if largest>0 else 1.)
    out=w.copy() if factor==1. else w*factor
    if not (0<=factor<=1.) or np.any(np.abs(out)>np.abs(w)+1e-15):raise ValueError('LOWER_ONLY_NO_REEXPANSION_REQUIRED')
    return immutable(out),dict(factor=factor,raw_sigma=sigma,post_sigma=float(np.sqrt(max(0.,float(out@c@out)))),reexpanded=False)


def from_components(decisions,static50_retargeted,sma200_10pct,covariance,*,symbols=SYMBOLS):
    if tuple(symbols)!=SYMBOLS:raise ValueError('EXACT_ORDERED_CORE5_REQUIRED')
    d=clock(decisions);a=supported(static50_retargeted,'float64');b=supported(sma200_10pct,'float64');cov=supported(covariance,'float64')
    if a.shape!=(len(d),5) or b.shape!=a.shape or cov.shape!=(len(d),5,5):raise ValueError('EXACT_COMPONENT_CALENDAR_SHAPES_REQUIRED')
    for v in (a,b):
        if not np.isfinite(v).all() or np.abs(v).max()>.3+1e-12 or np.abs(v).sum(axis=1).max()>.6+1e-12:
            raise ValueError('FINITE_ORIGINAL_RISK_CONTROLLED_COMPONENTS_REQUIRED')
    o=originals();w=eval(o.half_sum_code,{'__builtins__':{}},dict(a=a,b=b))
    arrays=dict(decision_us=d,annual_covariance=cov,STATIC50_RETARGETED=a,SMA200_10PCT=b,
        intrinsic_STATIC50_HALF_SMA200=w)
    proofs=[]
    for i,at in enumerate(d):
        tiers={}
        for tier,*_ in TIERS:
            key=RECIPE+'_'+tier
            if key not in arrays:arrays[key]=np.empty_like(w)
            arrays[key][i],tiers[tier]=lower_only(w[i],cov[i],tier)
        proofs.append(dict(decision_us=int(at),tiers=tiers,opposing_signed_legs_netted=True,
            post_mix_reexpansion=False,source_admitted=False,financial_authorized=False))
    return {key:immutable(value) for key,value in arrays.items()},proofs


def build_target_grid(close,close_us,available_us,decisions,*,symbols=SYMBOLS):
    """Complete original intrinsic recipe FIRST, then downward-only tier ceilings.

    The sole calendar adaptation admits any complete supplied daily window,
    including the fixed 274/365/366-day DEV periods. It does not modify any
    original feature, CS weekly state, risk function or half-sum expression.
    Caller arrays confer no source or financial authority.
    """
    if tuple(symbols)!=SYMBOLS:raise ValueError('EXACT_ORDERED_CORE5_REQUIRED')
    p=supported(close,'float64');t=clock(close_us);a=clock(available_us);d=clock(decisions)
    if p.shape!=(len(t),5) or not np.array_equal(t,a):raise ValueError('EXACT_COMPLETED_CLOSE_AVAILABILITY_NAMESPACE_REQUIRED')
    ids=np.searchsorted(t,d)
    if np.any(ids>=len(t)) or not np.array_equal(t[ids],d) or np.any(ids<199):raise ValueError('ORIGINAL_200_COMPLETED_CLOSE_ADMISSION_REQUIRED')
    end=int(ids[-1])+1;p=p[:end].copy();t=t[:end].copy()
    ready=np.zeros(p.shape,dtype=bool)
    for k in range(199,len(t)):
        ready[k]=np.all(np.isfinite(p[k-199:k+1]) & (p[k-199:k+1]>0),axis=0)
    if not ready[ids].all():raise ValueError('FULL_FIVE_ORIGINAL_200_CLOSE_READINESS_REQUIRED')
    o=originals()
    # Exact original producer: pandas rolling mean, sign including equality CASH,
    # exact signed_intents and exact downscale-only signed_risk_weights.
    sma,direction,mean,sma_ids=o.weights(t,p,d)
    np.testing.assert_array_equal(sma_ids,ids)
    # HOLD uses SMA solely as a finite membership mask in the original expert.
    # Use the actual original feature, rather than a substituted readiness gate.
    feature_ns=dict(np=np,pd=pd,p=p)
    exec(o.feature_code,feature_ns)
    feature=feature_ns['signal']
    experts=o.signed_intents(p,feature,t,SYMBOLS)
    hold=experts[ids,2,:]
    matched,match_proofs,states,diagnostic=o.match(t,p,d,hold,ready[ids])
    if any(row['status']!='READY' for row in match_proofs) or not np.asarray(diagnostic['current_eligible'],bool).all():
        raise ValueError('FULL_FIVE_ORIGINAL_CS_AND_MATCH_ADMISSION_REQUIRED')
    old_static=.5*matched['CS_MATCHED']+.5*matched['VOL_MATCHED']
    base=dict(CS_MATCHED=matched['CS_MATCHED'],VOL_MATCHED=matched['VOL_MATCHED'],STATIC50=old_static)
    retargeted,cov,risk_proofs=o.allocate(t,p,d,base)
    arrays,proofs=from_components(d,retargeted['STATIC50'],sma,cov)
    arrays.update(SMA200_DIRECTION=immutable(direction),SMA200_MEAN=immutable(mean),
        STATIC50_OLD_NO_REEXPANSION=immutable(old_static))
    source_ast_sha=verify_sources()['original_SMA_weights_AST_SHA256']
    for i,(at,k) in enumerate(zip(d,ids)):
        proofs[i].update(oldest_completed_close_us=int(t[k-199]),last_completed_close_us=int(t[k]),
            completed_close_count=200,CS_weekly_rank_us=int(diagnostic['rank_us'][i]),source_match=match_proofs[i],
            STATIC50_original_retarget=risk_proofs[i]['arms']['STATIC50'],
            SMA_original_weights_AST_SHA256=source_ast_sha,
            original_component_source_closure=True)
    return arrays,proofs
