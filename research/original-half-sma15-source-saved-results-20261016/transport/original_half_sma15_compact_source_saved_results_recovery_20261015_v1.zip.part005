        financial_code_manifest_SHA256=code_identity(),scope_manifest_SHA256=source_entry.manifest_sha(),
        tranche=source_entry.ALL15,ordered_cells=list(source_entry.tranche_cells(source_entry.ALL15)),years=list(source_entry.tranche_years(source_entry.ALL15)),
        native_financial_gate_reviewed=True,financial_execution_authorized=False,actual_source_or_target_bodies_read=False,
        old_CS_D_or_plain_V3_GO_reused_as_authority=False,generated_two_worker_fake_runtime_model_passed=True,worker_CPUs=[4,5],
        maximum_modeled_live_workers=2,actual_CPU45_resource_probe_run=False,annual_historical_resource_envelope_certified=False,generated_resource_probe_SHA256=c.digest(resource_probe_sha),
        shared_CPU45_lease_exclusion_reviewed=True,real_CLI_generated_GO_guard_integration_reviewed=True,
        separate_legacy_claim_namespace_reviewed=True,all_five_year_native_source_seams_reviewed=True,
        all15_source_review_is_not_native_authority=True)


def native_review(raw,expected_sha):
