def source_and_targets(year,contract,raw,storage):
    value=source.decode_capture(year,raw,contract)
    pc=contract['original_target_prefix'];blob=storage[str(source_c.ROOT/pc['wrapper']['path'])]
    selected,proof=prefix.select_prefix(blob,pc,year)
    prefix.validate_canonical_parity(selected,value)
    value.update(target_prefix=selected,target_prefix_metadata=proof)
    arrays,proofs=signal.build_target_grid(selected['close'],selected['clocks'],selected['clocks'],value['decisions'])
    return value,arrays,proofs

def artifact_set(year,raw,value,arrays,proofs):
    pre=str(year)+'/'
    result={pre+name:body for name,body in raw.items()}
    result.update({pre+'SOURCE_ROWS.json':c.canonical(value['source_rows'])+b'\n',
        pre+'TARGETS.npz':source.target_blob(arrays),pre+'TARGET_PROOFS.json':c.canonical(proofs)+b'\n',
        pre+'SOURCE_PREFIX_INPUTS.npz':source.target_blob(dict(close_available_us=value['target_prefix']['clocks'],close=value['target_prefix']['close']))})
    return result

@contextmanager
