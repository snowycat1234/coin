import copy, builtins
from decimal import Decimal, localcontext
from packet_common import *
from saved_native_reconciliation import reconcile_saved_native
import verify_packet

def run(root, archive, trusted):
 root = Path(root)
 tests = []
 def reject(name, function):
  try:
   function()
  except (ValueError, KeyError, TypeError) as error:
   tests.append(dict(test=name,rejected=True,error=str(error)))
   return
  raise ValueError('NEGATIVE_WAS_ACCEPTED:'+name)
 scope = load(root/'ATTEMPT_SCOPE_AND_STATUS.json')
 manifest = load(root/'MANIFEST.json')
 observed = copy.deepcopy(manifest['files'])
 for value in (15.0,True,'15'):
  changed = copy.deepcopy(scope)
  changed['case_count'] = value
  reject('scope_count_type_'+repr(value),lambda:verify_packet.verify_scope(changed))
 for key,value in (('publication_performed',0),('all15_saved_terminal',1),('new_execution_authority',0),('actual_root_shell_exit',False),('partial2021_paid_return_annualized',0),('partial2021_volatility_is_full_year_observed_sample',0),('GO_SHA256','0'*64)):
  changed = copy.deepcopy(scope)
  changed[key] = value
  reject('scope_gate_'+key,lambda:verify_packet.verify_scope(changed))
 changed = copy.deepcopy(scope)
 changed['ordered_cells'][0] = changed['ordered_cells'][1]
 reject('scope_duplicate_case',lambda:verify_packet.verify_scope(changed))
 for key,value in (('case_count',15.0),('external_trusted_outer_ZIP_SHA256_mandatory',1),('publication_performed',0),('new_execution_authority',0)):
  changed = copy.deepcopy(manifest)
  changed[key] = value
  reject('manifest_gate_'+key,lambda:verify_packet.verify_manifest(changed,observed))
 changed = copy.deepcopy(manifest)
 changed['files'].pop(next(iter(changed['files'])))
 reject('manifest_missing_member',lambda:verify_packet.verify_manifest(changed,observed))
 changed = copy.deepcopy(manifest)
 changed['files'][next(iter(changed['files']))]['SHA256'] = '0'*64
 reject('manifest_changed_member_pin',lambda:verify_packet.verify_manifest(changed,observed))
 for value in (True,1.0,'1'):
  reject('pin_size_type_'+repr(value),lambda:verify_pin_shape(dict(SHA256='0'*64,bytes=value)))
 for rel in ('../outside','/absolute','a/../b','a\\b'):
  reject('unsafe_member_'+rel,lambda:verify_packet.safe_rel(rel))
 for name,b in (('duplicate_JSON_key',b'{"x":1,"x":2}'),('NaN_JSON',b'{"x":NaN}'),('Infinity_JSON',b'{"x":Infinity}')):
  reject(name,lambda:decode(b))
 reject('wrong_external_outer_hash',lambda:verify_packet.verify_outer(root,archive,'0'*64))
 transform = copy.deepcopy(next(iter(load(root/'PROVENANCE_TRANSFORMATIONS.json')['files'].values())))
 transform['financial_decimal_or_event_fields_modified'] = 0
 reject('transform_boolean_is_not_zero',lambda:verify_packet.verify_transform(transform))
 # The launcher must deny historical/runtime imports even when the files exist inertly.
 for module in ('half_native','half_sma_source','run_half_sma','original_half_sma_signal_20261015_v1','legacy_core_adapter','numpy'):
  reject('historical_import_denied_'+module,lambda:builtins.__import__(module))
 case_map = load(root/'CASE_FILE_MAP.json')['cases']
 representatives = [next(cell for cell in scope['ordered_cells'] if cell.startswith(str(year)+'_') and '_LOW_' in cell) for year in (2021,2022,2024)]
 mutations = []
 for cell in representatives:
  fmap = case_map[cell]['files']
  audit = load(root/fmap['ACCOUNT_FINANCIAL_AUDIT.json'])
  result = load(root/fmap['NATIVE_RESULT.json'])
  for field in ('free_cash','unpaid_liability','isolated_balance'):
   for amount in ('1','1e-40'):
    target = audit['positions'][audit['symbols'][0]] if field == 'isolated_balance' else audit
    before = target[field]
    with localcontext() as context:
     context.prec = 100
     after = str(Decimal(before)+Decimal(amount))
    require(Decimal(before) != Decimal(after),'GENUINE_DECIMAL_MUTATION_REQUIRED')
    target[field] = after
    try:
     try:
      reconcile_saved_native(audit,result,expected_continuation_version=VERSION)
     except ValueError as error:
      mutations.append(dict(cell_id=cell,field=field,increment=amount,before=before,after=after,rejected=True,error=str(error)))
     else:
      raise ValueError('GENUINE_FINANCIAL_CORRUPTION_ACCEPTED:'+cell+':'+field)
    finally:
     target[field] = before
  old = audit['contract']['topup_enabled']
  audit['contract']['topup_enabled'] = 0
  try:
   reject('native_topup_boolean_'+cell,lambda:reconcile_saved_native(audit,result,expected_continuation_version=VERSION))
  finally:
   audit['contract']['topup_enabled'] = old
  old = audit['trades'][0]['event_us']
  audit['trades'][0]['event_us'] = True
  try:
   reject('native_event_clock_integer_'+cell,lambda:reconcile_saved_native(audit,result,expected_continuation_version=VERSION))
  finally:
   audit['trades'][0]['event_us'] = old
 exactint(len(mutations),18,'focused_financial_mutations')
 return dict(status='PASS',test_count=len(tests)+len(mutations),integrity_type_and_import_tests=tests,genuine_financial_mutations=mutations,genuine_financial_mutation_count=18,representative_partial2021_and_quality2022_2024=representatives,all_original_files_unmodified=True)
PK␀␀␀␀␀␀␀O]×±NºïT␀␀ïT␀␀V␀␀␀original_half_sma15_compact_source_saved_results_recovery_20261015_v1/verify_packet.py#!/usr/bin/env python3
"""Legacy-layout saved-only native40 verification and exact half-SMA15 bindings."""
import os
for key in ('OPENBLAS_NUM_THREADS','OMP_NUM_THREADS','MKL_NUM_THREADS','NUMEXPR_NUM_THREADS','POLARS_MAX_THREADS','VECLIB_MAXIMUM_THREADS','BLIS_NUM_THREADS'):
 os.environ[key] = '1'
if len(os.sched_getaffinity(0)) != 1: raise ValueError('SINGLE_INHERITED_CPU_AFFINITY_REQUIRED')
import ast, csv, io, re, zipfile
from pathlib import Path, PurePosixPath
from decimal import Decimal
from packet_common import *
from saved_native_reconciliation import reconcile_saved_native, checker_sha256

def safe_rel(rel):
 require(type(rel) is str, 'RELATIVE_MEMBER_STRING_REQUIRED')
 path = PurePosixPath(rel)
 require(not path.is_absolute() and '..' not in path.parts and '\\' not in rel and str(path) == rel, 'UNSAFE_RELATIVE_MEMBER')

def verify_scope(scope):
 for key, count in (('case_count',15),('actual_root_shell_exit',0),('root_shell_session_id',21331),('partial2021_volatility_sample_days',274),('network_actions',0)):
  exactint(scope[key],count,key)
 for key in ('all15_saved_terminal','all15_actual_paid_market_flat','shell_exit_not_inferred','fresh_10000_wallet_each','all_seen_development','nominal_risk_is_not_equal_realized_risk'):
  require(scope[key] is True,'EXPLICIT_TRUE_REQUIRED:'+key)
 for key in ('partial2021_paid_return_annualized','partial2021_volatility_is_full_year_observed_sample','annual_wallets_compounded','publication_performed','financial_or_source_replay','new_execution_authority','legacy30_CORE45_or_pureCS15_mixed','native_arrival_funding_units_or_venue_liquidation_certified'):
  require(scope[key] is False,'EXPLICIT_FALSE_REQUIRED:'+key)
 require(scope['calendar_days_by_year'] == {str(year):days for year,days in DAYS.items()},'EXACT274_365_366_CALENDAR')
 for key, digest in (('GO_SHA256',GO),('FIN_SHA256',FIN),('SOURCE_SHA256',SOURCE),('PURE_SHA256',PURE),('PREP_SHA256',PREP)):
  require(scope[key] == digest,'EXACT_TRUSTED_SCOPE_PIN:'+key)
 require(scope['partial2021_volatility_scaling'] == 'sample_std_of_complete_daily_simple_NAV_returns_ddof1_times_sqrt365','EXPLICIT_PARTIAL_SAMPLE_VOLATILITY_SCALING')
 expected = {f'{year}_STATIC50_HALF_SMA200_{tier}_D_INTRINSIC_LOWER_ONLY_V1' for year in DAYS for tier in TIERS}
 require(type(scope['ordered_cells']) is list and len(scope['ordered_cells']) == 15 and len(set(scope['ordered_cells'])) == 15 and set(scope['ordered_cells']) == expected,'EXACT_HALF_ONLY15_SCOPE')

def verify_manifest(manifest, observed):
 exactint(manifest['case_count'],15,'manifest_case_count')
 require(manifest['external_trusted_outer_ZIP_SHA256_mandatory'] is True and manifest['publication_performed'] is False and manifest['new_execution_authority'] is False,'MANIFEST_EXPLICIT_TRUST_LOCAL_ONLY_AUTHORITY_GATES')
 for rel, ref in manifest['files'].items():
  safe_rel(rel)
  verify_pin_shape(ref)
 require(same(manifest['files'],observed),'MANIFEST_FILESET_OR_BYTES_MISMATCH')

def verify_transform(transform):
 for key in ('original_pin','stored_pin','uncompressed_pin'):
  verify_pin_shape(transform[key])
 require(transform['financial_decimal_or_event_fields_modified'] is False,'FINANCIAL_VALUES_MUST_NEVER_BE_EDITED')
 require(transform['transformation'] in ('EXACT_ORIGINAL_BYTES','LOSSLESS_GZIP_EXACT_ORIGINAL_BYTES','PRIVATE_PREFIX_REDACTED_TEXT_DERIVATIVE','EXPLICIT_JSON_SELECTED_FIELD_DERIVATIVE'),'EXPLICIT_TRANSFORMATION_CLASS_REQUIRED')

def original_pin(spec):
 return {key:spec[key] for key in ('SHA256','bytes')}

def metric_row(review, result, risk):
 # Exact projection used by the original saved metrics supplement. No new metrics.
 summary, economics = result['summary'], result['economics']
 ds = summary['decimal_strings']
 return dict(cell_id=review['cell_id'],year=review['year'],tier=review['tier'],calendar_days=review['required_minutes']//1440,
  terminal_status=review['terminal_status'],paid_net_return=economics['paid_net_return'],NAV_USDT=ds['NAV'],
  net_PnL_USDT=ds['net_PnL'],fees_USDT=ds['fees_USDT'],execution_cost_USDT=ds['execution_cost_USDT'],funding_USDT=ds['funding_USDT'],
  paid_market_turnover_USDT=economics['actual_paid_market_turnover_USDT'],trade_legs=summary['trade_legs'],all_observation_MDD=summary['all_observation_max_drawdown'],
  realized_daily_annual_volatility=risk['realized_daily_simple_return_annual_volatility'],nominal_annual_volatility_budget=risk['nominal_annual_volatility_budget'],
  forecast_annual_volatility_mean=risk['forecast_annual_volatility_mean'],forecast_annual_volatility_max=risk['forecast_annual_volatility_max'],forecast_volatility_breach_minutes=risk['forecast_volatility_breach_minutes'],
  gross_exposure_mean=risk['gross_exposure_mean'],gross_exposure_max=risk['gross_exposure_max'],maximum_actual_asset_weight=risk['asset_exposure_absolute_max'],
  minimum_minute_close_free_cash_USDT=risk['minimum_observed_free_cash_USDT'],maximum_minute_close_isolated_margin_USDT=risk['maximum_observed_isolated_margin_USDT'],
  minute_close_free_cash_below1000=risk['minutes_observed_free_cash_below1000'],minute_close_margin_above8500=risk['minutes_observed_margin_above8500'],
  native40_secondary_PnL_bridge_residual=review['native40_secondary_PnL_bridge_residual'],raw_precision100_residuals=review['raw_precision100_residuals'])

def verify_content(root, *, recompute=True):
 root = Path(root)
 manifest = load(root/'MANIFEST.json')
 verify_manifest(manifest,files(root))
 scope = load(root/'ATTEMPT_SCOPE_AND_STATUS.json')
 verify_scope(scope)
 require(manifest['ordered_cells'] == scope['ordered_cells'],'MANIFEST_SCOPE_ORDER')
 require(checker_sha256() == CHECKER,'EXACT_PINNED_PURE_NATIVE40_CHECKER')
 for path in root.glob('*.py'):
  require(not any(isinstance(node,ast.Assert) for node in ast.walk(ast.parse(path.read_text()))),'NO_ASSERT_BASED_TRUST_GATES')
 exact = {'results/ALL15_SAVED_METRICS.json':METRICS,'results/ALL15_SAVED_METRICS.csv':CSV,'results/FINAL_REVIEW_AND_METRICS.md':REPORT,'results/PARTIAL2021_VOLATILITY_CLARIFICATION.json':CLARIFICATION,'receipts/FINAL_COMPLETE_BINDING_v2.json':FINAL2,'status/ROOT_OBSERVED_EXIT_CONFIRMED.json':EXIT,'provenance/PREPARATION_METADATA_EXACT.json':PREP}
 for rel,digest in exact.items():
  require(pin(root/rel)['SHA256'] == digest,'EXTERNALLY_PINNED_ORIGINAL:'+rel)
 originals = load(root/'ORIGINAL_EVIDENCE_HASH_PINS.json')['files']
 transforms = load(root/'PROVENANCE_TRANSFORMATIONS.json')['files']
 for rel,ref in originals.items():
  safe_rel(rel)
  verify_pin_shape(ref)
 for rel,transform in transforms.items():
  safe_rel(rel)
  verify_transform(transform)
  require(same(originals[transform['original_relative_path']],transform['original_pin']),'TRANSFORM_ORIGINAL_INVENTORY_BINDING')
  require(pin(root/rel) == transform['stored_pin'] and bytepin(raw(root/rel)) == transform['uncompressed_pin'],'TRANSFORM_STORED_UNCOMPRESSED_BINDING')
  if transform['transformation'] in ('EXACT_ORIGINAL_BYTES','LOSSLESS_GZIP_EXACT_ORIGINAL_BYTES'):
   require(transform['original_pin'] == transform['uncompressed_pin'],'EXACT_ORIGINAL_BYTES_REQUIRED')
 deps = load(root/'DEPENDENCY_CLASSIFICATION.json')
 require(deps['publication_performed'] is False and deps['new_execution_authority'] is False and deps['private_authority_bodies_included'] is False,'EXPLICIT_LOCAL_ONLY_AND_NO_AUTHORITY')
 for rel,spec in deps['dependencies'].items():
  require(spec['original_pin'] == originals[rel] and spec['body_in_packet'] is False and spec['hash_recovers_bytes'] is False and spec['exact_original_preserved_locally'] is True,'HONEST_OMITTED_DEPENDENCY')
 included = {value['original_relative_path'] for value in transforms.values()}
 require(set(originals) == included | set(deps['dependencies']) and not included & set(deps['dependencies']),'EXACT_INCLUDED_OR_OMITTED_INVENTORY_PARTITION')
 for name in ('MINUTE.npz','TARGETS.npz','SOURCE_INPUTS.npz','SOURCE_PREFIX_INPUTS.npz','RAW_EVENTS.json','SOURCE_ROWS.json'):
  require(any(Path(rel).name == name for rel in deps['dependencies']),'EXPLICIT_ARRAY_OR_RAW_SOURCE_OMISSION:'+name)
 limits = load(root/'OMITTED_ARRAYS_AND_RECOVERY_LIMITS.json')
 require(limits['saved_all15_native40_event_verification_self_contained'] is True and limits['all15_saved_financial_event_payloads_self_contained'] is True,'SELF_CONTAINED_SAVED_EVENT_PROOF')
 for key in ('full_minute_risk_reconstruction_self_contained','source_recapture_or_source_quality_regeneration_self_contained','historical_financial_restart_self_contained','hashes_recover_omitted_bytes'):
  require(limits[key] is False,'HONEST_OMISSION_LIMIT:'+key)
 source_map = load(root/'SOURCE_RECOVERY_FILE_MAP.json')
 require(source_map['cold_verifier_imports_bundled_source'] is False and source_map['exact_code_historical_path_literals_preserved'] is True and source_map['external_runtime_dependencies_restored'] is False,'INERT_EXACT_SOURCE_LIMITS')
 source_files = 0
 for directory,snapshot in source_map['inert_code_snapshots'].items():
  source_manifest = load(root/snapshot['manifest'])
  require(pin(root/snapshot['manifest'])['SHA256'] == snapshot['manifest_SHA256'],'EXACT_SOURCE_MANIFEST_PIN')
  require(set(snapshot['files']) == set(source_manifest['files']) | {Path(snapshot['manifest']).name},'COMPLETE_OWN_CODE_MANIFEST_CLOSURE')
  for name,rel in snapshot['files'].items():
   require(rel == 'source/'+directory+'/'+name,'INERT_SOURCE_PATH_BINDING')
   if name in source_manifest['files']:
    require(pin(root/rel) == source_manifest['files'][name],'EXACT_OWN_SOURCE_MANIFEST_MEMBER')
   source_files += 1
 final = load(root/'receipts/FINAL_BINDING.json')
 require(final['status'] == 'PASS_ALL15_SAVED_ONLY' and final['ordered_cells'] == scope['ordered_cells'],'EXACT_FINAL15_SAVED_REVIEW_SELECTION')
 exactint(final['completed_cell_count'],15,'review_completed_count')
 exactint(final['review_error_count'],0,'review_error_count')
 case_map = load(root/'CASE_FILE_MAP.json')['cases']
 require(set(case_map) == set(scope['ordered_cells']),'EXACT15_CASE_FILE_MAP')
 metrics = load(root/'results/ALL15_SAVED_METRICS.json')
 require(len(metrics['rows']) == 15 and [row['cell_id'] for row in metrics['rows']] == scope['ordered_cells'],'EXACT_METRICS_ORDER')
 metric_rows = {row['cell_id']:row for row in metrics['rows']}
 controller = load(root/'status/CONTROLLER_SELECTED_METADATA.json')
 require(controller['status'] == 'ALL_ADMITTED_ORDERED_CELLS_TERMINAL' and controller['saved_validation_errors'] == [] and controller['pending_not_launched'] == [],'CONTROLLER_TERMINAL_NO_ERRORS')
 require(len(controller['cases']) == 15 and len({row['cell_id'] for row in controller['cases']}) == 15 and {row['cell_id'] for row in controller['cases']} == set(scope['ordered_cells']),'EXACT_CONTROLLER_SAVED_COMPLETION_ORDER_COVERAGE')
 controller_cases = {row['cell_id']:row for row in controller['cases']}
 controller_binding = load(root/'receipts/CONTROLLER_RECEIPT_BINDING.json')
 require(transforms['status/CONTROLLER_SELECTED_METADATA.json']['original_pin'] == original_pin(controller_binding['controller_receipt']),'EXACT_CONTROLLER_ORIGINAL_PROJECTION_PIN')
 observations = []
 for cell in scope['ordered_cells']:
  cm = case_map[cell]
  fm = cm['files']
  saved = {name:load(root/rel) for name,rel in fm.items()}
  review,audit,result = saved['INDEPENDENT_REVIEW.json'],saved['ACCOUNT_FINANCIAL_AUDIT.json'],saved['NATIVE_RESULT.json']
  require(review['cell_id'] == cell and review['status'] == 'PASS_SAVED_ONLY','SAVED_CASE_REVIEW_IDENTITY')
  require(transforms[fm['INDEPENDENT_REVIEW.json']]['original_pin'] == original_pin(final['per_cell_reviews'][cell]),'EXACT_FINAL_CASE_REVIEW_PIN')
  checkpoint = saved['TERMINAL_CHECKPOINT.json']
  require(transforms[fm['TERMINAL_CHECKPOINT.json']]['original_pin'] == original_pin(review['terminal_checkpoint']),'EXACT_REVIEWED_TERMINAL_PIN')
  require(checkpoint['cell_id'] == cell and checkpoint['all_evidence_fsynced'] is True and checkpoint['fresh_scope_revoked'] is True and checkpoint['restart_financial_snapshot_permission'] is False and checkpoint['checker_SHA256'] == CHECKER,'REVOKED_IMMUTABLE_TERMINAL')
  for name,digest in checkpoint['files'].items():
   rel = cm['original_output_relative_directory']+'/'+name
   require(originals[rel]['SHA256'] == digest,'EXACT_CHECKPOINT_ORIGINAL_IDENTITY')
   if name in fm:
    require(transforms[fm[name]]['original_pin'] == originals[rel],'EXACT_INCLUDED_CHECKPOINT_MEMBER')
   else:
    require(rel in deps['dependencies'],'EXPLICIT_OMITTED_CHECKPOINT_MEMBER')
  year = review['year']
  days = DAYS[year]
  exactint(review['completed_minutes'],days*1440,'completed_minutes')
  exactint(review['required_minutes'],days*1440,'required_minutes')
  require(review['terminal_status'] == 'FULL_CALENDAR_ACTUAL_PAID_MARKET_FLAT' and review['full_calendar'] is True and review['paid_flat'] is True and review['conditional_settled_flat'] is False,'FULL_ADMITTED_CALENDAR_ACTUAL_PAID_FLAT')
  require(audit['config']['initial_cash'] == '10000' and audit['config']['fee_rate'] == '0.00055','FRESH_BASE27_WALLET')
  bind = audit['contract']['scope_binding']
  require(same(bind,result['summary']['contract']['scope_binding']),'AUDIT_RESULT_SCOPE_IDENTITY')
  for key,value in (('cell_id',cell),('root_GO_SHA256',GO),('financial_code_manifest_SHA256',FIN),('source_code_manifest_SHA256',SOURCE),('preparation_SHA256',PREP),('tier_name',review['tier'])):
   require(bind[key] == value,'EXACT_FINANCIAL_SOURCE_SCOPE:'+key)
  exactint(bind['year'],year,'bound_year')
  require(bind['fresh_genesis_only'] is True and bind['generated_fixture_scope_used'] is False,'FRESH_ORIGINAL_ONLY')
  proof = reconcile_saved_native(audit,result,expected_continuation_version=VERSION) if recompute else saved['NATIVE40_RECONSTRUCTION_PROOF.json']
  for value in (saved['NATIVE40_RECONSTRUCTION_PROOF.json'],saved['PRIMARY_FINANCIAL_RECONCILIATION.json']):
   require(same(proof,value),'EXACT_EVERY_NATIVE40_EVENT_STATE_PROOF:'+cell)
  exactint(proof['native_financial_precision'],40,'native40_precision')
  exactint(proof['raw_diagnostic_precision'],100,'raw100_precision')
  require(proof['passed'] is True and proof['tolerance_or_epsilon_used'] is False and proof['financial_values_changed'] is False,'EXACT_NO_EPSILON_OR_REPAIR')
  require(review['native40_secondary_PnL_bridge_residual'] == proof['native40_secondary_PnL_bridge_residual'] and same(review['raw_precision100_residuals'],proof['raw_precision100_stored_delta_terminal_residuals']),'UNCHANGED_EXACT_NATIVE40_RAW100_RESIDUAL_EXPLANATION')
  for value in (result['primary_financial_reconciliation'],result['legacy_primary_financial_reconciliation']):
   require(same(saved['LEGACY_PRIMARY_FINANCIAL_RECONCILIATION.json'],value),'UNCHANGED_SEPARATE_RAW100_DIAGNOSTIC')
  require(audit['unpaid_liability'] == '0' and audit['settlement_journal'] == [] and audit['transfer_journal'] == [] and audit['transfer_ids'] == {} and all(Decimal(position['quantity']) == 0 and Decimal(position['isolated_balance']) == 0 for position in audit['positions'].values()),'ACTUAL_PAID_FLAT_NO_DEBT_CAPITAL_TRANSFER_SETTLEMENT')
  require(result['economics']['actual_paid_market_flat'] is True and result['economics']['conditional_settled_flat'] is False and result['economics']['annual_wallets_compounded'] is False,'ACTUAL_TERMINAL_AND_FRESH_ANNUAL_WALLET')
  for key in ('internal_transfers','topups','new_capital','debt_forgiveness','conditional_settlements'):
   exactint(review[key],0,key)
  require(review['exact_NAV'] == proof['exact_native40_NAV'],'EXACT_REVIEW_NAV')
  require(same(metric_row(review,result,saved['ACTUAL_HELD_RISK_REPORT.json']),metric_rows[cell]),'EXACT_ORIGINAL_METRIC_PROJECTION:'+cell)
  for name,spec in metrics['metric_input_pins'][cell].items():
   require(original_pin(spec) == transforms[fm[name]]['original_pin'],'EXACT_METRICS_INPUT_PIN')
  quality = saved['CAUSAL_MARK_QUALITY.json']
  exactint(review['quality']['quality_block_rows'],len(quality['receipts']),'QUALITY_BLOCK_ROWS')
  for interval in review['quality']['actual_saved_interval_impacts']:
   start,end,symbols = interval['start_us'],interval['end_us'],interval['symbols']
   def hit(row):
    return start <= row['event_us'] < end and (row.get('symbol') in symbols or row.get('symbol') is None)
   trades = [row for row in audit['trades'] if hit(row)]
   require(all(row.get('reduce_only') is True for row in trades),'NO_NEW_RISK_TRADE_DURING_DECLARED_STALE_SOURCE')
   for key,count in (('paid_trades',len(trades)),('owned_funding_rows',sum(hit(row) and row['owned'] for row in audit['funding'])),('funding_rows',sum(hit(row) for row in result['funding'])),('ledger_rows',sum(hit(row) for row in audit['financial_ledger'])),('guard50_monitor_rows',sum(hit(row) for row in audit['monitor_journal'])),('quality_blocks',sum(hit(row) for row in quality['receipts']))):
    exactint(interval[key],count,'saved_quality_interval_'+key)
  guard = saved['SOURCE_RECAPTURE_GUARD_RECEIPT.json']
  require(guard['guard_active'] is False and guard['source_scopes_revoked'] is True and guard['native_source_scopes_revoked'] is True and guard['attempted_targets'] == [],'REVOKED_SOURCE_GUARD')
  for value in guard['forbidden_attempts'].values():
   exactint(value,0,'source_guard_forbidden_attempt')
  receipt = saved['CASE_RECEIPT.json']
  require(receipt['cell_id'] == cell and receipt['status'] == review['terminal_status'],'SAVED_CASE_RECEIPT_IDENTITY')
  exactint(receipt['completed_minutes'],days*1440,'receipt_completed_minutes')
  ctrl = controller_cases[cell]
  require(ctrl['checkpoint_SHA256'] == review['terminal_checkpoint']['SHA256'] and ctrl['CPU'] == review['actual_worker_CPU'] and ctrl['PID'] == review['actual_worker_PID'] and ctrl['status'] == review['terminal_status'] and ctrl['reused_saved_terminal'] is False,'EXACT_CONTROLLER_CHECKPOINT_PID_CPU_STATUS')
  observations.append(dict(cell_id=cell,calendar_days=days,exact_native40_NAV=proof['exact_native40_NAV'],ledger_rows=proof['financial_ledger_rows_checked'],native40_secondary_PnL_bridge_residual=proof['native40_secondary_PnL_bridge_residual'],raw_precision100_residuals=proof['raw_precision100_stored_delta_terminal_residuals']))
 # Exact existing CSV cells are bound to the JSON, preserving original column order.
 reader = csv.DictReader(io.StringIO(raw(root/'results/ALL15_SAVED_METRICS.csv').decode(),newline=''))
 csv_rows = list(reader)
 require(len(csv_rows) == 15,'EXACT_CSV_ROW_COUNT')
 for saved,row in zip(csv_rows,metrics['rows']):
  require(all(saved[key] == str(row[key]) for key in saved),'EXACT_CSV_JSON_CELL_BINDING')
 exit_receipt = load(root/'status/ROOT_OBSERVED_EXIT_CONFIRMED.json')
 require(exit_receipt == dict(session_id=21331,observed_exit_code=0,observed_utc='2026-10-15T21:06:50+00:00'),'EXACT_ROOT_OBSERVED_EXIT0')
 complete = load(root/'receipts/FINAL_COMPLETE_BINDING.json')
 require(complete['status'] == 'PASS' and complete['root_observed_exit_receipt']['SHA256'] == EXIT,'COMPLETE_CHAIN_EXIT0_BINDING')
 for key,rel in (('all15_metrics','results/ALL15_SAVED_METRICS.json'),('all15_metrics_csv','results/ALL15_SAVED_METRICS.csv'),('final_report','results/FINAL_REVIEW_AND_METRICS.md')):
  require(original_pin(complete[key]) == pin(root/rel),'COMPLETE_CHAIN_EXACT_RESULT_PIN')
 latest = load(root/'receipts/FINAL_COMPLETE_BINDING_v3.json')
 require(latest['previous_complete_binding']['SHA256'] == FINAL2 and latest['partial2021_volatility_clarification']['SHA256'] == CLARIFICATION and latest['numeric_values_changed'] is False,'LATEST_NONNUMERIC_SAMPLE_CLARIFICATION_CHAIN')
 scanned = 0
 authority_names = {'ADMISSION_GO.json','LAUNCH_CLAIM.json','SOURCE_STAGE_AUTHORIZATION.json','WORKER_AUTHORITY_VERIFIED.json','WORKER_SOURCE_ACCEPTED_BEFORE_ACCOUNT.json','PROCESS_OWNERSHIP.json','BOOTSTRAP_READY.json'}
 for path in root.rglob('*'):
  require(not path.is_symlink(),'NO_SYMLINKS')
  if not path.is_file():
   continue
  require(path.suffix not in ('.npz','.npy','.log') and path.name not in authority_names,'OMITTED_ARRAY_AUTHORITY_OR_LOG_BODY_FOUND')
  b = raw(path)
  scanned += 1
  for token in (b'-----BEGIN '+b'PRIVATE KEY',b'github_'+b'pat_',b'gh'+b'p_'):
   require(token not in b,'CREDENTIAL_MARKER_REJECTED')
  if not path.is_relative_to(root/'source'):
   for token in (b'/'+b'workspace/',b'/'+b'home/',b'/'+b'Users/'):
    require(token not in b,'LIVE_PRIVATE_PREFIX_OUTSIDE_INERT_SOURCE:'+str(path.relative_to(root)))
 return dict(schema='ORIGINAL_HALF_SMA15_SAVED_ONLY_COLD_VERIFICATION_V1',status='PASS_EXACT15_NATIVE40_SOURCE_AND_SAVED_BINDINGS',native40_recomputed=15 if recompute else 0,comparison_rows=15,inert_source_members=source_files,cases=observations,privacy_scanned_members=scanned,root_observed_shell_exit=0,full_minute_risk_source_or_historical_restart_self_contained=False,bundled_historical_source_imports=False,financial_or_source_runtime_used=False,publication_performed=False,CPU_affinity=sorted(os.sched_getaffinity(0)),numerical_pools=1)

def verify_outer(root, archive, trusted_zip_sha256):
 require(type(trusted_zip_sha256) is str and re.fullmatch('[0-9a-f]{64}',trusted_zip_sha256) is not None,'EXTERNALLY_TRUSTED_OUTER_HASH_REQUIRED')
 archive,root = Path(archive),Path(root)
 require(pin(archive)['SHA256'] == trusted_zip_sha256,'EXTERNAL_TRUSTED_ZIP_HASH_MISMATCH')
 with zipfile.ZipFile(archive) as handle:
  names = handle.namelist()
  require(len(names) == len(set(names)),'DUPLICATE_ZIP_MEMBERS')
  expected = {root.name+'/'+str(path.relative_to(root)):path for path in root.rglob('*') if path.is_file()}
  require(set(names) == set(expected),'TRUSTED_ARCHIVE_EXTRACTED_FILESET')
  for name,path in expected.items():
   safe_rel(name)
   require(bytepin(handle.read(name)) == pin(path),'TRUSTED_ARCHIVE_EXTRACTED_BYTES:'+name)
 return verify_content(root)
