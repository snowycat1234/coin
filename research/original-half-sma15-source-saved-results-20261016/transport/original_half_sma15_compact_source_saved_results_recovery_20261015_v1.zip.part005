def blob(values, columns):
    target=BytesIO();np.savez_compressed(target,values=values,columns=np.asarray(columns));return target.getvalue()


def reject(raw, rows, year=2024):
    with np.testing.assert_raises((ValueError,zipfile.BadZipFile,EOFError)):
        saved.saved_minute(raw,rows,cell_id=f'{year}_STATIC50_HALF_SMA200_LOW_D_INTRINSIC_LOWER_ONLY_V1')


def rewrite(raw, change):
    with zipfile.ZipFile(BytesIO(raw)) as z: parts={i.filename:z.read(i) for i in z.infolist()}
    parts=change(parts)
    target=BytesIO()
    with zipfile.ZipFile(target,'w',compression=zipfile.ZIP_DEFLATED) as z:
        for name,data in parts.items():z.writestr(name,data)
    return target.getvalue()


class FullWriterTests(unittest.TestCase):
    def test_full_actual_default_writer_274_365_366(self):
        # Execute the exact two writer statements parsed from frozen run_cs.case.
        source=ast.parse((HERE/'run_half_sma.py').read_text())
        case=next(x for x in source.body if isinstance(x,ast.FunctionDef) and x.name=='case')
        assign=next(x for x in ast.walk(case) if isinstance(x,ast.Assign) and ast.unparse(x).startswith('values, columns = (minute.to_numpy()'))
        write=next(x for x in ast.walk(case) if isinstance(x,ast.Expr) and ast.unparse(x).startswith('np.savez_compressed('))
        program=compile(ast.fix_missing_locations(ast.Module(body=[assign,write],type_ignores=[])),'<EXACT_FROZEN_CS_WRITER_AST>','exec')
        self.assertEqual(ast.unparse(assign),'values, columns = (minute.to_numpy(), minute.columns)')
        names=['close_us','nav','free_cash','isolated_balance','gross_weight']+[f'generated_col_{n}' for n in range(32)]
        for year,days in ((2021,274),(2022,365),(2023,365),(2024,366),(2025,365)):
            cell=f'{year}_STATIC50_HALF_SMA200_LOW_D_INTRINSIC_LOWER_ONLY_V1';rows=days*1440
            index=np.arange(rows,dtype=np.int64)
            data={name:(index%97).astype(np.float64)/7 for name in names}
            data['close_us']=config.cell_named(cell)['start_us']+(index+1)*60_000_000
            for i,name in enumerate(names[1:]): data[name][i::37]=-0.0
            minute=pl.DataFrame(data);del data,index
            with tempfile.TemporaryDirectory(prefix='GENERATED_FULL_CALENDAR_WRITER_') as td:
                env={'minute':minute,'np':np,'directory':Path(td)};exec(program,env)
                values=env['values'];self.assertTrue(values.flags.f_contiguous)
                raw=(Path(td)/'MINUTE.npz').read_bytes()
                decoded,columns=saved.saved_minute(raw,rows,cell_id=cell)
                self.assertEqual(columns,names);self.assertTrue(np.array_equal(decoded.view(np.uint64),values.view(np.uint64)))
                self.assertTrue(np.signbit(decoded[:,1:]).any())
                if year==2024:
                    with self.assertRaisesRegex(ValueError,'BOUNDED_SAVED_NATIVE_MINUTES_REQUIRED'):frozen.saved_minute(raw,rows)
                for layout in (np.ascontiguousarray(values),np.asfortranarray(values)):
                    small=blob(layout[:, :3],names[:3]);d,n=saved.saved_minute(small,rows,cell_id=cell)
                    self.assertTrue(np.array_equal(d.view(np.uint64),values[:,:3].view(np.uint64)));self.assertEqual(n,names[:3])
                reject(raw,rows-1,year)
                reject(raw,rows+1,year)
                if year==2024:
                    reject(raw,rows,2021);reject(raw,rows,2025)
                if year==2025:reject(raw,rows,2021)
            del minute,env,values,raw,decoded

    def test_bound_and_row_types(self):
        raw=blob(np.zeros((2,1)),['x'])
        for rows in (True,False,2.0,np.int64(2),-1,527041):reject(raw,rows)
        for cell in ('2026_STATIC50_HALF_SMA200_LOW_D_INTRINSIC_LOWER_ONLY_V1','2024_BAD_LEGACY_CELL',None):
