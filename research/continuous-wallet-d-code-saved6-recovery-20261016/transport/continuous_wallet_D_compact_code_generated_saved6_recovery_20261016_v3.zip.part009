PK␀␀␀␀␀␀␀P]ª‘Æ+%/␀␀%/␀␀å␀␀␀continuous_wallet_D_compact_code_generated_saved6_recovery_20261016_v3/source/continuous_wallet_D_generated_20261015_v1/continuous_native.py"""Single generated account/provider lifecycle over the exact immutable D rules.

This is an additive generated seam. There is no historical admission, source
loader, claim registry or financial GO parser here. No annual constructors fire.
"""
from __future__ import annotations
from dataclasses import asdict
from hashlib import sha256
from pathlib import Path
import sys
from types import MethodType
import numpy as np
import continuous_source as source

HERE=Path(__file__).resolve().parent
ANNUAL=source.ROOT/'legacy_intrinsic_D_remaining14_financial_20261015_v1'
source.checked_reference('legacy_intrinsic_D_remaining14_financial_20261015_v1/legacy_native.py')
source.checked_reference('legacy_intrinsic_D_remaining14_financial_20261015_v1/FINANCIAL_CODE_MANIFEST.json')
REFERENCE_CODE_GRAPH=source.verify_reference_code_graph()
if str(ANNUAL) not in sys.path:sys.path.insert(0,str(ANNUAL))
import legacy_native as base
if Path(base.__file__).resolve()!=ANNUAL/'legacy_native.py':raise ValueError('EXACT_IMMUTABLE_D_REFERENCE_REQUIRED')
V2=base.V2
DEC=V2.D
MINUTE=base.MINUTE
S=base.S
VERSION=source.VERSION

class ContinuousAccount(base.ExpansionAccount):
    VERSION=VERSION
    def __init__(self,*args,**kwargs):
        if kwargs.get('historical_scope') is not None:source.historical_finance()
        super().__init__(*args,**kwargs)
        self._continuous_constructions=1
    def contract_metadata(self):
        result=super().contract_metadata()
        result.update(integration_version=VERSION,continuation_policy=VERSION,
            annual_wallet_fresh_genesis=False,annual_wallets_compounded=False,
            one_initial_10000_wallet=True,continuous_wallet=True,
            full_year_DEV=False,partial2021_not_annualized=False,
            generated_only=True,historical_execution_admitted=False,
            global_terminal_only=True,snapshot_recovery_certified=False)
        return result
    def snapshot(self):
        result=super().snapshot()
        result.update(continuation_policy=VERSION,continuous_wallet=True,annual_wallet_fresh_genesis=False,
            generated_only=True,historical_execution_admitted=False)
        return result

# The financial method objects remain inherited unchanged. Only the exact-type
# preview binding and guard class binding are transported to this account type.
class TokenView(base.TokenView):pass
TokenView.__init__=V2._rebind(base.TokenView.__init__,ContinuationAccount=ContinuousAccount)
class CapitalView(TokenView):
    def snapshot(self):return V2.ExactToken(self._owned)
    def execute_fill(self,*args,**kwargs):return ContinuousAccount.execute_fill(self._owned,*args,**kwargs)
capital_guard_fill=V2._rebind(base.capital_guard_fill,CapitalView=CapitalView)
fresh_preview=V2._rebind(base.fresh_preview,TokenView=TokenView)
signal_preview=V2._rebind(base.signal_preview,TokenView=TokenView)
class ContinuousGuard(base.ContinuationGuard):pass
ContinuousGuard.schedule=V2._rebind(base.ContinuationGuard.schedule,signal_preview=signal_preview)
ContinuousGuard._frozen_attempt=V2._rebind(base.ContinuationGuard._frozen_attempt,
    signal_preview=signal_preview,fresh_preview=fresh_preview,capital_guard_fill=capital_guard_fill)
ContinuousGuard.attempt=base.ContinuationGuard.attempt

class CompositeQualityGuard(base.ContinuationQualityGuard):
    def quality_witness(self,event_us):
        # Both predicates must run: recovered typed cells cannot mask a later
        # interval, and interval recovery cannot certify an unknown typed mark.
        typed=base.ContinuationQualityGuard.quality_witness(self,event_us)
        interval=V2.quality_module.CausalMarkQualityGuard.quality_witness(self,event_us)
        if typed is None and interval is None:return None
        result=dict(allowed=False,reason=V2.quality_module.REJECTION,event_us=event_us,
            policy_sha256=self.policy_sha256,source_sidecar_sha256=self.source_sidecar_sha256,
            quality_composition='REJECT_WHEN_EITHER_TYPED_CELL_OR_INTERVAL_UNRECOVERED',
            valuation_status='UNKNOWN_OR_DERIVED_UNTIL_EACH_GENUINE_INSTALLED_RECOVERY',
            native_venue_or_current_mark_certified=False)
        if typed is not None:result['affected_source_cells']=typed.get('affected_source_cells',[])
        if interval is not None:result['affected_intervals']=interval['affected_intervals']
        return result
CompositeQualityGuard.install=V2._rebind(base.ContinuationQualityGuard.install,ContinuationGuard=ContinuousGuard)

class GeneratedMinuteProvider:
    """One pass; partition hints affect exports only, never wallet ownership."""
    def __init__(self,fixture,*,block_minutes=1440,quality_cells=(),intervals=()):
        source.require_generated(fixture)
        if type(block_minutes) is not int or not 1<=block_minutes<=1440:raise ValueError('BOUNDED_GENERATED_BLOCK_REQUIRED')
        self.fixture=fixture;self.block_minutes=block_minutes
        self.quality_cells=quality_cells;self.intervals=intervals;self.iterations=0
    def price_at(self,at):
        f=self.fixture;k=min(int((at-f.start)//source.DAY),len(f.decisions)-1)
        day=f.start+k*source.DAY;i=int(np.searchsorted(f.clocks,day));a=f.close[i]
        b=f.close[i+1] if i+1<len(f.close) else a*np.array([1.001,1.0006,1.0001,.9997,.9993])
        return a+(b-a)*((at-day)/source.DAY)
    def __call__(self):
        source.require_generated(self.fixture)
        if self.iterations:raise ValueError('ONE_CONTINUOUS_PROVIDER_LIFECYCLE_NO_RESTART')
        self.iterations+=1;f=self.fixture
        typed={(c.symbol,c.completed_us):c for c in self.quality_cells}
        for a in range(f.start,f.end,self.block_minutes*MINUTE):
            source.require_generated(f,full=False);b=min(a+self.block_minutes*MINUTE,f.end)
            times=np.arange(a,b,MINUTE,dtype='<i8');opens=np.vstack([self.price_at(int(t)) for t in times])
            closes=np.vstack([self.price_at(int(t)+MINUTE) for t in times]);marks=closes.copy()
            for j,s in enumerate(S):
                for k,t in enumerate(times):
                    at=int(t)+MINUTE
                    if (s,at) in typed:marks[k,j]=float(typed[(s,at)].price_text)
                    for interval in self.intervals:
                        if s in interval.symbols and interval.start_us<=at<interval.end_us:
                            marks[k,j]=self.price_at(interval.original_genuine_observation_us)[j]
            yield dict(times=times,market={s:dict(open=opens[:,j],close=closes[:,j],mark=marks[:,j],quote_volume=np.full(len(times),1e10)) for j,s in enumerate(S)})

def generated_quality(fixture):
    from legacy_native_quality import original_quality
    cell_type=original_quality().QualityCell
    probe=GeneratedMinuteProvider(fixture)
    opening=fixture.start+10*MINUTE;anchor=opening-MINUTE;cells=[]
    for offset in (0,1):
        at=opening+offset*MINUTE
        cell=cell_type(S[0],at,at+MINUTE,at+MINUTE,str(float(probe.price_at(anchor+MINUTE)[0])),
            anchor,anchor+MINUTE,anchor+MINUTE,anchor+MINUTE,anchor+MINUTE,'a'*64,'GENERATED_GENUINE_ANCHOR')
        cells.append(cell.validate())
    start=fixture.start+2*source.DAY+11*MINUTE;end=start+3*MINUTE
    interval=V2.quality_module.StaleMarkInterval(start,end,start-2*MINUTE,S)
    intervals=(interval,) if end<fixture.end else ()
    return tuple(cells),intervals

def construct_generated_case(fixture,recipe,tier,*,block_minutes=1440,with_quality=True):
    source.require_generated(fixture)
    if recipe not in source.RECIPES or tier not in source.TIERS or type(with_quality) is not bool:
        raise ValueError('EXACT_FROZEN_SIX_CELL_GENERATED_SCOPE_REQUIRED')
    projection=source.project_generated(fixture)
    cells,intervals=generated_quality(fixture) if with_quality else ((),())
    provider=GeneratedMinuteProvider(fixture,block_minutes=block_minutes,quality_cells=cells,intervals=intervals)
    rows=[dict(symbol=s,close_us=int(at),available_us=int(at),close=float(fixture.close[i,j]))
        for i,at in enumerate(fixture.clocks) for j,s in enumerate(S)]
    import polars as pl
    window=dict(start=fixture.start,end=fixture.end,symbols=S,daily=pl.DataFrame(rows),events=[dict(row) for row in fixture.events],
        minute_blocks=provider,fixture_scope=base.GENERATED)
    constructions=[]
    def factory(tier_name,cost):
        if constructions:raise ValueError('ONE_ACCOUNT_CONSTRUCTOR_PER_CONTINUOUS_CASE')
        plain=V2.grid.make_account(tier_name,cost['id'])
        account=ContinuousAccount(plain.config,symbols=S,instrument_profiles=plain.instrument_profiles,
            closing_min_notional_exempt=True,generated_scope=base.GENERATED,tier_name=tier_name)
        constructions.append(account);return account
    constructor=V2._rebind(V2.native._construct_case,make_owned_account=factory,PartialTierGuard=ContinuousGuard)
    sim,guard=constructor(window,rows,fixture.decisions,projection['targets'][recipe+'_'+tier],
        tier_name=tier,cost_name='BASE27',source_scope=source.GENERATED)
    account=sim.account;account._source_quality_cells=cells
    typed_intervals=tuple((c.completed_us,c.completed_us+MINUTE,(c.symbol,)) for c in cells)
    account._quality_intervals=typed_intervals+tuple((i.start_us,i.end_us,i.symbols) for i in intervals)
    quality=CompositeQualityGuard(guard,intervals=intervals,source_sidecar_sha256=source.digest(dict(
        cells=[asdict(c) for c in cells],intervals=[i.as_dict() for i in intervals])))
    quality.source_quality_cells=cells
    quality.identity.update(source_clock_cells=[asdict(c) for c in cells],per_asset_genuine_recovery_required=True,
        quality_composition='REJECT_WHEN_EITHER_TYPED_CELL_OR_INTERVAL_UNRECOVERED')
    quality.policy_sha256=sha256(V2.P._identity(quality.identity).encode()).hexdigest();quality.install()
    guard.causal_mark_quality_guard=quality
    if getattr(account.liquidation_callback,'__self__',None) is not sim:raise AssertionError('NATIVE_PENDING_CANCELLATION_REQUIRED')
    original_risk=sim.risk_schedule
    def risk_schedule(_sim,event_us):
        sameclock_next=(_sim.event_cursor<len(_sim.window['events']) and _sim.window['events'][_sim.event_cursor]['event_us']==event_us)
        if not sameclock_next and account.clock_us==event_us and event_us>account._noop_watermark:
            account.monitor('MONITOR:'+str(event_us),event_us)
        original_risk(event_us)
        if not _sim.terminal:
            for symbol,intent in tuple(account.pending_exits.items()):
                if not account.positions[symbol].quantity:
                    account.pending_exits.pop(symbol,None);continue
                existing=_sim.pending.get(symbol)
                if existing is None or existing['kind'] not in {'PROTECTIVE_STOP','TERMINAL'}:
                    guard.original_schedule(dict.fromkeys(S,DEC(0)),intent['signal_us'],'PROTECTIVE_STOP',(symbol,))
    sim.risk_schedule=MethodType(risk_schedule,sim)
    sim.meta.update(continuation_version=VERSION,policy_variant=base.POLICY_VARIANT,settlement_mode=base.SETTLEMENT,
        recipe=recipe,continuous_wallet=True,one_account_constructor=True,one_provider_lifecycle=True,
        annual_wallet_fresh_genesis=False,global_terminal_only=True,source_identity=fixture.identity,
        generated_only=True,historical_execution_admitted=False,
        mark_quality_policy_identity=quality.policy_sha256,original_interpolated_mark_execution_admitted=False)
    return sim,guard,dict(provider=provider,projection=projection,constructions=constructions)

def case_result(sim,guard):
    result=base.case_result(sim,guard)
    result['economics'].update(comparison_scope=VERSION,annual_wallet_fresh_genesis=False,
        continuous_wallet=True,annual_wallets_compounded=False,one_initial_10000_wallet=True,
        full_year_DEV=False,partial2021_not_annualized=False,generated_only=True)
    result['common_execution_policy'].update(version=VERSION,historical_execution_admitted=False,global_terminal_only=True)
    return result

def construct_historical_case(*args,**kwargs):source.historical_finance()
