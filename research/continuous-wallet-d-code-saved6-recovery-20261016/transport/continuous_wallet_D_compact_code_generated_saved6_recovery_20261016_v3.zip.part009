            anchor+p.MINUTE,anchor+p.MINUTE,anchor+p.MINUTE,anchor+p.MINUTE,'b'*64,'GENERATED_GENUINE_ANCHOR:'+symbol+':'+str(anchor)).validate())
    recoveries=[];points=set()
    for c in cells:
