from pathlib import Path
from decimal import Decimal, localcontext
from datetime import datetime, timezone
import argparse
import csv
import hashlib
import io
import json
import math
import os
import statistics

HERE = Path(__file__).resolve().parent
ROOT = HERE.parent
START, END, DAYS, MINUTES = 1617321600000000, 1767225600000000, 1735, 2498400
SOURCE_ID = '19c67731c85aff36c812b5446db33d14332ee93e460f94bdcfecd75757f0c66e'
CELLS = tuple(recipe + '_' + tier for recipe in ('STATIC50_OLD_NO_REEXPANSION', 'VOL_MANAGED_HOLD') for tier in ('LOW', 'MID', 'HIGH'))
PILOT = 'continuous_wallet_D_pilot_saved_independent_audit_20261015_v1'
REMAINING = 'continuous_wallet_D_remaining5_saved_independent_audit_20261015_v1'
AUDIT_HASHES = (
    '0269c00b3c272fb52589f4c4c20e3b272af163e35e6dd46ca5b1169571552622',
    '8bbcff2c393e7d7623211715242fde4a35c414f049c96259e25e7dba1c645739',
    '916c09d23e36ac4ebbe0980401a827444ce9d3864c6b7949bc6cb136810e512d',
    'f20ba31ae4d9fa4ae9ff69e0b3dc3c3c2761163ebbbb3fb3f255b00b5baa6031',
    '4d773eec3a13fecfa689c1835d05243946b810f8efd5a473ee5a75901859d98f',
)
PILOT_DESCRIPTION_PIN = dict(path=PILOT+'/DESCRIPTIVE_SAVED_PILOT_ADDENDUM.json', SHA256='fa9d3157caddc9f67bf386975b7e79a3549f9150843c3e5da85cae4aeec18b93', bytes=275639)
PILOT_RESOURCE_PIN = dict(path=PILOT+'/audit_attempt003/RESOURCE_OUTPUT_ADDENDUM.json', SHA256='ec1341c4ccccd2e3054bc45afbfef600ad1a91edcd9e55aeca7323fbc95328f3', bytes=1945)


def canonical(value):
    return (json.dumps(value, indent=2, sort_keys=True, allow_nan=False) + '\n').encode()


def pin(path):
    path = Path(path)
    if not path.is_absolute():
        path = ROOT / path
    if path.is_symlink() or any(p.is_symlink() for p in path.parents):
        raise ValueError('ORDINARY_EXACT_METADATA_ONLY_PATH_REQUIRED')
    raw = path.read_bytes()
    return dict(path=str(path.relative_to(ROOT)), SHA256=hashlib.sha256(raw).hexdigest(), bytes=len(raw))


def read(pin_value, inputs):
    path = Path(pin_value['path'])
    if path.is_absolute() or '..' in path.parts:
        raise ValueError('WORKSPACE_RELATIVE_METADATA_PIN_REQUIRED')
    actual = pin(ROOT / path)
    if actual != pin_value:
        raise ValueError('EXACT_SAVED_METADATA_PIN_MISMATCH:' + str(path))
    inputs[str(path)] = actual
    return json.loads((ROOT / path).read_bytes())


def decimal_returns(nav):
    """Historical whole-wallet rates; actual 1735 days, a stated 365-day year."""
    with localcontext() as ctx:
        ctx.prec = 60
        ratio = Decimal(str(nav)) / Decimal(10000)
        cumulative = ratio - 1
        cagr = ((ratio.ln() * Decimal(365) / Decimal(DAYS)).exp() - 1) if ratio > 0 else (Decimal(-1) if ratio == 0 else None)
        return str(cumulative), None if cagr is None else str(cagr)


def daily_risk(daily):
    previous = 10000.0
    returns = []
    peak = previous
    drawdown = 0.0
    for value in daily:
        value = float(value)
        if not math.isfinite(value) or previous <= 0:
            raise ValueError('FINITE_POSITIVE_PREVIOUS_DAILY_NAV_REQUIRED')
        returns.append(value / previous - 1)
        peak = max(peak, value)
        drawdown = max(drawdown, 1 - value / peak)
        previous = value
    if len(returns) != DAYS:
        raise ValueError('ALL_1735_DAILY_RATIOS_INCLUDING_INITIAL_10000_REQUIRED')
    return statistics.stdev(returns) * math.sqrt(365), drawdown


def extract(audit, description, resources, cell):
    """Reporting arithmetic only. Economic return sign never gates inclusion."""
    is_pilot = cell == CELLS[0]
    expected_status = 'PASS_ACTUAL_CONTINUOUS_PILOT_SAVED_AUDIT' if is_pilot else 'PASS_INCREMENTAL_COMPLETED_CASE_SAVED_AUDIT_ROOT_EXIT_PENDING'
    if (audit.get('status') != expected_status or audit.get('cell_id') != cell
            or audit.get('calendar') != [START, END] or audit.get('completed_minutes') != MINUTES
            or audit.get('native40_reconstructed') is not True or audit.get('resource_bounds_passed') is not True
            or audit.get('source_identity') != SOURCE_ID or audit.get('findings') != []
            or audit.get('financial_runs') != 0 or audit.get('accounts_constructed') != 0
            or len(audit['independent_annual_boundary_checks']) != 4):
        raise ValueError('EXACT_INDEPENDENT_FULL_CALENDAR_CASE_AUDIT_REQUIRED:' + cell)
    arithmetic = audit['independent_financial_arithmetic']
    if arithmetic['initial_cash'] != '10000' or arithmetic['status'] not in (
            'FULL_CALENDAR_ACTUAL_PAID_MARKET_FLAT', 'FULL_CALENDAR_CONDITIONAL_SETTLED_FLAT'):
        raise ValueError('HONEST_FULL_CALENDAR_FLAT_OUTCOME_REQUIRED')
    risk = audit['held_risk_report']
    vol, daily_mdd = daily_risk(risk['daily_NAV'])
    if abs(vol - risk['realized_daily_simple_return_annual_volatility']) > 1e-14:
        raise ValueError('RECOMPUTED_DAILY_RETURN_VOLATILITY_MISMATCH')
    cumulative, cagr = decimal_returns(arithmetic['NAV'])
    if abs(Decimal(cumulative) - Decimal(arithmetic['net_wallet_change'])) > Decimal('1e-35'):
        raise ValueError('CUMULATIVE_NATIVE_REPORTING_RATIO_MISMATCH')
    years = description['annual_descriptive_activity']
    if [x['year'] for x in years] != list(range(2021, 2026)) or sum(x['days'] for x in years) != DAYS:
        raise ValueError('ALL_FIVE_DESCRIPTIVE_CALENDAR_COMPONENTS_REQUIRED')
    episodes = description['guard50_warning_episodes'] if is_pilot else audit['guard50_warning_episodes']
    totals = arithmetic['totals']
    quality = audit['quality_saved_effects']
    qualification = audit['warnings_and_qualifications']
    with localcontext() as ctx:
        ctx.prec = 60
        funding_cost = -Decimal(totals['funding_cash'])
        friction = Decimal(totals['fees']) + Decimal(totals['execution_cost'])
    return dict(
        cell_id=cell, recipe=cell.rsplit('_', 1)[0], tier=cell.rsplit('_', 1)[1],
        outcome=arithmetic['status'], initial_cash_USDT='10000', ending_NAV_USDT=arithmetic['NAV'],
        cumulative_wallet_change=cumulative, historical_CAGR_365day_year=cagr,
        nominal_annual_volatility_budget=risk['nominal_annual_volatility_budget'],
        realized_daily_return_annual_volatility=vol,
        native_all_observation_max_drawdown=qualification['all_observation_max_drawdown'],
        independently_checked_minute_close_max_drawdown=audit['independent_chunk_audit']['minute_close_max_drawdown'],
        independently_recomputed_daily_close_max_drawdown=daily_mdd,
        actual_mean_gross_exposure=risk['gross_exposure_mean'], actual_max_gross_exposure=risk['gross_exposure_max'],
        actual_max_asset_absolute_weight=risk['asset_exposure_absolute_max'],
        saved_held_forecast_volatility_breach_minutes=risk['forecast_volatility_breach_minutes'],
        saved_held_forecast_volatility_max=risk['forecast_annual_volatility_max'],
        paid_trade_legs=sum(y['paid_trade_legs'] for y in years),
        gross_fill_turnover_USDT=totals['gross_fill_turnover'], fees_USDT=totals['fees'],
        spread_slippage_execution_cost_USDT=totals['execution_cost'], fees_plus_execution_friction_USDT=str(friction),
        signed_funding_cashflow_USDT=totals['funding_cash'], net_funding_cost_USDT=str(funding_cost),
        guard50_warning_episodes=len(episodes), warning_years=sorted({int(e['trigger_UTC'][:4]) for e in episodes}),
        warnings_crossing_Jan1=sum(bool(e['crossed_Jan1']) for e in episodes),
        unresolved_warning_episodes=sum(e.get('resume_us') is None for e in episodes),
        maximum_warning_duration_seconds=max((e['duration_seconds'] for e in episodes if e['duration_seconds'] is not None), default=0),
        guard50_warning_timeline=[{k:e.get(k) for k in ('trigger_UTC', 'resume_UTC', 'mode', 'reason', 'duration_seconds', 'crossed_Jan1')} for e in episodes],
        annual_seam_dynamic_states=description.get('annual_seam_dynamic_states', []),
        trading_active_years=[y['year'] for y in years if y['paid_trade_legs'] > 0],
        annual_descriptive_activity=[{k:y[k] for k in ('year', 'days', 'paid_trade_legs', 'mean_gross_weight', 'paid_turnover_USDT', 'fees_plus_execution_cost_USDT', 'signed_funding_cashflow_USDT')} for y in years],
        quality_typed_cells_with_carried_positions=quality['typed_cells_with_nonzero_carried_position'],
        quality_typed_cells=quality['typed2022_cells'], quality_rejected_increase_receipts=quality['total_actual_rejection_receipts'],
        secondary_native40_bridge_residual=qualification['native40_secondary_PnL_bridge_residual'],
        funding_observed_events=qualification['funding_observed_events'], funding_account_applied_events=qualification['funding_account_applied_events'],
        resources=resources,
        independent_audit_status=audit['status'], completed_minutes=MINUTES, annual_carried_seams=4,
        terminal_checkpoint_SHA256=audit['terminal_checkpoint_SHA256'], permanent_claim_SHA256=audit['permanent_claim_SHA256'],
        financial_code_manifest_SHA256=audit['financial_code_manifest_SHA256'], root_financial_GO_SHA256=audit['root_financial_GO_SHA256'],
    )


def pct(value):
    return 'N/A' if value is None else format(Decimal(str(value)) * 100, '.2f') + '%'


def report_text(document):
    rows = document['cases']
    paid = sum(r['outcome'] == 'FULL_CALENDAR_ACTUAL_PAID_MARKET_FLAT' for r in rows)
    conditional = sum(r['outcome'] == 'FULL_CALENDAR_CONDITIONAL_SETTLED_FLAT' for r in rows)
    resolved = all(r['unresolved_warning_episodes'] == 0 for r in rows)
    crossed = sum(r['warnings_crossing_Jan1'] for r in rows)
    maximum_duration = max(r['maximum_warning_duration_seconds'] for r in rows)
    lines = ['# Six fixed continuous wallets: saved comparison', '',
        'All six predeclared accounts completed the same [2021-04-02, 2026-01-01) interval: 1,735 actual days, each beginning with 10,000 USDT. These are seen-DEV historical simulations, not OOS evidence or future APRs. Rows remain in their original order; no profitable years or tiers were selected.', '',
        '| Frozen recipe | Nominal tier | End NAV (USDT) | Cumulative | Historical CAGR | Realized vol | Max drawdown | Mean gross |',
        '|---|---:|---:|---:|---:|---:|---:|---:|']
    for row in rows:
        name = 'Original intrinsic STATIC50' if row['recipe'].startswith('STATIC50') else 'CORE VOL_MANAGED_HOLD'
        lines.append('| ' + ' | '.join([name, pct(row['nominal_annual_volatility_budget']), format(Decimal(row['ending_NAV_USDT']), '.2f'), pct(row['cumulative_wallet_change']), pct(row['historical_CAGR_365day_year']), pct(row['realized_daily_return_annual_volatility']), pct(row['native_all_observation_max_drawdown']), pct(row['actual_mean_gross_exposure'])]) + ' |')
    lines += ['', f'Terminal outcomes: {paid} actual paid-market flat; {conditional} conditional-settled flat. Each outcome remains explicit in the CSV/JSON.', '',
        'Cumulative = final NAV / 10,000 ‚àí 1. Historical CAGR = (final NAV / 10,000)^(365 / 1,735) ‚àí 1, using the full actual elapsed interval and a stated 365-day year. Neither is a product of freshly seeded annual wallets or a forward return forecast. Volatility is std(ddof=1) of all 1,735 complete daily NAV ratios minus one, including the initial 10,000, multiplied by sqrt(365). Max drawdown is the saved native all-observation statistic; independently reconstructed minute-close and daily-close drawdowns are retained separately in COMPARISON.json.', '',
        '## Risk and continuity', '',
        '- Nominal 5%/10%/15% tiers do not produce matched realized risk. No return rescaling or risk-matched superiority claim is made.',
        '- Every account carried positions, pending orders, margins, cash, basis, open clocks and lifetime peak/risk state through all four Jan1 seams. There were no annual terminal closes, resets or cash reseeds. The global terminal used its single signal 61 minutes before the end and 60 later real minute opens.',
        '- GUARD50_EXIT_ONLY stayed installed, with no automatic cash transfers or topups. Dynamic warning states and paid exits are described below; the contract name alone does not mean that an account remained frozen in exit-only mode.',
        '- Saved covariance forecasts are code-bound diagnostics, not independently recomputed source covariance here. Actual gross/asset risk and saved forecast breaches are retained; no instantaneous capital, volatility or liquidation-safety guarantee follows.', '',
        '| Recipe / tier | Max gross | Forecast-breach minutes | Max saved forecast vol | Guard50 episodes | Paid legs | Fees | Execution friction | Net funding cost |',
        '|---|---:|---:|---:|---:|---:|---:|---:|---:|']
    for row in rows:
        lines.append('| ' + ' | '.join([row['cell_id'], pct(row['actual_max_gross_exposure']), str(row['saved_held_forecast_volatility_breach_minutes']), pct(row['saved_held_forecast_volatility_max']), str(row['guard50_warning_episodes']), str(row['paid_trade_legs']), format(Decimal(row['fees_USDT']), '.2f'), format(Decimal(row['spread_slippage_execution_cost_USDT']), '.2f'), format(Decimal(row['net_funding_cost_USDT']), '.2f')]) + ' |')
    lines += ['', 'All cost amounts are USDT. Signed funding cashflow is also retained in JSON: negative means a cash debit; the table shows its sign-reversed net expense. Costs are already reflected in executed NAV. Execution friction is embedded in actual fills and must not be deducted from realized fill PnL a second time.', '',
        ('Paid trading was active in every calendar component for every account. ' if all(r['trading_active_years'] == list(range(2021, 2026)) for r in rows) else 'Trading-active years are recorded per account in JSON. ') + 'Annual activity/exposure/cost observations are retained in JSON solely as carried-wallet descriptions, without multiplying annual fresh-wallet returns or attributing exposure changes to the guard alone.',
        'Dynamic Guard50 warning counts, active years, maximum duration, unresolved episodes and cross-Jan1 episodes are retained separately from the persistent policy name.', '',
        (f'Every recorded Guard50 episode resumed normal mode within {maximum_duration:g} seconds; none crossed Jan1.' if resolved and crossed == 0 and maximum_duration > 0 else f'Guard50 unresolved episodes: {sum(r["unresolved_warning_episodes"] for r in rows)}; episodes crossing Jan1: {crossed}; maximum observed completed duration: {maximum_duration:g} seconds.'), '',
        'Warning-active years mean actual temporary REDUCE_ONLY_MONITOR episodes. A retained cash-watch reason can outlast a warning while the actual mode is CONTINUE_CONDITIONAL; the reason string is not a persistent exit-only state. UTC warning timelines and annual dynamic modes are retained in JSON. Annual activity/cost rows use UTC event year, while Jan1 marked NAV includes same-clock funding before the next daily decision. These rows are chronology, not exact cost attribution to marked subperiod returns.', '',
        '## Evidence and limits', '',
        '- Two root-observed controller exits, all six child exits, terminal checkpoints, exact code/source identities and independent saved reconstructions are bound by SOURCE_PINS.json and the consolidated saved proof. Every account has 2,498,400 minute rows; native40 accounting and four carried annual seams passed.',
        '- Literal signed funding rates, event clocks, ordering and reported interval labels were preserved without interval rescaling. Each journal observed 26,100 events; 26,095 entered the account ledger because five genesis observations had no ownership/no past mark and zero cashflow. Funding units/publication timing remain uncertified.',
        '- Both quality sources were OR-composed (reject when either is unrecovered): 27 typed 2022 cells/eight genuine recovery endpoints and the separate 2024 interval. Typed cells with carried positions, in fixed account order: ' + ', '.join(str(r['quality_typed_cells_with_carried_positions']) + '/27' for r in rows) + '; rejected-increase receipts: ' + ', '.join(str(r['quality_rejected_increase_receipts']) for r in rows) + '. Valuation exposure remains; zero rejections is not safety evidence.',
        '- Venue/arrival/current-mark certification, liquidation or no-liquidation safety, OOS validity and instantaneous-risk guarantees remain false/unknown. Tiny native40 secondary bridge residuals are retained unchanged, not treated as cashflows or silently forgiven.',
        '- Each case stayed under the frozen 2,400 combined CPU-second, 2,700 wall-second, 4.5GB observed RSS, 7GB hard AS and 700MB output limits. The 4.2GB logical cohort includes the first pilot, remaining outputs and permanent claims. Admission required 5.5GB available memory; writes retained a 1.5GB disk floor. Cgroup visibility and unsampled transient/AS peaks remain qualified, not invented.',
        '- This closes the annual-reset evidence gap for this exact predeclared six-account simulation. It does not establish a deployable winner, live safety or an unseen-period result. No other account, strategy, parameter or half-SMA variant was added.', '',
        'Local research only. External publication remains blocked. Full minute chunks remain in their original locations; this compact comparison duplicates none.', '']
    return '\n'.join(lines)


def validate_final(final):
    required = dict(schema='INDEPENDENT_CONTINUOUS_REMAINING_FIVE_SAVED_AUDIT_V1', status='PASS_ACTUAL_REMAINING_FIVE_CONTINUOUS_SAVED_AUDIT',
        ordered_cells=list(CELLS[1:]), root_financial_GO_SHA256='83ca5ec50a5c0e1122bc00733ee1b46fee2efdcc698e748b7656d12b74e6bc70',
        actual_root_controller_shell_exit_code=0, completed_minutes_per_case=MINUTES, native40_reconstructed=True, resource_bounds_passed=True)
    if any(type(final.get(k)) is not type(v) or final[k] != v for k, v in required.items()):
        raise ValueError('FINAL_ROOT_EXIT_AND_INDEPENDENT_FIVE_CASE_SAVED_PROOF_REQUIRED')
    if (type(final.get('logical_cohort_output_bytes')) is not int
            or not 0 <= final['logical_cohort_output_bytes'] <= 4200000000):
        raise ValueError('FINAL_LOGICAL_COHORT_BYTE_PROOF_REQUIRED')
    paths = [REMAINING + '/' + cell + '/audit_attempt002/INDEPENDENT_CONTINUOUS_REMAINING_CASE_SAVED_AUDIT.json' for cell in CELLS[1:]]
    if [p['path'] for p in final.get('per_case_audits', [])] != paths:
        raise ValueError('EXACT_ALL_FIVE_REMAINING_AUDIT_PINS_IN_ORIGINAL_ORDER_REQUIRED')
    cases = final.get('cases', [])
    if ([r.get('cell_id') for r in cases] != list(CELLS[1:])
            or [r.get('reporting_addendum', {}).get('path') for r in cases] != [str(Path(p).parent/'INDEPENDENT_REPORTING_ADDENDUM.json') for p in paths]):
        raise ValueError('EXACT_ALL_FIVE_EXTERNALLY_BOUND_REPORTING_ADDENDA_REQUIRED')
    root_path = 'continuous_wallet_D_financial_20261015_v2/financial_attempts/ACTUAL_REMAINING5_attempt001/ROOT_OBSERVED_EXIT_CONFIRMED.json'
    if final.get('root_observed_exit_pin', {}).get('path') != root_path:
        raise ValueError('EXACT_ROOT_OBSERVED_EXIT_METADATA_PATH_REQUIRED')


def write_new(name, raw):
    path = HERE / name
    temporary = HERE / (name + '.tmp')
    if path.exists() or temporary.exists():
        raise ValueError('REPORT_OUTPUT_ALREADY_EXISTS_NO_SILENT_OVERWRITE:' + name)
    with temporary.open('xb') as handle:
        handle.write(raw)
        handle.flush()
        os.fsync(handle.fileno())
    os.rename(temporary, path)
    fd = os.open(HERE, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--consolidated-audit', required=True)
    parser.add_argument('--sha', required=True)
    parser.add_argument('--bytes', required=True, type=int)
    args = parser.parse_args()
    inputs = {}
    final_pin = dict(path=args.consolidated_audit, SHA256=args.sha, bytes=args.bytes)
    if final_pin['path'] != REMAINING + '/INDEPENDENT_REMAINING_FIVE_FINAL_SAVED_AUDIT.json':
        raise ValueError('EXACT_FINAL_INDEPENDENT_SAVED_METADATA_PATH_REQUIRED')
    final = read(final_pin, inputs)
    validate_final(final)
    root_exit = read(final['root_observed_exit_pin'], inputs)
    if type(root_exit.get('observed_exit_code')) is not int or root_exit['observed_exit_code'] != 0 or root_exit.get('session_id') != 12642:
        raise ValueError('EXACT_ROOT_OBSERVED_EXIT_ZERO_REQUIRED')
    audit_pins = final['per_case_audits']
    if len(audit_pins) != 5:
        raise ValueError('EXACT_ALL_FIVE_REMAINING_AUDIT_PINS_REQUIRED')
    pilot_path = PILOT + '/audit_attempt004/INDEPENDENT_CONTINUOUS_PILOT_SAVED_AUDIT.json'
    pilot_pin = pin(pilot_path)
    if pilot_pin['SHA256'] != AUDIT_HASHES[0]:
        raise ValueError('EXACT_PILOT_SAVED_AUDIT_REQUIRED')
    audits = [read(pilot_pin, inputs)] + [read(value, inputs) for value in audit_pins]
    observed = audits[0]['root_controller_exit']
    pilot_exit = read(dict(path=str(Path(observed['root_receipt_path']).relative_to(ROOT)), SHA256=observed['root_receipt_SHA256'], bytes=observed['root_receipt_bytes']), inputs)
    if type(pilot_exit.get('observed_exit_code')) is not int or pilot_exit['observed_exit_code'] != 0 or pilot_exit.get('session_id') != 63130:
        raise ValueError('FIRST_PILOT_ROOT_EXIT_STAYS_COUNTED_ONCE')
    descriptions = []
    resource_rows = []
    for index, (cell, audit) in enumerate(zip(CELLS, audits, strict=True)):
        if index < len(AUDIT_HASHES) and pin(pilot_path if index == 0 else audit_pins[index - 1]['path'])['SHA256'] != AUDIT_HASHES[index]:
            raise ValueError('PRESERVED_INCREMENTAL_AUDIT_PIN_CHANGED')
        if index == 0:
            desc = read(PILOT_DESCRIPTION_PIN, inputs)
            if desc['parent_audit_SHA256'] != pilot_pin['SHA256']:
                raise ValueError('PILOT_DESCRIPTION_PARENT_MISMATCH')
            r = read(PILOT_RESOURCE_PIN, inputs)
            resources = dict(combined_worker_controller_CPU_seconds=r['combined_CPU_seconds'], worker_plus_saved_validation_wall_seconds=r['worker_and_saved_validation_wall_seconds'], simultaneous_worker_controller_RSS_peak_bytes=r['pilot_worker_plus_controller_RSS_peak_bytes'], case_final_bytes_including_stdout=r['case_final_bytes_including_stdout'], all_case_resource_envelope_flags_passed=True, unknown_cgroup_uncertainty=r['unknown_cgroup_visibility'], transient_physical_write_peak_exactly_sampled=False, actual_peak_AS_measured=False)
        else:
            desc = read(final['cases'][index - 1]['reporting_addendum'], inputs)
            if desc['parent_audit']['SHA256'] != audit_pins[index - 1]['SHA256']:
                raise ValueError('REMAINING_DESCRIPTION_PARENT_MISMATCH')
            resources = desc['resources']
        descriptions.append(desc)
        resource_rows.append(resources)
    cases = [extract(a, d, r, c) for a, d, r, c in zip(audits, descriptions, resource_rows, CELLS, strict=True)]
    document = dict(schema='FIXED_SIX_CONTINUOUS_WALLET_SAVED_COMPARISON_V1', status='SIX_FULL_CASES_ROOT_EXIT_AND_INDEPENDENT_SAVED_PROOF_BOUND',
        created_UTC=datetime.now(timezone.utc).isoformat(), ordered_cohort=list(CELLS), calendar=[START, END], actual_days=DAYS,
        minutes_per_account=MINUTES, DEV_only=True, OOS=False, annual_wallet_reset=False, return_rescaling=False, tier_or_year_selection=False,
        source_identity=SOURCE_ID,
        CAGR_formula='(final_NAV_USDT / 10000) ** (365 / 1735) - 1; historical geometric annualization, not forward APR',
        final_independent_saved_audit=final_pin, logical_cohort_output_bytes=final['logical_cohort_output_bytes'], cases=cases,
        external_publication_authorized=False, financial_runs_by_report_builder=0, account_constructors_by_report_builder=0,
        native_modules_imported_by_report_builder=False, minute_chunks_copied=0)
    for name in ('build_saved_comparison.py', 'test_saved_comparison.py'):
        inputs[str((HERE/name).relative_to(ROOT))] = pin(HERE/name)
    fields = [key for key, value in cases[0].items() if not isinstance(value, (dict, list))]
    stream = io.StringIO(newline='')
    writer = csv.DictWriter(stream, fieldnames=fields, extrasaction='ignore')
    writer.writeheader()
    writer.writerows(cases)
    write_new('SOURCE_PINS.json', canonical(dict(schema='EXACT_SAVED_REPORT_INPUTS_V1', files=inputs)))
    write_new('COMPARISON.json', canonical(document))
    write_new('REPORT.md', report_text(document).encode())
    write_new('SUMMARY.csv', stream.getvalue().encode())
    print(json.dumps(dict(status=document['status'], cases=6, rows=6*MINUTES, metadata_inputs=len(inputs))))


if __name__ == '__main__':
    main()
