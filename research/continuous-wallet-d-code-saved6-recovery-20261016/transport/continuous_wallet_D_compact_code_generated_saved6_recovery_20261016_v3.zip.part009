            gp=meta/'INVENTED_PILOT_ROOT_GO.json';save(gp,dict(code_manifest_SHA256=a.PILOT_CODE_SHA256,limits=a.LIMITS,test_only_invented=True));gs=a.sha(gp.read_bytes())
            cp=claims/(a.CELLS[0]+'.json');save(cp,dict(cell_id=a.CELLS[0],root_GO_SHA256=gs,code_manifest_SHA256=a.PILOT_CODE_SHA256,
                source_identity=a.PILOT_SOURCE_ID,status='RESERVED_BEFORE_SPAWN_NO_AUTOMATIC_RETRY',case_output=str(case),test_only_invented=True))
            tp=case/'TERMINAL_CHECKPOINT.json';save(tp,dict(schema='SUPERVISOR_ADMITTED_CONTINUOUS_FINANCIAL_TERMINAL_V1',
                expected=dict(cell_id=a.CELLS[0],root_GO_SHA256=gs,code_manifest_SHA256=a.PILOT_CODE_SHA256,source_identity=a.PILOT_SOURCE_ID,claim_SHA256=pin(cp)['SHA256'],actual_shell_exit_code=0),
                actual_owned_shell_exit=dict(actual_shell_exit_code=0),saved_validation=dict(status='FULL_CALENDAR_ACTUAL_PAID_MARKET_FLAT',completed_minutes=2498400,
                    native40_reconstructed=True,actual_owned_shell_exit_code=0,first_account_counts_once=True),fresh_financial_scopes_revoked=True,automatic_retry=False,financial_snapshot_resume=False))
            (cohort/(a.CELLS[0]+'.stdout.log')).write_bytes(b'INVENTED_LOG\n')
            ap=meta/'INVENTED_PILOT_SAVED_AUDIT.json'
            audit=dict(schema='INDEPENDENT_CONTINUOUS_PILOT_SAVED_AUDIT_V1',status='PASS_ACTUAL_CONTINUOUS_PILOT_SAVED_AUDIT',cell_id=a.CELLS[0],root_financial_GO_SHA256=gs,
                financial_code_manifest_SHA256=a.PILOT_CODE_SHA256,source_identity=a.PILOT_SOURCE_ID,actual_root_controller_shell_exit_code=0,actual_worker_shell_exit_code=0,
                completed_minutes=2498400,native40_reconstructed=True,resource_bounds_passed=True,terminal_checkpoint_SHA256=pin(tp)['SHA256'],permanent_claim_SHA256=pin(cp)['SHA256'],
                case_output_bytes=a._regular_bytes(case)+(cohort/(a.CELLS[0]+'.stdout.log')).stat().st_size,cohort_output_bytes=a._regular_bytes(cohort),test_only_invented=True)
            save(ap,audit);go=dict(pilot_root_GO=pin(gp),pilot_claim=pin(cp),pilot_terminal=pin(tp),pilot_saved_audit=pin(ap))
            with patch.multiple(a,PILOT_COHORT=cohort,PILOT_GO=gp,PILOT_GO_SHA256=gs,CLAIMS=claims,_PILOT_BYTES=None):
                self.assertEqual(a.pilot_output_bytes(go),audit['cohort_output_bytes'])
                # Return sign is deliberately absent from policy and never sorts/selects.
                for profit in (-.999,.0,100.):
                    changed=dict(audit,paid_net_return=profit);save(ap,changed);wire=dict(go,pilot_saved_audit=pin(ap));self.assertEqual(a.pilot_output_bytes(wire),audit['cohort_output_bytes'])
                for field,value in [('status','PENDING'),('completed_minutes',1735),('actual_root_controller_shell_exit_code',1),('actual_worker_shell_exit_code',1),
