"""
import os
for key in ('OPENBLAS_NUM_THREADS','OMP_NUM_THREADS','MKL_NUM_THREADS','NUMEXPR_NUM_THREADS','POLARS_MAX_THREADS','VECLIB_MAXIMUM_THREADS','BLIS_NUM_THREADS'):os.environ[key]='1'
from pathlib import Path
from types import SimpleNamespace
from unittest.mock import patch
import json
import sys
import subprocess
import tempfile
import time
import unittest
