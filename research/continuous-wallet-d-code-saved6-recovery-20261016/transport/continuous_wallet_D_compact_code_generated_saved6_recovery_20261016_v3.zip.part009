            source_identity='INVENTED_METADATA_SOURCE_IDENTITY', artifacts={}, array_identities={},
            test_scope='INVENTED_METADATA_ONLY_NOT_ROOT_AUTHORITY')
        prep.update(preparation_change or {})
        prepared_pin = self._write(self.artifact_root / 'INVENTED_PREPARATION.json', a.canonical(prep))
        audit = dict(status='PASS_ACTUAL_PREPARED_SOURCE_NO_FINANCIAL_ADMISSION',
