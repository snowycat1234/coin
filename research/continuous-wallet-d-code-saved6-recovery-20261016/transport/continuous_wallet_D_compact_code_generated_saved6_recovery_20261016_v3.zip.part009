def build_invented(root):
    import continuous_admission as a
    import continuous_output as out
    import continuous_terminal as terminal
    sys.path.append(str(a.ROOT/'continuous_wallet_D_financial_20261015_v1'))
    import test_native_adapter_generated as helper
