HISTORICAL_DAYS=1735
LIVE={}

def utc(date):return int(datetime.fromisoformat(date).replace(tzinfo=timezone.utc).timestamp()*1_000_000)

def json_plain(value):
    if isinstance(value,Mapping):return {k:json_plain(v) for k,v in value.items()}
    if isinstance(value,(list,tuple)):return [json_plain(v) for v in value]
    return value

def canonical(value):return json.dumps(json_plain(value),sort_keys=True,separators=(',',':'),allow_nan=False).encode()

def digest(value):return sha256(canonical(value)).hexdigest()

def frozen(value,dtype='<f8'):
    a=np.asarray(value,dtype=dtype)
    return np.frombuffer(a.tobytes(order='C'),dtype=dtype).reshape(a.shape)

def array_id(value):
    a=np.asarray(value)
    if a.dtype not in (np.dtype('<f8'),np.dtype('<i8')):raise ValueError('EXACT_FLOAT64_OR_INT64_ARRAY_REQUIRED')
    return dict(dtype=a.dtype.str,shape=list(a.shape),raw_bytes_SHA256=sha256(a.tobytes()).hexdigest())

def checked_reference(path):
    pins=json.loads((HERE/'REFERENCE_PINS.json').read_text())
    p=ROOT/path;pin=pins[path]
    if p.is_symlink() or any(x.is_symlink() for x in p.parents):raise ValueError('ORDINARY_PINNED_CODE_REQUIRED')
    raw=p.read_bytes()
    if len(raw)!=pin['bytes'] or sha256(raw).hexdigest()!=pin['SHA256']:raise ValueError('REFERENCE_CODE_PIN_CHANGED:'+path)
    return p

def verify_reference_code_graph():
    name='legacy_intrinsic_D_remaining14_financial_20261015_v1/FINANCIAL_CODE_MANIFEST.json'
    manifest=json.loads(checked_reference(name).read_bytes());base=ROOT/Path(name).parent;verified={}
    for root,key in ((base,'files'),(ROOT,'dependencies')):
        for relative,pin in manifest[key].items():
            if not relative.endswith('.py'):continue
            path=root/relative
            if path.is_symlink() or any(p.is_symlink() for p in path.parents):raise ValueError('ORDINARY_REFERENCE_CODE_GRAPH_REQUIRED')
            raw=path.read_bytes()
            if len(raw)!=pin['bytes'] or sha256(raw).hexdigest()!=pin['SHA256']:
                raise ValueError('IMMUTABLE_REFERENCE_CODE_GRAPH_CHANGED:'+relative)
            verified[str(path.relative_to(ROOT))]=dict(pin)
    return dict(schema='CODE_ONLY_IMMUTABLE_D_REFERENCE_GRAPH_VERIFICATION_V1',files=verified,
        code_files=len(verified),source_body_reads=0,historical_admission=False)

def load_math():
    path=checked_reference('legacy_intrinsic_D_signal_20261015/pinned/legacy_core_adapter.py')
    name='_continuous_original_intrinsic_math'
    if name not in sys.modules:
        spec=importlib.util.spec_from_file_location(name,path);module=importlib.util.module_from_spec(spec)
        sys.modules[name]=module;spec.loader.exec_module(module)
    # frozen_grid loads source-code ASTs, never market bodies.
    grid_path=checked_reference('traditional_three_tier_freeze_20261015/frozen_grid.py')
    if str(grid_path.parent) not in sys.path:sys.path.insert(0,str(grid_path.parent))
    import frozen_grid
    if Path(frozen_grid.__file__).resolve()!=grid_path:raise ValueError('EXACT_CORE_GRID_MODULE_REQUIRED')
    return sys.modules[name],frozen_grid

def exact_daily_union(parts,*,start,end):
    """No precedence/tolerance: all duplicate clocks/availability/f64 bits agree."""
    expected=np.arange(start-199*DAY,end,DAY,dtype='<i8');rows={}
    for part in parts:
        t,a,p=(np.asarray(part[k]) for k in ('clocks','available','close'))
        if (t.dtype!=np.dtype('<i8') or a.dtype!=np.dtype('<i8') or p.dtype!=np.dtype('<f8')
                or t.ndim!=1 or a.shape!=t.shape or p.shape!=(len(t),5) or not len(t)
                or not np.array_equal(a,t) or np.any(np.diff(t)!=DAY)
                or not np.isfinite(p).all() or np.any(p<=0)):
            raise ValueError('EXACT_COMPLETED_DAILY_NAMESPACE_REQUIRED')
        for at,av,price in zip(t,a,p,strict=True):
            at,av=int(at),int(av)
            if not start-199*DAY<=at<end:raise ValueError('DAILY_SOURCE_OUTSIDE_ADMITTED_FEATURE_UNION')
            body=price.tobytes()
            if at in rows and rows[at]!=(av,body):raise ValueError('CROSS_YEAR_DAILY_OVERLAP_BIT_DISAGREEMENT')
            rows[at]=(av,body)
    if tuple(sorted(rows))!=tuple(expected):raise ValueError('COMPLETE_UNIQUE_DAILY_FEATURE_CALENDAR_REQUIRED')
    return frozen(expected,'<i8'),frozen(np.vstack([np.frombuffer(rows[int(t)][1],dtype='<f8') for t in expected]))

def validate_partitions(segments,*,start,end):
    cursor=start
    for a,b in segments:
        if type(a) is not int or type(b) is not int or a!=cursor or a%MINUTE or b%MINUTE or b<=a or b>end:
            raise ValueError('EXACT_ONCE_CONTIGUOUS_MINUTE_PARTITIONS_REQUIRED')
        cursor=b
    if cursor!=end:raise ValueError('COMPLETE_MINUTE_CALENDAR_REQUIRED')
    return (end-start)//MINUTE

def validate_endpoint(previous_end,next_first_clock,previous_native_close,next_first_close):
    a,b=np.asarray(previous_native_close),np.asarray(next_first_close)
    if (previous_end!=next_first_clock or a.shape!=(5,) or b.shape!=(5,)
            or a.dtype!=np.dtype('<f8') or b.dtype!=np.dtype('<f8') or a.tobytes()!=b.tobytes()):
        raise ValueError('GENUINE_NATIVE_ENDPOINT_NEXT_DAILY_CLOSE_BIT_DISAGREEMENT')

def validate_events(events,*,start,end):
    previous=(-1,-1);seen=set()
    for row in events:
        if set(row)!=set(('symbol','event_us','raw_rate','reported_interval_hours','raw_rate_unit')):
            raise ValueError('EXACT_LITERAL_FUNDING_SCHEMA_REQUIRED')
        at=row['event_us'];symbol=row['symbol']
        if type(at) is not int or not start<=at<end or symbol not in SYMBOLS:
            raise ValueError('FUNDING_OUTSIDE_HALF_OPEN_CALENDAR_OR_SYMBOL_NAMESPACE')
        order=(at,SYMBOLS.index(symbol))
        if order<previous or (symbol,at) in seen:raise ValueError('FUNDING_ORDER_OR_DUPLICATE_ID')
        if (not np.isfinite(row['raw_rate']) or row['reported_interval_hours'] not in (2.,4.,8.)
                or row['raw_rate_unit']!='UNCONFIRMED'):
            raise ValueError('LITERAL_SIGNED_UNCONFIRMED_FUNDING_REQUIRED')
        previous=order;seen.add((symbol,at))
    return digest(list(events))

@dataclass(frozen=True,eq=False)
class GeneratedSource:
    scope:str
    start:int
    end:int
    close:np.ndarray
    clocks:np.ndarray
    decisions:np.ndarray
    events:tuple
    parts:tuple
    identity:str
    def validate_live(self):
        rec=LIVE.get(id(self))
        if (type(self) is not GeneratedSource or rec is None or rec[0]() is not self or rec[1]!=self.identity
                or any(value is not expected for value,expected in zip(
                    (self.close,self.clocks,self.decisions,self.events,self.parts),rec[2:7],strict=True))
                or (self.start,self.end,self.scope)!=rec[7:10] or self.scope!=GENERATED
                or not utc('1970-01-01')<=self.clocks[0]<self.start<self.end<=utc('1976-01-01')
                or any(a.flags.writeable for a in (self.close,self.clocks,self.decisions))):
            raise ValueError('LIVE_INTERNALLY_GENERATED_NONHISTORICAL_SOURCE_REQUIRED')
        return self
    def validate(self):
        GeneratedSource.validate_live(self)
        if self.identity!=source_identity(self):raise ValueError('EXACT_GENERATED_SOURCE_IDENTITY_REQUIRED')
        return self

def require_generated(value,*,full=True):
    if type(value) is not GeneratedSource:raise ValueError('EXACT_LIVE_GENERATED_SOURCE_TYPE_REQUIRED')
    return GeneratedSource.validate(value) if full else GeneratedSource.validate_live(value)

def source_identity(source):
    return digest(dict(scope=source.scope,start=source.start,end=source.end,
        close=array_id(source.close),clocks=array_id(source.clocks),decisions=array_id(source.decisions),
        events=list(source.events),parts=[dict(start=p['start'],end=p['end'],
            close=array_id(p['close']),clocks=array_id(p['clocks']),available=array_id(p['available'])) for p in source.parts]))

@contextmanager
def generated_source(*,full_horizon=False,days=4,seed=1729):
    if type(full_horizon) is not bool or type(days) is not int or not 1<=days<=31 or type(seed) is not int or not 0<=seed<=65535:
        raise ValueError('BOUNDED_INTERNALLY_GENERATED_PARAMETERS_REQUIRED')
    start=utc('1971-04-02') if full_horizon else utc('1971-12-30')
    end=utc('1976-01-01') if full_horizon else start+days*DAY
    t=np.arange(start-199*DAY,end,DAY,dtype='<i8')
    rng=np.random.default_rng(seed)
    r=rng.normal(0,.006,(len(t)-1,5))+np.array([.001,.0006,.0001,-.0003,-.0007])
    p=np.vstack([np.array([50000.,2000.,20.,.5,.05]),np.array([50000.,2000.,20.,.5,.05])*np.cumprod(1+r,axis=0)])
    cuts=[start]+[utc(f'{year}-01-01') for year in range(1972,1976) if start<utc(f'{year}-01-01')<end]+[end]
    parts=[]
    for a,b in zip(cuts,cuts[1:]):
        selected=(t>=a-199*DAY)&(t<b)
        parts.append(dict(start=a,end=b,clocks=frozen(t[selected],'<i8'),available=frozen(t[selected],'<i8'),close=frozen(p[selected])))
    clocks,close=exact_daily_union(parts,start=start,end=end)
    for prev,nxt in zip(parts,parts[1:]):
        k=int(np.searchsorted(t,prev['end']))
        # Invented native final trade close is a separately passed witness.
        validate_endpoint(prev['end'],nxt['start'],p[k],nxt['close'][199])
    validate_partitions([(p['start'],p['end']) for p in parts],start=start,end=end)
    decisions=frozen(np.arange(start,end,DAY,dtype='<i8'),'<i8')
    events=tuple(dict(symbol=s,event_us=int(at),raw_rate=float((1 if (i+j)%2 else -1)*(j+1)*.000013),
        reported_interval_hours=float((2,4,8,2,8)[j]),raw_rate_unit='UNCONFIRMED')
        for i,at in enumerate(range(start,end,8*60*MINUTE)) for j,s in enumerate(SYMBOLS))
    validate_events(events,start=start,end=end)
    events=tuple(MappingProxyType(dict(row)) for row in events)
    parts=tuple(MappingProxyType(dict(part)) for part in parts)
    obj=GeneratedSource(GENERATED,start,end,close,clocks,decisions,events,parts,'')
    object.__setattr__(obj,'identity',source_identity(obj));LIVE[id(obj)]=(weakref.ref(obj),obj.identity,
        obj.close,obj.clocks,obj.decisions,obj.events,obj.parts,obj.start,obj.end,obj.scope)
    try:yield obj.validate()
    finally:LIVE.pop(id(obj),None)

def project_generated(source,*,verify_annual=True):
    require_generated(source);old,core=load_math();d=source.decisions;t=source.clocks;p=source.close
    od,ow,oc,op=old.build_target_grid(p,t,t,d)
    cd,cw,cc,cp=core.build_target_grid(p,t,t,d)
    if od.tobytes()!=cd.tobytes() or oc.tobytes()!=cc.tobytes():raise ValueError('SAME_DECISION_COVARIANCE_CONVENTION_REQUIRED')
    out={r+'_'+tier:frozen((ow if r==RECIPES[0] else cw)[r+'_'+tier]) for r in RECIPES for tier in TIERS}
    parity=[]
    if verify_annual:
        for part in source.parts:
            mask=(d>=part['start'])&(d<part['end']);ad=d[mask]
            a,aw,ac,ap=old.build_target_grid(part['close'],part['clocks'],part['available'],ad)
            b,bw,bc,bp=core.build_target_grid(part['close'],part['clocks'],part['available'],ad)
            if (a.tobytes()!=d[mask].tobytes() or b.tobytes()!=a.tobytes()
                    or ac.tobytes()!=oc[mask].tobytes() or bc.tobytes()!=ac.tobytes()
                    or any(out[r+'_'+tier][mask].tobytes()!=(aw if r==RECIPES[0] else bw)[r+'_'+tier].tobytes()
                           for r in RECIPES for tier in TIERS)):
                raise ValueError('CONTINUOUS_ANNUAL_TARGET_COVARIANCE_BYTE_PARITY_FAILED')
            # Preserve original decision-level source/rank provenance, not just weights.
            indexes=np.flatnonzero(mask)
            if any(canonical(ap[i])!=canonical(op[k]) or canonical(bp[i])!=canonical(cp[k]) for i,k in enumerate(indexes)):
                raise ValueError('CONTINUOUS_ANNUAL_CAUSAL_PROVENANCE_PARITY_FAILED')
            parity.append(dict(calendar=[part['start'],part['end']],days=len(ad),exact_target_covariance_provenance_parity=True))
    return dict(source_identity=source.identity,decision_us=d,annual_covariance=frozen(oc),targets=out,
        proofs=dict(original=op,core=cp),annual_parity=parity,generated_only=True)

def historical_source_stage(*args,**kwargs):
    raise PermissionError('CONTINUOUS_HISTORICAL_SOURCE_STAGE_NOT_ADMITTED_REQUIRES_EXACT_SOURCE_GO_AND_INDEPENDENT_REVIEW')

def historical_finance(*args,**kwargs):
    raise PermissionError('CONTINUOUS_HISTORICAL_FINANCE_NOT_ADMITTED_REQUIRES_SOURCE_TARGET_NATIVE_RESOURCE_REVIEWS_AND_NEW_SIX_CELL_ROOT_GO')

def declared_historical_metadata():
    """Read only the frozen design JSON; no body file is opened or trusted."""
    name='fixed_strategy_90_saved_comparison_20261015_v1/CONTINUOUS_WALLET_SOURCE_PINS.json'
    pins=json.loads(checked_reference(name).read_bytes());years=pins['annual_source_contracts']
    if [r['year'] for r in years]!=list(range(2021,2026)):raise ValueError('EXACT_FIVE_DECLARED_SOURCE_YEARS_REQUIRED')
    segments=[];funding=[];quality=[]
    for rec in years:
        start,end=rec['calendar_us_half_open'];months=rec['canonical_selected_months']
        parts=[]
        for m in months:
            if not 0<=m['lo']<m['hi']<=m['count']:raise ValueError('EXACT_DECLARED_MONTH_SLICE_REQUIRED')
            parts.append((m['start']+m['lo']*MINUTE,m['start']+m['hi']*MINUTE))
        count=validate_partitions(parts,start=start,end=end)
        if count!=rec['execution_minutes']:raise ValueError('DECLARED_SOURCE_MINUTE_COUNT_DISAGREES')
        segments.append((start,end));funding.append(rec['funding_contract']['selected_events'])
        count_quality=rec['quality_summary'].get('derived_mark_cells')
        if count_quality is None and rec['legacy_saved_source_metadata']['quality_cells_SHA256']==digest([]) and rec['quality_intervals']==[]:
            count_quality=0
        if type(count_quality) is not int:raise ValueError('EXACT_DECLARED_QUALITY_CELL_COUNT_REQUIRED')
        quality.append(count_quality)
    count=validate_partitions(segments,start=HISTORICAL_START,end=HISTORICAL_END)
    if (count!=2498400 or funding!=[4110,5550,5475,5490,5475] or quality!=[0,27,0,10,0]):
        raise ValueError('FROZEN_CONTINUOUS_DECLARED_COUNTS_DISAGREE')
    return dict(schema='DECLARED_CONTINUOUS_SOURCE_METADATA_ONLY_NOT_BODY_VERIFICATION_V1',
        calendar=[HISTORICAL_START,HISTORICAL_END],days=HISTORICAL_DAYS,minutes=count,
        annual_days=[(b-a)//DAY for a,b in segments],ordered_cells=list(CELLS),initial_cash_per_cell='10000',
        source_identities=[r['source_identity'] for r in years],funding_counts=funding,funding_total=sum(funding),
        derived_mark_counts=quality,source_body_reads=0,source_continuity_verified=False,
        target_continuity_verified=False,historical_source_stage_admitted=False,historical_finance_admitted=False)
