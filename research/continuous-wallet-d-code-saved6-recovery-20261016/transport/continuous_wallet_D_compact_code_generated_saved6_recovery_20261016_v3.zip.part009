            saved.save(writer.directory/'INTERRUPTION.json',dict(kind='GENERATED_RESOURCE_DATA_OR_VALIDATION_INTERRUPTION',
                error=repr(error),traceback=traceback.format_exc(),financial_terminal=False,automatic_retry=False,financial_snapshot_resume=False))
        raise
