class SourceTests(unittest.TestCase):
    def test_frozen_cohort(self):
        self.assertEqual(len(s.CELLS),6)
        metadata=s.declared_historical_metadata()
        self.assertEqual(metadata['annual_days'],[274,365,365,366,365])
        self.assertEqual(metadata['funding_total'],26100)
        self.assertFalse(metadata['source_continuity_verified'])
        self.assertEqual((s.HISTORICAL_END-s.HISTORICAL_START)//s.DAY,1735)
        self.assertEqual(s.HISTORICAL_DAYS*1440,2498400)
        self.assertEqual(s.HISTORICAL_DAYS*1440*36*8,719539200)
    def test_full_generated_calendar_and_exact_annual_recipe_provenance(self):
        with s.generated_source(full_horizon=True) as f:
            self.assertEqual((len(f.clocks),len(f.decisions)),(1934,1735))
            out=s.project_generated(f)
            self.assertEqual([r['days'] for r in out['annual_parity']],[274,366,365,365,365])
            self.assertEqual(set(out['targets']),set(s.CELLS))
            self.assertTrue(all(r['exact_target_covariance_provenance_parity'] for r in out['annual_parity']))
    def test_overlap_missing_duplicate_clock_endpoint_future_and_event_rejections(self):
        with s.generated_source() as f:
            parts=list(f.parts);bad=dict(parts[-1]);p=bad['close'].copy();p[0,0]=np.nextafter(p[0,0],np.inf);bad['close']=p
            with self.assertRaisesRegex(ValueError,'OVERLAP_BIT'):s.exact_daily_union([parts[0],bad],start=f.start,end=f.end)
            with self.assertRaisesRegex(ValueError,'UNIQUE_DAILY'):s.exact_daily_union([parts[0]],start=f.start,end=f.end)
            bad=dict(parts[-1]);bad['available']=bad['available']+1
            with self.assertRaisesRegex(ValueError,'DAILY_NAMESPACE'):s.exact_daily_union([parts[0],bad],start=f.start,end=f.end)
            for segments in ([(f.start,f.end-s.MINUTE)],[(f.start,f.end),(f.end-s.MINUTE,f.end)],[(f.start,f.start+s.DAY),(f.start+s.DAY+s.MINUTE,f.end)]):
                with self.assertRaises(ValueError):s.validate_partitions(segments,start=f.start,end=f.end)
            with self.assertRaisesRegex(ValueError,'ENDPOINT'):s.validate_endpoint(f.end,f.end,f.close[-1],np.nextafter(f.close[-1],np.inf))
            late=dict(f.events[-1]);late['event_us']=f.end
            with self.assertRaisesRegex(ValueError,'HALF_OPEN'):s.validate_events((*f.events,late),start=f.start,end=f.end)
            with self.assertRaisesRegex(ValueError,'DUPLICATE'):s.validate_events((f.events[0],f.events[0]),start=f.start,end=f.end)
            with self.assertRaises(ValueError):s.validate_events((dict(f.events[0],raw_rate=float('nan')),),start=f.start,end=f.end)
    def test_authority_is_fail_closed_and_generated_scope_revokes(self):
        for method in (s.historical_source_stage,s.historical_finance,n.construct_historical_case):
            for authority in ({'old_annual_GO':True},{'generated':True},{'review':'wrong','tier':'MID'},{'resume':'snapshot'}):
                with self.assertRaises(PermissionError):method(authority)
        with s.generated_source() as f:
            forged=replace(f)
            with self.assertRaises(ValueError):forged.validate()
        from types import SimpleNamespace
        fake=SimpleNamespace(**vars(f));fake.validate=lambda:fake
        for seam in (s.project_generated,n.GeneratedMinuteProvider):
            with self.assertRaisesRegex(ValueError,'GENERATED_SOURCE_TYPE'):seam(fake)
        with self.assertRaisesRegex(ValueError,'GENERATED_SOURCE_TYPE'):n.construct_generated_case(fake,s.RECIPES[0],'LOW')
        with self.assertRaises(ValueError):f.validate()
        with self.assertRaises(ValueError):n.construct_generated_case(f,s.RECIPES[0],'LOW')
    def test_future_suffix_does_not_change_prior_target_or_provenance(self):
        old,core=s.load_math()
        with s.generated_source(days=7) as f:
            d=f.decisions[:2];p=f.close.copy();p[-3:]*=np.array([3.,.4,2.,.2,4.])
            for builder in (old.build_target_grid,core.build_target_grid):
                a,aw,ac,ap=builder(f.close,f.clocks,f.clocks,d)
                b,bw,bc,bp=builder(p,f.clocks,f.clocks,d)
                self.assertEqual(a.tobytes(),b.tobytes());self.assertEqual(ac.tobytes(),bc.tobytes())
                self.assertEqual(s.canonical(ap),s.canonical(bp))
                for k in aw:self.assertEqual(aw[k].tobytes(),bw[k].tobytes())

class NativeTests(unittest.TestCase):
    def run_case(self,block):
        with s.generated_source(days=4) as f:
            sim,g,m=n.construct_generated_case(f,s.RECIPES[0],'MID',block_minutes=block)
            states=[]
            while sim.cursor<sim.end and sim.stop is None:
                sim.advance_day();states.append(saved.observed_state(sim))
            self.assertEqual(len(m['constructions']),1);self.assertEqual(m['provider'].iterations,1)
            self.assertEqual(sim.rows_written,5760);self.assertIsNone(sim.stop)
            with self.assertRaises(ValueError):next(m['provider']())
            with self.assertRaises(RuntimeError):sim.snapshot()
            with self.assertRaises(RuntimeError):type(sim).from_snapshot({})
            with self.assertRaises(RuntimeError):sim.fork()
            result=n.case_result(sim,g);values=result.pop('minute').to_numpy();result['targets']=result['targets'].to_dicts()
            return n.V2.OWNED.export_tree(sim.account.snapshot()),n.V2.OWNED.export_tree(result),values,states
    def test_partition_invariance_with_boundary_funding_and_quality(self):
        a=self.run_case(1440);b=self.run_case(137)
        self.assertEqual(a[0],b[0]);self.assertEqual(a[1],b[1]);self.assertEqual(a[2].tobytes(),b[2].tobytes());self.assertEqual(a[3],b[3])
        at=s.utc('1972-01-01');audit,result,values,states=a
        boundary=[row for row in result['funding'] if row['event_us']==at]
        self.assertEqual(len(boundary),5)
        self.assertTrue(any(row['owned'] for row in boundary))
        for row in boundary:
            self.assertLess(row['mark_close_us'],at)
            self.assertNotEqual(row.get('status'),'NO_POSITION_NO_PAST_MARK')
        self.assertTrue(any(q!='0' for q in states[1]['quantities'].values()))
        self.assertEqual(states[1]['event_cursor'],35)
        self.assertGreater(states[2]['financial_sequence'],states[1]['financial_sequence'])
        self.assertEqual(states[1]['account_constructors'],1)
    def test_marker_is_pure_and_only_final_terminal(self):
        with s.generated_source(days=4) as f:
            sim,g,m=n.construct_generated_case(f,s.RECIPES[1],'LOW')
            sim.advance_day();sim.advance_day();before=saved.observed_state(sim)
            marker=saved.annual_marker(sim)
            self.assertEqual(saved.observed_state(sim),before);self.assertEqual(marker['phase'],saved.PHASE)
            self.assertFalse(sim.terminal)
            self.assertEqual(sim.terminal_signal_us,f.end-61*s.MINUTE)
            self.assertTrue(any(p.quantity for p in sim.account.positions.values()))
            self.assertFalse(any(o['kind']=='TERMINAL' for o in sim.pending.values()))
            with self.assertRaises(ValueError):sim.schedule(dict.fromkeys(n.S,n.DEC(0)),sim.cursor,'TERMINAL')
            while sim.cursor<sim.end and sim.stop is None:sim.advance_day()
            self.assertTrue(sim.terminal)
            self.assertTrue(n.case_result(sim,g)['economics']['paid_flat'])
            self.assertTrue(all(r['event_us']<f.end for r in sim.account.trades))
            self.assertFalse(sim.account.transfer_journal)
    def test_both_quality_predicates_and_genuine_installed_recovery(self):
        with s.generated_source(days=4) as f:
            sim,g,m=n.construct_generated_case(f,s.RECIPES[0],'LOW')
            q=g.causal_mark_quality_guard;c=q.source_quality_cells[-1];later=q.intervals[0]
            self.assertIsNone(q.quality_witness(c.completed_us-3*s.MINUTE))
            self.assertIn('affected_source_cells',q.quality_witness(c.completed_us))
            sim.advance_day();sim.advance_day()
            self.assertIsNone(q.quality_witness(later.start_us-1))
            witness=q.quality_witness(later.start_us)
            self.assertIn('affected_intervals',witness)
            self.assertEqual(witness.get('affected_source_cells'),None)
            # Even after the interval's declared recovery clock, stale installed
            # state does not grant an increase. A future source value is irrelevant.
            self.assertIsNotNone(q.quality_witness(later.end_us+1))
            for symbol in n.S:
                sim.account.marks[symbol].append(dict(price=n.DEC('1'),close_us=later.end_us,available_us=later.end_us))
                sim.account.mark_quality[symbol]='DIRECT_GENERATED_OBSERVATION'
            self.assertIsNone(q.quality_witness(later.end_us+1))
    def test_warning_pending_capital_and_lots_carry_across_boundary(self):
        self.check_warning_boundary(False)
        self.check_warning_boundary(True)
    def check_warning_boundary(self,deplete):
        # A genuine invented mark shock arrives at the Jan 1 observation phase.
        # Capacity then stays below one coarse lot for eight opens, exercising
        # paid warning persistence/renewal without resetting the wallet.
        original=n.GeneratedMinuteProvider.__call__;boundary=s.utc('1972-01-01')
        def shocked(provider):
            for block in original(provider):
                times=block['times'];mask=(times>=boundary-3*s.MINUTE)&(times<boundary+8*s.MINUTE)
                block['market'][n.S[0]]['quote_volume'][mask]=1.
                at=np.flatnonzero(times==boundary-s.MINUTE)
                if len(at):block['market'][n.S[0]]['mark'][at[0]]*=.45
                yield block
        with s.generated_source(days=4) as f,patch.object(n.GeneratedMinuteProvider,'__call__',shocked):
            sim,g,m=n.construct_generated_case(f,s.RECIPES[0],'HIGH',with_quality=False)
            from types import MethodType
            original_risk=sim.risk_schedule
            def depletion(_sim,event_us):
                original_risk(event_us)
                if deplete and event_us==boundary-s.MINUTE:
                    a=_sim.account;sym=n.S[0];q=a.positions[sym].quantity;mark=a.marks[sym][-1]['price']
                    rate=(a.free_cash-n.DEC('500'))/(q*mark)
                    for i,row in enumerate(_sim.window['events']):
                        if row['event_us']==boundary and row['symbol']==sym:
                            _sim.window['events'][i]=dict(row,raw_rate=float(rate))
            sim.risk_schedule=MethodType(depletion,sim)
            sim.advance_day();sim.advance_day()
            state=saved.observed_state(sim);a=sim.account
            self.assertEqual(sim.cursor,boundary);self.assertGreater(a.positions[n.S[0]].quantity,0)
            self.assertIn(n.S[0],a.pending_exits);self.assertEqual(sim.pending[n.S[0]]['kind'],'PROTECTIVE_STOP')
            self.assertEqual(a.pending_exits[n.S[0]]['signal_us'],boundary)
            if deplete:
                self.assertLess(n.DEC(state['free_cash']),n.DEC('501'));self.assertGreater(n.DEC(state['free_cash']),n.DEC('499'))
            else:self.assertNotEqual(state['free_cash'],'10000')
            self.assertGreater(n.DEC(state['isolated_balances'][n.S[0]]),0)
            self.assertEqual(a.positions[n.S[0]].quantity%n.DEC('.001'),0)
            self.assertFalse(a.transfer_journal);self.assertFalse(sim.terminal)
            before_sequence=a._financial_sequence;peak=sim.peak
            marker=saved.annual_marker(sim);self.assertEqual(marker['state'],state)
            sim.advance_day()
            self.assertGreater(a._financial_sequence,before_sequence);self.assertGreaterEqual(sim.peak,peak)
            if not deplete:self.assertTrue(any(r.get('kind')=='PAID_WARNING_EXIT_RENEWED_AFTER_FIVE_OPENS' for r in a.mode_journal))
            self.assertTrue(any(action.get('reason')=='GUARD50_PAID_EXIT_NO_TOPUP' for row in a.monitor_journal for action in row.get('actions',[])))
            while sim.cursor<sim.end and sim.stop is None:sim.advance_day()
            self.assertTrue(n.case_result(sim,g)['economics']['paid_flat'])
            self.assertFalse(a.transfer_journal)
    def test_coarse_subminimum_paid_dust_and_warning_state_across_jan1(self):
        plain=n.V2.grid.make_account('LOW','BASE27')
        a=n.ContinuousAccount(plain.config,symbols=n.S,instrument_profiles=plain.instrument_profiles,
            closing_min_notional_exempt=True,generated_scope=n.base.GENERATED,tier_name='LOW')
        at=s.utc('1972-01-01');symbol='DOGEUSDT';signal=at-3*s.MINUTE
        def marks(clock,price):
            prices=dict(zip(n.S,('50000','2000','20','.5',price)))
            a.update_marks(clock,{sym:dict(price=n.DEC(p),close_us=clock,available_us=clock) for sym,p in prices.items()})
        marks(signal,'.02');marks(at-2*s.MINUTE,'.02')
        receipt=a.execute_fill(symbol,'BUY',n.DEC(1000),at-2*s.MINUTE+1,signal,'GENERATED_OPEN_DUST',
            execution_mid_price=n.DEC('.02'),quote_available_us=at-2*s.MINUTE,available_quantity=n.DEC(1000))
        self.assertEqual(receipt['status'],'FILLED');self.assertEqual(a.positions[symbol].quantity,n.DEC(1000))
        marks(at-s.MINUTE,'.005');a.monitor('MONITOR:'+str(at-s.MINUTE),at-s.MINUTE)
        self.assertIn(symbol,a.pending_exits);intent=dict(a.pending_exits[symbol]);cash=a.free_cash;peak_seq=a._financial_sequence
        marks(at,'.005')
        self.assertEqual(a.pending_exits[symbol],intent);self.assertEqual(a.free_cash,cash)
        self.assertEqual(a.positions[symbol].quantity,n.DEC(1000));self.assertGreater(a.positions[symbol].isolated_balance,0)
        marks(at+s.MINUTE,'.005')
        closed=a.execute_fill(symbol,'SELL',n.DEC(1000),at+s.MINUTE+1,intent['signal_us'],'GENERATED_PAID_DUST_CLOSE',
            execution_mid_price=n.DEC('.005'),quote_available_us=at+s.MINUTE,available_quantity=n.DEC(1000),reduce_only=True)
        self.assertEqual(closed['status'],'FILLED');self.assertEqual(a.positions[symbol].quantity,0)
        self.assertLess(n.DEC(a.trades[-1]['decimal_strings']['quantity'])*n.DEC(a.trades[-1]['decimal_strings']['fill_price']),10)
        self.assertGreater(a._financial_sequence,peak_seq);self.assertGreater(a.fees,0)
        self.assertFalse(a.transfer_journal);self.assertFalse(a.settlement_journal)
    def test_ordinary_five_and_global_terminal_sixty_real_attempts(self):
        original=n.GeneratedMinuteProvider.__call__
        def limited(provider):
            for block in original(provider):
                times=block['times'];f=provider.fixture
                mask=(times<f.start+10*s.MINUTE)|(times>=f.end-62*s.MINUTE)
                for row in block['market'].values():row['quote_volume'][mask]=1.
                yield block
        with s.generated_source(days=2) as f,patch.object(n.GeneratedMinuteProvider,'__call__',limited):
            sim,g,m=n.construct_generated_case(f,s.RECIPES[1],'MID',with_quality=False)
            while sim.cursor<sim.end and sim.stop is None:sim.advance_day()
            self.assertTrue(any(r.get('reason')=='FIVE_ATTEMPTS_EXPIRED' for r in sim.rejections))
            expired=[r for r in sim.rejections if r.get('reason')=='SIXTY_TERMINAL_ATTEMPTS_EXPIRED']
            self.assertTrue(expired)
            self.assertEqual(sim.rows_written,2880);self.assertIsNone(sim.stop)
            result=n.case_result(sim,g)
            self.assertFalse(result['economics']['paid_flat']);self.assertIsNone(result['economics']['paid_net_return'])
            self.assertTrue(any(p.quantity for p in sim.account.positions.values()))
            self.assertTrue(all(r['event_us']<f.end for r in sim.account.trades))
            self.assertEqual(sim.terminal_signal_us,f.end-61*s.MINUTE)
    def test_financial_methods_are_unchanged(self):
        for name in ('execute_fill','apply_funding','monitor','_transfer','economic_report'):
            self.assertIs(getattr(n.ContinuousAccount,name),getattr(n.base.ExpansionAccount,name))
        self.assertIs(n.ContinuousGuard.attempt,n.base.ContinuationGuard.attempt)
        self.assertEqual(n.V2.grid.make_account('HIGH','BASE27').config.leverage,1)
    def test_all_six_accounts_use_frozen_recipes_tiers_and_fresh_genesis_once(self):
        with s.generated_source(days=1) as f:
            ids=[]
            for recipe in s.RECIPES:
                for tier in s.TIERS:
                    sim,g,m=n.construct_generated_case(f,recipe,tier)
                    ids.append(id(sim.account))
                    self.assertEqual(sim.account.nav(),n.DEC(10000));self.assertEqual(len(m['constructions']),1)
                    self.assertEqual(sim.meta['recipe'],recipe);self.assertEqual(sim.account._bound_tier_name,tier)
                    self.assertEqual(sim.end-sim.start,s.DAY)
            # Store account references above through metadata lists, or IDs can
            # be reused by Python; numerical identity is not financial alias.
            with self.assertRaises(ValueError):n.construct_generated_case(f,'HOLD_CORE5_VOL_MATCHED_NOREEXP','LOW')
            with self.assertRaises(ValueError):n.construct_generated_case(f,s.RECIPES[0],'WRONG')

class WriterTests(unittest.TestCase):
    def test_durable_prefix_tamper_reuse_and_full_calendar(self):
        with tempfile.TemporaryDirectory(prefix='continuous_generated_') as temp:
            path=Path(temp)/'case';start=s.HISTORICAL_START;end=s.HISTORICAL_END
            w=saved.ChunkWriter(path,identity=dict(scope=s.GENERATED),start=start,end=end)
            values=np.zeros((1440,36),dtype='<f8');values[:,0]=10000;values[:,1]=10000
            for day in range(1735):
                at=start+(day+1)*s.DAY
                import datetime
                date=datetime.datetime.fromtimestamp(at/1e6,datetime.timezone.utc)
                boundary=(date.month,date.day)==(1,1) and at<end
                state=dict(generated_day=day,cursor=at,financial_snapshot_resume=False)
                if boundary:state=dict(boundary_us=at,phase=saved.PHASE,state=state,state_SHA256=s.digest(state),boundary_funding=[],read_only_observation=True,forced_flatten=False,cash_reseed=False,snapshot_resume_authorized=False)
                w.append(values,end_us=at,state=state,boundary=boundary)
                if day==0:
                    self.assertFalse(w.validate()['full_calendar'])
                    with self.assertRaises(ValueError):w.validate(require_full=True)
            proof=w.validate(require_full=True)
            self.assertEqual((proof['rows'],proof['chunks']),(2498400,1735))
            self.assertFalse(proof['financial_terminal_admitted'])
            with self.assertRaises(FileExistsError):saved.ChunkWriter(path,identity={},start=start,end=end)
            with self.assertRaises(ValueError):w.append(values,end_us=end+s.DAY)
            (path/w.records[0]['name']).write_bytes(b'CORRUPT_GENERATED_TEST')
            with self.assertRaisesRegex(ValueError,'PIN_CHANGED'):w.validate(require_full=True)
    def test_atomic_immutable_and_interruption_prefix(self):
        with tempfile.TemporaryDirectory(prefix='continuous_generated_') as temp:
            path=Path(temp)/'x';saved.atomic(path,b'first')
            with self.assertRaises(FileExistsError):saved.atomic(path,b'second')
            self.assertEqual(path.read_bytes(),b'first')
            self.assertFalse(path.with_name('x.tmp').exists())
if __name__=='__main__':unittest.main(verbosity=2)
