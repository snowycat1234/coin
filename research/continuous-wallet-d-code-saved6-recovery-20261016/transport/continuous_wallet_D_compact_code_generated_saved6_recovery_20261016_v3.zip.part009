Import reads code/metadata only. No actual body I/O happens until a separately
reviewed, exact-code root SOURCE GO is validated and a clean guard is active.
"""
from __future__ import annotations
from contextlib import contextmanager
from dataclasses import dataclass,field
from hashlib import sha256
import json
import os
from pathlib import Path
import sys
from types import SimpleNamespace

HERE=Path(__file__).resolve().parent;ROOT=HERE.parent
GENERATED=ROOT/'continuous_wallet_D_generated_20261015_v1'
if str(GENERATED) not in sys.path:sys.path.insert(0,str(GENERATED))
import continuous_source as pure
from continuous_source import canonical,digest
import source_backend as backend
from legacy_source_guard import SourceOnlyGuard as FrozenSourceOnlyGuard,current_guard

SCHEMA='ROOT_CONTINUOUS_SOURCE_ONLY_V1'
ACTION='QUALIFY_EXACT_FIVE_YEAR_CONTINUOUS_SOURCE_AND_TWO_RECIPES_ALL_THREE_TIERS_ONLY'
YEARS=(2021,2022,2023,2024,2025)
_SEAL=object();_LIVE={}


def catalog():
    return json.loads((HERE/'SOURCE_INPUT_CATALOG.json').read_bytes())

def year_record(year):
    if type(year) is not int or year not in YEARS:raise ValueError('EXACT_FIVE_DEV_SOURCE_YEARS_REQUIRED')
    return catalog()['years'][str(year)]

def code_identity():
    raw=(HERE/'CODE_MANIFEST.json').read_bytes();m=backend.c.exact_object(raw)
    for name,pin in m['files'].items():backend.c.exact(HERE/backend.c.relative(name),pin['SHA256'],pin['bytes'])
    for name,pin in m['dependencies'].items():backend.c.exact(ROOT/backend.c.relative(name),pin['SHA256'],pin['bytes'])
    return sha256(raw).hexdigest()

def validate_authority(go_raw,go_sha,review_raw,review_sha):
    # Every byte expectation comes from the root invocation, never an artifact's
    # own claimed digest, and authority is checked before a body reader exists.
    go=backend.c.checked_external(go_raw,go_sha);review=backend.c.checked_external(review_raw,review_sha)
    code=code_identity();cat=catalog();catalog_sha=digest(cat)
    required=dict(schema=SCHEMA,action=ACTION,code_manifest_SHA256=code,source_catalog_SHA256=catalog_sha,
        independent_source_code_review_SHA256=review_sha,ordered_years=list(YEARS),ordered_cells=list(pure.CELLS),
        calendar=[pure.HISTORICAL_START,pure.HISTORICAL_END],source_reads_authorized=True,target_generation_authorized=True,
        historical_execution_authorized=False,account_construction_authorized=False,provider_iteration_authorized=False,
        process_launch_authorized=False,canonical_claims_authorized=False,financial_GO_authorized=False,
        downloads_authorized=False,holdout_reads_authorized=False,publication_authorized=False)
    if type(go) is not dict or any(type(go.get(k)) is not type(v) or canonical(go[k])!=canonical(v) for k,v in required.items()):
        raise ValueError('EXACT_FRESH_CONTINUOUS_SOURCE_ONLY_ROOT_AUTHORITY_REQUIRED')
    expected=dict(schema='INDEPENDENT_CONTINUOUS_SOURCE_CODE_REVIEW_V1',status='PASS_SOURCE_CODE_GENERATED_ONLY_NO_ACTUAL_ADMISSION',
        code_manifest_SHA256=code,source_catalog_SHA256=catalog_sha,historical_execution_authorized=False,
        account_construction_authorized=False,source_body_reads=0)
    if type(review) is not dict or any(type(review.get(k)) is not type(v) or canonical(review[k])!=canonical(v) for k,v in expected.items()):
        raise ValueError('EXACT_INDEPENDENT_CONTINUOUS_SOURCE_CODE_REVIEW_REQUIRED')
    if set(cat['core_saved_target_lineage'])!={str(y) for y in YEARS}:raise ValueError('ALL_FIVE_CORE_ANNUAL_TARGET_LINEAGES_REQUIRED')
    return dict(code=code,catalog=catalog_sha,go=go_sha,review=review_sha)

@dataclass(frozen=True,slots=True)
class SourceOnlyScope:
    authority:object=field(repr=False)
    _guard:object=field(repr=False)
    _token:object=field(repr=False)
    _seal:object=field(repr=False)
    def __post_init__(self):
        if self._seal is not _SEAL:raise ValueError('ENTRY_OWNED_CONTINUOUS_SOURCE_SCOPE_REQUIRED')
    def validate_current(self,*,year=None):
        require_scope(self)
        if year is not None:year_record(year)
        return True
    def source_root(self,year):
        require_scope(self);return ROOT/backend.c.relative(year_record(year)['contract']['source_root'])
    def read_source(self,year,name,expected_sha256,expected_bytes=None):
        return read_body(self,year,name,expected_sha256,expected_bytes)
    def qualification_for(self,year):
        require_scope(self);return SimpleNamespace(source_identity=year_record(year)['source_identity'])

def require_scope(scope):
    guard=current_guard()
    if (type(scope) is not SourceOnlyScope or scope._seal is not _SEAL or _LIVE.get(scope._token) is not scope
            or type(guard) is not ContinuousSourceGuard or not guard.active or guard is not scope._guard):raise ValueError('LIVE_EXACT_GUARDED_CONTINUOUS_SOURCE_SCOPE_REQUIRED')
    guard.checkpoint('SOURCE_SCOPE_CHECK');return scope

def body_allowlist():
    cat=catalog();out={}
    def add(name,pin):
        backend.c.relative(name)
        if name in out and out[name]!=pin:raise ValueError('CONFLICTING_BODY_PIN_DECLARATIONS')
        out[name]=dict(pin)
    for y in YEARS:
        rec=cat['years'][str(y)]
        for name,pin in rec['contract']['read_files'].items():add(name,pin)
        for pin in rec['saved'].values():add(pin['path'],{k:pin[k] for k in ('SHA256','bytes')})
        for pin in cat['core_saved_target_lineage'].get(str(y),{}).get('artifacts',{}).values():add(pin['path'],{k:pin[k] for k in ('SHA256','bytes')})
    return out

def read_body(scope,year,name,expected_sha256,expected_bytes=None):
    require_scope(scope);year_record(year);name=backend.c.relative(name);pin=body_allowlist().get(name)
    if pin is None or pin['SHA256']!=expected_sha256 or expected_bytes is not None and pin['bytes']!=expected_bytes:
        raise ValueError('EXACT_CONTINUOUS_SOURCE_BODY_ALLOWLIST_REQUIRED')
    return backend.c.exact(ROOT/name,expected_sha256,pin['bytes'])

@contextmanager
def admit_source(go_raw,go_sha,review_raw,review_sha):
    authority=validate_authority(go_raw,go_sha,review_raw,review_sha)
    if type(current_guard()) is not ContinuousSourceGuard or not current_guard().active:raise ValueError('EXACT_WHOLE_INVOCATION_CONTINUOUS_SOURCE_GUARD_REQUIRED')
    token=object();scope=SourceOnlyScope(backend.c.immutable(authority),current_guard(),token,_SEAL);_LIVE[token]=scope
    try:
        require_scope(scope);current_guard().enable_body_reads(scope);yield scope
    finally:
        try:scope._guard.disable_body_reads()
        finally:_LIVE.pop(token,None)


def read_paths():
    m=json.loads((HERE/'CODE_MANIFEST.json').read_bytes())
    return [HERE/'CODE_MANIFEST.json',*[HERE/n for n in m['files']],*[ROOT/n for n in m['dependencies']],
        ]


def historical_finance(*args,**kwargs):raise PermissionError('SOURCE_STAGE_CANNOT_ADMIT_HISTORICAL_FINANCE_ACCOUNTS_PROVIDERS_CLAIMS_OR_GO')

def design_record(year):
    path=ROOT/'fixed_strategy_90_saved_comparison_20261015_v1/CONTINUOUS_WALLET_SOURCE_PINS.json'
    for rec in json.loads(path.read_bytes())['annual_source_contracts']:
        if rec['year']==year:return rec
    raise ValueError('EXACT_DECLARED_DESIGN_YEAR_REQUIRED')


class ContinuousSourceGuard(FrozenSourceOnlyGuard):
    def __init__(self,*,write_roots=()):
        # Before root authority is bound, even direct Path/os.open body reads
        # are denied. Only the exact sealed source scope can enable bodies.
        self._metadata_paths=frozenset(Path(p).absolute() for p in read_paths())
        self._body_scope=None
        super().__init__(read_paths=self._metadata_paths,write_roots=write_roots)
    def _check_read(self,path):
        # The inherited guard scoped its pathname boundary to its original
        # workspace. This new invocation has no reason to read shared/home/OS
        # data outside the exact code/metadata/body/output allowlist either.
        if not isinstance(path,int):
            if not isinstance(path,(str,bytes,os.PathLike)):
                self.deny('nonallowlisted_file_reads','UNKNOWN_PATH_TYPE')
            p=Path(os.path.abspath(os.fsdecode(path)))
            output=any(p==root or root in p.parents for root in self.write_roots)
            if p not in self.read_paths and not output:self.deny('nonallowlisted_file_reads',p)
        return super()._check_read(path)

    def enable_body_reads(self,scope):
        if type(self) is not ContinuousSourceGuard or not self.active or self._body_scope is not None:
            raise ValueError('ONE_ACTIVE_ROOT_BOUND_SOURCE_BODY_PHASE_REQUIRED')
        require_scope(scope);self._body_scope=scope
        self.read_paths=self._metadata_paths|frozenset((ROOT/n).absolute() for n in body_allowlist())
        self.checkpoint('ROOT_BOUND_SOURCE_BODY_READ_PHASE_ENABLED')
    def disable_body_reads(self):
        self.read_paths=self._metadata_paths;self._body_scope=None
        self.checkpoint('SOURCE_BODY_READ_PHASE_REVOKED')
