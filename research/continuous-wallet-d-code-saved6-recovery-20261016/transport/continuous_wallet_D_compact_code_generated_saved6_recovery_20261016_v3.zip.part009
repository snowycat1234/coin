    try:return _CLASSIFY(audit,result,calendar=calendar,completed_minutes=completed_minutes,stop_us=stop_us)
    except ValueError as error:
        if str(error)=='UNSETTLED_OR_RESIDUAL_CASE_PAUSES_FINITE_QUEUE':return 'FULL_CALENDAR_RESIDUAL_OR_UNSETTLED_UNPAID'
        raise


def bounded_chunk(raw,rows):
    """Validate the allocation header before any np.load/member allocation."""
    import numpy as np
    if type(rows) is not int or not 1<=rows<=1440 or len(raw)>1440*36*8+2048:raise ValueError('BOUNDED_DAILY_CHUNK_BYTES_REQUIRED')
    with zipfile.ZipFile(BytesIO(raw)) as archive:
        members=archive.infolist()
        if (len(members)!=1 or members[0].filename!='values.npy' or members[0].flag_bits&1
                or members[0].is_dir() or stat.S_ISLNK(members[0].external_attr>>16)
                or members[0].file_size>rows*36*8+256):raise ValueError('EXACT_BOUNDED_DAILY_NPZ_MEMBER_REQUIRED')
        with archive.open(members[0]) as stream:
            ver=np.lib.format.read_magic(stream)
            if ver not in ((1,0),(2,0)):raise ValueError('SUPPORTED_NUMPY_CHUNK_HEADER_REQUIRED')
            read=np.lib.format.read_array_header_1_0 if ver==(1,0) else np.lib.format.read_array_header_2_0
            shape,fortran,dtype=read(stream)
            if shape!=(rows,36) or fortran or dtype!=np.dtype('<f8'):raise ValueError('EXACT_DAILY_FLOAT64_SHAPE_BEFORE_ALLOCATION_REQUIRED')
            if members[0].file_size-stream.tell()!=rows*36*8:raise ValueError('EXACT_DAILY_CHUNK_PAYLOAD_LENGTH_REQUIRED')
    return True


