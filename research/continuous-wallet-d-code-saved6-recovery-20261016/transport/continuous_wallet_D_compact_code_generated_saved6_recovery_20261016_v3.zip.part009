        self._bound_tier_name=actual_tier
        self._source_quality_cells=historical_scope.quality_cells
        self._continuous_constructions=1

    def contract_metadata(self):
        result = super().contract_metadata()
        result.update(integration_version=VERSION, continuation_policy=VERSION,
            annual_wallet_fresh_genesis=False, annual_wallets_compounded=False,
            one_initial_10000_wallet=True, continuous_wallet=True,
            full_year_DEV=False, partial2021_not_annualized=True,
            generated_only=False, historical_execution_admitted=True,
            global_terminal_only=True, snapshot_recovery_certified=False)
        return result

    def snapshot(self):
        result = super().snapshot()
        result.update(continuation_policy=VERSION, continuous_wallet=True,
            annual_wallet_fresh_genesis=False, annual_wallets_compounded=False,
            one_initial_10000_wallet=True, full_year_DEV=False,
            partial2021_not_annualized=True, generated_only=False,
            historical_execution_admitted=True, global_terminal_only=True)
