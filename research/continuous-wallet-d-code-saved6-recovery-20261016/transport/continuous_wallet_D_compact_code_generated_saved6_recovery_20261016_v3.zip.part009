def price(clocks):
    x=(np.asarray(clocks)-p.HISTORICAL_START)/p.DAY
    return np.column_stack([100+20*j+.02*(j+1)*x+3*np.sin(x/(11+j)+j) for j in range(5)]).astype('<f8')

