        return True

def require_capture(scope):
    if (type(scope) is not CaptureScope or scope.seal is not _SEAL or _CAPTURES.get(scope.token) is not scope
            or current_guard() is not scope.guard or type(scope.guard) is not RecaptureGuard or not scope.guard.active):
        raise ValueError('LIVE_EXACT_FINANCE_BOUND_RECAPTURE_SCOPE_REQUIRED')
    a.require_binding(scope.binding);scope.guard.checkpoint('EXACT_FINANCE_BOUND_SOURCE_RECAPTURE');return scope

def read_body(scope,year,name,expected_sha256,expected_bytes=None):
    require_capture(scope);source_metadata.year_record(year);pin=source_metadata.body_allowlist().get(b.c.relative(name))
    if pin is None or pin['SHA256']!=expected_sha256 or expected_bytes is not None and pin['bytes']!=expected_bytes:
        raise ValueError('EXACT_EXISTING_SOURCE_CONTRACT_RECAPTURE_PATH_REQUIRED')
    return b.c.exact(a.ROOT/name,expected_sha256,pin['bytes'])

def capture_year(scope,year):
    # Same byte reads and unchanged pure annual parsers as the source stage.
    # Only the exact scope predicate belongs to this consumed financial binding.
    require_capture(scope);contract=source_metadata.year_record(year)['contract']
    def read(name):
        pin=contract['read_files'][name];return read_body(scope,year,name,pin['SHA256'],pin['bytes'])
    sidecar=read(contract['quality_sidecar_path']);transport=None
    if year==2022:
        def predicate(value,root):
            require_capture(value)
            if Path(root).resolve()!=b.bridge.SOURCE_ROOT:raise ValueError('EXACT_2022_NORMALIZER_SOURCE_ROOT_REQUIRED')
            return Path(root).resolve()
        fn=b.bridge.capture_2022
        normalize=FunctionType(fn.__code__,dict(fn.__globals__,_require_source_scope=predicate),fn.__name__,fn.__defaults__,fn.__closure__)
        transport,captured=normalize(scope.source_root(year),source_scope=scope)
        warm=captured['DAILY_PROJECTION.npz'];events=captured['RAW_EVENTS.json'];daily=None
        months=tuple((r['path'],captured[r['path']]) for r in contract['months'])
    else:
        warm=read(contract['warmup_path']);daily=read(contract['daily_path']) if contract['daily_path'] is not None else None
        events=read(contract['events_path']);months=tuple((r['path'],read(r['path'])) for r in contract['months'])
    qualification=read(contract['qualification']['path']) if year==2021 else None
    if year==2023:result=b.FIRST2023.assemble_inputs(year,warm,daily,events,sidecar,months,contract)
    else:result=b.ANNUAL.assemble_inputs(year,warm,daily,events,sidecar,months,contract,qualification)
    if transport is not None:result['normalization_equivalence']=transport['normalization_equivalence']
    rec=contract['months'][-1];arrays,_=b.codec.month_arrays(year,months[-1][1],rec['start'],rec['count'],result['quality_cells']);off=rec['hi']-1
    endpoint=b.codec.frozen_array(np.asarray([arrays[s+'_close'][off] for s in a.SYMBOLS]))
    result['native_endpoint_witness']=dict(minute_open_us=int(arrays['times'][off]),completed_us=int(arrays['times'][off])+a.MINUTE,
        source_file=rec['path'],source_file_SHA256=rec['hash'],source_float64_bits_SHA256=b.c.sha(endpoint.tobytes()),
        genuine_native_trade_close=True,end_boundary_witness_not_2026_execution_authority=True)
    return result

@dataclass(frozen=True,slots=True)
class LoadedInputs:
    binding:object=field(repr=False);values:object=field(repr=False);token:object=field(repr=False);seal:object=field(repr=False)
