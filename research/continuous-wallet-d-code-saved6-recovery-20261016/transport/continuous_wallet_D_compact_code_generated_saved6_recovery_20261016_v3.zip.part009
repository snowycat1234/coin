historical source, real claim, root GO or actual pilot evidence is accessed.
"""
from contextlib import contextmanager
import json
import os
from pathlib import Path
import resource
import subprocess
import sys
import tempfile
from types import SimpleNamespace, ModuleType
import unittest
from unittest.mock import patch

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))
import run_continuous as r
import continuous_admission as a

TEST_CPU = 7
PAID = 'FULL_CALENDAR_ACTUAL_PAID_MARKET_FLAT'
CONDITIONAL = 'FULL_CALENDAR_CONDITIONAL_SETTLED_FLAT'


class RemainingQueueGeneratedTests(unittest.TestCase):
    @classmethod
    def setUpClass(cls):
        cls.original_affinity = os.sched_getaffinity(0)
        if TEST_CPU not in cls.original_affinity:
            raise unittest.SkipTest('Explicit generated-only CPU7 is unavailable')
        for task in Path('/proc/self/task').iterdir():
            os.sched_setaffinity(int(task.name), {TEST_CPU})

    @classmethod
    def tearDownClass(cls):
        for task in Path('/proc/self/task').iterdir():
            try:
                os.sched_setaffinity(int(task.name), cls.original_affinity)
            except ProcessLookupError:
                pass

    def setUp(self):
        self.temp = tempfile.TemporaryDirectory(prefix='invented_remaining_five_')
        self.root = Path(self.temp.name)
        self.module = self.root / 'invented_module'
        self.module.mkdir()
        self.claims = self.root / 'invented_claims'
        self.claims.mkdir()
        self.pilot_claim = self.claims / (a.CELLS[0] + '.json')
        self.pilot_claim.write_bytes(b'{"invented_previously_completed_pilot":true}\n')
        self.pilot_original = self.pilot_claim.read_bytes()
        self.pilot_baseline = 12345  # Invented immutable cohort byte observation.
        self.shared = self.root / 'invented_shared.lock'
        self.shared.touch()
        self.output = self.module / 'financial_attempts' / 'invented_queue'
        self.go = dict(CPU=TEST_CPU, controller_output=str(self.output),
                       code_manifest_SHA256='invented code', prepared_source={'invented': 'source'},
                       prepared_source_audit={'invented': 'audit'})
        self.prep = dict(source_identity='invented source', array_identities={'invented': 'arrays'},
                         artifacts={'SOURCE_QUALITY.json': {'SHA256': 'invented quality'}})
        self.args = SimpleNamespace(output=str(self.output), cpu=TEST_CPU,
                                    go=str(self.root/'invented_GO'), go_sha='invented go',
                                    review=str(self.root/'invented_REVIEW'), review_sha='invented review')
        limits = dict(a.LIMITS, CPU_seconds=3, wall_seconds=5, RSS_bytes=500_000_000,
                      case_output_bytes=100_000, cohort_output_bytes=5_000_000,
                      free_disk_floor_bytes=0)
        self.launched = []
        self.validated = []
        self.resource_checks = []
        self.baselines = []
        self.statuses = {}
        self.fake_code = "print('invented generated worker',flush=True)"
        self.real_supervise = r.supervise
        self.real_cohort_bytes = a.cohort_bytes
        self.real_validation_envelope = r.validation_envelope
        self.real_controller_cpu_limit = r.controller_case_cpu_limit
        terminal = ModuleType('continuous_terminal')
        terminal.validate_saved_terminal = self.fake_validate
        self.patches = [
            patch.object(r, 'HERE', self.module), patch.object(r, 'admission', return_value=a),
            patch.object(a, 'CLAIMS', self.claims), patch.object(a, 'SHARED_LEASE', self.shared),
            patch.object(a, 'LIMITS', limits),
            patch.object(a, 'cohort_bytes', side_effect=self.cohort_bytes),
            patch.object(a, 'pilot_output_bytes', return_value=self.pilot_baseline),
            patch.object(r, 'read_wires', return_value=(b'{}', b'{}', self.go, self.prep)),
            patch.object(r, 'require_launch_resources', side_effect=self.fake_resources),
            patch.object(r, 'controller_case_cpu_limit', side_effect=lambda baseline, worker_cpu=0.: self.baselines.append(baseline)),
            patch.object(r, 'validation_envelope', side_effect=self.fake_validation_envelope),
            patch.object(r, 'supervise', side_effect=self.fake_supervise),
            patch.object(r, 'POLL_SECONDS', .01), patch.object(r, 'HEARTBEAT_SECONDS', .03),
            patch.dict(sys.modules, {'continuous_terminal': terminal}),
        ]
        for item in self.patches:
            item.start()

    def tearDown(self):
        for item in reversed(self.patches):
            item.stop()
        self.temp.cleanup()

    def cohort_bytes(self, current):
        return self.pilot_baseline + r.own_bytes(current) + r.own_bytes(self.claims)

    def fake_resources(self, cpu):
        self.assertEqual(cpu, TEST_CPU)
        # This snapshot is taken before the next irreversible claim.
        self.resource_checks.append(list(self.launched))
        return {'invented_resources': True, 'before_launched_count': len(self.launched)}

    def fake_supervise(self, command, directory, **kwargs):
        self.assertEqual(Path(command[2]), self.module/'run_continuous.py')
        self.assertIn('--bootstrap', command)
        self.assertEqual(tuple(kwargs['lease_fds']).__len__(), 2)
        cell = directory.name
        self.assertIn(cell, a.RELEASED_CELLS)
        self.assertNotEqual(cell, a.CELLS[0])
        self.assertTrue((self.claims/(cell+'.json')).exists())
        claim = json.loads((directory/'LAUNCH_CLAIM.json').read_bytes())
        self.assertEqual(claim['cell_id'], cell)
        self.assertTrue(claim['pilot_never_rerun'])
        self.assertEqual(claim['released_queue_index'], a.RELEASED_CELLS.index(cell))
        self.assertEqual(claim['released_cells'], list(a.RELEASED_CELLS))
        self.launched.append(cell)
        result = self.real_supervise([sys.executable, '-B', '-c', self.fake_code], directory, **kwargs)
        (directory/'WORKER_COMPLETE_NOT_TERMINAL.json').write_bytes(b'{"invented_candidate":true}\n')
        return result

    @contextmanager
    def fake_validation_envelope(self, cpu, worker_exit):
        self.assertEqual(cpu, TEST_CPU)
        self.assertIn('case_controller_CPU_baseline', worker_exit)
        report = {'invented_validation_resources': True}
        yield report
        report['all_observed_resources_within_envelope'] = True

    def fake_validate(self, directory, *, expected):
        self.assertEqual(expected['cell_id'], directory.name)
        self.assertTrue((self.output/(directory.name+'.OWNED_SHELL_EXIT.json')).exists())
        self.assertFalse((directory/'OWNED_SHELL_EXIT.json').exists())
        self.validated.append(directory.name)
        return dict(status=self.statuses.get(directory.name, PAID), cell_id=directory.name,
                    invented_terminal_only=True)

    def test_exact_fixed_five_order_excludes_pilot_and_counts_prior_once(self):
        self.statuses[a.RELEASED_CELLS[2]] = CONDITIONAL
        result = r.controller(self.args)
        self.assertEqual(self.launched, list(a.CELLS[1:]))
        self.assertEqual(self.validated, list(a.CELLS[1:]))
        self.assertEqual(result['total_cohort_accounts_counted_once'], 6)
        self.assertEqual(result['financial_accounts_constructed'], 5)
        self.assertEqual(self.pilot_claim.read_bytes(), self.pilot_original)
        self.assertFalse((self.output/a.CELLS[0]).exists())
        self.assertEqual(len(self.baselines), 5)
        self.assertEqual(self.baselines, sorted(self.baselines))
        self.assertEqual(self.resource_checks, [[], []] + [list(a.RELEASED_CELLS[:i]) for i in range(1, 5)])
        for cell in a.RELEASED_CELLS:
            terminal = json.loads((self.output/cell/'TERMINAL_CHECKPOINT.json').read_bytes())
            self.assertTrue(terminal['saved_validation']['saved_validation_resources']['all_observed_resources_within_envelope'])

    def test_honest_economic_halt_records_terminal_and_never_claims_next(self):
        cell = a.RELEASED_CELLS[1]
        self.statuses[cell] = 'NATIVE_HALT_PARTIAL_CALENDAR'
        with self.assertRaisesRegex(RuntimeError, 'ECONOMIC_HALT_OR_UNSETTLED'):
            r.controller(self.args)
        self.assertEqual(self.launched, list(a.RELEASED_CELLS[:2]))
        self.assertTrue((self.output/cell/'TERMINAL_CHECKPOINT.json').exists())
        self.assertFalse((self.claims/(a.RELEASED_CELLS[2]+'.json')).exists())
        self.assertTrue((self.output/'CONTROLLER_PAUSE.json').exists())

    def test_unsettled_full_calendar_never_launches_following_cell(self):
        self.statuses[a.RELEASED_CELLS[0]] = 'FULL_CALENDAR_RESIDUAL_OR_UNSETTLED_UNPAID'
        with self.assertRaisesRegex(RuntimeError, 'ECONOMIC_HALT_OR_UNSETTLED'):
            r.controller(self.args)
        self.assertEqual(self.launched, [a.RELEASED_CELLS[0]])
        self.assertFalse((self.claims/(a.RELEASED_CELLS[1]+'.json')).exists())

    def test_real_fake_worker_output_cap_stops_without_next_claim(self):
        a.LIMITS['case_output_bytes'] = 5000
        self.fake_code = "import time;print('x'*100000,flush=True);time.sleep(10)"
        with self.assertRaisesRegex(RuntimeError, 'STDOUT_CAP_STOP'):
            r.controller(self.args)
        self.assertEqual(self.launched, [a.RELEASED_CELLS[0]])
        self.assertFalse((self.claims/(a.RELEASED_CELLS[1]+'.json')).exists())
        self.assertEqual(self.pilot_claim.read_bytes(), self.pilot_original)

    def test_resource_drop_is_observed_before_each_next_claim(self):
        def resources(cpu):
            if self.launched:
                raise RuntimeError('INVENTED_MEMORY_BELOW_5500000000')
            return self.fake_resources(cpu)
        with patch.object(r, 'require_launch_resources', side_effect=resources):
            with self.assertRaisesRegex(RuntimeError, 'MEMORY_BELOW'):
                r.controller(self.args)
        self.assertEqual(self.launched, [a.RELEASED_CELLS[0]])
        self.assertFalse((self.claims/(a.RELEASED_CELLS[1]+'.json')).exists())

    def test_nonzero_exit_claim_is_permanent_and_new_output_cannot_resume(self):
        self.fake_code = 'raise SystemExit(3)'
        with self.assertRaisesRegex(RuntimeError, 'NONZERO_SHELL_EXIT'):
            r.controller(self.args)
        cell = a.RELEASED_CELLS[0]
        original = (self.claims/(cell+'.json')).read_bytes()
        fresh = self.output.with_name('invented_forbidden_resume')
        self.args.output = str(fresh)
        self.go['controller_output'] = str(fresh)
        with self.assertRaisesRegex(RuntimeError, 'NO_DUPLICATE_LAUNCH'):
            r.controller(self.args)
        self.assertEqual((self.claims/(cell+'.json')).read_bytes(), original)
        self.assertFalse(fresh.exists())
        self.assertEqual(self.launched, [cell])

    def test_generated_reserved_claim_passes_real_worker_admission(self):
        self.output.parent.mkdir()
        self.output.mkdir()
        case = self.output/a.RELEASED_CELLS[0]
        controller_pid = os.getpid()
        with r.controller_leases() as fds:
            raw = r.reserve_claim(self.go, self.prep, self.args, case)
            with patch.object(a, 'validate_wire', return_value=(self.go, self.prep)), \
                    patch.object(a, 'ROOT', self.root), \
                    patch.object(a.os, 'getppid', return_value=controller_pid):
                with a.admit_worker(b'{}', self.args.go_sha, b'{}', self.args.review_sha,
                                    claim_raw=raw, claim_sha=r.sha(raw), lease_fds=fds) as binding:
                    self.assertEqual(binding.cell_id, a.RELEASED_CELLS[0])
                    self.assertIs(a.require_binding(binding), binding)
                self.assertFalse(a._BINDINGS)
        with self.assertRaisesRegex(ValueError, 'PILOT_SUCCESS_NEVER_RERUN'):
            r.reserve_claim(self.go, self.prep, self.args, self.output/a.CELLS[0])
        self.assertEqual(self.pilot_claim.read_bytes(), self.pilot_original)

    def test_global_guard_counts_invented_pilot_registry_and_temporary_bytes(self):
        self.output.parent.mkdir()
        self.output.mkdir()
        (self.output/'invented_existing.tmp').write_bytes(b'1234567')
        current = self.cohort_bytes(self.output)
        a.LIMITS['cohort_output_bytes'] = current + 2
        with self.assertRaisesRegex(RuntimeError, 'COHORT_OUTPUT_CAP_STOP_BEFORE_WRITE'):
            r.atomic(self.output/'must_not_exist', b'123', cohort=self.output)
        self.assertFalse((self.output/'must_not_exist').exists())

    def test_all_case_writes_include_existing_log_bytes(self):
        self.output.parent.mkdir()
        self.output.mkdir()
        case = self.output/a.RELEASED_CELLS[0]
        case.mkdir()
        (self.output/(case.name+'.stdout.log')).write_bytes(b'x'*30)
        a.LIMITS['case_output_bytes'] = 32
        with self.assertRaisesRegex(RuntimeError, 'CASE_OUTPUT_CAP_STOP_BEFORE_WRITE'):
            r.atomic(case/'invented', b'123', cohort=self.output, case=case)

    def test_supervisor_charges_case_delta_not_lifetime_cpu(self):
        self.output.parent.mkdir()
        self.output.mkdir()
        case = self.output/a.RELEASED_CELLS[0]
        case.mkdir()
        with r.controller_leases() as fds, patch.object(r.time, 'process_time', return_value=5000.):
            result = self.real_supervise([sys.executable, '-B', '-c', 'pass'], case,
                cohort=self.output, cpu=TEST_CPU, lease_fds=fds, claim_sha='invented',
                case_controller_cpu_baseline=5000.)
        self.assertEqual(result['actual_shell_exit_code'], 0)
        self.assertEqual(result['observed_case_controller_CPU_seconds'], 0.)

    def test_controller_soft_cpu_offsets_each_case_and_preserves_hard(self):
        # The production helper is exercised without changing real rlimits.
        with patch.object(r.resource, 'getrlimit', return_value=(resource.RLIM_INFINITY, resource.RLIM_INFINITY)), \
                patch.object(r.resource, 'setrlimit') as setter, \
                patch.object(r.time, 'process_time', return_value=5000.):
            self.real_controller_cpu_limit(5000.)
            self.assertEqual(setter.call_args.args, (resource.RLIMIT_CPU, (5003, resource.RLIM_INFINITY)))
            self.real_controller_cpu_limit(5005., .75)
            self.assertEqual(setter.call_args.args, (resource.RLIMIT_CPU, (5008, resource.RLIM_INFINITY)))

    def test_validation_envelope_uses_case_cpu_delta_and_finalizes_report(self):
        observed = dict(RSS_bytes=1, CPU_affinity=[TEST_CPU], tasks=[{'CPU_affinity': [TEST_CPU]}])
        worker_exit = dict(actual_worker_CPU_seconds=1., case_controller_CPU_baseline=5000., total_wall_seconds=.01,
                           case_started_monotonic=r.time.monotonic()-.01)
        with patch.object(r.resource, 'getrlimit', return_value=(resource.RLIM_INFINITY, resource.RLIM_INFINITY)), \
                patch.object(r.resource, 'setrlimit') as setter, \
                patch.object(r.time, 'process_time', return_value=5000.5), \
                patch.object(r, 'process_observation', return_value=observed), \
                patch.object(r, 'controller_case_cpu_limit', side_effect=self.real_controller_cpu_limit):
            with self.real_validation_envelope(TEST_CPU, worker_exit) as report:
                self.assertEqual(report['remaining_CPU_seconds_at_entry'], 1.5)
            self.assertEqual(report['combined_CPU_seconds'], 1.5)
            self.assertTrue(report['all_observed_resources_within_envelope'])
            cpu_calls = [c.args[1] for c in setter.call_args_list if c.args[0] == resource.RLIMIT_CPU]
            self.assertEqual(cpu_calls, [(5002, resource.RLIM_INFINITY), (resource.RLIM_INFINITY, resource.RLIM_INFINITY)])

    def test_bootstrap_primes_own_gate_from_exact_bound_worker_arguments(self):
        case = self.output/a.RELEASED_CELLS[0]
        claim = r.canonical(dict(cell_id=case.name, root_GO_SHA256=self.args.go_sha,
                                 independent_review_SHA256=self.args.review_sha))
        child = [str(r.PYTHON), '-B', str(self.module/'run_continuous.py'), '--case',
                 '--case-output', str(case), '--cpu', str(TEST_CPU), '--claim-sha', r.sha(claim),
                 '--go', self.args.go, '--go-sha', self.args.go_sha,
                 '--review', self.args.review, '--review-sha', self.args.review_sha]
        with patch.object(r, 'read_wires', return_value=(b'{}', b'{}', self.go, self.prep)) as wires:
            r.bootstrap_wire(child, case, TEST_CPU, claim)
            self.assertEqual(wires.call_count, 1)
            self.assertEqual(wires.call_args.args[0].go_sha, self.args.go_sha)
            self.assertEqual(wires.call_args.args[0].review_sha, self.args.review_sha)
            with self.assertRaisesRegex(ValueError, 'EXACT_PINNED'):
                r.bootstrap_wire(child + ['--output', 'invented'], case, TEST_CPU, claim)
            bad = list(child)
            bad[5] = str(self.output/a.CELLS[0])
            with self.assertRaisesRegex(ValueError, 'EXACT_PINNED'):
                r.bootstrap_wire(bad, case, TEST_CPU, claim)
            self.assertEqual(wires.call_count, 1)

    def test_real_bootstrap_primes_fresh_gate_before_its_first_budgeted_write(self):
        # The real bootstrap entry executes entirely on CPU7. OS affinity,
        # rlimits, parent identity and exec are explicit invented-only seams;
        # no task is ever placed on the live pilot's CPU4/5.
        self.output.parent.mkdir()
        self.output.mkdir()
        case = self.output/a.RELEASED_CELLS[0]
        case.mkdir()
        claim = r.canonical(dict(cell_id=case.name, CPU=4, case_output=str(case),
                                 root_GO_SHA256=self.args.go_sha, independent_review_SHA256=self.args.review_sha))
        (case/'LAUNCH_CLAIM.json').write_bytes(claim)
        observed = r.process_observation(os.getpid())
        parent = dict(PID=os.getppid(), process_start_ticks='invented parent ticks')
        owner = dict(cell_id=case.name, PID=os.getpid(), CPU=4,
                     process_start_ticks=observed['process_start_ticks'],
                     controller_PID=os.getppid(), controller_start_ticks=parent['process_start_ticks'],
                     claim_SHA256=r.sha(claim))
        (case/'PROCESS_OWNERSHIP.json').write_bytes(r.canonical(owner))
        child = [str(r.PYTHON), '-B', str(self.module/'run_continuous.py'), '--case',
                 '--case-output', str(case), '--cpu', '4', '--claim-sha', r.sha(claim),
                 '--go', self.args.go, '--go-sha', self.args.go_sha,
                 '--review', self.args.review, '--review-sha', self.args.review_sha]

        def generated_wire(args):
            self.assertIsNone(a._PILOT_BYTES)
            a._PILOT_BYTES = self.pilot_baseline
            return b'{}', b'{}', self.go, self.prep

        class GeneratedExecIntercept(Exception):
            pass

        with r.controller_leases() as fds, \
                patch.object(a, '_PILOT_BYTES', None), \
                patch.object(a, 'cohort_bytes', side_effect=self.real_cohort_bytes), \
                patch.object(r, 'read_wires', side_effect=generated_wire) as wires, \
                patch.object(r, 'install_parent_death_guard'), \
                patch.object(r, 'require_parent', return_value=parent), \
                patch.object(r, 'lease_fds_from_environment', return_value=fds), \
                patch.object(r.os, 'sched_getaffinity', return_value={4}), \
                patch.object(r.os, 'sched_setaffinity') as affinity, \
                patch.object(r.resource, 'setrlimit'), \
                patch.object(r.os, 'execve', side_effect=GeneratedExecIntercept) as execute, \
                patch.dict(os.environ):
            with self.assertRaises(GeneratedExecIntercept):
                r.bootstrap(4, str(case), child)
            self.assertEqual(wires.call_count, 1)
            self.assertEqual(execute.call_count, 1)
            affinity.assert_called_once_with(0, {4})  # Mock only; no CPU4 operation.
            receipt = json.loads((case/'BOOTSTRAP_READY.json').read_bytes())
            self.assertEqual(receipt['claim_SHA256'], r.sha(claim))
            self.assertEqual(receipt['PID'], os.getpid())

    def test_import_is_stdlib_only_and_starts_nothing(self):
        code = ("import runpy,sys,json;runpy.run_path(%r);"
                "print(json.dumps([n for n in sys.modules if n.split('.')[0] in "
                "('numpy','polars','native_adapter','continuous_inputs','legacy_process_runtime')]))") % str(HERE/'run_continuous.py')
        result = subprocess.run([sys.executable, '-B', '-c', code], capture_output=True, text=True, check=True)
        self.assertEqual(json.loads(result.stdout), [])


if __name__ == '__main__':
    unittest.main()
