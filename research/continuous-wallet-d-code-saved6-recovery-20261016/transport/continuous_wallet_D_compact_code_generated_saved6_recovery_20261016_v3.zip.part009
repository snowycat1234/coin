import copy,builtins,importlib
from decimal import Decimal,localcontext
from packet_common import *
from saved_native_reconciliation import reconcile_saved_native
import verify_packet

def run(root,archive,trusted):
 root=Path(root);tests=[]
 def reject(name,fn):
  try:fn()
  except (ValueError,KeyError,TypeError)as e:tests.append(dict(test=name,rejected=True,error=str(e)));return
  raise ValueError('NEGATIVE_ACCEPTED:'+name)
 scope=load(root/'ATTEMPT_SCOPE_AND_STATUS.json');manifest=load(root/'MANIFEST.json')
