import os
for k in ('OPENBLAS_NUM_THREADS','OMP_NUM_THREADS','MKL_NUM_THREADS','NUMEXPR_NUM_THREADS','POLARS_MAX_THREADS','VECLIB_MAXIMUM_THREADS','BLIS_NUM_THREADS'):os.environ[k]='1'
from hashlib import sha256
from io import BytesIO
import gzip
import json
from pathlib import Path
import sys
import time
import traceback
import numpy as np
