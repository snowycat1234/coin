HERE=Path(__file__).resolve().parent

def build_invented(root):
    import continuous_admission as a
    import continuous_output as out
    import continuous_terminal as terminal
    import test_native_adapter_generated as helper
    import numpy as np
    n=helper.n;s=helper.s
    sys.path.insert(0,str(a.ROOT/'bounded_native_continuation_guard50_exit_expansion_20261015'))
    from saved_native_reconciliation import reconcile_saved_native
    from decimal import Decimal,localcontext
    root=Path(root);case=root/a.CELLS[0]
    with helper.invented_case(days=4,tier='LOW') as (scope,provider,authority):
        start,end=scope.window['start'],scope.window['end']
        object.__setattr__(scope,'_binding',SimpleNamespace(go={'controller_output':str(root)}))
        with patch.object(a,'START',start),patch.object(a,'END',end),patch.object(a,'require_execution_scope',side_effect=authority.require_execution_scope):
            sim,guard=n.construct_case(scope.window,scope.rows,scope.decisions,scope.targets,historical_scope=scope)
            writer=out.make_writer(scope,case,start=start,end=end,cohort=root)
            while sim.cursor<sim.end and sim.stop is None:
                sim.advance_day();boundary=sim.cursor<sim.end and time.gmtime(sim.cursor/1e6).tm_mon==1 and time.gmtime(sim.cursor/1e6).tm_mday==1
                writer.append(sim.minute_chunks[-1],end_us=start+sim.rows_written*s.MINUTE,
                    state=out.original.annual_marker(sim) if boundary else out.original.observed_state(sim),boundary=boundary)
            result=n.case_result(sim,guard);minute=result.pop('minute');values=minute.to_numpy();result['targets']=result['targets'].to_dicts()
            audit=n.V2.OWNED.export_tree(sim.account.snapshot());result=n.V2.OWNED.export_tree(result)
            proof=reconcile_saved_native(audit,result,expected_continuation_version=a.VERSION)
            classification=terminal.classify_saved(audit,result,calendar=[start,end],completed_minutes=sim.rows_written,stop_us=sim.stop)
            out.validate_chunks(writer,values)
            subs=[];prior_at=start;prior=Decimal('10000')
            for at,text in [(m['boundary_us'],m['state']['NAV']) for m in writer.boundaries]+[(end,str(sim.account.nav()))]:
                nav=Decimal(text)
                with localcontext() as ctx:ctx.prec=40;change=str(nav/prior-1)
                subs.append(dict(calendar=[prior_at,at],start_NAV=str(prior),end_NAV=str(nav),marked_wallet_change_fraction=change,
                    phase=out.original.PHASE,carried_wallet=True,fresh_wallet_return=False,annualized=False,generated_only=False))
                prior_at=at;prior=nav
            bulky={'ACCOUNT_FINANCIAL_AUDIT.json.gz':audit,'NATIVE_RESULT.json.gz':result,'NATIVE40_RECONSTRUCTION_PROOF.json.gz':proof,
                'ACTUAL_HELD_RISK_REPORT.json.gz':{'test_only_invented':True},'GUARD_RECEIPTS.json.gz':n.V2.OWNED.export_tree(guard.receipts),
                'CAUSAL_MARK_QUALITY.json.gz':{'identity':guard.causal_mark_quality_guard.identity,'receipts':n.V2.OWNED.export_tree(guard.causal_mark_quality_guard.receipts)},
                'ANNUAL_MARKED_SUBPERIODS.json.gz':subs,'ANNUAL_BOUNDARIES.json.gz':writer.boundaries,
                'LEGACY_PRIMARY_FINANCIAL_RECONCILIATION.json.gz':result['primary_financial_reconciliation']}
            pins={name:writer.budget.gzip(case/name,value) for name,value in bulky.items()};writer.budget.save(case/'COMPRESSED_JSON_PINS.json',pins)
            pid=os.getpid();parent=os.getppid();ticks=Path('/proc/self/stat').read_text().rsplit(') ',1)[1].split()[19]
            claim={'cell_id':a.CELLS[0],'CPU':5,'controller_PID':parent,'test_only_invented':True};writer.budget.save(case/'LAUNCH_CLAIM.json',claim)
            claim_sha=sha256((case/'LAUNCH_CLAIM.json').read_bytes()).hexdigest()
            writer.budget.save(case/'BOOTSTRAP_READY.json',dict(PID=pid,CPU=5,test_only_invented=True))
            writer.budget.save(case/'PROCESS_OWNERSHIP.json',dict(PID=pid,process_start_ticks=ticks,test_only_invented=True))
            from legacy_source_guard import SourceOnlyGuard
            writer.budget.save(case/'SOURCE_RECAPTURE_GUARD_RECEIPT.json',dict(schema='OBSERVED_LEGACY_INTRINSIC_SOURCE_GUARD_V1',status='PASS_FINANCIAL_SOURCE_RECAPTURE_ONLY_NO_ACCOUNT',
                guard_active=False,error=None,forbidden_attempts=dict.fromkeys(SourceOnlyGuard.CATEGORIES,0),attempted_targets=[],source_scopes_revoked=True,saved_targets_and_covariance_rebuilt=False,
                test_only_invented_capture_seam=True))
            receipt=dict(cell_id=a.CELLS[0],root_GO_SHA256='a'*64,code_manifest_SHA256='b'*64,source_identity=scope.source_identity,
                claim_SHA256=claim_sha,CPU=5,worker_PID=pid,worker_start_ticks=ticks,controller_PID=parent,calendar=[start,end],limits=a.LIMITS,
                completed_minutes=sim.rows_written,account_stop_us=sim.stop,status=classification,terminal_signal_us=sim.terminal_signal_us)
            writer.budget.save(case/'CASE_RECEIPT.json',receipt)
            expected={k:receipt[k] for k in ('cell_id','root_GO_SHA256','code_manifest_SHA256','source_identity','claim_SHA256','CPU','worker_PID','worker_start_ticks','controller_PID')}
            expected.update(actual_shell_exit_code=0,quality_sidecar_SHA256='a'*64,quality_cell_count=len(scope.quality_cells),
                later_interval_anchor=scope.later_interval_witnesses[0]['original_genuine_observation_us'])
    # The invented authority/source is revoked before the candidate publication.
    files={p.name:dict(SHA256=sha256(p.read_bytes()).hexdigest(),bytes=p.stat().st_size) for p in case.iterdir() if p.is_file()}
    writer.budget.save(case/'WORKER_COMPLETE_NOT_TERMINAL.json',dict(schema='CONTINUOUS_WORKER_CANDIDATE_V1',cell_id=a.CELLS[0],files=files,
        classification=classification,native40_proof_passed=True,execution_scopes_revoked=True,inputs_revoked=True,worker_binding_revoked=True,financial_terminal_admitted=False))
    (root/'INVENTED_EXPECTATIONS.json').write_text(json.dumps(dict(expected=expected,calendar=[start,end],test_only_invented=True)))

class TerminalGeneratedTests(unittest.TestCase):
    def test_owned_native_exit_and_real_saved_gate(self):
        with tempfile.TemporaryDirectory(prefix='CONTINUOUS_INVENTED_TERMINAL_',dir=HERE) as root:
            cmd=[str(HERE.parent/'coin_partial_restore_20261014/.venv/bin/python'),'-B',str(Path(__file__)),'--build-invented-candidate',root]
            process=subprocess.Popen(cmd,stdout=subprocess.PIPE,stderr=subprocess.PIPE,text=True)
            stdout,stderr=process.communicate(timeout=60)
            self.assertEqual(process.returncode,0,msg=stdout+stderr)
            import continuous_admission as a
            import continuous_terminal as terminal
            wire=json.loads((Path(root)/'INVENTED_EXPECTATIONS.json').read_bytes());expected=wire['expected'];expected['actual_shell_exit_code']=process.returncode
            with patch.object(a,'START',wire['calendar'][0]),patch.object(a,'END',wire['calendar'][1]):
                proof=terminal.validate_saved_terminal(Path(root)/a.CELLS[0],expected=expected)
                self.assertTrue(proof['native40_reconstructed']);self.assertEqual(proof['completed_minutes'],5760)
                for key,value in [('actual_shell_exit_code',1),('source_identity','0'*64),('worker_start_ticks','0'),('quality_sidecar_SHA256','0'*64)]:
                    bad=dict(expected,**{key:value})
                    with self.assertRaises(ValueError):terminal.validate_saved_terminal(Path(root)/a.CELLS[0],expected=bad)
                chunk=next((Path(root)/a.CELLS[0]).glob('MINUTE_*.npz'));raw=chunk.read_bytes();chunk.write_bytes(raw[:-1]+bytes([raw[-1]^1]))
                with self.assertRaises(ValueError):terminal.validate_saved_terminal(Path(root)/a.CELLS[0],expected=expected)
    def test_preallocation_npz_header_rejected(self):
        import continuous_terminal as terminal
        import numpy as np
        from io import BytesIO
        for shape,dtype in [((1441,36),'<f8'),((2,35),'<f8'),((2,36),'<f4')]:
            buf=BytesIO();np.savez_compressed(buf,values=np.zeros(shape,dtype=dtype))
            with self.assertRaises(ValueError):terminal.bounded_chunk(buf.getvalue(),2)

if __name__=='__main__':
    if len(sys.argv)==3 and sys.argv[1]=='--build-invented-candidate':build_invented(sys.argv[2])
    else:unittest.main(verbosity=2)
