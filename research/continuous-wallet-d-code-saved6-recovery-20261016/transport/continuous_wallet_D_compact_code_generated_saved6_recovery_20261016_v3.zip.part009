        start,end=scope.window['start'],scope.window['end']
        object.__setattr__(scope,'_binding',SimpleNamespace(go={'controller_output':str(root)}))
        with patch.object(a,'START',start),patch.object(a,'END',end),patch.object(a,'require_execution_scope',side_effect=authority.require_execution_scope),patch.object(a,'_PILOT_BYTES',0),patch.object(a,'CLAIMS',root/'INVENTED_EMPTY_CLAIMS'):
            sim,guard=n.construct_case(scope.window,scope.rows,scope.decisions,scope.targets,historical_scope=scope)
            writer=out.make_writer(scope,case,start=start,end=end,cohort=root)
            while sim.cursor<sim.end and sim.stop is None:
                sim.advance_day();boundary=sim.cursor<sim.end and time.gmtime(sim.cursor/1e6).tm_mon==1 and time.gmtime(sim.cursor/1e6).tm_mday==1
                writer.append(sim.minute_chunks[-1],end_us=start+sim.rows_written*s.MINUTE,
                    state=out.original.annual_marker(sim) if boundary else out.original.observed_state(sim),boundary=boundary)
            result=n.case_result(sim,guard);minute=result.pop('minute');values=minute.to_numpy();result['targets']=result['targets'].to_dicts()
            audit=n.V2.OWNED.export_tree(sim.account.snapshot());result=n.V2.OWNED.export_tree(result)
            proof=reconcile_saved_native(audit,result,expected_continuation_version=a.VERSION)
            classification=terminal.classify_saved(audit,result,calendar=[start,end],completed_minutes=sim.rows_written,stop_us=sim.stop)
            out.validate_chunks(writer,values)
            subs=[];prior_at=start;prior=Decimal('10000')
            for at,text in [(m['boundary_us'],m['state']['NAV']) for m in writer.boundaries]+[(end,str(sim.account.nav()))]:
                nav=Decimal(text)
                with localcontext() as ctx:ctx.prec=40;change=str(nav/prior-1)
                subs.append(dict(calendar=[prior_at,at],start_NAV=str(prior),end_NAV=str(nav),marked_wallet_change_fraction=change,
                    phase=out.original.PHASE,carried_wallet=True,fresh_wallet_return=False,annualized=False,generated_only=False))
                prior_at=at;prior=nav
