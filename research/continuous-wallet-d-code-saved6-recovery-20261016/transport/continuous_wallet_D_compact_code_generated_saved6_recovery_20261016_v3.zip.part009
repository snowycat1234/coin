class RecaptureGuard(SourceOnlyGuard):
    def _check_read(self,path):
        if not isinstance(path,int):
            p=Path(os.path.abspath(os.fsdecode(path)))
            if p not in self.read_paths:self.deny('nonallowlisted_file_reads',p)
        return super()._check_read(path)

@dataclass(frozen=True,slots=True)
class CaptureScope:
    binding:object=field(repr=False);guard:object=field(repr=False);token:object=field(repr=False);seal:object=field(repr=False)
