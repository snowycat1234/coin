    guard_receipt.update(source_scopes_revoked=not _CAPTURES,saved_targets_and_covariance_rebuilt=False,accounts_constructed=0,providers_constructed=0)
    rows=tuple(MappingProxyType(dict(symbol=s,close_us=int(at),available_us=int(at),close=float(close[i,j]))) for i,at in enumerate(clocks) for j,s in enumerate(a.SYMBOLS))
    import polars as pl
    from continuous_provider import ContinuousMinuteProvider
    provider=ContinuousMinuteProvider(binding,b.c.immutable(captures))
    window=MappingProxyType(dict(start=a.START,end=a.END,symbols=a.SYMBOLS,daily=pl.DataFrame([dict(r) for r in rows]),events=b.c.immutable(events),minute_blocks=provider))
    values=MappingProxyType(dict(window=window,rows=rows,decisions=arrays['decision_us'],target=arrays[binding.cell_id],arrays=MappingProxyType(arrays),
        quality_cells=cells,quality_intervals=intervals,later_interval_witnesses=b.c.immutable(witnesses),quality_sidecar_sha256=sha256(artifacts['SOURCE_QUALITY.json']).hexdigest(),
        provider=provider,source_guard_receipt=guard_receipt,source_scopes_revoked=not _CAPTURES))
    token=object();loaded=LoadedInputs(binding,values,token,_SEAL);_INPUTS[token]=loaded;return loaded


def revoke_inputs(value):
    require_inputs(value,value.binding);_INPUTS.pop(value.token,None)
