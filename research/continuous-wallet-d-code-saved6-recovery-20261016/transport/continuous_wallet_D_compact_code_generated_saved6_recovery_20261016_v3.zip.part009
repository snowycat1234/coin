from pathlib import Path
from types import FunctionType,MethodType
from io import BytesIO
import gzip
import json
import os
import sys
import numpy as np
import continuous_admission as a
G=a.ROOT/'continuous_wallet_D_generated_20261015_v1'
if str(G) not in sys.path:sys.path.insert(0,str(G))
import continuous_saved as original


def own_bytes(path):return sum(p.stat().st_size for p in Path(path).rglob('*') if p.is_file())

class Budget:
    def __init__(self,directory,cohort):self.directory=Path(directory);self.cohort=Path(cohort)
    def atomic(self,path,raw,*,replace=False):
        p=Path(path)
        if p.parent!=self.directory:raise ValueError('EXACT_OWNED_CASE_WRITE_REQUIRED')
        # Include the temporary file while a replace still retains its old file.
        log=self.cohort/(self.directory.name+'.stdout.log');log_bytes=log.stat().st_size if log.exists() else 0
        if own_bytes(self.directory)+log_bytes+len(raw)>a.LIMITS['case_output_bytes']:raise RuntimeError('CASE_OUTPUT_CAP_STOP_BEFORE_WRITE')
        if a.cohort_bytes(self.cohort)+len(raw)>a.LIMITS['cohort_output_bytes']:raise RuntimeError('COHORT_OUTPUT_CAP_STOP_BEFORE_WRITE')
        return original.atomic(p,raw,replace=replace)
    def save(self,path,value,*,replace=False):return self.atomic(path,original.source.canonical(value)+b'\n',replace=replace)
    def gzip(self,path,value):
        raw=original.source.canonical(value)+b'\n';compressed=gzip.compress(raw,compresslevel=6,mtime=0)
        pin=self.atomic(path,compressed)
        if gzip.decompress(Path(path).read_bytes())!=raw:raise ValueError('EXACT_COMPRESSED_JSON_ROUNDTRIP_REQUIRED')
        return dict(**pin,uncompressed_SHA256=__import__('hashlib').sha256(raw).hexdigest(),uncompressed_bytes=len(raw))


def make_writer(scope,directory,*,start,end,cohort):
    a.require_execution_scope(scope)
    if [start,end]!=[a.START,a.END]:raise ValueError('EXACT_COMPLETE_CONTINUOUS_CALENDAR_REQUIRED')
    class ActualWriter(original.ChunkWriter):pass
    writer=ActualWriter.__new__(ActualWriter);writer.directory=Path(directory)
    if writer.directory.is_symlink() or any(p.is_symlink() for p in writer.directory.parents):raise ValueError('ORDINARY_OWNED_OUTPUT_ROOT_REQUIRED')
    if writer.directory.name!=scope.cell_id:raise ValueError('EXACT_SCOPE_CELL_OUTPUT_REQUIRED')
    writer.start=start;writer.end=end;writer.cursor=start;writer.records=[];writer.boundaries=[]
    writer.identity=dict(schema=a.VERSION,cell=scope.cell_id,recipe=scope.recipe,tier=scope.tier_name,source_identity=scope.source_identity,
        generated_only=False,historical_execution_admitted=True,one_initial_10000_wallet=True,annual_wallet_reset=False)
    writer.header=dict(schema=a.VERSION,identity=writer.identity,calendar=[start,end],historical_admission=True,generated_only=False,financial_snapshot_resume=False)
    expected=Path(scope._binding.go['controller_output'])/scope.cell_id
    allowed={'BOOTSTRAP_READY.json','PROCESS_OWNERSHIP.json','LAUNCH_CLAIM.json','SOURCE_RECAPTURE_GUARD_RECEIPT.json','SOURCE_ACCEPTED_BEFORE_ACCOUNT.json'}
    if writer.directory!=expected or writer.directory.exists() and any(p.name not in allowed or not p.is_file() or p.is_symlink() for p in writer.directory.iterdir()):
        raise ValueError('EXACT_FRESH_CASE_BOOTSTRAP_ONLY_OUTPUT_REQUIRED')
    writer.directory.mkdir(parents=True,exist_ok=True);budget=Budget(writer.directory,cohort)
    budget.save(writer.directory/'IDENTITY.json',writer.header)
    fn=original.ChunkWriter.append
    rebound=FunctionType(fn.__code__,dict(fn.__globals__,atomic=budget.atomic,save=budget.save),fn.__name__,fn.__defaults__,fn.__closure__)
    writer.append=MethodType(rebound,writer);writer.budget=budget
    return writer


def validate_chunks(writer,values):
    result=writer.validate(require_full=True);offset=0
    for rec in writer.records:
        with np.load(writer.directory/rec['name'],allow_pickle=False) as chunk:
            arr=chunk['values']
            if arr.tobytes()!=values[offset:offset+len(arr),:len(original.COLUMNS)].tobytes():raise ValueError('DURABLE_CHUNK_NATIVE_FINAL_EXPORT_BIT_PARITY_REQUIRED')
            offset+=len(arr)
    return result
