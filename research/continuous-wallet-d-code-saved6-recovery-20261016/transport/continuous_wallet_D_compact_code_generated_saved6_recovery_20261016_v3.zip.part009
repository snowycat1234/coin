def require_execution_scope(scope):
    if type(scope) is not ExecutionScope or scope._seal is not _SEAL or _LIVE.get(scope._token) is not scope:
        raise ValueError('LIVE_EXACT_CONTINUOUS_EXECUTION_SCOPE_REQUIRED')
