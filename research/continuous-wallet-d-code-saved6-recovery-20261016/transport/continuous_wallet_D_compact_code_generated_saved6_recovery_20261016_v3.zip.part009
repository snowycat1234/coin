  boundaries=load(root/fm['ANNUAL_BOUNDARIES.json.gz']);require(same(boundaries,prefix['boundaries']),'SAVED_PREFIX_SEAM_PARITY');exactint(len(boundaries),4,'four_carried_Jan1_seams')
  for b,clock in zip(boundaries,(1640995200000000,1672531200000000,1704067200000000,1735689600000000)):
   exactint(b['boundary_us'],clock,'Jan1_clock');require(b['forced_flatten']is False and b['cash_reseed']is False and b['read_only_observation']is True and b['snapshot_resume_authorized']is False,'SEAM_NO_RESET_CLOSE_RESEED_OR_AUTHORITY');exactint(b['state']['account_constructors'],1,'single_lifetime_account');require(canonical_sha256(b['state'])==b['state_SHA256'],'EXACT_SEAM_STATE_COMMITMENT')
  terminalclock=review['global_terminal_clock'];exactint(terminalclock['annual_terminal_signal_trade_rows'],0,'no_annual_terminal');exactint(terminalclock['subsequent_real_open_clocks'],60,'only_60_final_real_opens');exactint(terminalclock['signal_us'],END-61*60000000,'single_global_terminal_signal')
  observations.append(dict(cell_id=cell,status=row['outcome'],native40_proof_passed=True,trade_rows=proof['trade_rows_checked'],funding_rows=proof['funding_rows_checked'],saved_chunk_pins=len(chunks),carried_Jan1_seams=4,ending_NAV_USDT=proof['exact_native40_NAV'],secondary_bridge_residual=proof['native40_secondary_PnL_bridge_residual']))
  del audit,result
 return dict(status='PASS',case_count=6,cases=observations,exact_inert_source_files=source_files,exact_report_rows=len(rows),omitted_dependencies=len(deps),full_minute_or_source_rebuild_self_contained=False,financial_or_source_execution=False,new_authority=False)
def verify_outer(root,archive,trusted):
 require(type(trusted)is str and re.fullmatch('[0-9a-f]{64}',trusted)is not None and pin(archive)['SHA256']==trusted,'EXTERNAL_TRUSTED_ZIP_HASH_MISMATCH')
 root=Path(root)
 with zipfile.ZipFile(archive)as z:
  expected={root.name+'/'+rel for rel in files(root)}|{root.name+'/MANIFEST.json'}
  require(set(z.namelist())==expected and len(z.namelist())==len(expected),'EXACT_ZIP_MEMBER_SET')
 return verify_content(root)
