import os
for _key in ('OPENBLAS_NUM_THREADS', 'OMP_NUM_THREADS', 'MKL_NUM_THREADS',
        'NUMEXPR_NUM_THREADS', 'POLARS_MAX_THREADS', 'VECLIB_MAXIMUM_THREADS', 'BLIS_NUM_THREADS'):
    os.environ[_key] = '1'

from contextlib import contextmanager
from dataclasses import dataclass
import ast
from pathlib import Path
import sys
from types import SimpleNamespace
import unittest
from unittest.mock import patch

import native_adapter as n
import numpy as np
import polars as pl

s = n.generated.source


@dataclass(frozen=True, eq=False)
class _InventedExecutionScope:
    fixture: object
    tier_name: str
    cell_id: str
    recipe: str
    source_identity: str
    quality_cells: tuple
    quality_intervals: tuple
    later_interval_witnesses: tuple
    quality_sidecar_sha256: str
    metadata: dict
    window: dict
    rows: list
    decisions: object
    targets: object
    source_scope = n.SOURCE_SCOPE
    generated_only = False  # Only the patched test authority models this flag.

    def validate_inputs(self, window, rows, decisions, targets):
        if not (window is self.window and rows is self.rows
                and decisions is self.decisions and targets is self.targets):
            raise ValueError('EXACT_TEST_ONLY_INVENTED_INPUT_REFERENCES_REQUIRED')
        if window['start'] < s.utc('1970-01-01') or window['end'] >= s.utc('1976-01-01'):
            raise ValueError('TEST_ONLY_NONHISTORICAL_CALENDAR_REQUIRED')


class _InventedAdmission:
    def __init__(self, scope):
        self.scope = scope
        self.consumptions = 0

    def require_execution_scope(self, scope):
        if type(scope) is not _InventedExecutionScope or scope is not self.scope:
            raise ValueError('EXACT_TEST_ONLY_LIVE_SCOPE_REQUIRED')
        s.require_generated(scope.fixture)
        _InventedExecutionScope.validate_inputs(scope,
            scope.window, scope.rows, scope.decisions, scope.targets)

    def consume_construction(self, scope):
        self.require_execution_scope(scope)
        if self.consumptions:
            raise ValueError('ONE_TEST_ONLY_CONSTRUCTION_REQUIRED')
        self.consumptions += 1


@contextmanager
def invented_case(*, days=4, block_minutes=1440, tier='MID'):
    with s.generated_source(days=days) as fixture:
        cells, intervals = n.generated.generated_quality(fixture)
        provider = n.generated.GeneratedMinuteProvider(fixture,
            block_minutes=block_minutes, quality_cells=cells, intervals=intervals)
        rows = [dict(symbol=symbol, close_us=int(at), available_us=int(at),
            close=float(fixture.close[i, j]))
            for i, at in enumerate(fixture.clocks) for j, symbol in enumerate(n.S)]
        window = dict(start=fixture.start, end=fixture.end, symbols=n.S,
            daily=pl.DataFrame(rows), events=[dict(row) for row in fixture.events],
            minute_blocks=provider)
        recipe = s.RECIPES[0]
        targets = s.project_generated(fixture)['targets'][recipe + '_' + tier]
        account_intervals = tuple((c.completed_us, c.completed_us + n.MINUTE, (c.symbol,))
            for c in cells) + tuple((i.start_us, i.end_us, i.symbols) for i in intervals)
        witnesses = tuple(dict(**i.as_dict(), recovery_evidence='INVENTED_TEST_ONLY') for i in intervals)
        scope = _InventedExecutionScope(fixture, tier, recipe + '_' + tier, recipe,
            fixture.identity, cells, account_intervals, witnesses, 'a' * 64,
            dict(test_only_invented_authority=True), window, rows, fixture.decisions, targets)
        admission = _InventedAdmission(scope)
        with patch.object(n, '_admission', return_value=admission):
            yield scope, provider, admission


class NativeAdapterGeneratedTests(unittest.TestCase):
    def test_actual_initialization_financial_field_seam_is_exact_annual_ast(self):
        def initialization_slice(path, class_name):
            tree = ast.parse(Path(path).read_text())
            account = next(node for node in tree.body
                if isinstance(node, ast.ClassDef) and node.name == class_name)
            init = next(node for node in account.body
                if isinstance(node, ast.FunctionDef) and node.name == '__init__')
            def assigns(node, name):
                return isinstance(node, ast.Assign) and any(
                    isinstance(target, ast.Attribute) and isinstance(target.value, ast.Name)
                    and target.value.id == 'self' and target.attr == name for target in node.targets)
            first = next(i for i, node in enumerate(init.body) if assigns(node, 'generated_scope'))
            last = next(i for i, node in enumerate(init.body) if assigns(node, '_source_quality_cells'))
            return [ast.dump(node, include_attributes=False) for node in init.body[first:last + 1]]
        self.assertEqual(initialization_slice(n.__file__, 'ContinuousAccount'),
            initialization_slice(n.base.__file__, 'ExpansionAccount'))

    def test_production_admission_rejects_noncapabilities_without_construction(self):
        admission = n._admission()
        self.assertEqual(admission.VERSION, n.VERSION)
        with s.generated_source(days=1) as fixture:
            for fake in (None, {}, object(), fixture,
                    SimpleNamespace(source_scope=n.SOURCE_SCOPE, generated_only=False,
                        validate_current=lambda: True)):
                with self.assertRaisesRegex(ValueError, 'LIVE_EXACT_CONTINUOUS_EXECUTION_SCOPE'):
                    n._require_scope(fake)

    def test_financial_and_composite_predicate_objects_are_unchanged(self):
        for name in ('execute_fill', 'apply_funding', 'monitor', '_transfer',
                'economic_report', 'update_marks', 'can_increase', '_capture'):
            self.assertIs(getattr(n.ContinuousAccount, name), getattr(n.base.ExpansionAccount, name))
        self.assertIs(n.ContinuousGuard.attempt, n.base.ContinuationGuard.attempt)
        self.assertIs(n.CompositeQualityGuard.quality_witness,
            n.generated.CompositeQualityGuard.quality_witness)

    def test_exact_authority_generated_flags_and_constructor_reuse_rejected(self):
        with invented_case(days=1) as (scope, provider, admission):
            for fake in (None, {}, object(), SimpleNamespace(**vars(scope))):
                with self.assertRaisesRegex(ValueError, 'EXACT_TEST_ONLY_LIVE_SCOPE'):
                    n.construct_case(scope.window, scope.rows, scope.decisions,
                        scope.targets, historical_scope=fake)
            plain = n.V2.grid.make_account(scope.tier_name, 'BASE27')
            args = dict(symbols=n.S, instrument_profiles=plain.instrument_profiles,
                closing_min_notional_exempt=True, historical_scope=scope)
            with self.assertRaisesRegex(ValueError, 'GENERATED_SCOPE_CANNOT'):
                n.ContinuousAccount(plain.config, generated_scope=None, **args)
            self.assertEqual(admission.consumptions, 0)
            with self.assertRaisesRegex(ValueError, 'INPUT_REFERENCES'):
                n.construct_case(scope.window, scope.rows, scope.decisions,
                    scope.targets.copy(), historical_scope=scope)
            sim, guard = n.construct_case(scope.window, scope.rows,
                scope.decisions, scope.targets, historical_scope=scope)
            self.assertEqual(admission.consumptions, 1)
            self.assertEqual(sim.account.nav(), n.DEC(10000))
            with self.assertRaisesRegex(ValueError, 'ONE_ACCOUNT_CONSTRUCTOR'):
                sim.account.__init__(plain.config, **args)
            with self.assertRaisesRegex(ValueError, 'ONE_TEST_ONLY_CONSTRUCTION'):
                n.construct_case(scope.window, scope.rows,
                    scope.decisions, scope.targets, historical_scope=scope)
            with self.assertRaises(TypeError):
                n.TokenView(SimpleNamespace())
            self.assertIs(n.TokenView(sim.account)._owned, sim.account)
            self.assertEqual(sim.risk_schedule.__func__.__code__, n._RISK_CODES[0])
            self.assertFalse(sim.account.generated_scope)
            self.assertEqual(sim.terminal_signal_us, scope.window['end'] - 61 * n.MINUTE)
            self.assertEqual(provider.iterations, 0)

    def _run(self, block_minutes):
        import continuous_saved as saved
        with invented_case(block_minutes=block_minutes) as (scope, provider, admission):
            sim, guard = n.construct_case(scope.window, scope.rows,
                scope.decisions, scope.targets, historical_scope=scope)
            quality = guard.causal_mark_quality_guard
            self.assertEqual(sim.account._quality_intervals, scope.quality_intervals)
            self.assertEqual(quality.source_quality_cells, scope.quality_cells)
            self.assertEqual(len(quality.intervals), len(scope.later_interval_witnesses))
            self.assertEqual(quality.intervals[0].original_genuine_observation_us,
                scope.later_interval_witnesses[0]['original_genuine_observation_us'])
            states = []
            while sim.cursor < sim.end and sim.stop is None:
                sim.advance_day()
                states.append(saved.observed_state(sim))
                if len(states) == 2:
                    before = saved.observed_state(sim)
                    marker = saved.annual_marker(sim)
                    self.assertEqual(saved.observed_state(sim), before)
                    self.assertFalse(marker['forced_flatten'])
                    self.assertFalse(sim.terminal)
            self.assertEqual((provider.iterations, admission.consumptions), (1, 1))
            self.assertEqual(sim.rows_written, 4 * 1440)
            self.assertIsNone(sim.stop)
            self.assertFalse(sim.account.transfer_journal)
            self.assertTrue(sim.terminal)
            self.assertTrue(any(row['owned'] for row in sim.funding_journal
                if row['event_us'] == s.utc('1972-01-01')))
            result = n.case_result(sim, guard)
            self.assertTrue(result['economics']['paid_flat'])
            self.assertFalse(result['economics']['annual_wallet_fresh_genesis'])
            self.assertFalse(result['economics']['generated_only'])
            self.assertTrue(result['economics']['partial2021_not_annualized'])
            self.assertTrue(result['common_execution_policy']['historical_execution_admitted'])
            self.assertFalse(sim.account.contract_metadata()['generated_only'])
            self.assertEqual(states[1]['account_constructors'], 1)
            self.assertTrue(any(q != '0' for q in states[1]['quantities'].values()))
            self.assertGreater(states[2]['financial_sequence'], states[1]['financial_sequence'])
            self.assertTrue(all(row['event_us'] < sim.end for row in sim.account.trades))
            with self.assertRaises(RuntimeError):
                sim.snapshot()
            values = result.pop('minute').to_numpy()
            result['targets'] = result['targets'].to_dicts()
            audit = n.V2.OWNED.export_tree(sim.account.snapshot())
            result = n.V2.OWNED.export_tree(result)
            checker_path = s.checked_reference(
                'bounded_native_continuation_guard50_exit_expansion_20261015/saved_native_reconciliation.py')
            if str(checker_path.parent) not in sys.path:
                sys.path.insert(0, str(checker_path.parent))
            from saved_native_reconciliation import reconcile_saved_native
            proof = reconcile_saved_native(audit, result, expected_continuation_version=n.VERSION)
            self.assertTrue(proof['passed'])
            self.assertFalse(proof['tolerance_or_epsilon_used'])
            return audit, result, values, states

    def test_both_quality_predicates_wait_for_installed_genuine_recovery(self):
        with invented_case() as (scope, provider, admission):
            sim, guard = n.construct_case(scope.window, scope.rows,
                scope.decisions, scope.targets, historical_scope=scope)
            quality = guard.causal_mark_quality_guard
            cell = quality.source_quality_cells[-1]
            later = quality.intervals[0]
            self.assertIsNone(quality.quality_witness(cell.completed_us - 3 * n.MINUTE))
            self.assertIn('affected_source_cells', quality.quality_witness(cell.completed_us))
            sim.advance_day()
            sim.advance_day()
            self.assertIsNone(quality.quality_witness(later.start_us - 1))
            witness = quality.quality_witness(later.start_us)
            self.assertIn('affected_intervals', witness)
            self.assertNotIn('affected_source_cells', witness)
            self.assertIsNotNone(quality.quality_witness(later.end_us + 1))
            for symbol in n.S:
                sim.account.marks[symbol].append(dict(price=n.DEC('1'),
                    close_us=later.end_us, available_us=later.end_us + 2))
                sim.account.mark_quality[symbol] = 'DIRECT_REVIEWED_SOURCE_OBSERVATION'
            self.assertIsNotNone(quality.quality_witness(later.end_us + 1))
            for symbol in n.S:
                sim.account.marks[symbol].append(dict(price=n.DEC('1'),
                    close_us=later.end_us, available_us=later.end_us))
            self.assertIsNone(quality.quality_witness(later.end_us + 1))

    def test_generated_boundary_and_partition_invariance(self):
        first = self._run(1440)
        second = self._run(137)
        self.assertEqual(first[0], second[0])
        self.assertEqual(first[1], second[1])
        self.assertEqual(first[2].tobytes(), second[2].tobytes())
        self.assertEqual(first[3], second[3])


if __name__ == '__main__':
    unittest.main(verbosity=2)
