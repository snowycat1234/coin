        self.assertEqual(a.RELEASED_CELLS,('STATIC50_OLD_NO_REEXPANSION_MID','STATIC50_OLD_NO_REEXPANSION_HIGH','VOL_MANAGED_HOLD_LOW','VOL_MANAGED_HOLD_MID','VOL_MANAGED_HOLD_HIGH'))
