    bindings = dict(account=sim.account, guard=guard, original_risk=sim.risk_schedule)
    function = FunctionType(_RISK_CODES[0], generated.construct_generated_case.__globals__,
        'risk_schedule', None, tuple(_cell(bindings[name]) for name in _RISK_CODES[0].co_freevars))
    sim.risk_schedule = MethodType(function, sim)


def construct_case(window, source_rows, decisions, targets, *, historical_scope):
    """One actual account/simulator over the exact scope-owned global inputs."""
    _require_scope(historical_scope)
    type(historical_scope).validate_inputs(historical_scope, window, source_rows, decisions, targets)
    constructions = []

    def factory(tier_name, cost):
        if constructions:
            raise ValueError('ONE_ACCOUNT_CONSTRUCTOR_PER_CONTINUOUS_CASE')
        if tier_name != historical_scope.tier_name or cost['id'] != 'BASE27':
            raise ValueError('EXACT_CONTINUOUS_TIER_BASE27_REQUIRED')
        plain = V2.grid.make_account(tier_name, cost['id'])
        account = ContinuousAccount(plain.config, symbols=S,
            instrument_profiles=plain.instrument_profiles, closing_min_notional_exempt=True,
            historical_scope=historical_scope, tier_name=tier_name)
        constructions.append(account)
        return account

    constructor = V2._rebind(V2.native._construct_case,
        make_owned_account=factory, PartialTierGuard=ContinuousGuard)
    sim, guard = constructor(window, source_rows, decisions, targets,
        tier_name=historical_scope.tier_name, cost_name='BASE27', source_scope=SOURCE_SCOPE)
    account = sim.account
    if len(constructions) != 1 or constructions[0] is not account:
        raise AssertionError('ONE_OWNED_CONTINUOUS_ACCOUNT_REQUIRED')
    intervals = tuple(V2.quality_module.StaleMarkInterval(
        start_us=row['start_us'], end_us=row['end_us'], symbols=tuple(row['symbols']),
        original_genuine_observation_us=row['original_genuine_observation_us'])
        for row in historical_scope.later_interval_witnesses)
    quality = CompositeQualityGuard(guard, intervals=intervals,
        source_sidecar_sha256=historical_scope.quality_sidecar_sha256)
    quality.source_quality_cells = historical_scope.quality_cells
    quality.identity.update(source_clock_cells=[asdict(c) for c in historical_scope.quality_cells],
        per_asset_genuine_recovery_required=True,
        quality_composition='REJECT_WHEN_EITHER_TYPED_CELL_OR_INTERVAL_UNRECOVERED')
    quality.policy_sha256 = sha256(V2.P._identity(quality.identity).encode()).hexdigest()
    quality.install()
    guard.causal_mark_quality_guard = quality
    if getattr(account.liquidation_callback, '__self__', None) is not sim:
        raise AssertionError('NATIVE_PENDING_CANCELLATION_REQUIRED')
    _bind_risk_schedule(sim, guard)
    sim.meta.update(continuation_version=VERSION, policy_variant=POLICY_VARIANT,
        settlement_mode=SETTLEMENT, noop_receipt_limit=V2.NOOP_RECEIPT_LIMIT,
        old_baselines_modified=False, frozen_D_rule_unchanged=True,
        cell_id=historical_scope.cell_id, recipe=historical_scope.recipe,
        continuous_wallet=True, one_account_constructor=True, one_provider_lifecycle=True,
        annual_wallet_fresh_genesis=False, annual_wallets_compounded=False,
        one_initial_10000_wallet=True, full_year_DEV=False, partial2021_not_annualized=True,
        global_terminal_only=True, source_identity=historical_scope.source_identity,
        generated_only=False, historical_execution_admitted=True, adaptive_DEV_only=True,
        nominal_tier_is_not_exact_realized_risk_matching=True,
        mark_quality_policy_identity=quality.policy_sha256,
        mark_quality_guard_version=V2.quality_module.VERSION,
        original_interpolated_mark_execution_admitted=False)
    return sim, guard


def case_result(sim, guard):
    """Reuse annual financial exports with truthful continuous-only labels."""
    if type(sim.account) is not ContinuousAccount or type(guard) is not ContinuousGuard:
        raise ValueError('EXACT_ACTUAL_CONTINUOUS_CASE_REQUIRED')
    _require_scope(sim.account._execution_scope)
    result = base.case_result(sim, guard)
    result['economics'].update(comparison_scope=VERSION,
        annual_wallet_fresh_genesis=False, continuous_wallet=True,
        annual_wallets_compounded=False, one_initial_10000_wallet=True,
        full_year_DEV=False, partial2021_not_annualized=True, generated_only=False,
        historical_execution_admitted=True, global_terminal_only=True)
    result['common_execution_policy'].update(version=VERSION,
        historical_execution_admitted=True, generated_only=False,
        annual_wallet_fresh_genesis=False, continuous_wallet=True,
        global_terminal_only=True)
    return result
