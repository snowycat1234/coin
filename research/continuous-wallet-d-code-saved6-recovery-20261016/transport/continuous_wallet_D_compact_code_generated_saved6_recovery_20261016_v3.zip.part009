import numpy as np

HERE=Path(__file__).resolve().parent;ROOT=HERE.parent
FINANCIAL_REFERENCE=ROOT/'legacy_intrinsic_D_remaining14_financial_20261015_v1'
if str(FINANCIAL_REFERENCE) not in sys.path:sys.path.insert(0,str(FINANCIAL_REFERENCE))
import legacy_bootstrap
import legacy_native_common as c
import legacy_native_codec as codec
import legacy_native_quality as quality
import legacy_config as config
import legacy_signal as signal
import legacy_native_source_bridge as bridge


def select_functions(path,names,namespace):
    tree=ast.parse(path.read_bytes());selected=[x for x in tree.body if isinstance(x,ast.FunctionDef) and x.name in names]
    if tuple(x.name for x in selected)!=tuple(names):raise ValueError('EXACT_REUSED_PURE_FUNCTION_INVENTORY_REQUIRED')
    namespace=dict(namespace,__name__=__name__)
    exec(compile(ast.Module(body=selected,type_ignores=[]),str(path),'exec'),namespace)
    return SimpleNamespace(**{name:namespace[name] for name in names})

# Load source code only. Pins are bound and verified by source_entry's manifest.
ANNUAL=select_functions(FINANCIAL_REFERENCE/'legacy_native_source.py',
    ('funding_events','qualified_terminal_witness_2021','assemble_inputs'),
    dict(np=np,c=c,codec=codec,quality=quality,config=config,signal=signal,asdict=asdict,
         MappingProxyType=__import__('types').MappingProxyType))
CONFIG2023=SimpleNamespace(source_year=config.period_named,SYMBOLS=signal.SYMBOLS,DAY=config.DAY)
FIRST2023=select_functions(ROOT/'legacy_intrinsic_D_20261015_v1/legacy_source.py',
    ('finite_number','funding_events','assemble_inputs'),dict(np=np,c=c,codec=codec,config=CONFIG2023))


def capture_year(scope,year,contract):
    # Import is source-only; the new sealed type is checked unbound, never via a
    # caller-defined validate method or generated flag.
    import source_entry as entry
    entry.require_scope(scope)
    def read(name):
        pin=contract['read_files'][name]
        return entry.read_body(scope,year,name,pin['SHA256'],pin['bytes'])
    raw_sidecar=read(contract['quality_sidecar_path'])
    if year==2022:
        def new_predicate(value,root):
            entry.require_scope(value)
            if Path(root).resolve()!=bridge.SOURCE_ROOT or entry.year_record(2022)['source_identity']!=bridge.SOURCE_IDENTITY:
                raise ValueError('EXACT_QUALIFIED_2022_SOURCE_SCOPE_ROOT_REQUIRED')
            return Path(root).resolve()
        globals_copy=dict(bridge.capture_2022.__globals__,_require_source_scope=new_predicate)
        normalize=FunctionType(bridge.capture_2022.__code__,globals_copy,bridge.capture_2022.__name__,
            bridge.capture_2022.__defaults__,bridge.capture_2022.__closure__)
        transport,captured=normalize(scope.source_root(year),source_scope=scope)
        warm=captured['DAILY_PROJECTION.npz'];events=captured['RAW_EVENTS.json'];daily=None
        months=tuple((r['path'],captured[r['path']]) for r in contract['months'])
    else:
        warm=read(contract['warmup_path']);daily=read(contract['daily_path']) if contract['daily_path'] is not None else None
        events=read(contract['events_path']);months=tuple((r['path'],read(r['path'])) for r in contract['months'])
        transport=None
    qualification=read(contract['qualification']['path']) if year==2021 else None
    if year==2023:result=FIRST2023.assemble_inputs(year,warm,daily,events,raw_sidecar,months,contract)
    else:result=ANNUAL.assemble_inputs(year,warm,daily,events,raw_sidecar,months,contract,qualification)
    if transport is not None:result['normalization_equivalence']=transport['normalization_equivalence']
    # Endpoint witness is the actual final selected native trade-close bits,
    # not the previous feature close or a made-up recovery price.
    rec=contract['months'][-1];arrays,_=codec.month_arrays(year,months[-1][1],rec['start'],rec['count'],result['quality_cells'])
    off=rec['hi']-1
    result['native_endpoint_close']=codec.frozen_array(np.asarray([arrays[s+'_close'][off] for s in signal.SYMBOLS]))
    result['native_endpoint_witness']=dict(minute_open_us=int(arrays['times'][off]),completed_us=int(arrays['times'][off])+codec.MINUTE,
        source_file=rec['path'],source_file_SHA256=rec['hash'],source_float64_bits_SHA256=c.sha(result['native_endpoint_close'].tobytes()),
        genuine_native_trade_close=True,end_boundary_witness_not_2026_execution_authority=True)
    entry.require_scope(scope)
    return result
