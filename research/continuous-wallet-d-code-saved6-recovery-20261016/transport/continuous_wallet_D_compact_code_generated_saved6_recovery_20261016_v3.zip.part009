def _regular_bytes(root):
    total=0
    for p in Path(root).rglob('*'):
        if p.is_symlink():raise ValueError('COHORT_OUTPUT_SYMLINK_FORBIDDEN')
        if p.is_file():total+=p.stat().st_size
    return total


def pilot_output_bytes(go):
    """Root-pinned saved metadata only; no source/native replay or outcome sort."""
    global _PILOT_BYTES
    _PILOT_BYTES=None
    def read(key,path):
        pin=go[key]
        if pin['path']!=str(path.relative_to(ROOT)):raise ValueError('EXACT_SUCCESSFUL_PILOT_EVIDENCE_PATH_REQUIRED:'+key)
        return json.loads(pinned(pin))
    root_go=read('pilot_root_GO',PILOT_GO)
    if go['pilot_root_GO']['SHA256']!=PILOT_GO_SHA256 or root_go.get('code_manifest_SHA256')!=PILOT_CODE_SHA256 or canonical(root_go.get('limits'))!=canonical(LIMITS):
        raise ValueError('EXACT_UNCHANGED_FIRST_PILOT_ROOT_AND_CAPS_REQUIRED')
    claim=read('pilot_claim',CLAIMS/(CELLS[0]+'.json'))
    terminal=read('pilot_terminal',PILOT_COHORT/CELLS[0]/'TERMINAL_CHECKPOINT.json')
    audit=json.loads(pinned(go['pilot_saved_audit']))
    fixed=dict(schema='INDEPENDENT_CONTINUOUS_PILOT_SAVED_AUDIT_V1',status='PASS_ACTUAL_CONTINUOUS_PILOT_SAVED_AUDIT',cell_id=CELLS[0],
        root_financial_GO_SHA256=PILOT_GO_SHA256,financial_code_manifest_SHA256=PILOT_CODE_SHA256,source_identity=PILOT_SOURCE_ID,
        actual_root_controller_shell_exit_code=0,actual_worker_shell_exit_code=0,completed_minutes=2498400,native40_reconstructed=True,
        resource_bounds_passed=True,terminal_checkpoint_SHA256=go['pilot_terminal']['SHA256'],permanent_claim_SHA256=go['pilot_claim']['SHA256'])
    if any(type(audit.get(k)) is not type(v) or canonical(audit[k])!=canonical(v) for k,v in fixed.items()):
        raise ValueError('INDEPENDENT_FULL_PILOT_SAVED_AND_RESOURCE_PASS_REQUIRED_NO_ECONOMIC_SELECTION')
    expected=terminal.get('expected',{});saved=terminal.get('saved_validation',{})
    if (type(expected.get('actual_shell_exit_code')) is not int
            or type(terminal.get('actual_owned_shell_exit',{}).get('actual_shell_exit_code')) is not int
            or type(saved.get('completed_minutes')) is not int or type(saved.get('actual_owned_shell_exit_code')) is not int):
        raise ValueError('EXACT_PILOT_TERMINAL_INTEGER_TYPES_REQUIRED')
    if (terminal.get('schema')!='SUPERVISOR_ADMITTED_CONTINUOUS_FINANCIAL_TERMINAL_V1'
            or expected.get('cell_id')!=CELLS[0] or expected.get('root_GO_SHA256')!=PILOT_GO_SHA256
            or expected.get('code_manifest_SHA256')!=PILOT_CODE_SHA256 or expected.get('source_identity')!=PILOT_SOURCE_ID
            or expected.get('claim_SHA256')!=go['pilot_claim']['SHA256'] or expected.get('actual_shell_exit_code')!=0
            or terminal.get('actual_owned_shell_exit',{}).get('actual_shell_exit_code')!=0
            or saved.get('status') not in ('FULL_CALENDAR_ACTUAL_PAID_MARKET_FLAT','FULL_CALENDAR_CONDITIONAL_SETTLED_FLAT')
            or saved.get('completed_minutes')!=2498400 or saved.get('native40_reconstructed') is not True
            or saved.get('actual_owned_shell_exit_code')!=0 or saved.get('first_account_counts_once') is not True
            or terminal.get('fresh_financial_scopes_revoked') is not True or terminal.get('automatic_retry') is not False
            or terminal.get('financial_snapshot_resume') is not False
            or claim.get('cell_id')!=CELLS[0] or claim.get('root_GO_SHA256')!=PILOT_GO_SHA256
            or claim.get('code_manifest_SHA256')!=PILOT_CODE_SHA256 or claim.get('source_identity')!=PILOT_SOURCE_ID
            or claim.get('status')!='RESERVED_BEFORE_SPAWN_NO_AUTOMATIC_RETRY'
            or claim.get('case_output')!=str(PILOT_COHORT/CELLS[0])):
        raise ValueError('EXACT_SUCCESSFUL_FIRST_PILOT_TERMINAL_AND_PERMANENT_CLAIM_REQUIRED')
    case_bytes=_regular_bytes(PILOT_COHORT/CELLS[0]);log=PILOT_COHORT/(CELLS[0]+'.stdout.log')
    if log.exists():case_bytes+=log.stat().st_size
    cohort_bytes=_regular_bytes(PILOT_COHORT)
    if (type(audit.get('case_output_bytes')) is not int or type(audit.get('cohort_output_bytes')) is not int
            or audit['case_output_bytes']!=case_bytes or audit['cohort_output_bytes']!=cohort_bytes
            or case_bytes>LIMITS['case_output_bytes'] or cohort_bytes>LIMITS['cohort_output_bytes']):
        raise ValueError('EXACT_IMMUTABLE_PILOT_OUTPUT_RESOURCE_PROOF_REQUIRED')
    _PILOT_BYTES=cohort_bytes
    return cohort_bytes


def cohort_bytes(current_root):
    if _PILOT_BYTES is None:raise ValueError('VERIFIED_PILOT_RESOURCE_BASELINE_REQUIRED_BEFORE_ANY_REMAINING_WRITE')
    return _PILOT_BYTES+_regular_bytes(current_root)+_regular_bytes(CLAIMS)
