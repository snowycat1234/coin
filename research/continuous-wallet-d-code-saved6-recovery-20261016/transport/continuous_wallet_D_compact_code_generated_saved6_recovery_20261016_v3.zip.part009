        clocks,close=pure.exact_daily_union([dict(clocks=s['clocks'],available=s['clocks'],close=s['close']) for s in captures.values()],start=a.START,end=a.END)
        events=[dict(row) for s in captures.values() for row in s['events']]
        cells=tuple(cell for s in captures.values() for cell in s['quality_cells']);intervals=tuple(i for s in captures.values() for i in s['quality_intervals'])
        witnesses=[dict(start_us=x,end_us=y,symbols=list(ss),original_genuine_observation_us=source_metadata.design_record(2024)['last_genuine_source_available_us'],
            recovery_evidence='ORIGINAL_QUALIFIED_CONTRACT_AND_GUARDED_SOURCE_PATH_NOT_STANDALONE_SAVED_RECOVERY_PRICE') for x,y,ss in captures[2024]['quality_intervals']]
        quality=dict(cells=[asdict(c) for c in cells],account_quality_intervals=pure.json_plain(intervals),later_interval_witnesses=witnesses,
            genuine_2022_recovery_witnesses=pure.json_plain(captures[2022]['sidecar']['genuine_recovery_witnesses']),
            policy='REJECT_INCREASE_WHEN_EITHER_TYPED_CELL_OR_INTERVAL_UNRECOVERED',original_source_age_and_arrival_flags_preserved=True,
            arrival_certified=False,native_venue_certified=False,actual_event_or_position_impacts='PENDING_FUTURE_ACTUAL_EXECUTION')
        endpoints=[s['native_endpoint_witness'] for s in captures.values()]
        identity=pure.digest(dict(ordered_source_identities=[s['source_identity'] for s in captures.values()],feature_clocks=pure.array_id(clocks),
            feature_close=pure.array_id(close),events=events,quality=quality,selected_months=[source_metadata.catalog()['years'][str(y)]['source_month_declarations'] for y in captures],endpoints=endpoints))
        if (clocks.tobytes()!=features['close_available_us'].tobytes() or close.tobytes()!=features['close'].tobytes()
                or pure.canonical(events)!=pure.canonical(b.c.object_json(artifacts['RAW_EVENTS.json']))
                or pure.canonical(quality)!=pure.canonical(b.c.object_json(artifacts['SOURCE_QUALITY.json']))
                or pure.canonical(endpoints)!=pure.canonical(b.c.object_json(artifacts['ENDPOINT_WITNESSES.json']))
                or identity!=prep['source_identity'] or arrays['decision_us'].tobytes()!=np.arange(a.START,a.END,pure.DAY,dtype='<i8').tobytes()):
            raise ValueError('EXACT_RECAPTURED_SOURCE_UNION_LITERAL_FUNDING_QUALITY_ENDPOINT_IDENTITY_REQUIRED')
