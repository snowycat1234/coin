                'ACTUAL_HELD_RISK_REPORT.json.gz':{'test_only_invented':True},'GUARD_RECEIPTS.json.gz':n.V2.OWNED.export_tree(guard.receipts),
                'CAUSAL_MARK_QUALITY.json.gz':{'identity':guard.causal_mark_quality_guard.identity,'receipts':n.V2.OWNED.export_tree(guard.causal_mark_quality_guard.receipts)},
                'ANNUAL_MARKED_SUBPERIODS.json.gz':subs,'ANNUAL_BOUNDARIES.json.gz':writer.boundaries,
                'LEGACY_PRIMARY_FINANCIAL_RECONCILIATION.json.gz':result['primary_financial_reconciliation']}
            pins={name:writer.budget.gzip(case/name,value) for name,value in bulky.items()};writer.budget.save(case/'COMPRESSED_JSON_PINS.json',pins)
            pid=os.getpid();parent=os.getppid();ticks=Path('/proc/self/stat').read_text().rsplit(') ',1)[1].split()[19]
