class Tests(unittest.TestCase):
    @classmethod
    def setUpClass(cls):cls.fixture=generated_fixture.build()
    def wires(self,output):
        code=e.code_identity();review=dict(schema='INDEPENDENT_CONTINUOUS_SOURCE_CODE_REVIEW_V1',
            status='PASS_SOURCE_CODE_GENERATED_ONLY_NO_ACTUAL_ADMISSION',code_manifest_SHA256=code,
            source_catalog_SHA256=p.digest(e.catalog()),historical_execution_authorized=False,account_construction_authorized=False,source_body_reads=0,
            test_scope='INVENTED_WIRES_ONLY_NOT_ROOT_AUTHORIZATION')
        rr=p.canonical(review);rs=sha256(rr).hexdigest()
        go=dict(schema=e.SCHEMA,action=e.ACTION,code_manifest_SHA256=code,source_catalog_SHA256=p.digest(e.catalog()),
            independent_source_code_review_SHA256=rs,ordered_years=list(e.YEARS),ordered_cells=list(p.CELLS),calendar=[p.HISTORICAL_START,p.HISTORICAL_END],
            source_reads_authorized=True,target_generation_authorized=True,historical_execution_authorized=False,account_construction_authorized=False,
            provider_iteration_authorized=False,process_launch_authorized=False,canonical_claims_authorized=False,financial_GO_authorized=False,
            downloads_authorized=False,holdout_reads_authorized=False,publication_authorized=False,output_directory=str(output),
            test_scope='INVENTED_WIRES_ONLY_NOT_ROOT_AUTHORIZATION')
        gr=p.canonical(go);return gr,sha256(gr).hexdigest(),rr,rs
    def test_exact_full_union_and_saved_annual_provenance(self):
        f=self.fixture
        with patch.object(e,'catalog',return_value=f.catalog):
            result=splice.qualify(f.captures,f.saved,f.old,f.core)
        self.assertEqual((len(result['clocks']),len(result['decisions']),len(result['events'])),(1934,1735,26100))
        self.assertEqual(len(result['annual_parity']),5);self.assertEqual(set(result['projection']['targets']),set(p.CELLS))
        self.assertEqual(len(result['quality']['cells']),27);self.assertEqual(len(result['quality']['later_interval_witnesses']),1)
        self.assertEqual(len(result['quality']['genuine_2022_recovery_witnesses']),8)
        self.assertEqual(result['quality']['later_interval_witnesses'][0]['original_genuine_observation_us'],1723456920000000)
        self.assertTrue(all(r['saved_legacy_STATIC50_and_CORE_HOLD_all_three_tiers_exact'] for r in result['annual_parity']))
    def test_overlap_endpoint_event_source_and_proof_negatives(self):
        f=self.fixture
        with patch.object(e,'catalog',return_value=f.catalog):
            captures=dict(f.captures);bad=dict(captures[2021]);bad['native_endpoint_close']=np.nextafter(bad['native_endpoint_close'],np.inf);captures[2021]=bad
            with self.assertRaisesRegex(ValueError,'ENDPOINT'):splice.qualify(captures,f.saved,f.old,f.core)
            captures=dict(f.captures);bad=dict(captures[2022]);a=bad['close'].copy();a[0,0]=np.nextafter(a[0,0],np.inf);bad['close']=a;captures[2022]=bad
            with self.assertRaisesRegex(ValueError,'OVERLAP_BIT'):splice.qualify(captures,f.saved,f.old,f.core)
            captures=dict(f.captures);bad=dict(captures[2025]);events=list(bad['events']);events[-1]=dict(events[-1],event_us=p.HISTORICAL_END);bad['events']=events;captures[2025]=bad
            with self.assertRaisesRegex(ValueError,'BEYOND_YEAR_ENDPOINT'):splice.qualify(captures,f.saved,f.old,f.core)
            captures=dict(f.captures);bad=dict(captures[2023],source_identity='0'*64);captures[2023]=bad
            with self.assertRaisesRegex(ValueError,'SOURCE_IDENTITY'):splice.qualify(captures,f.saved,f.old,f.core)
            # Saved proof tamper is rejected without needing to rebuild full union.
            year=2021;source=f.captures[year];lp=deepcopy(f.saved[year][1]);lp['proofs'][0]['CS_weekly_rank_us']+=p.DAY
            projection=splice.targets_from_union(source['clocks'],source['close'],source['decisions'],f.old,f.core)
            with self.assertRaisesRegex(ValueError,'CAUSAL_PROVENANCE'):
                splice.verify_saved_annual(source,f.saved[year][0],lp,f.saved[year][2],f.saved[year][3],projection,np.arange(len(source['decisions'])),f.old,f.core)
    def test_fresh_authority_fails_before_any_body_reader(self):
        gr,gs,rr,rs=self.wires('/tmp/INVENTED_OUTPUT')
        for field,value in [('action','OLD_ANNUAL_GO'),('account_construction_authorized',True),('ordered_cells',list(p.CELLS)[:-1]),('calendar',[p.HISTORICAL_START,p.HISTORICAL_END+1]),('code_manifest_SHA256','0'*64),('downloads_authorized',True)]:
            bad=json.loads(gr);bad[field]=value;raw=p.canonical(bad)
            with patch.object(e,'read_body',side_effect=AssertionError('BODY_READER_MUST_NOT_FIRE')):
                with self.assertRaises(ValueError):e.validate_authority(raw,sha256(raw).hexdigest(),rr,rs)
        with self.assertRaises(ValueError):e.validate_authority(gr,'0'*64,rr,rs)
        with self.assertRaises(ValueError):e.require_scope(type('Fake',(),{'validate_current':lambda s:True})())
        with self.assertRaises(PermissionError):e.historical_finance({'generated':True,'old_GO':True})
    def test_direct_body_read_denied_before_go_and_after_scope_revocation(self):
        folder=e.HERE/'generated_test_inputs';folder.mkdir(exist_ok=True);path=folder/'INVENTED_SENTINEL.npz'
        if not path.exists():path.write_bytes(b'INVENTED_SOURCE_BODY_NOT_MARKET_DATA')
        name=str(path.relative_to(e.ROOT));pin=dict(SHA256=sha256(path.read_bytes()).hexdigest(),bytes=path.stat().st_size)
        gr,gs,rr,rs=self.wires('/tmp/INVENTED_OUTPUT')
        body=dict(e.body_allowlist(),**{name:pin})
        with patch.object(e,'body_allowlist',return_value=body):
            guard=e.ContinuousSourceGuard()
            with self.assertRaises(SourceBoundaryViolation):
                with guard:path.read_bytes()
            self.assertEqual(guard.attempts['nonallowlisted_file_reads'],1)
            guard=e.ContinuousSourceGuard()
            with self.assertRaises(SourceBoundaryViolation):
                with guard:
                    with e.admit_source(gr,gs,rr,rs) as scope:
                        self.assertEqual(e.read_body(scope,2021,name,pin['SHA256'],pin['bytes']),b'INVENTED_SOURCE_BODY_NOT_MARKET_DATA')
                    self.assertFalse(e._LIVE)
                    with self.assertRaises(ValueError):e.read_body(scope,2021,name,pin['SHA256'],pin['bytes'])
                    path.read_bytes()
            self.assertEqual(guard.attempts['nonallowlisted_file_reads'],1)
    def test_forbidden_attempt_revokes_scope_even_when_caught_and_new_guard_cannot_reuse(self):
        gr,gs,rr,rs=self.wires('/tmp/INVENTED_OUTPUT');scope=None
        guard=e.ContinuousSourceGuard()
        with self.assertRaises(SourceBoundaryViolation):
            with guard:
                with e.admit_source(gr,gs,rr,rs) as scope:
                    try:(e.HERE/'INVENTED_FORBIDDEN_SOURCE_SENTINEL').read_bytes()
                    except SourceBoundaryViolation:pass
        self.assertFalse(e._LIVE);self.assertIsNone(guard._body_scope)
        with e.ContinuousSourceGuard():
            with self.assertRaises(ValueError):e.require_scope(scope)
    def test_saved_reference_loader_raw_and_namespaced_conventions(self):
        f=self.fixture;fake=deepcopy(f.catalog);bodies={}
