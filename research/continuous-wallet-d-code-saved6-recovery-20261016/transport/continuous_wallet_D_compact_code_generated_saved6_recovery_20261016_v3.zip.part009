def write(path,raw):
    path=Path(path)
    if path.exists() or path.is_symlink():raise FileExistsError('IMMUTABLE_SOURCE_OUTPUT_ALREADY_EXISTS')
    if __import__('shutil').disk_usage(path.parent).free<len(raw)+1500000000:raise RuntimeError('DISK_RESERVE_STOP_BEFORE_SOURCE_WRITE')
    temp=path.with_name(path.name+'.tmp')
    with temp.open('xb') as stream:stream.write(raw);stream.flush();os.fsync(stream.fileno())
    os.replace(temp,path)
    fd=os.open(path.parent,os.O_RDONLY|os.O_DIRECTORY)
    try:os.fsync(fd)
    finally:os.close(fd)
    return dict(SHA256=sha256(raw).hexdigest(),bytes=len(raw))

def save(path,value):return write(path,pure.canonical(value)+b'\n')

def npz(arrays):
    buf=BytesIO();np.savez_compressed(buf,**arrays);return buf.getvalue()

def preload_source_math():
    # The unchanged CORE builder constructs every canonical proof internally,
    # including H090, even though this experiment selects only HOLD. Warm that
    # exact code dependency before the whole-invocation source guard forbids
    # dynamic loaders. This does not build a target or open a market body.
    old,core=pure.load_math()
    old.originals();core.originals();core._h090()
    e.backend.quality.original_quality();e.backend.codec.mark2024()
    if core._H090 is None:raise ValueError('EXACT_CORE_TARGET_CODE_PRELOAD_REQUIRED')
    return old,core

def saved_references(scope,year):
    rec=e.year_record(year);old={}
    for name,pin in rec['saved'].items():old[name]=e.read_body(scope,year,pin['path'],pin['SHA256'],pin['bytes'])
    count=rec['annual_year_metadata']['days']
    oldspec={key:(tuple(pin['shape']),pin['dtype']) for key,pin in rec['annual_year_metadata']['array_identities'].items()}
    legacy=e.backend.codec.npz(old['TARGETS.npz'],oldspec)
    for key,pin in rec['annual_year_metadata']['array_identities'].items():
        if sha256(legacy[key].tobytes()).hexdigest()!=pin['raw_bytes_SHA256']:raise ValueError('EXACT_SAVED_LEGACY_ARRAY_IDENTITY_REQUIRED')
    core_rec=e.catalog()['core_saved_target_lineage'][str(year)];core_raw={}
    for name,pin in core_rec['artifacts'].items():core_raw[name]=e.read_body(scope,year,pin['path'],pin['SHA256'],pin['bytes'])
    selected={'decision_us':((count,),'int64'),'annual_covariance':((count,5,5),'float64')}
    selected.update({'VOL_MANAGED_HOLD_'+t:((count,5),'float64') for t in pure.TIERS})
    # Headers of selected fields are bounded before allocation; the full archive
    # pin binds all nine arrays, while unrelated recipe payloads are not loaded.
    core=e.backend.codec.npz(core_raw['TARGETS.npz'],selected,allow_unselected=True)
    for field,key in (('decision_raw_SHA256','decision_us'),('covariance_raw_SHA256','annual_covariance')):
        if core_rec.get(field) is not None and sha256(core[key].tobytes()).hexdigest()!=core_rec[field]:
            raise ValueError('EXACT_CORE_SAVED_DECISION_COVARIANCE_IDENTITY_REQUIRED')
    namespace=json.dumps(list(pure.SYMBOLS),separators=(',',':')).encode()+core['decision_us'].astype('<i8').tobytes()
    for key,pin in core_rec['target_arrays'].items():
        convention=pin['digest_convention']
        if convention=='sha256(target_<f8_C_bytes)':got=sha256(core[key].tobytes()).hexdigest();expected=pin['raw_bytes_SHA256']
        elif 'symbol' in convention.lower() or 'namespace' in convention.lower():
            got=sha256(namespace+core[key].tobytes()).hexdigest();expected=pin.get('symbol_decision_target_SHA256')
        else:raise ValueError('EXACT_CORE_TARGET_DIGEST_CONVENTION_REQUIRED')
        if got!=expected:raise ValueError('EXACT_CORE_SAVED_TARGET_IDENTITY_REQUIRED:'+key)
    return legacy,e.backend.c.object_json(old['TARGET_PROOFS.json']),core,e.backend.c.object_json(core_raw['TARGET_PROOFS.json']),old


def prepare_source_only(output,*,go_raw,go_sha,review_raw,review_sha):
    authority=e.validate_authority(go_raw,go_sha,review_raw,review_sha)
    output=Path(output).absolute();base=e.HERE/'source_attempts'
    if (output.parent!=base or output.exists() or output.is_symlink() or any(p.is_symlink() for p in output.parents)):
        raise ValueError('NEW_SINGLE_OWNED_CONTINUOUS_SOURCE_ATTEMPT_DIRECTORY_REQUIRED')
    go=e.backend.c.exact_object(go_raw)
    if go.get('output_directory')!=str(output):raise ValueError('EXACT_ROOT_BOUND_SOURCE_OUTPUT_DIRECTORY_REQUIRED')
    # Complete numerical/code loading occurs before the guard, but only code and
    # pinned metadata are touched. Then the clean guard covers every body read,
    # target construction, proof and output in the entire source invocation.
    old,core=preload_source_math()
    base.mkdir(exist_ok=True);output.mkdir(exist_ok=False)
    guard=e.ContinuousSourceGuard(write_roots=(output,))
    began=time.monotonic();captures={};references={};pins={}
    try:
        with guard:
            guard.checkpoint('SOURCE_TARGET_CODE_DEPENDENCIES_PRELOADED_BEFORE_GUARD_NO_TARGET_OR_BODY_READ')
            guard.checkpoint('EXACT_NEW_CONTINUOUS_SOURCE_ONLY_ROOT_AND_REVIEW_BOUND_BEFORE_BODY_READ')
            with e.admit_source(go_raw,go_sha,review_raw,review_sha) as scope:
                for year in e.YEARS:
                    rec=e.year_record(year)
                    captures[year]=e.backend.capture_year(scope,year,rec['contract'])
                    legacy,lp,core_arrays,cp,saved=saved_references(scope,year)
                    captured=captures[year]
                    # Saved source/quality/funding provenance is independently
                    # preserved before any new concatenation or target math.
                    inputs=e.backend.codec.npz(saved['SOURCE_INPUTS.npz'],{'close_available_us':((len(captured['clocks']),),'int64'),'close':((len(captured['clocks']),5),'float64')})
                    if (inputs['close_available_us'].tobytes()!=captured['clocks'].tobytes() or inputs['close'].tobytes()!=captured['close'].tobytes()
                            or saved['MINUTE_MARK_PROVENANCE.json']!=captured['sidecar_raw']
                            or pure.canonical(e.backend.c.object_json(saved['RAW_EVENTS.json']))!=pure.canonical(captured['events'])
                            or pure.canonical(e.backend.c.object_json(saved['SOURCE_ROWS.json']))!=pure.canonical(captured['source_rows'])):
                        raise ValueError('EXACT_ANNUAL_SAVED_SOURCE_QUALITY_LITERAL_FUNDING_AND_ROWS_REQUIRED:'+str(year))
                    if year==2022 and pure.canonical(e.backend.c.object_json(saved['NORMALIZATION_EQUIVALENCE.json']))!=pure.canonical(captured['normalization_equivalence']):
                        raise ValueError('EXACT_2022_MEMORY_ONLY_NORMALIZATION_EQUIVALENCE_REQUIRED')
                    references[year]=(legacy,lp,core_arrays,cp)
                guard.checkpoint('ALL_FIVE_PINNED_ANNUAL_SOURCES_AND_SAVED_TARGET_REFERENCES_CAPTURED_NO_ACCOUNT')
                value=splice.qualify(captures,references,old,core)
                guard.checkpoint('EXACT_CROSS_YEAR_BITS_ENDPOINTS_TARGETS_COVARIANCE_AND_CAUSAL_PROVENANCE_PARITY_ACCEPTED')
                arrays={'decision_us':value['decisions'],'annual_covariance':value['projection']['annual_covariance'],**value['projection']['targets']}
                outputs={'SOURCE_INPUTS.npz':npz(dict(close_available_us=value['clocks'],close=value['close'])),
                    'TARGETS.npz':npz(arrays),'RAW_EVENTS.json':pure.canonical(value['events'])+b'\n',
                    'SOURCE_QUALITY.json':pure.canonical(value['quality'])+b'\n',
                    'ANNUAL_PARITY.json':pure.canonical(value['annual_parity'])+b'\n',
                    'ENDPOINT_WITNESSES.json':pure.canonical(value['endpoint_witnesses'])+b'\n',
                    'TARGET_PROVENANCE.json.gz':gzip.compress(pure.canonical(dict(original=value['projection']['old_proofs'],core=value['projection']['core_proofs']))+b'\n',compresslevel=6,mtime=0),
                    'ROOT_SOURCE_ONLY_INPUT.json':go_raw,'INDEPENDENT_SOURCE_CODE_REVIEW.json':review_raw}
                for name,raw in outputs.items():pins[name]=write(output/name,raw)
                prepared=dict(schema='CONTINUOUS_SOURCE_ONLY_PREPARATION_V1',status='PASS_SOURCE_TARGET_QUALIFICATION_ONLY_NO_FINANCE',
                    calendar=[pure.HISTORICAL_START,pure.HISTORICAL_END],days=1735,execution_minutes=2498400,
                    unique_feature_rows=1934,ordered_years=list(e.YEARS),ordered_cells=list(pure.CELLS),
                    source_identity=value['source_identity'],component_source_identities=[captures[y]['source_identity'] for y in e.YEARS],
                    code_manifest_SHA256=authority['code'],source_catalog_SHA256=authority['catalog'],root_source_GO_SHA256=go_sha,
                    independent_source_code_review_SHA256=review_sha,artifacts=pins,
                    array_identities={key:pure.array_id(a) for key,a in arrays.items()},
                    annual_parity=value['annual_parity'],funding_events=26100,literal_rates_clocks_intervals_order_preserved=True,
                    quality_cells=27,quality_later_2024_interval=1,quality_2022_genuine_recovery_witnesses=8,
                    financial_runs=0,accounts_constructed=0,providers_constructed=0,provider_iterations=0,
                    canonical_financial_claims=0,real_financial_GO_written=0,downloads=0,holdout_reads=0,publication=0,
                    historical_admission=False,financial_snapshot_resume=False,wall_seconds=time.monotonic()-began)
                pins['PREPARATION.json']=save(output/'PREPARATION.json',prepared)
            if e._LIVE:raise ValueError('ALL_CONTINUOUS_SOURCE_SCOPES_MUST_REVOKE')
            guard.checkpoint('SOURCE_OUTPUTS_DURABLE_AND_ALL_SOURCE_SCOPES_REVOKED')
        receipt=guard.receipt('PASS_CONTINUOUS_SOURCE_ONLY_QUALIFICATION')
        receipt.update(source_scopes_revoked=not e._LIVE,code_manifest_SHA256=authority['code'],source_identity=value['source_identity'])
        save(output/'SOURCE_GUARD_RECEIPT.json',receipt)
        save(output/'SOURCE_TERMINAL_CHECKPOINT.json',dict(schema='CONTINUOUS_SOURCE_ONLY_COMPLETE_CHECKPOINT_V1',artifacts=pins,
            source_guard_receipt_SHA256=sha256((output/'SOURCE_GUARD_RECEIPT.json').read_bytes()).hexdigest(),
            historical_execution_authorized=False,financial_execution_authorized=False,source_only=True))
        return prepared
    except BaseException as error:
        failed=guard.receipt('STOP_CONTINUOUS_SOURCE_ONLY_QUALIFICATION',repr(error))
        failed.update(source_scopes_revoked=not e._LIVE,source_body_phase_revoked=guard._body_scope is None)
        save(output/'FAILED_SOURCE_GUARD_RECEIPT.json',failed)
        save(output/'SOURCE_FAILURE.json',dict(status='SOURCE_QUALIFICATION_BLOCKED_NO_ACCOUNT_CONSTRUCTED',error=repr(error),traceback=traceback.format_exc(),historical_admission=False))
        raise


def main():
    import argparse
    parser=argparse.ArgumentParser(description=__doc__)
    for name in ('go','go-sha','review','review-sha','output'):parser.add_argument('--'+name,required=True)
    parser.add_argument('--cpu',type=int,choices=(7,8),required=True);args=parser.parse_args();os.sched_setaffinity(0,{args.cpu})
    # Input wires are metadata. No market/source/target body is read here.
    result=prepare_source_only(args.output,go_raw=Path(args.go).read_bytes(),go_sha=args.go_sha,
        review_raw=Path(args.review).read_bytes(),review_sha=args.review_sha)
    print(json.dumps(dict(status=result['status'],source_identity=result['source_identity'],output=args.output)),flush=True)
if __name__=='__main__':main()
