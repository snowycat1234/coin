class ContinuousMinuteProvider:
    def __init__(self,binding,captures):self.binding=binding;self.captures=captures;self.scope=None;self.iterations=0
    def bind(self,scope):
        a.require_execution_scope(scope)
        if self.scope is not None or scope._binding is not self.binding:raise ValueError('ONE_EXACT_PROVIDER_SCOPE_BINDING_REQUIRED')
        self.scope=scope
    def __call__(self):
        a.require_execution_scope(self.scope)
        if self.iterations:raise ValueError('ONE_CONTINUOUS_PROVIDER_LIFECYCLE_NO_RESTART')
        self.iterations+=1;cursor=a.START
        for year,source in self.captures.items():
            for rec,(name,raw) in zip(source['contract']['months'],source['months'],strict=True):
                a.require_execution_scope(self.scope)
                if (name!=rec['path'] or sha256(raw).hexdigest()!=rec['hash'] or len(raw)!=rec['size']
                        or rec['start']+rec['lo']*a.MINUTE!=cursor):raise ValueError('EXACT_ONCE_PINNED_MONTH_CONTINUOUS_CALENDAR_REQUIRED')
                arrays,_=b.codec.month_arrays(year,raw,rec['start'],rec['count'],source['quality_cells'])
                for off in range(rec['lo'],rec['hi'],1440):
                    a.require_execution_scope(self.scope);stop=min(off+1440,rec['hi'])
                    yield dict(times=arrays['times'][off:stop],market={s:{k:arrays[s+'_'+k][off:stop] for k in ('open','close','quote_volume','mark')} for s in a.SYMBOLS})
                cursor=rec['start']+rec['hi']*a.MINUTE
        if cursor!=a.END:raise ValueError('COMPLETE_CONTINUOUS_PROVIDER_CALENDAR_REQUIRED')

