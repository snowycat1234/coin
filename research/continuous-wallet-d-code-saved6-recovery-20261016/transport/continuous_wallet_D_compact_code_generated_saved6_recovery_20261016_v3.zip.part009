No annual capability, generated flag, old GO, or saved checkpoint is authority.
No account, source reader, claim, lease or process is created on import.
"""
from contextlib import contextmanager
from dataclasses import dataclass,field
from hashlib import sha256
from pathlib import Path
from types import MappingProxyType
import json
import os

HERE=Path(__file__).resolve().parent;ROOT=HERE.parent
VERSION='CONTINUOUS_WALLET_D_EXACT_SIX_SEEN_DEV_V1'
START=1617321600000000;END=1767225600000000;MINUTE=60000000
SYMBOLS=('BTCUSDT','ETHUSDT','SOLUSDT','XRPUSDT','DOGEUSDT')
RECIPES=('STATIC50_OLD_NO_REEXPANSION','VOL_MANAGED_HOLD');TIERS=('LOW','MID','HIGH')
CELLS=tuple(r+'_'+t for r in RECIPES for t in TIERS)
LIMITS=dict(max_workers=1,CPU_seconds=2400,wall_seconds=2700,RSS_bytes=4500000000,AS_bytes=7000000000,
    case_output_bytes=700000000,cohort_output_bytes=4200000000,free_disk_floor_bytes=1500000000,available_memory_before_launch_bytes=5500000000)
CLAIMS=ROOT/'continuous_wallet_D_EXECUTION_CLAIMS_20261015_v1'
SHARED_LEASE=ROOT/'original_cs_mom21_D_20261015_v4/EXECUTION_CLAIMS/9a5ef547d61272d5eb0bfb1b61fef8005a752d82f4e0007d18cbe65f06445a8a/CONTROLLER_LEASE.lock'
_SEAL=object();_BINDINGS={};_LIVE={};_CONSTRUCTED=set()


def canonical(v):return json.dumps(v,sort_keys=True,separators=(',',':'),allow_nan=False).encode()
def digest(v):return sha256(canonical(v)).hexdigest()
def sha(raw):return sha256(raw).hexdigest()
def exact(path,pin):
    p=Path(path)
    if p.is_symlink() or any(x.is_symlink() for x in p.parents):raise ValueError('ORDINARY_EXACT_INPUT_PATH_REQUIRED')
    raw=p.read_bytes()
    if type(pin) is not dict or len(raw)!=pin['bytes'] or sha(raw)!=pin['SHA256']:raise ValueError('EXTERNAL_PIN_MISMATCH:'+str(path))
    return raw

def pinned(pin):
    rel=Path(pin['path'])
    if rel.is_absolute() or '..' in rel.parts:raise ValueError('ORDINARY_WORKSPACE_RELATIVE_PIN_REQUIRED')
    return exact(ROOT/rel,pin)

def code_identity():
    raw=(HERE/'FINANCIAL_CODE_MANIFEST.json').read_bytes();m=json.loads(raw)
    for name,pin in m['files'].items():exact(HERE/name,pin)
    for name,pin in m['dependencies'].items():pinned(dict(path=name,**pin))
    return sha(raw)

def validate_wire(go_raw,go_sha,review_raw,review_sha):
    if sha(go_raw)!=go_sha or sha(review_raw)!=review_sha:raise ValueError('EXACT_EXTERNAL_ROOT_AND_REVIEW_HASHES_REQUIRED')
    go=json.loads(go_raw);review=json.loads(review_raw);code=code_identity()
    required=dict(schema='ROOT_CONTINUOUS_WALLET_D_FINANCIAL_PILOT_V1',action='RUN_FIRST_PREDECLARED_CONTINUOUS_ACCOUNT_ONCE_AS_RESOURCE_PILOT',
        code_manifest_SHA256=code,independent_financial_code_review_SHA256=review_sha,ordered_cohort=list(CELLS),launch_cells=[CELLS[0]],
        calendar=[START,END],cost='BASE27',initial_cash_USDT=10000,limits=LIMITS,source_recap_authorized=True,
        historical_offline_execution_authorized=True,financial_accounts=1,serial=True,first_account_counts_once=True,
        annual_wallet_reset=False,automatic_retry=False,snapshot_resume=False,downloads=False,holdout_reads=False,publication=False,
        pilot_following_accounts_require_fresh_root_release=True)
    if type(go) is not dict or any(type(go.get(k)) is not type(v) or canonical(go[k])!=canonical(v) for k,v in required.items()):
        raise ValueError('FRESH_EXACT_FIRST_OF_SIX_CONTINUOUS_FINANCIAL_PILOT_GO_REQUIRED')
    out=Path(go.get('controller_output',''))
    if (type(go.get('CPU')) is not int or go['CPU'] not in (4,5) or not out.is_absolute()
            or out.parent!=HERE/'financial_attempts' or out.is_symlink() or any(p.is_symlink() for p in out.parents)):
        raise ValueError('EXACT_ROOT_SELECTED_RELEASED_CPU_AND_OWNED_CONTROLLER_OUTPUT_REQUIRED')
    expected=dict(schema='INDEPENDENT_CONTINUOUS_FINANCIAL_CODE_REVIEW_V1',status='PASS_CODE_GENERATED_ONLY_NO_FINANCIAL_GO',
        code_manifest_SHA256=code,ordered_cohort=list(CELLS),calendar=[START,END],financial_runs=0)
    if type(review) is not dict or any(type(review.get(k)) is not type(v) or canonical(review[k])!=canonical(v) for k,v in expected.items()):
        raise ValueError('EXACT_INDEPENDENT_CONTINUOUS_FINANCIAL_CODE_REVIEW_REQUIRED')
    preparation=json.loads(pinned(go['prepared_source']));audit=json.loads(pinned(go['prepared_source_audit']))
    if any(type(preparation.get(k)) is not int for k in ('days','execution_minutes','accounts_constructed')):
        raise ValueError('EXACT_SOURCE_PREPARATION_INTEGER_TYPES_REQUIRED')
    if (preparation.get('status')!='PASS_SOURCE_TARGET_QUALIFICATION_ONLY_NO_FINANCE' or preparation.get('ordered_cells')!=list(CELLS)
            or preparation.get('calendar')!=[START,END] or preparation.get('days')!=1735 or preparation.get('execution_minutes')!=2498400
            or preparation.get('accounts_constructed')!=0 or preparation.get('historical_admission') is not False
            or preparation.get('code_manifest_SHA256')!='6f0b5ae1e463478b38ee78fc7c21abf6c272f21272bcca7de4c39257d5c9cd6b'
            or preparation.get('source_catalog_SHA256')!='2e29b1bf2048890e7b9ca441d8ca7803e8f01240ffb46653ddbf00c3b40bccf4'
            or preparation.get('independent_source_code_review_SHA256')!='89aa549c6dc32bd09cb2fe03b8135f01fc8ffe9bc3587fb764978604a20da86e'
            or audit.get('status')!='PASS_ACTUAL_PREPARED_SOURCE_NO_FINANCIAL_ADMISSION'
            or audit.get('preparation_SHA256')!=go['prepared_source']['SHA256']
            or audit.get('source_identity')!=preparation.get('source_identity')
            or review.get('prepared_source_audit_SHA256')!=go['prepared_source_audit']['SHA256']):
        raise ValueError('EXACT_INDEPENDENTLY_AUDITED_ACTUAL_SOURCE_PREPARATION_REQUIRED')
    return go,preparation


def require_binding(binding):
    if type(binding) is not WorkerBinding or binding._seal is not _SEAL or _BINDINGS.get(binding._token) is not binding:
        raise ValueError('LIVE_EXACT_CONTROLLER_CLAIM_AND_WIRE_BOUND_WORKER_REQUIRED')
    return binding

@dataclass(frozen=True,slots=True)
class WorkerBinding:
    go:object=field(repr=False);preparation:object=field(repr=False);cell_id:str
    _token:object=field(repr=False);_seal:object=field(repr=False)
    def __post_init__(self):
        if self._seal is not _SEAL:raise ValueError('ENTRY_OWNED_WORKER_BINDING_REQUIRED')

@contextmanager
def admit_worker(go_raw,go_sha,review_raw,review_sha,*,claim_raw,claim_sha,lease_fds):
    go,prep=validate_wire(go_raw,go_sha,review_raw,review_sha)
    if sha(claim_raw)!=claim_sha:raise ValueError('EXACT_PERMANENT_CLAIM_REQUIRED')
    claim=json.loads(claim_raw);cell=CELLS[0]
    if (claim.get('cell_id')!=cell or claim.get('root_GO_SHA256')!=go_sha or claim.get('source_identity')!=prep['source_identity']
            or claim.get('status')!='RESERVED_BEFORE_SPAWN_NO_AUTOMATIC_RETRY' or claim.get('code_manifest_SHA256')!=go['code_manifest_SHA256']
            or claim.get('case_output')!=str(Path(go['controller_output'])/cell)
