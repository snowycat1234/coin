    files={p.name:dict(SHA256=sha256(p.read_bytes()).hexdigest(),bytes=p.stat().st_size) for p in case.iterdir() if p.is_file()}
    writer.budget.save(case/'WORKER_COMPLETE_NOT_TERMINAL.json',dict(schema='CONTINUOUS_WORKER_CANDIDATE_V1',cell_id=a.RELEASED_CELLS[0],files=files,
        classification=classification,native40_proof_passed=True,execution_scopes_revoked=True,inputs_revoked=True,worker_binding_revoked=True,financial_terminal_admitted=False))
    (root/'INVENTED_EXPECTATIONS.json').write_text(json.dumps(dict(expected=expected,calendar=[start,end],test_only_invented=True)))

class TerminalGeneratedTests(unittest.TestCase):
    def test_owned_native_exit_and_real_saved_gate(self):
        with tempfile.TemporaryDirectory(prefix='CONTINUOUS_INVENTED_TERMINAL_',dir=HERE) as root:
            cmd=[str(HERE.parent/'coin_partial_restore_20261014/.venv/bin/python'),'-B',str(Path(__file__)),'--build-invented-candidate',root]
            process=subprocess.Popen(cmd,stdout=subprocess.PIPE,stderr=subprocess.PIPE,text=True)
            stdout,stderr=process.communicate(timeout=60)
            self.assertEqual(process.returncode,0,msg=stdout+stderr)
            import continuous_admission as a
            import continuous_terminal as terminal
            wire=json.loads((Path(root)/'INVENTED_EXPECTATIONS.json').read_bytes());expected=wire['expected'];expected['actual_shell_exit_code']=process.returncode
            with patch.object(a,'START',wire['calendar'][0]),patch.object(a,'END',wire['calendar'][1]):
                proof=terminal.validate_saved_terminal(Path(root)/a.RELEASED_CELLS[0],expected=expected)
                self.assertTrue(proof['native40_reconstructed']);self.assertEqual(proof['completed_minutes'],5760)
                for key,value in [('actual_shell_exit_code',1),('source_identity','0'*64),('worker_start_ticks','0'),('quality_sidecar_SHA256','0'*64)]:
                    bad=dict(expected,**{key:value})
                    with self.assertRaises(ValueError):terminal.validate_saved_terminal(Path(root)/a.RELEASED_CELLS[0],expected=bad)
                chunk=next((Path(root)/a.RELEASED_CELLS[0]).glob('MINUTE_*.npz'));raw=chunk.read_bytes();chunk.write_bytes(raw[:-1]+bytes([raw[-1]^1]))
                with self.assertRaises(ValueError):terminal.validate_saved_terminal(Path(root)/a.RELEASED_CELLS[0],expected=expected)
    def test_preallocation_npz_header_rejected(self):
        import continuous_terminal as terminal
        import numpy as np
        from io import BytesIO
        for shape,dtype in [((1441,36),'<f8'),((2,35),'<f8'),((2,36),'<f4')]:
            buf=BytesIO();np.savez_compressed(buf,values=np.zeros(shape,dtype=dtype))
            with self.assertRaises(ValueError):terminal.bounded_chunk(buf.getvalue(),2)

if __name__=='__main__':
    if len(sys.argv)==3 and sys.argv[1]=='--build-invented-candidate':build_invented(sys.argv[2])
    else:unittest.main(verbosity=2)
