    @contextmanager
    def _invented_binding(self, prep=None):
        sentinel = SimpleNamespace(cell_id=a.CELLS[0],
            go=MappingProxyType(dict(prepared_source=dict(path=str(
                (self.artifact_root / 'INVENTED_PREPARATION.json').relative_to(a.ROOT))))),
            preparation=MappingProxyType(prep or dict(source_identity='INVENTED_ONLY')))
        def require(value):
            if value is not sentinel:
                raise ValueError('EXACT_TEST_ONLY_INVENTED_BINDING_SENTINEL_REQUIRED')
            return value
        with patch.object(a, 'require_binding', side_effect=require):
            yield sentinel

    def test_real_execution_scope_exact_references_constructor_consumption_and_revocation(self):
        with self._invented_binding() as binding:
            values = MappingProxyType(dict(window=object(), rows=(), decisions=p.frozen([1], '<i8'),
                target=p.frozen([[0.] * 5]), quality_cells=(), quality_intervals=(),
                later_interval_witnesses=(), quality_sidecar_sha256='a' * 64, provider=_InventedSink()))
            token = object()
            loaded = i.LoadedInputs(binding, values, token, i._SEAL)
            i._INPUTS[token] = loaded
            self.addCleanup(i._INPUTS.pop, token, None)
            with self.assertRaisesRegex(ValueError, 'EXACT_SEALED_VERIFIED_CONTINUOUS_INPUTS'):
                i.require_inputs(loaded, object())
            with a.admit_execution(binding, loaded) as scope:
                self.assertTrue(scope.validate_current())
                self.assertTrue(scope.validate_inputs(loaded['window'], loaded['rows'],
                    loaded['decisions'], loaded['target']))
                for key in ('window', 'rows', 'decisions', 'target'):
                    args = [loaded[k] for k in ('window', 'rows', 'decisions', 'target')]
                    args[('window', 'rows', 'decisions', 'target').index(key)] = object()
                    with self.assertRaisesRegex(ValueError, 'EXACT_BOUND_IMMUTABLE'):
                        scope.validate_inputs(*args)
                self.assertEqual((scope.cell_id, scope.recipe, scope.tier_name),
                    (a.CELLS[0], a.RECIPES[0], 'LOW'))
                a.consume_construction(scope)  # Token accounting only; no account.
                with self.assertRaisesRegex(ValueError, 'ONE_ACCOUNT_CONSTRUCTOR'):
                    a.consume_construction(scope)
                forged = replace(scope, cell_id=a.CELLS[1])
                with self.assertRaisesRegex(ValueError, 'LIVE_EXACT_CONTINUOUS_EXECUTION_SCOPE'):
                    a.require_execution_scope(forged)
                for key, bad in [('cell_id', a.CELLS[1]), ('tier_name', 'MID'),
                        ('recipe', a.RECIPES[1]), ('source_identity', 'OTHER_INVENTED'),
                        ('source_scope', 'OLD_ANNUAL_SCOPE'), ('generated_only', True),
                        ('quality_cells', (object(),)), ('quality_intervals', ((1, 2, ()),)),
                        ('later_interval_witnesses', (object(),)),
                        ('quality_sidecar_sha256', '0' * 64)]:
                    before = getattr(scope, key)
                    object.__setattr__(scope, key, bad)
                    try:
                        with self.subTest(scope_field=key):
                            with self.assertRaisesRegex(ValueError, 'EXACT_CONTINUOUS_SCOPE_COHORT_SOURCE_AND_QUALITY'):
                                a.require_execution_scope(scope)
                    finally:
                        object.__setattr__(scope, key, before)
                self.assertIs(values['provider'].bound, scope)
                i.revoke_inputs(loaded)
                with self.assertRaisesRegex(ValueError, 'EXACT_SEALED_VERIFIED_CONTINUOUS_INPUTS'):
                    scope.validate_current()
            self.assertNotIn(scope._token, a._LIVE)
            with self.assertRaisesRegex(ValueError, 'LIVE_EXACT_CONTINUOUS_EXECUTION_SCOPE'):
                scope.validate_current()
            with self.assertRaisesRegex(ValueError, 'EXACT_SEALED_VERIFIED_CONTINUOUS_INPUTS'):
                i.require_inputs(loaded, binding)

    def test_recapture_guard_exact_reads_forbidden_attempt_poison_and_revocation(self):
        allowed = self.case / 'INVENTED_ALLOWLISTED_BODY'
        denied = self.case / 'INVENTED_FORBIDDEN_BODY'
        allowed.write_bytes(b'INVENTED_ONLY')
        denied.write_bytes(b'INVENTED_FORBIDDEN_ONLY')
        with self._invented_binding() as binding:
            guard = i.RecaptureGuard(read_paths=[allowed])
            token = object()
            scope = i.CaptureScope(binding, guard, token, i._SEAL)
            with guard:
                i._CAPTURES[token] = scope
                try:
                    self.assertIs(i.require_capture(scope), scope)
                    self.assertEqual(allowed.read_bytes(), b'INVENTED_ONLY')
                finally:
                    i._CAPTURES.pop(token, None)
                with self.assertRaisesRegex(ValueError, 'LIVE_EXACT_FINANCE_BOUND_RECAPTURE'):
                    i.require_capture(scope)
            self.assertFalse(guard.active)
            poisoned = i.RecaptureGuard(read_paths=[allowed])
            with self.assertRaises(SourceBoundaryViolation):
                with poisoned:
                    with self.assertRaises(SourceBoundaryViolation):
                        denied.read_bytes()
                    with self.assertRaisesRegex(SourceBoundaryViolation, 'FATAL_EVEN_IF_CAUGHT'):
                        poisoned.checkpoint('INVENTED_AFTER_CAUGHT_DENIAL')
            self.assertEqual(poisoned.attempts['nonallowlisted_file_reads'], 1)
            self.assertFalse(poisoned.active)

    def _prepared(self):
        q = self.qualified
        arrays = dict(decision_us=q['decisions'], annual_covariance=q['projection']['annual_covariance'],
            **q['projection']['targets'])
        blobs = {'SOURCE_INPUTS.npz': i.source_runner.npz(dict(close_available_us=q['clocks'], close=q['close'])),
            'TARGETS.npz': i.source_runner.npz(arrays),
            'RAW_EVENTS.json': p.canonical(q['events']) + b'\n',
            'SOURCE_QUALITY.json': p.canonical(q['quality']) + b'\n',
            'ENDPOINT_WITNESSES.json': p.canonical(q['endpoint_witnesses']) + b'\n',
            'ANNUAL_PARITY.json': p.canonical(q['annual_parity']) + b'\n',
            'TARGET_PROVENANCE.json.gz': gzip.compress(p.canonical(dict(
                original=q['projection']['old_proofs'], core=q['projection']['core_proofs'])), mtime=0)}
        for name, raw in blobs.items():
            (self.artifact_root / name).write_bytes(raw)
        return dict(source_identity=q['source_identity'], artifacts={n: pin(raw) for n, raw in blobs.items()},
            array_identities={k: p.array_id(v) for k, v in arrays.items()}), arrays, blobs

    def test_z_full_loader_real_guard_saved_bits_union_negatives_and_revoked_provider(self):
        prep, arrays, blobs = self._prepared()
        captures = dict(self.fixture.captures)
        captured_scopes = []
        def capture(scope, year):
            i.require_capture(scope)
            captured_scopes.append(scope)
            return captures[year]
        # No metadata methods here can expose an actual saved-source path.
        # Annual catalog metadata is invented; body allowlist is empty because
        # the invented capture seam needs no source-body read at all.
        metadata_paths = i.source_metadata.read_paths() + [
            a.HERE / 'FINANCIAL_CODE_MANIFEST.json', self.dependency]
        with self._invented_binding(prep) as binding, ExitStack() as stack:
            stack.enter_context(patch.object(i.source_metadata, 'catalog', return_value=self.fixture.catalog))
            stack.enter_context(patch.object(i.source_metadata, 'read_paths', return_value=metadata_paths))
            stack.enter_context(patch.object(i.source_metadata, 'body_allowlist', return_value={}))
            stack.enter_context(patch.object(i, 'capture_year', side_effect=capture))
            # Preload code only outside the guard. Every target-producing entry
            # then raises if load_inputs accidentally regenerates target math.
            i.source_runner.preload_source_math()
            for owner, name in ((self.fixture.old, 'build_target_grid'),
                    (self.fixture.core, 'build_target_grid'), (splice, 'targets_from_union'),
                    (p, 'project_generated')):
                stack.enter_context(patch.object(owner, name,
                    side_effect=AssertionError('FINANCIAL_LOADER_MUST_NOT_BUILD_TARGETS')))

            # Artifact pin, saved-array identity and exact shapes are independent.
            provenance = self.artifact_root / 'TARGET_PROVENANCE.json.gz'
            provenance.write_bytes(blobs[provenance.name] + b'INVENTED_TAMPER')
            with self.assertRaisesRegex(ValueError, 'EXACT_SOURCE_BYTES_REQUIRED'):
                i.load_inputs(binding)
            provenance.write_bytes(blobs[provenance.name])
            target_file = self.artifact_root / 'TARGETS.npz'
            changed = dict(arrays)
            altered = arrays[a.CELLS[0]].copy()
            altered[0, 0] = np.nextafter(altered[0, 0], np.inf)
            changed[a.CELLS[0]] = altered
            changed_raw = i.source_runner.npz(changed)
            target_file.write_bytes(changed_raw)
            original_pin = prep['artifacts']['TARGETS.npz']
            prep['artifacts']['TARGETS.npz'] = pin(changed_raw)
            with self.assertRaisesRegex(ValueError, 'EXACT_SAVED_ARRAY_BITS'):
                i.load_inputs(binding)
            target_file.write_bytes(blobs['TARGETS.npz'])
            prep['artifacts']['TARGETS.npz'] = original_pin

            for malformed in (dict(arrays, **{a.CELLS[0]: arrays[a.CELLS[0]][:-1]}),
                    dict(arrays, **{a.CELLS[0]: arrays[a.CELLS[0]].astype('<f4')}),
                    dict(arrays, INVENTED_UNREQUESTED_ARRAY=np.zeros(1))):
                malformed_raw = i.source_runner.npz(malformed)
                target_file.write_bytes(malformed_raw)
                prep['artifacts']['TARGETS.npz'] = pin(malformed_raw)
                with self.assertRaisesRegex(ValueError, 'EXACT_NUMERIC_HEADER_SCHEMA|EXACT_ARRAY_MEMBER_NAMESPACE'):
                    i.load_inputs(binding)
            target_file.write_bytes(blobs['TARGETS.npz'])
            prep['artifacts']['TARGETS.npz'] = original_pin

            changed_decisions = arrays['decision_us'].copy()
            changed_decisions[0] += a.MINUTE
            calendar_raw = i.source_runner.npz(dict(arrays, decision_us=changed_decisions))
            target_file.write_bytes(calendar_raw)
            original_decision_identity = prep['array_identities']['decision_us']
            prep['artifacts']['TARGETS.npz'] = pin(calendar_raw)
            prep['array_identities']['decision_us'] = p.array_id(changed_decisions)
            with self.assertRaisesRegex(ValueError, 'EXACT_RECAPTURED_SOURCE_UNION'):
                i.load_inputs(binding)
            target_file.write_bytes(blobs['TARGETS.npz'])
            prep['artifacts']['TARGETS.npz'] = original_pin
            prep['array_identities']['decision_us'] = original_decision_identity

            feature_file = self.artifact_root / 'SOURCE_INPUTS.npz'
            changed_close = self.qualified['close'].copy()
            changed_close[0, 0] = np.nextafter(changed_close[0, 0], np.inf)
            feature_raw = i.source_runner.npz(dict(close_available_us=self.qualified['clocks'], close=changed_close))
            original_feature_pin = prep['artifacts']['SOURCE_INPUTS.npz']
            feature_file.write_bytes(feature_raw)
            prep['artifacts']['SOURCE_INPUTS.npz'] = pin(feature_raw)
            with self.assertRaisesRegex(ValueError, 'EXACT_RECAPTURED_SOURCE_UNION'):
                i.load_inputs(binding)
            feature_file.write_bytes(blobs['SOURCE_INPUTS.npz'])
            prep['artifacts']['SOURCE_INPUTS.npz'] = original_feature_pin

            bad = dict(captures[2022])
            close = bad['close'].copy()
            close[0, 0] = np.nextafter(close[0, 0], np.inf)
            bad['close'] = p.frozen(close)
            original = captures[2022]
            captures[2022] = bad
            with self.assertRaisesRegex(ValueError, 'CROSS_YEAR_DAILY_OVERLAP_BIT_DISAGREEMENT'):
                i.load_inputs(binding)
            captures[2022] = original

            # Literal funding, quality, endpoint and source-identity changes all
            # fail the real union-vs-saved-artifacts identity comparison.
            for field in ('events', 'quality_intervals', 'native_endpoint_witness', 'source_identity'):
                year = 2024
                original = captures[year]
                bad = dict(original)
                if field == 'events':
                    rows = list(original[field])
                    rows[0] = dict(rows[0], raw_rate=rows[0]['raw_rate'] + .000001)
                    bad[field] = tuple(rows)
                elif field == 'quality_intervals':
                    bad[field] = ()
                elif field == 'native_endpoint_witness':
                    bad[field] = dict(original[field], source_float64_bits_SHA256='0' * 64)
                else:
                    bad[field] = 'INVENTED_CHANGED_SOURCE_IDENTITY'
                captures[year] = bad
                with self.subTest(union_field=field):
                    with self.assertRaisesRegex(ValueError, 'EXACT_RECAPTURED_SOURCE_UNION'):
                        i.load_inputs(binding)
                captures[year] = original

            loaded = i.load_inputs(binding)
            self.addCleanup(i._INPUTS.pop, loaded.token, None)
            self.assertEqual(loaded['decisions'].shape, (1735,))
            self.assertEqual(loaded['target'].shape, (1735, 5))
            self.assertEqual(loaded['arrays']['annual_covariance'].shape, (1735, 5, 5))
            self.assertEqual(len(loaded['rows']), 1934 * 5)
            self.assertEqual(len(loaded['window']['events']), 26100)
            self.assertEqual(len(loaded['quality_cells']), 27)
            self.assertEqual(len(loaded['later_interval_witnesses']), 1)
            self.assertFalse(loaded['target'].flags.writeable)
            self.assertFalse(loaded['decisions'].flags.writeable)
            with self.assertRaises(ValueError):
                loaded['target'].setflags(write=True)
            with self.assertRaises(TypeError):
                loaded['rows'][0]['close'] = 1
            self.assertFalse(i._CAPTURES)
            self.assertTrue(loaded['source_scopes_revoked'])
            receipt = loaded['source_guard_receipt']
            self.assertFalse(any(receipt['forbidden_attempts'].values()))
            self.assertFalse(receipt['guard_active'])
            self.assertFalse(receipt['saved_targets_and_covariance_rebuilt'])
            observed = set(receipt['observed_workspace_read_paths'])
            self.assertTrue(observed)
            self.assertTrue(all(Path(name).parent == self.artifact_root
                or Path(name) in metadata_paths for name in observed))
            for scope in captured_scopes:
                with self.assertRaisesRegex(ValueError, 'LIVE_EXACT_FINANCE_BOUND_RECAPTURE'):
                    i.require_capture(scope)
            provider = loaded['provider']
            with self.assertRaisesRegex(ValueError, 'LIVE_EXACT_CONTINUOUS_EXECUTION_SCOPE'):
                next(provider())
            self.assertEqual(provider.iterations, 0)
            with a.admit_execution(binding, loaded) as scope:
                self.assertIs(provider.scope, scope)
                self.assertEqual(provider.iterations, 0)  # Never iterate source/native tape.
                scope.validate_inputs(loaded['window'], loaded['rows'],
                    loaded['decisions'], loaded['target'])
                with self.assertRaisesRegex(ValueError, 'ONE_EXACT_PROVIDER_SCOPE_BINDING'):
                    provider.bind(scope)
                # Exercise the no-restart predicate before any source/native
                # iteration. Setting the counter models an exhausted lifecycle.
                provider.iterations = 1
                with self.assertRaisesRegex(ValueError, 'ONE_CONTINUOUS_PROVIDER_LIFECYCLE'):
                    next(provider())
                provider.iterations = 0
                i.revoke_inputs(loaded)
                with self.assertRaisesRegex(ValueError, 'EXACT_SEALED_VERIFIED_CONTINUOUS_INPUTS'):
                    next(provider())
            with self.assertRaisesRegex(ValueError, 'LIVE_EXACT_CONTINUOUS_EXECUTION_SCOPE'):
                next(provider())
            self.assertEqual(provider.iterations, 0)
            with self.assertRaisesRegex(ValueError, 'EXACT_SEALED_VERIFIED_CONTINUOUS_INPUTS'):
                i.require_inputs(loaded, binding)


if __name__ == '__main__':
    unittest.main(verbosity=2)
