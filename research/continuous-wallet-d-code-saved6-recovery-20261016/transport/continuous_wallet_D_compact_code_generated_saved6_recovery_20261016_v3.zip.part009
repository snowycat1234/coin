def pin(raw):
    return dict(SHA256=sha256(raw).hexdigest(), bytes=len(raw))


class _InventedSink:
    """No account or provider: records the real execution-scope bind only."""
    def __init__(self):
        self.bound = None

    def bind(self, scope):
        a.require_execution_scope(scope)
        if self.bound is not None:
            raise ValueError('ONE_INVENTED_SINK_BIND')
        self.bound = scope


class AdmissionInputsGeneratedTests(unittest.TestCase):
    @classmethod
    def setUpClass(cls):
        cls.folder_owner = tempfile.TemporaryDirectory(
            prefix='GENERATED_ADMISSION_INPUTS_ONLY_', dir=a.HERE)
        cls.folder = Path(cls.folder_owner.name)
        cls.fixture = generated_fixture.build()
        # This is deliberately before financial load. It is pure invented-data
        # qualification, not authority to run an actual source/financial stage.
        with patch.object(i.source_metadata, 'catalog', return_value=cls.fixture.catalog):
            cls.qualified = splice.qualify(cls.fixture.captures, cls.fixture.saved,
                cls.fixture.old, cls.fixture.core)

    @classmethod
    def tearDownClass(cls):
        cls.folder_owner.cleanup()

    def setUp(self):
        self.case_owner = tempfile.TemporaryDirectory(prefix='case_', dir=self.folder)
        self.addCleanup(self.case_owner.cleanup)
        self.case = Path(self.case_owner.name)
        self.artifact_root = self.case / 'INVENTED_PREPARED'
        self.artifact_root.mkdir()
        self.dependency = self.case / 'INVENTED_CODE_DEPENDENCY.py'
        self.dependency.write_bytes(b'# invented code dependency, no behavior\n')
        # Only this manifest read is replaced. The real code_identity(), exact()
        # and pinned() verify every actual code/test-dependency byte underneath.
        self.manifest = dict(schema='TEST_ONLY_UNFROZEN_FINANCIAL_MANIFEST',
            files={name: pin((a.HERE / name).read_bytes()) for name in
                ('continuous_admission.py', 'continuous_inputs.py')},
            dependencies={str(self.dependency.relative_to(a.ROOT)): pin(self.dependency.read_bytes())})
        self.manifest_raw = a.canonical(self.manifest)
        original = Path.read_bytes
        manifest_path = a.HERE / 'FINANCIAL_CODE_MANIFEST.json'
        raw = self.manifest_raw
        def metadata_read(path):
            return raw if path == manifest_path else original(path)
        self.addCleanup(patch.stopall)
        patch.object(Path, 'read_bytes', metadata_read).start()

    def _write(self, path, raw):
        path.write_bytes(raw)
        return dict(path=str(path.relative_to(a.ROOT)), **pin(raw))

    def _wires(self, *, preparation_change=None, audit_change=None,
            go_change=None, review_change=None):
        prep = dict(status='PASS_SOURCE_TARGET_QUALIFICATION_ONLY_NO_FINANCE',
            ordered_cells=list(a.CELLS), calendar=[a.START, a.END], days=1735,
            execution_minutes=2498400, accounts_constructed=0, historical_admission=False,
            code_manifest_SHA256='6f0b5ae1e463478b38ee78fc7c21abf6c272f21272bcca7de4c39257d5c9cd6b',
