    if Path(admission.__file__).resolve() != HERE / 'continuous_admission.py':
        raise ValueError('EXACT_CONTINUOUS_ADMISSION_MODULE_REQUIRED')
    return admission


def _require_scope(scope):
    admission = _admission()
    # The admission function owns the unbound exact-type/live-scope checks.
    admission.require_execution_scope(scope)
    if scope.source_scope != SOURCE_SCOPE or scope.generated_only is not False:
        raise ValueError('EXACT_ACTUAL_CONTINUOUS_SOURCE_SCOPE_REQUIRED')
    return admission


class ContinuousAccount(base.ExpansionAccount):
    VERSION = VERSION

    def __init__(self, config=None, *, historical_scope, tier_name=None,
                 settlement_mode=SETTLEMENT, policy_variant=POLICY_VARIANT, **kwargs):
        if type(self) is not ContinuousAccount:
            raise TypeError('EXACT_CONTINUOUS_ACCOUNT_TYPE_REQUIRED')
        if '_continuous_constructions' in vars(self) or '_execution_scope' in vars(self):
            raise ValueError('ONE_ACCOUNT_CONSTRUCTOR_PER_CONTINUOUS_CASE')
        if 'generated_scope' in kwargs:
            raise ValueError('GENERATED_SCOPE_CANNOT_CONSTRUCT_ACTUAL_CONTINUOUS_ACCOUNT')
        if policy_variant != POLICY_VARIANT:
            raise ValueError('EXACT_FROZEN_D_POLICY_REQUIRED')
        admission = _require_scope(historical_scope)
        actual_tier = historical_scope.tier_name
        if (actual_tier not in TIERS or tier_name not in (None, actual_tier)
                or historical_scope.recipe not in RECIPES or settlement_mode != SETTLEMENT):
            raise ValueError('CONTINUOUS_D_SCOPE_POLICY_OR_TIER_MISMATCH')
        V2.P.verify_primitives()
        expected = V2.grid.make_account(actual_tier, 'BASE27')
        if (config != expected.config or tuple(kwargs.get('symbols', ())) != S
                or kwargs.get('instrument_profiles') != expected.instrument_profiles
                or kwargs.get('closing_min_notional_exempt') is not True):
            raise ValueError('EXACT_CONTINUOUS_TIER_BASE27_COARSE_FRESH_GENESIS_REQUIRED')
        # Single-use capability consumption precedes all account initialization.
        admission.consume_construction(historical_scope)

        # Audited annual actual initialization seam, financial fields unchanged.
        self.generated_scope=None;self._settlement_mode=settlement_mode
        self._policy_variant=POLICY_VARIANT;self._policy_enabled=True;self._topup_enabled=False
        self.transfer_journal=[];self.monitor_journal=[];self.settlement_journal=[]
        self.operation_ids={};self.pending_exits={};self.capacity_used={}
        self.capacity_registrations={};self.transfer_ids={};self.cash_watch_reason=None
        self.liquidations=[];self.blocked_signals={};self.liquidation_callback=None
        self._exact_closing=None;self.mark_quality={}
