        features=b.codec.npz(artifacts['SOURCE_INPUTS.npz'],{'close_available_us':((1934,),'int64'),'close':((1934,5),'float64')})
        specs={'decision_us':((1735,),'int64'),'annual_covariance':((1735,5,5),'float64'),**{cell:((1735,5),'float64') for cell in a.CELLS}}
        arrays=b.codec.npz(artifacts['TARGETS.npz'],specs)
