        if type(fd) is not int:raise ValueError('INHERITED_OWN_AND_SHARED_LIVE_LEASES_REQUIRED')
        a,b=os.fstat(fd),path.stat()
        if (a.st_dev,a.st_ino)!=(b.st_dev,b.st_ino):raise ValueError('EXACT_INHERITED_LEASE_INODES_REQUIRED')
    token=object();binding=WorkerBinding(MappingProxyType(go),MappingProxyType(prep),cell,token,_SEAL);_BINDINGS[token]=binding
    try:yield binding
    finally:_BINDINGS.pop(token,None)

@dataclass(frozen=True,slots=True)
class ExecutionScope:
    _binding:object=field(repr=False);_inputs:object=field(repr=False);_token:object=field(repr=False);_seal:object=field(repr=False)
