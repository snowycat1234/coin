 reject('case_original_directory_remap',lambda:verify_packet.verify_case_file_map(changed,CELLS[0],transforms))
 changed=copy.deepcopy(cm[CELLS[0]]);changed['files']['IDENTITY.json']='aliased_packet_member'
 reject('case_packet_member_remap',lambda:verify_packet.verify_case_file_map(changed,CELLS[0],transforms))
