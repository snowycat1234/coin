The writer is used by generated native runs through the actual output path;
its full-calendar validator is separately exercised with generated full-size
chunks. Successful chunks are prefix evidence, never a financial terminal.
"""
from __future__ import annotations
from hashlib import sha256
from io import BytesIO
import json
import gzip
import shutil
import os
from pathlib import Path
import numpy as np
import continuous_source as source

COLUMNS=['nav','free_cash','isolated_balance','gross_notional','net_signed_notional','cumulative_fees',
    'cumulative_execution_costs','cumulative_funding','cumulative_turnover',
    *[s+'_quantity' for s in source.SYMBOLS],*[s+'_signed_marked_notional' for s in source.SYMBOLS],
    *[s+'_isolated_balance' for s in source.SYMBOLS],*[s+'_isolated_equity' for s in source.SYMBOLS],
    *[s+'_signed_weight' for s in source.SYMBOLS],'gross_weight','net_signed_weight']
PHASE='AFTER_MINUTE_MARK_SAME_CLOCK_FUNDING_AND_RISK_BEFORE_NEXT_DAY_DECISION'
FREE_DISK_FLOOR_BYTES=1_500_000_000

def atomic(path,raw,*,replace=False):
    path=Path(path)
    if path.is_symlink() or any(p.is_symlink() for p in path.parents):raise ValueError('ORDINARY_OWNED_OUTPUT_PATH_REQUIRED')
    if path.exists() and not replace:raise FileExistsError('IMMUTABLE_OUTPUT_ALREADY_EXISTS:'+str(path))
    if shutil.disk_usage(path.parent).free<len(raw)+FREE_DISK_FLOOR_BYTES:
        raise RuntimeError('DISK_RESERVE_STOP_BEFORE_WRITE_NO_FINANCIAL_TERMINAL')
    temp=path.with_name(path.name+'.tmp')
    fd=os.open(temp,os.O_WRONLY|os.O_CREAT|os.O_EXCL,0o600)
    try:
        with os.fdopen(fd,'wb') as stream:stream.write(raw);stream.flush();os.fsync(stream.fileno())
        if replace:os.replace(temp,path)
        else:
            # Link creation, unlike replace(), cannot clobber an existing file.
            os.link(temp,path);temp.unlink()
        directory=os.open(path.parent,os.O_RDONLY|os.O_DIRECTORY)
        try:os.fsync(directory)
        finally:os.close(directory)
    except BaseException:
        if temp.exists():temp.unlink()
        raise
    return dict(SHA256=sha256(raw).hexdigest(),bytes=len(raw))

def save(path,value,*,replace=False):return atomic(path,source.canonical(value)+b'\n',replace=replace)

def save_gzip(path,value):
    raw=source.canonical(value)+b'\n'
    compressed=gzip.compress(raw,compresslevel=6,mtime=0)
    pin=atomic(path,compressed)
    if gzip.decompress(Path(path).read_bytes())!=raw:raise ValueError('EXACT_COMPRESSED_JSON_ROUNDTRIP_REQUIRED')
    return dict(**pin,uncompressed_SHA256=sha256(raw).hexdigest(),uncompressed_bytes=len(raw))

def plain(value):
    if isinstance(value,dict):return {str(k):plain(v) for k,v in value.items()}
    if isinstance(value,(list,tuple)):return [plain(v) for v in value]
    if isinstance(value,(str,int,float,bool)) or value is None:return value
    return str(value)

def observed_state(sim):
    a=sim.account
    return plain(dict(cursor=sim.cursor,rows_written=sim.rows_written,account_clock_us=a.clock_us,
        quantities={s:a.positions[s].quantity for s in sim.symbols},NAV=a.nav(),free_cash=a.free_cash,
        isolated_balances={s:a.positions[s].isolated_balance for s in sim.symbols},debt=a.unpaid_liability,
        entry_prices={s:a.positions[s].entry_price for s in sim.symbols},
        opened_us={s:a.positions[s].opened_us for s in sim.symbols},
        pending=sim.pending,pending_age_us={s:a.clock_us-o['signal_us'] for s,o in sim.pending.items()},pending_exits=a.pending_exits,event_cursor=sim.event_cursor,
        funding_applied_count=len(a.funding),funding_journal_count=len(sim.funding_journal),
        financial_sequence=a._financial_sequence,financial_ledger_count=len(a.financial_ledger),
        lifetime_peak=sim.peak,lifetime_mdd=sim.mdd,previous_quote=sim.previous_quote,
        quality=a.mark_quality,marks={s:(dict(a.marks[s][-1]) if a.marks[s] else None) for s in sim.symbols},
        mode=a.mode(),cash_watch_reason=a.cash_watch_reason,status=a.status,terminal=sim.terminal,
        fees=a.fees,execution_cost=a.execution_cost,funding_cash=a.funding_cash,
        noop_watermark=a._noop_watermark,noop_commitment=a._noop_commitment,
        capacity_registrations_SHA256=source.digest(plain(dict(a.capacity_registrations))),
        capacity_used_SHA256=source.digest(plain(dict(a.capacity_used))),
        account_constructors=a._continuous_constructions))

def annual_marker(sim):
    before=observed_state(sim)
    record=dict(boundary_us=sim.cursor,phase=PHASE,state=before,state_SHA256=source.digest(before),
        boundary_funding=plain([r for r in sim.funding_journal if r['event_us']==sim.cursor]),
        read_only_observation=True,forced_flatten=False,cash_reseed=False,snapshot_resume_authorized=False)
    if observed_state(sim)!=before:raise AssertionError('ANNUAL_MARKER_MUTATED_ACCOUNT')
    return record

class ChunkWriter:
    def __init__(self,directory,*,identity,start,end):
        self.directory=Path(directory)
        if self.directory.is_symlink() or any(p.is_symlink() for p in self.directory.parents):raise ValueError('ORDINARY_OWNED_OUTPUT_ROOT_REQUIRED')
        self.start=start;self.end=end;self.cursor=start;self.records=[];self.identity=json.loads(source.canonical(identity));self.boundaries=[]
        if type(start) is not int or type(end) is not int or start%source.DAY or end%source.DAY or start>=end:
            raise ValueError('EXACT_COMPLETE_DAILY_OUTPUT_CALENDAR_REQUIRED')
        self.directory.mkdir(parents=True,exist_ok=False)
        self.header=dict(schema=source.VERSION,identity=self.identity,calendar=[start,end],
            historical_admission=False,generated_only=True,financial_snapshot_resume=False)
        save(self.directory/'IDENTITY.json',self.header)
    def append(self,values,*,end_us,state=None,boundary=False):
        values=np.asarray(values)
        count=(end_us-self.cursor)//source.MINUTE
        if (type(end_us) is not int or end_us!=self.cursor+count*source.MINUTE or not 0<count<=1440
                or end_us>self.end or values.dtype!=np.dtype('<f8') or values.shape!=(count,len(COLUMNS))
                or not np.isfinite(values).all()):raise ValueError('EXACT_CONTIGUOUS_FINITE_NATIVE_MINUTE_CHUNK_REQUIRED')
        name=f'MINUTE_{len(self.records):04d}.npz';buf=BytesIO();np.savez_compressed(buf,values=values)
        pin=atomic(self.directory/name,buf.getvalue())
        record=dict(name=name,start_open_us=self.cursor,end_exclusive_us=end_us,rows=count,
            values_identity=source.array_id(values),**pin)
        self.records.append(record);self.cursor=end_us
        if boundary:
            if state is None:raise ValueError('ANNUAL_BOUNDARY_REQUIRES_CARRIED_STATE')
            self.boundaries.append(state)
        checkpoint=dict(schema='CONTINUOUS_OBSERVATION_PREFIX_NOT_RESTART_SNAPSHOT_V1',identity=self.identity,
            calendar=[self.start,self.end],completed_open_interval=[self.start,self.cursor],rows=sum(r['rows'] for r in self.records),
            chunks=self.records,boundaries=self.boundaries,last_observed_state=state,
            actual_financial_terminal=False,financial_snapshot_resume=False,automatic_retry=False,
            chunk_files_fsynced_before_checkpoint=True)
        save(self.directory/'PREFIX_CHECKPOINT.json',checkpoint,replace=True)
    def validate(self,*,require_full=False):
        header_path=self.directory/'IDENTITY.json';checkpoint_path=self.directory/'PREFIX_CHECKPOINT.json'
        if header_path.is_symlink() or checkpoint_path.is_symlink():raise ValueError('ORDINARY_SAVED_METADATA_REQUIRED')
        header=json.loads(header_path.read_text());checkpoint=json.loads(checkpoint_path.read_text())
        if source.canonical(header)!=source.canonical(self.header):raise ValueError('EXACT_CALLER_BOUND_SAVED_IDENTITY_REQUIRED')
        fixed=dict(schema='CONTINUOUS_OBSERVATION_PREFIX_NOT_RESTART_SNAPSHOT_V1',identity=self.identity,
            calendar=[self.start,self.end],actual_financial_terminal=False,financial_snapshot_resume=False,
            automatic_retry=False,chunk_files_fsynced_before_checkpoint=True)
        required=set(fixed)|{'completed_open_interval','rows','chunks','boundaries','last_observed_state'}
        if (set(checkpoint)!=required or any(type(checkpoint.get(k)) is not type(v) or source.canonical(checkpoint[k])!=source.canonical(v) for k,v in fixed.items())
                or type(checkpoint['completed_open_interval']) is not list or len(checkpoint['completed_open_interval'])!=2
                or checkpoint['completed_open_interval'][0]!=self.start or type(checkpoint['rows']) is not int
                or type(checkpoint['chunks']) is not list or not checkpoint['chunks'] or type(checkpoint['boundaries']) is not list):
            raise ValueError('EXACT_CALLER_BOUND_PREFIX_SCHEMA_IDENTITY_CALENDAR_AND_FLAGS_REQUIRED')
        cursor=self.start;rows=0
        fields={'name','start_open_us','end_exclusive_us','rows','values_identity','SHA256','bytes'}
        for index,row in enumerate(checkpoint['chunks']):
            if (type(row) is not dict or set(row)!=fields or row['name']!=f'MINUTE_{index:04d}.npz'
                    or type(row['rows']) is not int or not 1<=row['rows']<=1440
                    or type(row['start_open_us']) is not int or type(row['end_exclusive_us']) is not int
                    or row['start_open_us']!=cursor or row['end_exclusive_us']!=cursor+row['rows']*source.MINUTE
                    or row['end_exclusive_us']>self.end or type(row['bytes']) is not int or row['bytes']<=0):
                raise ValueError('EXACT_BOUNDED_CHRONOLOGICAL_CANONICAL_CHUNK_DESCRIPTOR_REQUIRED')
            path=self.directory/row['name']
            if path.is_symlink():raise ValueError('ORDINARY_SAVED_CHUNK_REQUIRED')
            raw=path.read_bytes()
            if len(raw)!=row['bytes'] or sha256(raw).hexdigest()!=row['SHA256']:raise ValueError('SAVED_CHUNK_PIN_CHANGED')
            with np.load(BytesIO(raw),allow_pickle=False) as data:
                if data.files!=['values']:raise ValueError('EXACT_MINUTE_CHUNK_MEMBERS_REQUIRED')
                values=data['values']
            if (values.dtype!=np.dtype('<f8') or not np.isfinite(values).all()
                    or source.array_id(values)!=row['values_identity'] or values.shape!=(row['rows'],len(COLUMNS))):
                raise ValueError('EXACT_SAVED_CHUNK_FINITE_DTYPE_SHAPE_AND_BYTES_REQUIRED')
            cursor=row['end_exclusive_us'];rows+=row['rows']
        if (cursor!=checkpoint['completed_open_interval'][1] or rows!=checkpoint['rows']
                or require_full and (cursor!=self.end or rows!=(self.end-self.start)//source.MINUTE)):
            raise ValueError('EXACT_SAVED_CONTINUOUS_CALENDAR_REQUIRED')
        from datetime import datetime,timezone
        expected_boundaries=[]
        for year in range(datetime.fromtimestamp(self.start/1e6,timezone.utc).year+1,datetime.fromtimestamp(cursor/1e6,timezone.utc).year+1):
            at=source.utc(f'{year}-01-01')
            if self.start<at<=cursor and at<self.end:expected_boundaries.append(at)
        seen=[]
        for marker in checkpoint['boundaries']:
            if (type(marker) is not dict or set(marker)!={'boundary_us','phase','state','state_SHA256','boundary_funding','read_only_observation','forced_flatten','cash_reseed','snapshot_resume_authorized'}
                    or type(marker['boundary_us']) is not int or marker['phase']!=PHASE or marker['read_only_observation'] is not True
                    or marker['forced_flatten'] is not False or marker['cash_reseed'] is not False or marker['snapshot_resume_authorized'] is not False
                    or type(marker['boundary_funding']) is not list
                    or any(type(r) is not dict or r.get('event_us')!=marker['boundary_us'] for r in marker['boundary_funding'])
                    or type(marker['state']) is not dict or marker['state'].get('cursor')!=marker['boundary_us']
                    or marker['state_SHA256']!=source.digest(marker['state'])):
                raise ValueError('EXACT_READ_ONLY_ANNUAL_BOUNDARY_CARRIED_STATE_REQUIRED')
            seen.append(marker['boundary_us'])
        if seen!=expected_boundaries:raise ValueError('ALL_INTERNAL_JAN1_BOUNDARIES_REQUIRED')
        return dict(rows=rows,calendar=[self.start,cursor],required_minutes=(self.end-self.start)//source.MINUTE,
            full_calendar=cursor==self.end,chunks=len(checkpoint['chunks']),boundaries=len(seen),financial_terminal_admitted=False)
