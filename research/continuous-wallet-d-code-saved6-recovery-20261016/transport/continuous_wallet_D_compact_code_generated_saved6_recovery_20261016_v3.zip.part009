from pathlib import Path
from io import BytesIO
from hashlib import sha256
import ast
import gzip
import json
import stat
import sys
import zipfile
import continuous_admission as a
_CLASSIFY=None


def classify_saved(audit,result,*,calendar,completed_minutes,stop_us):
    # Execute the immutable original classifier unchanged. A residual is an
    # honestly saved economic failure that pauses this pilot, never a technical
    # reset or a full paid-return claim.
    global _CLASSIFY
    if _CLASSIFY is None:
        path=a.ROOT/'legacy_intrinsic_D_remaining14_financial_20261015_v1/legacy_process_runtime.py'
        tree=ast.parse(path.read_bytes());nodes=[n for n in tree.body if isinstance(n,ast.FunctionDef) and n.name=='classify_terminal']
        if len(nodes)!=1:raise ValueError('EXACT_ORIGINAL_TERMINAL_CLASSIFIER_REQUIRED')
        checker=a.ROOT/'bounded_native_continuation_guard50_exit_expansion_20261015'
        if str(checker) not in sys.path:sys.path.insert(0,str(checker))
        ns={'__name__':__name__};exec(compile(ast.Module(body=nodes,type_ignores=[]),str(path),'exec'),ns);_CLASSIFY=ns['classify_terminal']
    try:return _CLASSIFY(audit,result,calendar=calendar,completed_minutes=completed_minutes,stop_us=stop_us)
    except ValueError as error:
        if str(error)=='UNSETTLED_OR_RESIDUAL_CASE_PAUSES_FINITE_QUEUE':return 'FULL_CALENDAR_RESIDUAL_OR_UNSETTLED_UNPAID'
        raise


def bounded_chunk(raw,rows):
    """Validate the allocation header before any np.load/member allocation."""
    import numpy as np
    if type(rows) is not int or not 1<=rows<=1440 or len(raw)>1440*36*8+2048:raise ValueError('BOUNDED_DAILY_CHUNK_BYTES_REQUIRED')
    with zipfile.ZipFile(BytesIO(raw)) as archive:
        members=archive.infolist()
        if (len(members)!=1 or members[0].filename!='values.npy' or members[0].flag_bits&1
                or members[0].is_dir() or stat.S_ISLNK(members[0].external_attr>>16)
                or members[0].file_size>rows*36*8+256):raise ValueError('EXACT_BOUNDED_DAILY_NPZ_MEMBER_REQUIRED')
        with archive.open(members[0]) as stream:
            ver=np.lib.format.read_magic(stream)
            if ver not in ((1,0),(2,0)):raise ValueError('SUPPORTED_NUMPY_CHUNK_HEADER_REQUIRED')
            read=np.lib.format.read_array_header_1_0 if ver==(1,0) else np.lib.format.read_array_header_2_0
            shape,fortran,dtype=read(stream)
            if shape!=(rows,36) or fortran or dtype!=np.dtype('<f8'):raise ValueError('EXACT_DAILY_FLOAT64_SHAPE_BEFORE_ALLOCATION_REQUIRED')
            if members[0].file_size-stream.tell()!=rows*36*8:raise ValueError('EXACT_DAILY_CHUNK_PAYLOAD_LENGTH_REQUIRED')
    return True


def validate_saved_terminal(directory,*,expected):
    if expected.get('actual_shell_exit_code')!=0:raise ValueError('OBSERVED_OWNED_SHELL_EXIT0_REQUIRED_BEFORE_TERMINAL')
    directory=Path(directory)
    if directory.name!=expected['cell_id'] or expected['cell_id'] not in a.RELEASED_CELLS:raise ValueError('EXACT_RELEASED_REMAINING_CELL_REQUIRED_PILOT_EXCLUDED')
    if directory.is_symlink() or any(p.is_symlink() for p in directory.parents):raise ValueError('ORDINARY_OWNED_SAVED_CASE_REQUIRED')
    candidate_path=directory/'WORKER_COMPLETE_NOT_TERMINAL.json'
    if candidate_path.stat().st_size>8000000:raise ValueError('BOUNDED_CANDIDATE_METADATA_REQUIRED')
    candidate=json.loads(candidate_path.read_bytes())
    fixed=dict(schema='CONTINUOUS_WORKER_CANDIDATE_V1',cell_id=expected['cell_id'],native40_proof_passed=True,
        execution_scopes_revoked=True,inputs_revoked=True,worker_binding_revoked=True,financial_terminal_admitted=False)
    if any(type(candidate.get(k)) is not type(v) or a.canonical(candidate[k])!=a.canonical(v) for k,v in fixed.items()):
        raise ValueError('EXACT_REVOKED_DURABLE_WORKER_CANDIDATE_REQUIRED')
    pins=candidate.get('files')
    if type(pins) is not dict or not 12<=len(pins)<=1800:raise ValueError('EXACT_BOUNDED_CANDIDATE_FILE_GRAPH_REQUIRED')
    actual={p.name for p in directory.iterdir()}
    if actual!=set(pins)|{'WORKER_COMPLETE_NOT_TERMINAL.json'}:raise ValueError('EXACT_CANDIDATE_FILE_NAMESPACE_REQUIRED')
    bodies={}
    for name,pin in pins.items():
        if Path(name).name!=name or type(pin) is not dict or pin.get('bytes',0)>a.LIMITS['case_output_bytes']:raise ValueError('EXACT_BOUNDED_CANDIDATE_FILE_PIN_REQUIRED')
        p=directory/name
        if not p.is_file() or p.is_symlink():raise ValueError('ORDINARY_SAVED_FILE_REQUIRED')
        raw=a.exact(p,pin)
        # Keep only metadata/bulk JSON; bounded daily chunks are reread singly.
        if not name.startswith('MINUTE_'):bodies[name]=raw
    receipt=json.loads(bodies['CASE_RECEIPT.json'])
    for key in ('cell_id','root_GO_SHA256','code_manifest_SHA256','source_identity','claim_SHA256','CPU','worker_PID','worker_start_ticks','controller_PID'):
        if type(receipt.get(key)) is not type(expected[key]) or receipt[key]!=expected[key]:raise ValueError('EXTERNAL_SAVED_CASE_PROCESS_AND_AUTHORITY_BINDING_REQUIRED:'+key)
    if receipt.get('calendar')!=[a.START,a.END] or receipt.get('limits')!=a.LIMITS:raise ValueError('EXACT_SAVED_CALENDAR_AND_RESOURCE_ENVELOPE_REQUIRED')
    claim=json.loads(bodies['LAUNCH_CLAIM.json']);bootstrap=json.loads(bodies['BOOTSTRAP_READY.json']);owner=json.loads(bodies['PROCESS_OWNERSHIP.json'])
    if (sha256(bodies['LAUNCH_CLAIM.json']).hexdigest()!=expected['claim_SHA256'] or claim.get('controller_PID')!=expected['controller_PID']
            or claim.get('cell_id')!=expected['cell_id'] or claim.get('CPU')!=expected['CPU']
            or bootstrap.get('PID')!=expected['worker_PID'] or bootstrap.get('CPU')!=expected['CPU']
            or owner.get('PID')!=expected['worker_PID'] or owner.get('process_start_ticks')!=expected['worker_start_ticks']):
        raise ValueError('EXACT_SAVED_BOOTSTRAP_OWNER_AND_CLAIM_REQUIRED')
    guard=json.loads(bodies['SOURCE_RECAPTURE_GUARD_RECEIPT.json'])
    guard_path=a.ROOT/'legacy_intrinsic_D_remaining24_source_20261015_v1'
    if str(guard_path) not in sys.path:sys.path.insert(0,str(guard_path))
    from legacy_source_guard import SourceOnlyGuard
    if (guard.get('schema')!='OBSERVED_LEGACY_INTRINSIC_SOURCE_GUARD_V1'
