Only this test file patches the authority/resource seams. Production CLI has no
generated mode, weakened limits, replay path or arbitrary subprocess argument.
"""
import json
import os
from pathlib import Path
import signal
import subprocess
import sys
import tempfile
import time
from types import SimpleNamespace
import unittest
from unittest.mock import patch

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))
import run_continuous as r
import continuous_admission as a
TEST_CPU = int(os.environ.get('CONTINUOUS_GENERATED_TEST_CPU', min(os.sched_getaffinity(0))))


class GeneratedProcessTests(unittest.TestCase):
    @classmethod
    def setUpClass(cls):
        cls.affinity = os.sched_getaffinity(0)
        if TEST_CPU not in cls.affinity:
            raise unittest.SkipTest('Assigned generated-test CPU is unavailable')
        for task in Path('/proc/self/task').iterdir():
            os.sched_setaffinity(int(task.name), {TEST_CPU})

    @classmethod
    def tearDownClass(cls):
        for task in Path('/proc/self/task').iterdir():
            try:
                os.sched_setaffinity(int(task.name), cls.affinity)
            except ProcessLookupError:
                pass

    def setUp(self):
        self.temp = tempfile.TemporaryDirectory(prefix='invented_continuous_runner_')
        self.root = Path(self.temp.name)
        self.cohort = self.root / 'cohort'
        self.cohort.mkdir()
        self.case = self.cohort / 'INVENTED_FIRST_CELL'
        self.case.mkdir()
        self.claims = self.root / 'invented_claims'
        self.shared = self.root / 'invented_shared.lock'
        self.shared.touch()
        limits = dict(a.LIMITS)
        limits.update(wall_seconds=3, CPU_seconds=3, RSS_bytes=500_000_000,
                      case_output_bytes=1_000_000, cohort_output_bytes=10_000_000,
                      free_disk_floor_bytes=0)
        self.patches = [patch.object(a, 'CLAIMS', self.claims), patch.object(a, 'SHARED_LEASE', self.shared),
                        patch.object(a, 'LIMITS', limits), patch.object(r, 'POLL_SECONDS', .01),
                        patch.object(r, 'HEARTBEAT_SECONDS', .03)]
        for item in self.patches:
            item.start()

    def tearDown(self):
        for item in reversed(self.patches):
            item.stop()
        self.temp.cleanup()

    def run_fake(self, code):
        with r.controller_leases() as fds:
            return r.supervise([sys.executable, '-B', '-c', code], self.case,
                               cohort=self.cohort, cpu=TEST_CPU, lease_fds=fds, claim_sha='invented')

    def test_import_is_stdlib_only_and_starts_nothing(self):
        code = "import runpy,sys,json;runpy.run_path(%r);print(json.dumps([n for n in sys.modules if n.split('.')[0] in ('numpy','polars','native_adapter','continuous_inputs','legacy_bootstrap','legacy_process_runtime')]))" % str(HERE/'run_continuous.py')
        result = subprocess.run([sys.executable, '-B', '-c', code], text=True,
                                capture_output=True, check=True)
        self.assertEqual(json.loads(result.stdout), [])
        self.assertEqual(list(self.case.iterdir()), [])

    def test_small_interruption_preserves_observed_halt_separately(self):
        account = SimpleNamespace(status='BANKRUPT_HALT', clock_us=3,
            halt_witness={'event_us':3,'decimal_strings':{'NAV':'-1','unpaid_liability':'2'}},
            nav=lambda:'-1', unpaid_liability='2')
        sim = SimpleNamespace(account=account, stop=3, rows_written=0)
        record = r.small_halt_observation(sim)
        self.assertTrue(record['economic_halt_observed'])
        self.assertTrue(record['economic_halt_is_not_a_validated_terminal'])
        self.assertEqual((record['NAV'],record['debt'],record['stop_us']), ('-1','2',3))
        self.assertLess(len(r.canonical(record)), 1000)

    def test_owned_exit_zero_is_real_and_observations_are_bounded(self):
        result = self.run_fake("import time;print('invented stdout',flush=True);time.sleep(.08)")
        self.assertEqual(result['actual_shell_exit_code'], 0)
        self.assertTrue(result['actual_shell_exit_observed'])
        self.assertGreater(result['actual_worker_CPU_seconds'], 0)
        owner = json.loads((self.case/'PROCESS_OWNERSHIP.json').read_bytes())
        self.assertEqual(owner['PID'], result['worker_PID'])
        self.assertEqual(owner['process_start_ticks'], result['worker_start_ticks'])
        self.assertIn('invented stdout', (self.cohort/(self.case.name+'.stdout.log')).read_text())
        heartbeat = json.loads((self.cohort/'CONTROLLER_HEARTBEAT.json').read_bytes())
        self.assertLessEqual(len(heartbeat['samples']), 16)
        self.assertFalse((self.case/'TERMINAL_CHECKPOINT.json').exists())

    def test_real_stdlib_bootstrap_sets_caps_before_invented_exec(self):
        if TEST_CPU != 4:
            self.skipTest('Production bootstrap CPU4 was separately verified; assigned CPU is different')
        # Explicit test-only location/claim seams. The child is invented stdlib
        # code, not the financial worker, and no production namespace is used.
        module = self.root/'invented_module'
        module.mkdir()
        case = module/'financial_attempts'/'invented_attempt'/'INVENTED_CELL'
        case.mkdir(parents=True)
        executed = case/'INVENTED_EXECUTED.json'
        child = module/'run_continuous.py'
        child.write_text("import sys,os,json,resource;open(%r,'w').write(json.dumps(dict(affinity=sorted(os.sched_getaffinity(0)),numerical_imports=[n for n in sys.modules if n.split('.')[0] in ('numpy','polars','native_adapter','legacy_bootstrap')],CPU=list(resource.getrlimit(resource.RLIMIT_CPU)),AS=list(resource.getrlimit(resource.RLIMIT_AS)),env={k:os.environ.get(k) for k in %r})))" % (str(executed), r.THREAD_ENV))
        raw = r.canonical(dict(CPU=TEST_CPU, case_output=str(case)))
        (case/'LAUNCH_CLAIM.json').write_bytes(raw)
        code = ("import sys;from pathlib import Path;sys.path.insert(0,%r);import run_continuous as r,continuous_admission as a;"
                "r.HERE=Path(%r);r.PYTHON=Path(sys.executable);a.CLAIMS=Path(%r);a.SHARED_LEASE=Path(%r);r.admission=lambda:a;"
                "r.bootstrap(4,%r,[str(r.PYTHON),'-B',str(r.HERE/'run_continuous.py'),'--case'])") % (str(HERE), str(module), str(self.claims), str(self.shared), str(case))
        with r.controller_leases() as fds:
            parent = r.process_observation(os.getpid())
            process = subprocess.Popen([sys.executable, '-B', '-c', code],
                pass_fds=fds, env=r.environment(fds, parent), stdout=subprocess.PIPE, stderr=subprocess.PIPE)
            observed = r.process_observation(process.pid)
            self.assertIsNotNone(observed)
            owner = dict(PID=process.pid, CPU=TEST_CPU, process_start_ticks=observed['process_start_ticks'],
                         controller_PID=os.getpid(), controller_start_ticks=parent['process_start_ticks'],
                         claim_SHA256=r.sha(raw))
            (case/'PROCESS_OWNERSHIP.json').write_bytes(r.canonical(owner))
            stdout, stderr = process.communicate(timeout=5)
            self.assertEqual(process.returncode, 0, stderr.decode())
        result = json.loads(executed.read_bytes())
        self.assertEqual(result['affinity'], [TEST_CPU])
        self.assertEqual(result['numerical_imports'], [])
        self.assertEqual(result['CPU'], [2400,2400])
        self.assertEqual(result['AS'], [7_000_000_000,7_000_000_000])
        self.assertEqual(set(result['env'].values()), {'1'})
        boot = json.loads((case/'BOOTSTRAP_READY.json').read_bytes())
        self.assertEqual(boot['PID'], process.pid)
        self.assertEqual(boot['parent_death_signal'], int(signal.SIGTERM))

    def test_failed_pilot_stops_controller_before_any_second_account(self):
        module = self.root/'invented_controller_module'
        module.mkdir()
        output = module/'financial_attempts'/'invented_controller_attempt'
        go = dict(CPU=TEST_CPU, controller_output=str(output), code_manifest_SHA256='invented code',
                  prepared_source={'invented':'source'}, prepared_source_audit={'invented':'audit'})
        prep = dict(source_identity='invented source', array_identities={'all8':'invented'})
        args = SimpleNamespace(output=str(output), cpu=TEST_CPU, go='invented unused', review='invented unused',
                               go_sha='invented go', review_sha='invented review')
        real_supervise = r.supervise

        def fake_command_seam(command, directory, **kwargs):
            return real_supervise([sys.executable,'-B','-c','raise SystemExit(3)'], directory, **kwargs)

        with patch.object(r, 'HERE', module), patch.object(r, 'admission', return_value=a), \
                patch.object(r, 'read_wires', return_value=(b'{}',b'{}',go,prep)), \
                patch.object(r, 'require_launch_resources', return_value={'invented':True}), \
                patch.object(r, 'supervise', side_effect=fake_command_seam) as launch:
            with self.assertRaisesRegex(RuntimeError, 'NONZERO_SHELL_EXIT'):
                r.controller(args)
            self.assertEqual(launch.call_count, 1)
        self.assertTrue((self.claims/(a.CELLS[0]+'.json')).exists())
        self.assertTrue((output/'CONTROLLER_PAUSE.json').exists())
        self.assertEqual([p.name for p in output.iterdir() if p.is_dir()], [a.CELLS[0]])

    def test_real_wall_cap_kills_only_owned_child_and_preserves_prefix(self):
        (self.case/'PREFIX_CHECKPOINT.json').write_text('{"invented_prefix":true}\n')
        a.LIMITS['wall_seconds'] = .08
        with self.assertRaisesRegex(RuntimeError, 'WALL_CAP_STOP'):
            self.run_fake('import time;time.sleep(10)')
        self.assertTrue((self.case/'PREFIX_CHECKPOINT.json').exists())
        failure = json.loads((self.cohort/'SUPERVISOR_INTERRUPTION.json').read_bytes())
        self.assertFalse(failure['financial_terminal'])
        self.assertIsNotNone(failure['actual_shell_exit_code'])
        self.assertIsNone(r.process_observation(failure['worker_PID']))

    def test_real_aggregate_rss_cap_stops_allocating_child(self):
        a.LIMITS['RSS_bytes'] = 55_000_000
        with self.assertRaisesRegex(RuntimeError, 'AGGREGATE_RSS_CAP_STOP'):
            self.run_fake("import time;v=bytearray(80_000_000);print('invented allocated',flush=True);time.sleep(10)")
        failure = json.loads((self.cohort/'SUPERVISOR_INTERRUPTION.json').read_bytes())
        self.assertIsNone(r.process_observation(failure['worker_PID']))

    def test_final_peak_rss_rejects_zero_exit_burst_between_polls(self):
        a.LIMITS['RSS_bytes'] = 55_000_000
        with patch.object(r, 'POLL_SECONDS', .2):
            with self.assertRaisesRegex(RuntimeError, 'AGGREGATE_RSS_CAP_STOP'):
                self.run_fake('v=bytearray(80_000_000)')
        failure = json.loads((self.cohort/'SUPERVISOR_INTERRUPTION.json').read_bytes())
        self.assertFalse(failure['financial_terminal'])

    def test_real_stdout_cap_stops_before_persisting_over_budget(self):
        a.LIMITS['case_output_bytes'] = 5000
        with self.assertRaisesRegex(RuntimeError, 'STDOUT_CAP_STOP'):
            self.run_fake("import time;print('x'*100000,flush=True);time.sleep(10)")
        log = self.cohort/(self.case.name+'.stdout.log')
        self.assertLessEqual(r.own_bytes(self.case)+log.stat().st_size, a.LIMITS['case_output_bytes'])

    def test_real_disk_floor_stops_and_keeps_preexisting_evidence(self):
        import shutil
        (self.case/'PREFIX_CHECKPOINT.json').write_bytes(b'invented durable prefix')
        a.LIMITS['free_disk_floor_bytes'] = shutil.disk_usage(self.cohort).free + 1_000_000
        with self.assertRaisesRegex(RuntimeError, 'DISK_RESERVE_STOP'):
            self.run_fake('import time;time.sleep(10)')
        self.assertEqual((self.case/'PREFIX_CHECKPOINT.json').read_bytes(), b'invented durable prefix')

    def test_failed_spawn_consumes_claim_and_duplicate_is_refused(self):
        go = dict(code_manifest_SHA256='invented code', prepared_source={'invented':'source'},
                  prepared_source_audit={'invented':'audit'})
        prep = dict(source_identity='invented source identity', array_identities={'all8':'invented'})
        args = SimpleNamespace(go_sha='invented go', review_sha='invented review', cpu=TEST_CPU, output=str(self.cohort))
        self.claims.mkdir()
        raw = r.reserve_claim(go, prep, args, self.case)
        claim_path = self.claims/(a.CELLS[0]+'.json')
        with r.controller_leases() as fds:
            with self.assertRaises(FileNotFoundError):
                r.supervise([str(self.root/'does_not_exist')], self.case, cohort=self.cohort,
                            cpu=TEST_CPU, lease_fds=fds, claim_sha=r.sha(raw))
        self.assertEqual(claim_path.read_bytes(), raw)
        with self.assertRaisesRegex(RuntimeError, 'NO_DUPLICATE_LAUNCH'):
            r.reserve_claim(go, prep, args, self.case)
        self.assertEqual(claim_path.read_bytes(), raw)

    def test_shared_lease_conflict_is_nonblocking_and_does_not_unlock_owner(self):
        import fcntl
        fd = os.open(self.shared, os.O_RDWR)
        try:
            fcntl.flock(fd, fcntl.LOCK_EX|fcntl.LOCK_NB)
            with self.assertRaisesRegex(RuntimeError, 'SHARED_CPU45_LEASE_HELD'):
                with r.controller_leases():
                    self.fail('Conflicting lease was accepted')
            second = os.open(self.shared, os.O_RDWR)
            try:
                with self.assertRaises(BlockingIOError):
                    fcntl.flock(second, fcntl.LOCK_EX|fcntl.LOCK_NB)
            finally:
                os.close(second)
        finally:
            os.close(fd)

    def test_inherited_lease_remains_locked_after_parent_closes(self):
        import fcntl
        with r.controller_leases() as fds:
            child = subprocess.Popen([sys.executable,'-B','-c','import time;time.sleep(10)'], pass_fds=fds)
            owned = r.process_observation(child.pid)
        try:
            fd = os.open(self.shared, os.O_RDWR)
            try:
                with self.assertRaises(BlockingIOError):
                    fcntl.flock(fd, fcntl.LOCK_EX|fcntl.LOCK_NB)
            finally:
                os.close(fd)
        finally:
            r.stop_owned(child, owned['process_start_ticks'])
        fd = os.open(self.shared, os.O_RDWR)
        try:
            fcntl.flock(fd, fcntl.LOCK_EX|fcntl.LOCK_NB)
        finally:
            os.close(fd)

    def test_tighter_visible_cgroup_remaining_controls_prelaunch(self):
        observed = dict(allowed_CPUs=[TEST_CPU], conservative_available_bytes=5_499_999_999,
                        MemAvailable_bytes=100_000_000_000, visible_cgroup_remaining_bytes=5_499_999_999,
                        unknown_cgroup_uncertainty=False)
        with patch.object(r, 'host_observation', return_value=observed):
            with self.assertRaisesRegex(RuntimeError, 'MEMORY_BELOW'):
                r.require_launch_resources(TEST_CPU)

    def test_parent_death_guard_aborts_worker_without_next_day(self):
        ready = self.root/'invented_parent_death_ready.json'
        worker = ("import sys,os,time,json;sys.path.insert(0,%r);import run_continuous as r;"
                  "r.install_parent_death_guard();p=r.process_observation(os.getpid());"
                  "open(%r,'w').write(json.dumps(p));time.sleep(20)") % (str(HERE), str(ready))
        parent = ("import sys,os,time,subprocess;sys.path.insert(0,%r);import run_continuous as r;"
                  "p=r.process_observation(os.getpid());e=dict(os.environ,CONTINUOUS_CONTROLLER_PID=str(p['PID']),"
                  "CONTINUOUS_CONTROLLER_START_TICKS=p['process_start_ticks']);"
                  "c=subprocess.Popen([sys.executable,'-B','-c',%r],env=e,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL);"
                  "deadline=time.monotonic()+3;"
                  "exec(\"while not __import__('pathlib').Path(%r).exists() and time.monotonic()<deadline: time.sleep(.01)\")") % (str(HERE), worker, str(ready))
        subprocess.run([sys.executable, '-B', '-c', parent], check=True, timeout=5)
        self.assertTrue(ready.exists())
        owned = json.loads(ready.read_bytes())
        deadline = time.monotonic()+3
        try:
            while time.monotonic()<deadline:
                current = r.process_observation(owned['PID'])
                if current is None or current['state']=='Z':
                    break
                self.assertEqual(current['process_start_ticks'], owned['process_start_ticks'])
                time.sleep(.02)
            else:
                self.fail('Orphaned generated worker continued after parent death')
        finally:
            current = r.process_observation(owned['PID'])
            if current is not None and current['state']!='Z' and current['process_start_ticks']==owned['process_start_ticks']:
                os.kill(owned['PID'], signal.SIGKILL)


if __name__ == '__main__':
    unittest.main()
