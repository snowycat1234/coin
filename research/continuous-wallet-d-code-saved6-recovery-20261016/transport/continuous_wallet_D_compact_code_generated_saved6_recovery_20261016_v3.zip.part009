        typed=tuple(cells) if year==2022 else ();intervals=e.backend.quality.intervals(typed) if typed else tuple((a,b,tuple(names)) for a,b,names in rec['contract']['quality_intervals'])
        witness=dict(minute_open_us=end-p.MINUTE,completed_us=end,source_file='GENERATED_NATIVE_ENDPOINT',source_file_SHA256='e'*64,
            source_float64_bits_SHA256=sha256(price([end])[0].tobytes()).hexdigest(),genuine_native_trade_close=True,
            end_boundary_witness_not_2026_execution_authority=True)
        sidecar=dict(cells=[asdict(c) for c in typed],genuine_recovery_witnesses=recoveries if year==2022 else [],
            quality_intervals=p.json_plain(intervals),generated_only=True)
        source=dict(year=year,period=dict(start=start,end=end,days=days),clocks=t,close=close,decisions=d,
            source_identity=sid,events=tuple(events),quality_cells=typed,quality_intervals=intervals,
            sidecar=sidecar,sidecar_raw=p.canonical(sidecar)+b'\n',contract=rec['contract'],
            native_endpoint_close=p.frozen(price([end])[0]),native_endpoint_witness=witness,
            source_rows=tuple(dict(symbol=s,close_us=int(at),available_us=int(at),close=float(close[i,j])) for i,at in enumerate(t) for j,s in enumerate(p.SYMBOLS)))
        captures[year]=source
        od,ow,oc,op=old.build_target_grid(close,t,t,d);cd,cw,cc,cp=core.build_target_grid(close,t,t,d)
        la=dict(decision_us=od,annual_covariance=oc,**ow,
            **{'intrinsic_'+recipe:np.asarray([r['intrinsic'][recipe] for r in op],dtype='<f8') for recipe in old.STRATEGIES})
        ca=dict(decision_us=cd,annual_covariance=cc,**cw)
