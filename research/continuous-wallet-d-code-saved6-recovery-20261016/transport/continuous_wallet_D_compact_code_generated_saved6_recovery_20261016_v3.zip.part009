        with patch.object(e,'catalog',return_value=fake),patch.object(e,'read_body',side_effect=read):
            for year in e.YEARS:
                la,lp,ca,cp,_=runner.saved_references(object(),year)
                self.assertEqual(la['decision_us'].tobytes(),ca['decision_us'].tobytes());self.assertEqual(p.canonical(lp),p.canonical(f.saved[year][1]))
    def test_all_five_reused_annual_assemblers_on_invented_byte_containers(self):
        from io import BytesIO
        from types import SimpleNamespace
        helper_path=e.ROOT/'legacy_intrinsic_D_remaining14_financial_20261015_v1/generated_native_source_fixture.py'
        cfg=SimpleNamespace(**{k:getattr(e.backend.config,k) for k in dir(e.backend.config) if not k.startswith('__')})
        cfg.source_year=e.backend.config.period_named
        shim=SimpleNamespace(contracts=lambda:{'years':{str(y):e.year_record(y)['contract'] for y in e.YEARS}})
        helper=e.backend.select_functions(helper_path,('pack','prices','fake_daily','fake_events','fake_month','fake_source','fake_source_2022'),
            dict(np=np,BytesIO=BytesIO,deepcopy=deepcopy,asdict=__import__('dataclasses').asdict,
                c=e.backend.c,config=cfg,codec=e.backend.codec,quality=e.backend.quality,signal=e.backend.signal,e=shim))
        for year in e.YEARS:
            parts=list(helper.fake_source(year));parts[6]['source_identity']=p.digest(dict(generated_only=True,year=year))
            if year==2023:
                clocks=np.arange(e.year_record(year)['calendar'][0],e.year_record(year)['calendar'][1],p.DAY,dtype='<i8')
                prices=helper.prices(clocks)
                parts[2]=p.canonical([dict(symbol=s,close_us=int(at),close=float(prices[i,j])) for i,at in enumerate(clocks) for j,s in enumerate(p.SYMBOLS)])
                sidecar=e.backend.c.object_json(parts[4]);sidecar['original200_quality']=parts[6]['quality_summary'];parts[4]=p.canonical(sidecar)
                result=e.backend.FIRST2023.assemble_inputs(*parts[:7])
            else:result=e.backend.ANNUAL.assemble_inputs(*parts)
            self.assertEqual(len(result['decisions']),e.backend.config.period_named(year)['days'])
            self.assertEqual(result['source_identity'],parts[6]['source_identity'])
            self.assertEqual(len(result['quality_cells']),27 if year==2022 else 0)
            if year==2022:self.assertEqual(len(result['sidecar']['genuine_recovery_witnesses']),8)
    def test_actual_output_writer_and_whole_guard_on_invented_capture_seam(self):
        f=self.fixture
        # A fresh actual process has not warmed H090 through fixture building.
        # Recreate that cold dependency state immediately before the real entry.
        f.core._H090=None
        self.assertIsNone(f.core._H090)
        # Mock only the invented capture/reference seam. Authority, clean whole
        # invocation guard, pure qualification, target math and output writer run.
        index=1
        output=e.HERE/'source_attempts'/f'GENERATED_END_TO_END_attempt{index:03d}'
        while output.exists():
            index+=1;output=e.HERE/'source_attempts'/f'GENERATED_END_TO_END_attempt{index:03d}'
        gr,gs,rr,rs=self.wires(output)
        def refs(scope,year):
            source=captures[year];old={'SOURCE_INPUTS.npz':runner.npz(dict(close_available_us=source['clocks'],close=source['close'])),
                'MINUTE_MARK_PROVENANCE.json':source['sidecar_raw'],'RAW_EVENTS.json':p.canonical(source['events'])+b'\n',
                'SOURCE_ROWS.json':p.canonical(source['source_rows'])+b'\n'}
            if year==2022:old['NORMALIZATION_EQUIVALENCE.json']=p.canonical(source['normalization_equivalence'])
            return (*f.saved[year],old)
        captures=dict(f.captures);captures[2022]=dict(captures[2022],normalization_equivalence={'generated_only':True})
        def capture(scope,year,contract):e.require_scope(scope);return captures[year]
        # Wire catalog hash must bind the same invented catalog inside the guard.
        with patch.object(e,'catalog',return_value=f.catalog):
            gr,gs,rr,rs=self.wires(output)
            with patch.object(e.backend,'capture_year',side_effect=capture),patch.object(runner,'saved_references',side_effect=refs):
                prepared=runner.prepare_source_only(output,go_raw=gr,go_sha=gs,review_raw=rr,review_sha=rs)
        self.assertFalse(e._LIVE);self.assertFalse(prepared['historical_admission']);self.assertEqual(prepared['accounts_constructed'],0)
        self.assertEqual(prepared['execution_minutes'],2498400)
        self.assertEqual((output/'SOURCE_INPUTS.npz').exists(),True)
        with np.load(output/'TARGETS.npz',allow_pickle=False) as data:self.assertEqual(len(data['decision_us']),1735)
        provenance=json.loads(gzip.decompress((output/'TARGET_PROVENANCE.json.gz').read_bytes()));self.assertEqual(len(provenance['original']),1735)
        receipt=json.loads((output/'SOURCE_GUARD_RECEIPT.json').read_bytes());self.assertFalse(any(receipt['forbidden_attempts'].values()))
        self.assertTrue(receipt['source_scopes_revoked']);self.assertFalse(receipt['guard_active'])
        self.assertIsNotNone(f.core._H090)
        self.assertTrue(any('CODE_DEPENDENCIES_PRELOADED' in str(row) for row in receipt['checkpoints']))
if __name__=='__main__':unittest.main(verbosity=2)
