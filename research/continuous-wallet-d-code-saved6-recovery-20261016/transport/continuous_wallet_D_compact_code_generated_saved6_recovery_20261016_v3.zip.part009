from copy import deepcopy
from decimal import Decimal
from pathlib import Path
from unittest.mock import patch
import tempfile
import unittest
import json
import sys
import build_saved_comparison as b


def invented(cell, nav='10000'):
    daily = [10000.] * (b.DAYS - 1) + [float(nav)]
    vol, _ = b.daily_risk(daily)
    cum, _ = b.decimal_returns(nav)
    years = [dict(year=year, days=days, paid_trade_legs=1, mean_gross_weight=.1,
                  paid_turnover_USDT='1', fees_plus_execution_cost_USDT='.1', signed_funding_cashflow_USDT='-.1')
             for year, days in zip(range(2021, 2026), (274, 365, 365, 366, 365))]
    audit = dict(status='PASS_ACTUAL_CONTINUOUS_PILOT_SAVED_AUDIT' if cell == b.CELLS[0] else 'PASS_INCREMENTAL_COMPLETED_CASE_SAVED_AUDIT_ROOT_EXIT_PENDING',
        cell_id=cell, calendar=[b.START,b.END], completed_minutes=b.MINUTES, native40_reconstructed=True,
        resource_bounds_passed=True, source_identity=b.SOURCE_ID, findings=[], financial_runs=0,
        accounts_constructed=0, independent_annual_boundary_checks=[{}]*4,
        independent_financial_arithmetic=dict(initial_cash='10000', status='FULL_CALENDAR_ACTUAL_PAID_MARKET_FLAT', NAV=nav,
            net_wallet_change=cum, totals=dict(fees='1', execution_cost='2', funding_cash='-3', gross_fill_turnover='10')),
        held_risk_report=dict(daily_NAV=daily, realized_daily_simple_return_annual_volatility=vol,
            nominal_annual_volatility_budget=.05, gross_exposure_mean=.1, gross_exposure_max=.2,
            asset_exposure_absolute_max=.1, forecast_volatility_breach_minutes=1, forecast_annual_volatility_max=.1),
        quality_saved_effects=dict(typed_cells_with_nonzero_carried_position=27, typed2022_cells=27, total_actual_rejection_receipts=0),
        warnings_and_qualifications=dict(all_observation_max_drawdown=.5, native40_secondary_PnL_bridge_residual='1E-35', funding_observed_events=26100, funding_account_applied_events=26095),
        independent_chunk_audit=dict(minute_close_max_drawdown=.5), guard50_warning_episodes=[],
        terminal_checkpoint_SHA256='0'*64, permanent_claim_SHA256='1'*64, financial_code_manifest_SHA256='2'*64,
        root_financial_GO_SHA256='3'*64)
    description = dict(annual_descriptive_activity=years, guard50_warning_episodes=[])
    return audit, description


class ReportingTests(unittest.TestCase):
    def test_exact_full_actual_day_return_and_CAGR_formulas(self):
        cumulative, cagr = b.decimal_returns('12000')
        self.assertEqual(Decimal(cumulative), Decimal('.2'))
        self.assertAlmostEqual(float(cagr), 1.2**(365/1735)-1, places=14)
        self.assertEqual(b.decimal_returns('10000'), ('0', '0'))
        self.assertEqual(b.decimal_returns('0'), ('-1', '-1'))
        self.assertIsNone(b.decimal_returns('-1')[1])

    def test_daily_first_close_is_not_mistaken_for_genesis(self):
        daily = [10000.] * b.DAYS
        self.assertEqual(b.daily_risk(daily), (0., 0.))
        with self.assertRaises(ValueError):b.daily_risk([10000.] + daily)
        with self.assertRaises(ValueError):b.daily_risk(daily[:-1])

    def test_all_six_in_original_order_and_losing_case_not_selected_out(self):
        rows = []
        for cell in b.CELLS:
            a, d = invented(cell, '5000')
            rows.append(b.extract(a, d, {}, cell))
        self.assertEqual(tuple(r['cell_id'] for r in rows), b.CELLS)
        self.assertTrue(all(Decimal(r['cumulative_wallet_change']) == Decimal('-.5') for r in rows))
        self.assertTrue(all(r['signed_funding_cashflow_USDT'] == '-3' and r['net_funding_cost_USDT'] == '3' for r in rows))
        self.assertTrue(all(r['fees_plus_execution_friction_USDT'] == '3' for r in rows))
        text = b.report_text(dict(cases=rows))
        self.assertIn('not OOS', text)
        self.assertIn('not be deducted', text)
        self.assertIn('365 / 1,735', text)
        self.assertIn('6 actual paid-market flat; 0 conditional-settled flat', text)

    def test_bad_full_calendar_or_audit_proof_refused(self):
        a, d = invented(b.CELLS[1])
        for key, value in [('cell_id', b.CELLS[0]), ('completed_minutes', 1735), ('native40_reconstructed', False),
                           ('status', 'PENDING'), ('source_identity', 'bad'), ('resource_bounds_passed', False), ('findings', ['bad'])]:
            changed = deepcopy(a);changed[key] = value
            with self.assertRaises(ValueError, msg=key):b.extract(changed, d, {}, b.CELLS[1])

    def test_consolidated_root_exit_strict_types_order_and_budget(self):
        final = dict(schema='INDEPENDENT_CONTINUOUS_REMAINING_FIVE_SAVED_AUDIT_V1', status='PASS_ACTUAL_REMAINING_FIVE_CONTINUOUS_SAVED_AUDIT',
            ordered_cells=list(b.CELLS[1:]), root_financial_GO_SHA256='83ca5ec50a5c0e1122bc00733ee1b46fee2efdcc698e748b7656d12b74e6bc70',
            actual_root_controller_shell_exit_code=0, completed_minutes_per_case=b.MINUTES, native40_reconstructed=True,
            resource_bounds_passed=True, logical_cohort_output_bytes=1000,
            per_case_audits=[dict(path=b.REMAINING+'/'+c+'/audit_attempt002/INDEPENDENT_CONTINUOUS_REMAINING_CASE_SAVED_AUDIT.json') for c in b.CELLS[1:]],
            cases=[dict(cell_id=c,reporting_addendum=dict(path=b.REMAINING+'/'+c+'/audit_attempt002/INDEPENDENT_REPORTING_ADDENDUM.json')) for c in b.CELLS[1:]],
            root_observed_exit_pin=dict(path='continuous_wallet_D_financial_20261015_v2/financial_attempts/ACTUAL_REMAINING5_attempt001/ROOT_OBSERVED_EXIT_CONFIRMED.json'))
        b.validate_final(final)
        for key, value in [('actual_root_controller_shell_exit_code', False), ('actual_root_controller_shell_exit_code', 1),
                           ('logical_cohort_output_bytes', 4200000001), ('ordered_cells', list(reversed(b.CELLS[1:]))), ('per_case_audits', [])]:
            changed = deepcopy(final);changed[key] = value
            with self.assertRaises(ValueError, msg=key):b.validate_final(changed)

    def test_report_file_no_silent_overwrite(self):
        with tempfile.TemporaryDirectory(prefix='INVENTED_REPORT_', dir=b.HERE) as temp, patch.object(b, 'HERE', Path(temp)):
            b.write_new('invented.json', b'{}\n')
            with self.assertRaises(ValueError):b.write_new('invented.json', b'changed')

    def test_invented_full_six_report_writer_end_to_end(self):
        with tempfile.TemporaryDirectory(prefix='INVENTED_REPORT_E2E_', dir=b.HERE) as temp:
            root=Path(temp);here=root/'REPORT';here.mkdir()
            def save(relative, value):
                path=root/relative;path.parent.mkdir(parents=True,exist_ok=True);path.write_bytes(b.canonical(value));return b.pin(path)
            with patch.multiple(b, ROOT=root, HERE=here):
                pilot_exit='continuous_wallet_D_financial_20261015_v1/financial_attempts/ACTUAL_PILOT_attempt001/ROOT_OBSERVED_EXIT_CONFIRMED.json'
                pilot_exit_pin=save(pilot_exit,dict(session_id=63130,observed_exit_code=0,test_only_invented=True))
                final_exit='continuous_wallet_D_financial_20261015_v2/financial_attempts/ACTUAL_REMAINING5_attempt001/ROOT_OBSERVED_EXIT_CONFIRMED.json'
                exit_pin=save(final_exit,dict(session_id=12642,observed_exit_code=0,test_only_invented=True))
                hashes=[];case_pins=[];case_rows=[]
                resource=dict(combined_worker_controller_CPU_seconds=1.,worker_plus_saved_validation_wall_seconds=1.,
                    simultaneous_worker_controller_RSS_peak_bytes=1,case_final_bytes_including_stdout=1,
                    all_case_resource_envelope_flags_passed=True,unknown_cgroup_uncertainty=True,
                    transient_physical_write_peak_exactly_sampled=False,actual_peak_AS_measured=False)
                for index,cell in enumerate(b.CELLS):
                    audit,desc=invented(cell,'5000')
                    audit['test_only_invented']=True
                    if index==0:
                        audit['root_controller_exit']=dict(root_receipt_path=str(root/pilot_exit),root_receipt_SHA256=pilot_exit_pin['SHA256'],root_receipt_bytes=pilot_exit_pin['bytes'])
                        ap=save(b.PILOT+'/audit_attempt004/INDEPENDENT_CONTINUOUS_PILOT_SAVED_AUDIT.json',audit)
                        desc['parent_audit_SHA256']=ap['SHA256']
                        pilot_desc_pin=save(b.PILOT+'/DESCRIPTIVE_SAVED_PILOT_ADDENDUM.json',desc)
                        pilot_resource_pin=save(b.PILOT+'/audit_attempt003/RESOURCE_OUTPUT_ADDENDUM.json',dict(combined_CPU_seconds=1.,worker_and_saved_validation_wall_seconds=1.,
                            pilot_worker_plus_controller_RSS_peak_bytes=1,case_final_bytes_including_stdout=1,unknown_cgroup_visibility=True))
                    else:
                        ap=save(b.REMAINING+'/'+cell+'/audit_attempt002/INDEPENDENT_CONTINUOUS_REMAINING_CASE_SAVED_AUDIT.json',audit)
                        case_pins.append(ap);desc.update(parent_audit=ap,resources=resource)
                        dp=save(str(Path(ap['path']).parent/'INDEPENDENT_REPORTING_ADDENDUM.json'),desc)
                        case_rows.append(dict(cell_id=cell,reporting_addendum=dp))
                    hashes.append(ap['SHA256'])
                final=dict(schema='INDEPENDENT_CONTINUOUS_REMAINING_FIVE_SAVED_AUDIT_V1',status='PASS_ACTUAL_REMAINING_FIVE_CONTINUOUS_SAVED_AUDIT',
                    ordered_cells=list(b.CELLS[1:]),root_financial_GO_SHA256='83ca5ec50a5c0e1122bc00733ee1b46fee2efdcc698e748b7656d12b74e6bc70',
                    actual_root_controller_shell_exit_code=0,completed_minutes_per_case=b.MINUTES,native40_reconstructed=True,resource_bounds_passed=True,
                    logical_cohort_output_bytes=1000,per_case_audits=case_pins,cases=case_rows,root_observed_exit_pin=exit_pin,test_only_invented=True)
                fp=save(b.REMAINING+'/INDEPENDENT_REMAINING_FIVE_FINAL_SAVED_AUDIT.json',final)
                for name in ('build_saved_comparison.py','test_saved_comparison.py'):(here/name).write_text('INVENTED REPORT SOURCE PIN\n')
                argv=['test','--consolidated-audit',fp['path'],'--sha',fp['SHA256'],'--bytes',str(fp['bytes'])]
                with patch.multiple(b,AUDIT_HASHES=tuple(hashes),PILOT_DESCRIPTION_PIN=pilot_desc_pin,PILOT_RESOURCE_PIN=pilot_resource_pin),patch.object(sys,'argv',argv):b.main()
                result=json.loads((here/'COMPARISON.json').read_bytes())
                self.assertEqual([r['cell_id'] for r in result['cases']],list(b.CELLS))
                self.assertTrue(all(Decimal(r['cumulative_wallet_change'])==Decimal('-.5') for r in result['cases']))
                self.assertEqual(len((here/'SUMMARY.csv').read_text().splitlines()),7)
                self.assertTrue((here/'SOURCE_PINS.json').is_file())
                self.assertIn('Local research only',(here/'REPORT.md').read_text())


if __name__ == '__main__':unittest.main(verbosity=2)
