                files={p.name:dict(SHA256=__import__('hashlib').sha256(p.read_bytes()).hexdigest(),bytes=p.stat().st_size)
                    for p in writer.directory.iterdir() if p.is_file()},historical_admission=False,root_financial_GO=False))
            print(json.dumps(dict(status='PASS_GENERATED_ONLY',output=str(writer.directory),minutes=sim.rows_written,
                native40=proof['passed'],peak_RSS_bytes=receipt['stages'][-1]['max_RSS_bytes'],CPU_seconds=time.process_time()-cpu)),flush=True)
    except BaseException as error:
