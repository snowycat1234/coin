Pure in-memory helpers mint no scope, perform no I/O, and authorize nothing.
The actual caller is source_entry's new exact root-gated source-only stage.
"""
from __future__ import annotations
from dataclasses import asdict
from io import BytesIO
from hashlib import sha256
import numpy as np
import source_entry as entry
import continuous_source as pure

S=pure.SYMBOLS;DAY=pure.DAY;MINUTE=pure.MINUTE


def targets_from_union(clocks,close,decisions,old,core):
    od,ow,oc,op=old.build_target_grid(close,clocks,clocks,decisions)
    cd,cw,cc,cp=core.build_target_grid(close,clocks,clocks,decisions)
    if od.tobytes()!=cd.tobytes() or oc.tobytes()!=cc.tobytes():raise ValueError('EXACT_SHARED_CONTINUOUS_DECISION_COVARIANCE_REQUIRED')
    targets={r+'_'+tier:pure.frozen((ow if r==pure.RECIPES[0] else cw)[r+'_'+tier]) for r in pure.RECIPES for tier in pure.TIERS}
    return dict(decision_us=pure.frozen(od,'<i8'),annual_covariance=pure.frozen(oc),targets=targets,old_proofs=op,core_proofs=cp)


def verify_saved_annual(source,legacy_arrays,legacy_proofs,core_arrays,core_proofs,projection,indexes,old,core):
    y=source['year'];t=source['clocks'];p=source['close'];d=source['decisions']
    od,ow,oc,op=old.build_target_grid(p,t,t,d);cd,cw,cc,cp=core.build_target_grid(p,t,t,d)
    required_legacy={'decision_us':od,'annual_covariance':oc,**{pure.RECIPES[0]+'_'+tier:ow[pure.RECIPES[0]+'_'+tier] for tier in pure.TIERS}}
    required_core={'decision_us':cd,'annual_covariance':cc,**{pure.RECIPES[1]+'_'+tier:cw[pure.RECIPES[1]+'_'+tier] for tier in pure.TIERS}}
    for reference,expected in ((legacy_arrays,required_legacy),(core_arrays,required_core)):
        for key,value in expected.items():
            if key not in reference or reference[key].dtype!=value.dtype or reference[key].shape!=value.shape or reference[key].tobytes()!=value.tobytes():
                raise ValueError('SAVED_ANNUAL_TARGET_DECISION_COVARIANCE_BIT_PARITY_FAILED:'+str(y)+':'+key)
    if (type(legacy_proofs) is not dict or legacy_proofs.get('original_intrinsic_then_downward_only') is not True
            or pure.canonical(legacy_proofs.get('proofs'))!=pure.canonical(op) or pure.canonical(core_proofs)!=pure.canonical(cp)):
        raise ValueError('SAVED_ANNUAL_COMPLETE_CAUSAL_PROVENANCE_PARITY_FAILED:'+str(y))
    if (projection['decision_us'][indexes].tobytes()!=od.tobytes() or projection['annual_covariance'][indexes].tobytes()!=oc.tobytes()
            or any(projection['targets'][key][indexes].tobytes()!=value.tobytes() for key,value in {**required_legacy,**required_core}.items() if key in projection['targets'])
            or any(pure.canonical(projection['old_proofs'][k])!=pure.canonical(op[i]) or pure.canonical(projection['core_proofs'][k])!=pure.canonical(cp[i]) for i,k in enumerate(indexes))):
        raise ValueError('CONTINUOUS_UNION_VERSUS_SAVED_ANNUAL_TARGET_OR_PROVENANCE_DISAGREEMENT:'+str(y))
    return dict(year=y,decisions=len(d),saved_legacy_STATIC50_and_CORE_HOLD_all_three_tiers_exact=True,
        covariance_and_decisions_exact=True,complete_source_rank_and_matching_provenance_exact=True,
        no_target_regeneration_in_financial_worker=True)


def qualify(captures,saved,old,core):
    if type(captures) is not dict or tuple(captures)!=entry.YEARS or set(saved)!=set(entry.YEARS):
        raise ValueError('EXACT_ORDERED_FIVE_YEAR_CAPTURE_AND_SAVED_REFERENCE_SET_REQUIRED')
    parts=[];segments=[];events=[];quality_cells=[];account_intervals=[];interval_witnesses=[];endpoints=[]
    cat=entry.catalog()
    for y,source in captures.items():
        rec=cat['years'][str(y)];start,end=rec['calendar']
        if (source['year']!=y or source['source_identity']!=rec['source_identity']
                or source['period']['start']!=start or source['period']['end']!=end):
            raise ValueError('EXACT_QUALIFIED_YEAR_SOURCE_IDENTITY_CALENDAR_REQUIRED')
        parts.append(dict(clocks=source['clocks'],available=source['clocks'],close=source['close']))
        selected=[]
        for r in source['contract']['months']:
            selected.append((r['start']+r['lo']*MINUTE,r['start']+r['hi']*MINUTE))
        pure.validate_partitions(selected,start=start,end=end);segments+=selected
        witness=source['native_endpoint_witness']
        if witness['completed_us']!=end or witness['minute_open_us']!=end-MINUTE or witness['genuine_native_trade_close'] is not True:
            raise ValueError('EXACT_GENUINE_YEAR_FINAL_SELECTED_NATIVE_MINUTE_ENDPOINT_REQUIRED')
        endpoints.append(witness)
        if y<2025:
            nxt=captures[y+1];k=int(np.searchsorted(nxt['clocks'],end))
            if k>=len(nxt['clocks']):raise ValueError('NEXT_YEAR_FIRST_DAILY_ENDPOINT_MISSING')
            pure.validate_endpoint(end,int(nxt['clocks'][k]),source['native_endpoint_close'],nxt['close'][k])
        expected_count=rec['contract']['events']['selected_events']
        if len(source['events'])!=expected_count:raise ValueError('EXACT_YEAR_LITERAL_FUNDING_COUNT_REQUIRED')
        # Each annual assembler already validates its original same-clock symbol
        # order. Concatenate unchanged, never globally re-sort or rescale rates.
        for row in source['events']:
            if not start<=row['event_us']<end:raise ValueError('SOURCE_EVENT_AT_OR_BEYOND_YEAR_ENDPOINT')
            events.append(dict(row))
        quality_cells.extend(source['quality_cells']);account_intervals.extend(source['quality_intervals'])
        if y==2024:
            original=entry.design_record(y)['last_genuine_source_available_us']
            interval_witnesses.extend(dict(start_us=a,end_us=b,symbols=list(symbols),original_genuine_observation_us=original,
                recovery_evidence='ORIGINAL_QUALIFIED_CONTRACT_AND_GUARDED_SOURCE_PATH_NOT_STANDALONE_SAVED_RECOVERY_PRICE') for a,b,symbols in source['quality_intervals'])
    count=pure.validate_partitions(segments,start=pure.HISTORICAL_START,end=pure.HISTORICAL_END)
    if count!=2498400:raise ValueError('EXACT_CONTINUOUS_2498400_MINUTES_REQUIRED')
    clocks,close=pure.exact_daily_union(parts,start=pure.HISTORICAL_START,end=pure.HISTORICAL_END)
    decisions=pure.frozen(np.arange(pure.HISTORICAL_START,pure.HISTORICAL_END,DAY,dtype='<i8'),'<i8')
    if len(events)!=26100 or len({(r['symbol'],r['event_us']) for r in events})!=len(events) or any(a['event_us']>b['event_us'] for a,b in zip(events,events[1:])):
        raise ValueError('EXACT_LITERAL_GLOBAL_26100_FUNDING_EVENTS_NO_REPLAY_REQUIRED')
    if len(clocks)!=1934 or len(decisions)!=1735:raise ValueError('EXACT_1934_FEATURE_1735_DECISION_UNION_REQUIRED')
    projection=targets_from_union(clocks,close,decisions,old,core);parity=[]
    for y,source in captures.items():
        indexes=np.flatnonzero((decisions>=source['period']['start'])&(decisions<source['period']['end']))
        parity.append(verify_saved_annual(source,*saved[y],projection,indexes,old,core))
    if len(quality_cells)!=27 or len(interval_witnesses)!=1 or len(captures[2022]['sidecar']['genuine_recovery_witnesses'])!=8:
        raise ValueError('EXACT_27_TYPED_CELLS_EIGHT_RECOVERIES_AND_LATER_2024_INTERVAL_REQUIRED')
    quality=dict(cells=[asdict(c) for c in quality_cells],account_quality_intervals=pure.json_plain(account_intervals),
        later_interval_witnesses=interval_witnesses,genuine_2022_recovery_witnesses=pure.json_plain(captures[2022]['sidecar']['genuine_recovery_witnesses']),
        policy='REJECT_INCREASE_WHEN_EITHER_TYPED_CELL_OR_INTERVAL_UNRECOVERED',
        original_source_age_and_arrival_flags_preserved=True,arrival_certified=False,native_venue_certified=False,
        actual_event_or_position_impacts='PENDING_FUTURE_ACTUAL_EXECUTION')
    identity=pure.digest(dict(ordered_source_identities=[captures[y]['source_identity'] for y in entry.YEARS],
        feature_clocks=pure.array_id(clocks),feature_close=pure.array_id(close),events=events,quality=quality,
        selected_months=[cat['years'][str(y)]['source_month_declarations'] for y in entry.YEARS],endpoints=endpoints))
    return dict(clocks=clocks,close=close,decisions=decisions,projection=projection,events=events,quality=quality,
        source_identity=identity,annual_parity=parity,endpoint_witnesses=endpoints,execution_minutes=count)
