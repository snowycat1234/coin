def safe_rel(rel):
 require(type(rel)is str,'MEMBER_STRING_REQUIRED');p=PurePosixPath(rel)
 require(rel and not p.is_absolute() and '..'not in p.parts and '\\'not in rel and str(p)==rel,'UNSAFE_RELATIVE_MEMBER')
def verify_scope(s):
 for k,v in (('case_count',6),('days',DAYS),('minutes_per_account',MINUTES),('carried_Jan1_seams_per_account',4),('only_final_later_real_minute_opens',60),('network_actions',0)):exactint(s[k],v,k)
 require(s['ordered_cells']==list(CELLS) and s['calendar']==[START,END] and s['source_identity']==SOURCE_ID,'EXACT_FIXED_CONTINUOUS_COHORT')
 for k in ('one_initial_10000_USDT_shared_wallet_each','all_seen_DEV','nominal_tier_is_not_equal_realized_risk'):require(s[k]is True,'EXPLICIT_TRUE:'+k)
 for k in ('annual_reset_close_reseed','publication_performed','financial_or_source_replay','new_execution_authority','originals_changed'):require(s[k]is False,'EXPLICIT_FALSE:'+k)
def verify_manifest(m,observed):
 exactint(m['case_count'],6,'manifest_case_count');require(m['ordered_cells']==list(CELLS),'MANIFEST_FIXED_ORDER')
 for k in ('external_trusted_outer_ZIP_SHA256_mandatory','external_trusted_launcher_SHA256_mandatory'):require(m[k]is True,'EXTERNAL_TRUST_REQUIRED')
 for k in ('publication_performed','new_execution_authority'):require(m[k]is False,'LOCAL_ONLY_NO_AUTHORITY')
 for rel,ref in m['files'].items():safe_rel(rel);verify_pin_shape(ref)
 require(same(m['files'],observed),'MANIFEST_FILESET_OR_BYTES_MISMATCH')
def verify_transform(t):
 for k in ('original_pin','stored_pin','uncompressed_pin'):verify_pin_shape(t[k])
 require(t['financial_decimal_or_event_fields_modified']is False,'FINANCIAL_VALUES_NEVER_EDITED')
 require(t['transformation']in ('EXACT_ORIGINAL_BYTES','EXACT_ORIGINAL_COMPRESSED_BYTES'),'EXACT_ORIGINAL_COPY_REQUIRED')
 require(t['original_pin']==t['stored_pin'],'EXACT_STORED_ORIGINAL_BYTES')
def verify_saved_risk_metrics(risk,row):
 daily=risk['daily_NAV'];exactint(len(daily),DAYS,'1735_daily_NAV')
 previous=10000.0;peak=previous;mdd=0.0;returns=[]
 for value in daily:
  value=float(value);require(math.isfinite(value) and previous>0,'FINITE_DAILY_NAV_AND_POSITIVE_PREVIOUS')
  returns.append(value/previous-1);peak=max(peak,value);mdd=max(mdd,1-value/peak);previous=value
 vol=statistics.stdev(returns)*math.sqrt(365)
 require(abs(vol-risk['realized_daily_simple_return_annual_volatility'])<=1e-14 and vol==row['realized_daily_return_annual_volatility'],'RECOMPUTED_SAVED_DAILY_VOLATILITY')
 require(mdd==row['independently_recomputed_daily_close_max_drawdown'],'RECOMPUTED_SAVED_DAILY_MDD')
 # This tolerance is reporting-only, reproducing the original report's saved-float check.
 # All native40 financial/event assertions remain exact with no epsilon.
 return dict(realized_daily_return_annual_volatility=vol,daily_close_max_drawdown=mdd)
def verify_snapshot_set(smap):
 snapshots=smap['inert_code_snapshots'];expected={rel.rsplit('/',1)[0] for rel in CODE_PINS}
 require(type(snapshots)is dict and set(snapshots)==expected,'EXACT_FOUR_REQUIRED_CODE_SNAPSHOTS')
 for directory,snapshot in snapshots.items():
  manifest_name='FINANCIAL_CODE_MANIFEST.json' if 'financial_'in directory else 'CODE_MANIFEST.json'
  require(snapshot['manifest']=='source/'+directory+'/'+manifest_name,'EXACT_SOURCE_MANIFEST_PACKET_PATH')
  exclusions=['AUTHOR_GENERATED_TESTS_FINAL.log'] if directory=='continuous_wallet_D_generated_20261015_v1' else []
  require(snapshot['excluded_manifest_members_hash_only']==exclusions,'ONLY_DECLARED_GENERATED_LOG_OMISSION')
  for name,rel in snapshot['files'].items():require(rel=='source/'+directory+'/'+name,'EXACT_INERT_SOURCE_FILE_PATH')
def verify_case_file_map(cm,cell,transforms):
 original=('continuous_wallet_D_financial_20261015_v1/financial_attempts/ACTUAL_PILOT_attempt001' if cell==CELLS[0] else 'continuous_wallet_D_financial_20261015_v2/financial_attempts/ACTUAL_REMAINING5_attempt001')+'/'+cell
 require(cm['original_output_relative_directory']==original,'EXACT_FIXED_CASE_ORIGINAL_DIRECTORY')
 require(set(cm['files'])==set(CASE_FILE_NAMES),'EXACT_COMPLETE_CASE_FILE_NAMES')
 require(cm['review']=='reviews/'+cell+'/INDEPENDENT_SAVED_AUDIT.json' and cm['reporting_addendum']=='reviews/'+cell+'/REPORTING_ADDENDUM.json','EXACT_CASE_REVIEW_PACKET_PATHS')
 for name,rel in cm['files'].items():
  require(rel=='cases/'+cell+'/'+name,'EXACT_CASE_PACKET_FILE_PATH')
  require(transforms[rel]['original_relative_path']==original+'/'+name,'EXACT_CASE_ORIGINAL_FILE_BACKBINDING')
def verify_required_evidence(root):
 for rel,digest in REQUIRED_EVIDENCE_PINS.items():require(pin(Path(root)/rel)['SHA256']==digest,'EXACT_REQUIRED_INDEPENDENT_EVIDENCE:'+rel)
