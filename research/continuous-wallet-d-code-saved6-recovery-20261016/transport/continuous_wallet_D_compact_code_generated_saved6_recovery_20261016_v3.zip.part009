Import and the bootstrap branch are stdlib only. Neither imports a numerical,
source, native-account or old controller module. There is no retry or recovery
branch, and a failed spawn consumes its permanent cell claim.
"""
from __future__ import annotations

import argparse
from contextlib import contextmanager
from collections.abc import Mapping
from datetime import datetime, timezone
from hashlib import sha256
import fcntl
import json
from itertools import islice
import math
import os
from pathlib import Path
import re
import resource
import shutil
import signal
import stat
import subprocess
import sys
import threading
import time

HERE = Path(__file__).resolve().parent
ROOT = HERE.parent
PYTHON = ROOT / 'coin_partial_restore_20261014/.venv/bin/python'
THREAD_ENV = ('OPENBLAS_NUM_THREADS', 'OMP_NUM_THREADS', 'MKL_NUM_THREADS',
              'NUMEXPR_NUM_THREADS', 'POLARS_MAX_THREADS',
              'VECLIB_MAXIMUM_THREADS', 'BLIS_NUM_THREADS')
LEASE_ENV = ('CONTINUOUS_OWN_LEASE_FD', 'CONTINUOUS_SHARED_CPU45_LEASE_FD')
POLL_SECONDS = .25
HEARTBEAT_SECONDS = 2.


def admission():
    import continuous_admission as value
    if Path(value.__file__).resolve() != HERE / 'continuous_admission.py':
        raise ValueError('EXACT_CONTINUOUS_ADMISSION_MODULE_REQUIRED')
    return value


def utc():
    return datetime.now(timezone.utc).isoformat()


def canonical(value):
    return json.dumps(value, sort_keys=True, separators=(',', ':'), allow_nan=False).encode()


def sha(raw):
    return sha256(raw).hexdigest()


def ordinary(path):
    path = Path(os.path.abspath(path))
    if path.is_symlink() or any(p.is_symlink() for p in path.parents):
        raise ValueError('ORDINARY_NO_SYMLINK_PATH_REQUIRED')
    return path


def own_bytes(path):
    total = 0
    for item in Path(path).rglob('*'):
        try:
            info = item.lstat()
        except FileNotFoundError:
            continue
        if stat.S_ISLNK(info.st_mode):
            raise ValueError('OWNED_OUTPUT_MUST_NOT_CONTAIN_SYMLINKS')
        if stat.S_ISREG(info.st_mode):
            total += info.st_size
    return total


def atomic(path, raw, *, cohort=None, case=None, log=None, replace=False):
    """Bound even temporary bytes and publish without clobbering evidence."""
    a = admission()
    path = ordinary(path)
    if case is not None:
        log_bytes = Path(log).stat().st_size if log is not None and Path(log).exists() else 0
        if own_bytes(case) + log_bytes + len(raw) > a.LIMITS['case_output_bytes']:
            raise RuntimeError('CASE_OUTPUT_CAP_STOP_BEFORE_WRITE')
    if cohort is not None and own_bytes(cohort) + len(raw) > a.LIMITS['cohort_output_bytes']:
        raise RuntimeError('COHORT_OUTPUT_CAP_STOP_BEFORE_WRITE')
    if shutil.disk_usage(path.parent).free < a.LIMITS['free_disk_floor_bytes'] + len(raw):
        raise RuntimeError('DISK_RESERVE_STOP_BEFORE_WRITE')
    if path.exists() and not replace:
        raise FileExistsError('IMMUTABLE_EVIDENCE_ALREADY_EXISTS:' + str(path))
    temp = path.with_name('.' + path.name + '.' + str(os.getpid()) + '.tmp')
    fd = os.open(temp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    try:
        with os.fdopen(fd, 'wb') as stream:
            stream.write(raw)
            stream.flush()
            os.fsync(stream.fileno())
        if replace:
            os.replace(temp, path)
        else:
            os.link(temp, path)
            temp.unlink()
        fd = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(fd)
        finally:
            os.close(fd)
    finally:
        if temp.exists():
            temp.unlink()
    return dict(SHA256=sha(raw), bytes=len(raw))


def save(path, value, **kwargs):
    return atomic(path, canonical(value) + b'\n', **kwargs)


def process_observation(pid):
    try:
        proc = Path('/proc') / str(pid)
        # comm can itself contain ')' or spaces; the final ') ' is the delimiter.
        fields = (proc / 'stat').read_text().rsplit(') ', 1)[1].split()
        status = dict(line.split(':', 1) for line in (proc / 'status').read_text().splitlines() if ':' in line)
        tasks = []
        for item in (proc / 'task').iterdir():
            try:
                tasks.append(dict(TID=int(item.name), CPU_affinity=sorted(os.sched_getaffinity(int(item.name)))))
            except (FileNotFoundError, ProcessLookupError):
                continue
        return dict(PID=pid, process_start_ticks=fields[19], parent_PID=int(fields[1]),
                    CPU_seconds=(int(fields[11]) + int(fields[12])) / os.sysconf('SC_CLK_TCK'),
                    RSS_bytes=int(status.get('VmRSS', '0 kB').split()[0]) * 1024,
                    CPU_affinity=sorted(os.sched_getaffinity(pid)), tasks=tasks,
                    state=fields[0])
    except (FileNotFoundError, ProcessLookupError):
        return None


def host_observation():
    mem = dict(line.split(':', 1) for line in Path('/proc/meminfo').read_text().splitlines())
    host = int(mem['MemAvailable'].split()[0]) * 1024
    observations = {}
    remaining = []
    # Inspect every visible ancestor, since an ancestor can impose the tighter
    # cgroup cap. An invisible mount/ancestor is explicitly an uncertainty.
    mounts = []
    for line in Path('/proc/self/mountinfo').read_text().splitlines():
        left, right = line.split(' - ', 1)
        if right.split()[0] == 'cgroup2':
            fields = left.split()
            mounts.append((Path(fields[4]), fields[3]))
    own_group = next((line.split(':', 2)[2] for line in Path('/proc/self/cgroup').read_text().splitlines()
                      if line.startswith('0::')), None)
    uncertain = not mounts or own_group is None
    for mount, root in mounts:
        if own_group == root:
            current = mount
        elif own_group is not None and root == '/':
            current = mount / own_group.lstrip('/')
        elif own_group is not None and own_group.startswith(root.rstrip('/') + '/'):
            current = mount / own_group[len(root):].lstrip('/')
        else:
            uncertain = True
            continue
        # Container cgroup namespaces can report a root not navigable from the
        # mount. Do not claim that missing traversal establishes availability.
        if not current.is_dir():
            current = mount
            uncertain = True
        while True:
            row = {}
            for name in ('memory.max', 'memory.current', 'cpu.max'):
                try:
                    row[name] = (current / name).read_text().strip()
                except (FileNotFoundError, PermissionError):
                    row[name] = 'UNAVAILABLE'
                    uncertain = True
            observations[str(current)] = row
            maximum, used = row['memory.max'], row['memory.current']
            if maximum.isdigit() and used.isdigit():
                remaining.append(max(0, int(maximum) - int(used)))
            elif maximum != 'max':
                uncertain = True
            if current == mount:
                if root != '/':
                    uncertain = True
                break
            current = current.parent
    return dict(UTC=utc(), allowed_CPUs=sorted(os.sched_getaffinity(0)), MemAvailable_bytes=host,
                visible_cgroup_remaining_bytes=min(remaining) if remaining else None,
                conservative_available_bytes=min([host] + remaining),
                cgroup_observations=observations, unknown_cgroup_uncertainty=uncertain,
                availability_is_observation_not_a_guarantee=True)


def require_launch_resources(cpu):
    a = admission()
    observation = host_observation()
    if type(cpu) is not int or cpu not in observation['allowed_CPUs']:
        raise ValueError('EXPLICIT_ACTUALLY_ALLOWED_WORKER_CPU_REQUIRED')
    if observation['conservative_available_bytes'] < a.LIMITS['available_memory_before_launch_bytes']:
        raise RuntimeError('AVAILABLE_MEMORY_BELOW_5500000000_PAUSE_BEFORE_LAUNCH')
    return observation


@contextmanager
def controller_leases():
    a = admission()
    shared = ordinary(a.SHARED_LEASE)
    # This established shared resource inode must already exist.
    shared_fd = os.open(shared, os.O_RDWR | os.O_NOFOLLOW)
    own_fd = None
    try:
        try:
            fcntl.flock(shared_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise RuntimeError('SHARED_CPU45_LEASE_HELD_REFUSE_OVERLAP')
        ordinary(a.CLAIMS).mkdir(parents=True, exist_ok=True)
        own_fd = os.open(a.CLAIMS / 'CONTROLLER_LEASE.lock', os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
        try:
            fcntl.flock(own_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise RuntimeError('CONTINUOUS_OWN_LEASE_HELD_REFUSE_OVERLAP')
        yield (own_fd, shared_fd)
    finally:
        # Never LOCK_UN an inherited open file description: a surviving child
        # must continue holding both exclusions after this controller dies.
        if own_fd is not None:
            os.close(own_fd)
        os.close(shared_fd)


def reserve_claim(go, prep, args, case):
    a = admission()
    cell = a.CELLS[0]
    current = process_observation(os.getpid())
    claim = dict(schema='PERMANENT_CONTINUOUS_FIRST_OF_SIX_CELL_CLAIM_V1',
                 status='RESERVED_BEFORE_SPAWN_NO_AUTOMATIC_RETRY', cell_id=cell,
                 ordered_cohort=list(a.CELLS), calendar=[a.START, a.END],
                 root_GO_SHA256=args.go_sha, independent_review_SHA256=args.review_sha,
                 code_manifest_SHA256=go['code_manifest_SHA256'],
                 prepared_source=go['prepared_source'], prepared_source_audit=go['prepared_source_audit'],
                 source_identity=prep['source_identity'], array_identities_SHA256=a.digest(prep['array_identities']),
                 CPU=args.cpu, case_output=str(case), controller_output=str(ordinary(args.output)),
                 controller_PID=os.getpid(), controller_start_ticks=current['process_start_ticks'],
                 claim_UTC=utc(), automatic_retry=False, snapshot_resume=False, first_account_counts_once=True)
    path = ordinary(a.CLAIMS / (cell + '.json'))
    try:
        save(path, claim)
    except FileExistsError:
        raise RuntimeError('PERMANENT_CONTINUOUS_CELL_CLAIM_EXISTS_NO_DUPLICATE_LAUNCH:' + cell)
    return path.read_bytes()


def environment(lease_fds, parent):
    env = dict(os.environ)
    for key in ('PYTHONPATH', 'PYTHONHOME', 'LD_PRELOAD'):
        env.pop(key, None)
    env.update(PYTHONDONTWRITEBYTECODE='1', **{key: '1' for key in THREAD_ENV})
    env.update({key: str(fd) for key, fd in zip(LEASE_ENV, lease_fds, strict=True)})
    env['CONTINUOUS_CONTROLLER_PID'] = str(parent['PID'])
    env['CONTINUOUS_CONTROLLER_START_TICKS'] = parent['process_start_ticks']
    return env


def lease_fds_from_environment():
    fds = []
    for key in LEASE_ENV:
        raw = os.environ.get(key, '')
        if not raw.isdigit():
            raise ValueError('EXACT_INHERITED_OWN_AND_SHARED_LEASE_FDS_REQUIRED')
        fds.append(int(raw))
    a = admission()
    for fd, path in zip(fds, (a.CLAIMS / 'CONTROLLER_LEASE.lock', a.SHARED_LEASE), strict=True):
        held, actual = os.fstat(fd), ordinary(path).stat()
        if not stat.S_ISREG(held.st_mode) or (held.st_dev, held.st_ino) != (actual.st_dev, actual.st_ino):
            raise ValueError('EXACT_INHERITED_LEASE_INODES_REQUIRED')
        # Existing inherited descriptions can reassert their own lock; another
        # process's unlocked/replaced descriptor cannot establish this pair.
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    return tuple(fds)


def require_parent():
    pid = os.environ.get('CONTINUOUS_CONTROLLER_PID', '')
    ticks = os.environ.get('CONTINUOUS_CONTROLLER_START_TICKS', '')
    if not pid.isdigit() or not ticks.isdigit() or os.getppid() != int(pid):
        raise RuntimeError('LIVE_EXACT_CONTROLLER_PARENT_REQUIRED')
    observed = process_observation(int(pid))
    if observed is None or observed['process_start_ticks'] != ticks or observed['state'] == 'Z':
        raise RuntimeError('CONTROLLER_PARENT_LOST_ABORT_PRESERVE_PREFIX')
    return observed


def _termination(signum, frame):
    raise RuntimeError('ASYNC_PARENT_OR_RESOURCE_TERMINATION_' + str(signum))


def install_parent_death_guard():
    require_parent()
    # ctypes is stdlib, and this occurs before numerical/legacy imports. The
    # Linux kernel sends SIGTERM on parent death even during numerical work.
    import ctypes
    libc = ctypes.CDLL(None, use_errno=True)
    if libc.prctl(1, int(signal.SIGTERM), 0, 0, 0) != 0:
        raise OSError(ctypes.get_errno(), 'PR_SET_PDEATHSIG_REQUIRED')
    signal.signal(signal.SIGTERM, _termination)
    require_parent()  # Close the parent-death race around prctl.


def bootstrap(cpu, directory, child):
    # All calls above this point are stdlib-only; no legacy bootstrap is used.
    a = admission()
    if type(cpu) is not int or cpu not in (4, 5) or cpu not in os.sched_getaffinity(0):
        raise ValueError('ROOT_RELEASED_EXPLICIT_CPU4_OR_CPU5_REQUIRED')
    for key in THREAD_ENV:
        os.environ[key] = '1'
    os.sched_setaffinity(0, {cpu})
    for which, limit in ((resource.RLIMIT_CPU, a.LIMITS['CPU_seconds']),
                         (resource.RLIMIT_AS, a.LIMITS['AS_bytes']),
                         (resource.RLIMIT_RSS, a.LIMITS['RSS_bytes'])):
        resource.setrlimit(which, (limit, limit))
    install_parent_death_guard()
    fds = lease_fds_from_environment()
    directory = ordinary(directory)
    if not directory.is_dir() or directory.parent.parent != HERE / 'financial_attempts':
        raise ValueError('PRECREATED_EXACT_FRESH_PILOT_CASE_DIRECTORY_REQUIRED')
    owner_path = directory / 'PROCESS_OWNERSHIP.json'
    deadline = time.monotonic() + 3
    while not owner_path.exists() and time.monotonic() < deadline:
        require_parent()
        time.sleep(.01)
    owner = json.loads(ordinary(owner_path).read_bytes())
    self_observed = process_observation(os.getpid())
    if (owner.get('PID') != os.getpid() or owner.get('CPU') != cpu
            or owner.get('process_start_ticks') != self_observed['process_start_ticks']
            or owner.get('controller_PID') != os.getppid()
            or owner.get('controller_start_ticks') != require_parent()['process_start_ticks']):
        raise ValueError('EXACT_OWNED_PID_START_PARENT_BOOTSTRAP_HANDSHAKE_REQUIRED')
    claim_raw = (directory / 'LAUNCH_CLAIM.json').read_bytes()
    claim = json.loads(claim_raw)
    if claim.get('CPU') != cpu or claim.get('case_output') != str(directory) or owner.get('claim_SHA256') != sha(claim_raw):
        raise ValueError('EXACT_BOOTSTRAP_CANONICAL_CLAIM_BINDING_REQUIRED')
    receipt = dict(schema='CONTINUOUS_STDLIB_PRE_NUMERICAL_BOOTSTRAP_V1', PID=os.getpid(),
                   process_start_ticks=self_observed['process_start_ticks'], requested_CPU=cpu, CPU=cpu,
                   actual_affinity=sorted(os.sched_getaffinity(0)), controller_PID=os.getppid(),
                   controller_start_ticks=require_parent()['process_start_ticks'],
                   claim_SHA256=sha(claim_raw), parent_death_signal=int(signal.SIGTERM),
                   inherited_lease_inodes=[dict(device=os.fstat(fd).st_dev, inode=os.fstat(fd).st_ino) for fd in fds],
                   thread_environment={key: os.environ[key] for key in THREAD_ENV},
                   limits={name: list(resource.getrlimit(which)) for name, which in
                           (('CPU', resource.RLIMIT_CPU), ('AS', resource.RLIMIT_AS), ('RSS', resource.RLIMIT_RSS))})
    save(directory / 'BOOTSTRAP_READY.json', receipt, cohort=directory.parent, case=directory,
         log=directory.parent / (directory.name + '.stdout.log'))
    if child[:3] != [str(PYTHON), '-B', str(HERE / 'run_continuous.py')] or '--case' not in child:
        raise ValueError('EXACT_PINNED_CONTINUOUS_WORKER_EXEC_REQUIRED')
    for fd in fds:
        os.set_inheritable(fd, True)
    os.execve(child[0], child, environment(fds, require_parent()))


def stop_owned(process, start_ticks):
    def send(sig):
        observed = process_observation(process.pid)
        if observed is not None and observed['process_start_ticks'] == start_ticks:
            os.kill(process.pid, sig)
    if process.poll() is None:
        send(signal.SIGTERM)
        try:
            process.wait(timeout=2)
        except subprocess.TimeoutExpired:
            send(signal.SIGKILL)
            process.wait(timeout=3)


def supervise(command, directory, *, cohort, cpu, lease_fds, claim_sha):
    """One real owned subprocess. No admission, launch queue or retry policy."""
    a = admission()
    directory, cohort = ordinary(directory), ordinary(cohort)
    parent = process_observation(os.getpid())
    log_path = cohort / (directory.name + '.stdout.log')
    began = time.monotonic()
    process = None
    owned_ticks = None
    last_heartbeat = 0.
    observations = []
    maximum_rss = 0
    maximum_aggregate_rss = 0
    maximum_cpu = 0.
    stop_reason = None
    log_fd = os.open(log_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    try:
        children_before = resource.getrusage(resource.RUSAGE_CHILDREN)
        process = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                   pass_fds=tuple(lease_fds), env=environment(lease_fds, parent),
                                   cwd=ROOT, close_fds=True)
        observed = process_observation(process.pid)
        if observed is None:
            raise RuntimeError('SPAWNED_WORKER_DISAPPEARED_BEFORE_OWNERSHIP_HANDSHAKE')
        owned_ticks = observed['process_start_ticks']
        owner = dict(schema='CONTINUOUS_OWNED_CHILD_PROCESS_V1', cell_id=directory.name,
                     PID=process.pid, process_start_ticks=owned_ticks, CPU=cpu,
                     controller_PID=os.getpid(), controller_start_ticks=parent['process_start_ticks'],
                     claim_SHA256=claim_sha, created_UTC=utc())
        save(directory / 'PROCESS_OWNERSHIP.json', owner, cohort=cohort, case=directory, log=log_path)
        os.set_blocking(process.stdout.fileno(), False)
        while True:
            # Drain a bounded amount each pass, checking the exact byte budgets
            # before persistence. Child pipe backpressure bounds unread output.
            for _ in range(16):
                try:
                    raw = os.read(process.stdout.fileno(), 65536)
                except BlockingIOError:
                    break
                if not raw:
                    break
                if own_bytes(directory) + os.fstat(log_fd).st_size + len(raw) > a.LIMITS['case_output_bytes']:
                    raise RuntimeError('CASE_OUTPUT_INCLUDING_STDOUT_CAP_STOP')
                if own_bytes(cohort) + len(raw) > a.LIMITS['cohort_output_bytes']:
                    raise RuntimeError('COHORT_OUTPUT_INCLUDING_STDOUT_CAP_STOP')
                if shutil.disk_usage(cohort).free < a.LIMITS['free_disk_floor_bytes'] + len(raw):
                    raise RuntimeError('DISK_RESERVE_STOP_BEFORE_STDOUT_WRITE')
                os.write(log_fd, raw)
            now = time.monotonic()
            observed = process_observation(process.pid)
            code = process.poll()
            if observed is not None:
                if observed['process_start_ticks'] != owned_ticks:
                    raise RuntimeError('OWNED_WORKER_PID_IDENTITY_CHANGED_PAUSE')
                maximum_rss = max(maximum_rss, observed['RSS_bytes'])
                controller_rss = process_observation(os.getpid())['RSS_bytes']
                maximum_aggregate_rss = max(maximum_aggregate_rss, observed['RSS_bytes'] + controller_rss)
                maximum_cpu = max(maximum_cpu, observed['CPU_seconds'])
                if observed['CPU_affinity'] != [cpu] or any(t['CPU_affinity'] != [cpu] for t in observed['tasks']):
                    # Bootstrap has a very short pre-affinity interval.
                    if (directory / 'BOOTSTRAP_READY.json').exists() or now - began > 3:
                        raise RuntimeError('OWNED_WORKER_THREAD_AFFINITY_ESCAPED')
                if maximum_aggregate_rss >= a.LIMITS['RSS_bytes']:
                    raise RuntimeError('OBSERVED_WORKER_AGGREGATE_RSS_CAP_STOP')
                if maximum_cpu >= a.LIMITS['CPU_seconds']:
                    raise RuntimeError('OBSERVED_WORKER_CPU_CAP_STOP')
                if observed['CPU_seconds'] + time.process_time() >= a.LIMITS['CPU_seconds']:
                    raise RuntimeError('OBSERVED_WORKER_AND_CONTROLLER_COMBINED_CPU_CAP_STOP')
            if now - began >= a.LIMITS['wall_seconds']:
                raise RuntimeError('OWNED_WORKER_WALL_CAP_STOP')
            if own_bytes(directory) + os.fstat(log_fd).st_size > a.LIMITS['case_output_bytes']:
                raise RuntimeError('CASE_OUTPUT_INCLUDING_STDOUT_CAP_STOP')
            if own_bytes(cohort) > a.LIMITS['cohort_output_bytes']:
                raise RuntimeError('COHORT_OUTPUT_CAP_STOP')
            if shutil.disk_usage(cohort).free < a.LIMITS['free_disk_floor_bytes']:
                raise RuntimeError('DISK_FREE_FLOOR_RESOURCE_STOP')
            if now - last_heartbeat >= HEARTBEAT_SECONDS:
                sample = dict(wall_seconds=now-began, RSS_bytes=observed['RSS_bytes'] if observed else None,
                              CPU_seconds=observed['CPU_seconds'] if observed else None,
                              case_output_including_log_bytes=own_bytes(directory)+os.fstat(log_fd).st_size,
                              cohort_output_bytes=own_bytes(cohort))
                observations.append(sample)
                observations = observations[-16:]
                save(cohort / 'CONTROLLER_HEARTBEAT.json', dict(schema='BOUNDED_CONTINUOUS_CONTROLLER_OBSERVATION_V1',
                     PID=process.pid, process_start_ticks=owned_ticks, samples=observations,
                     max_RSS_bytes=maximum_rss, max_aggregate_RSS_bytes=maximum_aggregate_rss,
                     max_CPU_seconds=maximum_cpu, limits=a.LIMITS),
                     cohort=cohort, replace=True)
                last_heartbeat = now
            if code is not None:
                # wait() is the actual owned shell exit, never a worker claim.
                code = process.wait()
                # Drain the finite remaining pipe after owned exit.
                while True:
                    try:
                        raw = os.read(process.stdout.fileno(), 65536)
                    except BlockingIOError:
                        break
                    if not raw:
                        break
                    if (own_bytes(directory)+os.fstat(log_fd).st_size+len(raw)>a.LIMITS['case_output_bytes']
                            or own_bytes(cohort)+len(raw)>a.LIMITS['cohort_output_bytes']
                            or shutil.disk_usage(cohort).free<a.LIMITS['free_disk_floor_bytes']+len(raw)):
                        raise RuntimeError('FINAL_STDOUT_RESOURCE_CAP_STOP')
                    os.write(log_fd, raw)
                child_usage = resource.getrusage(resource.RUSAGE_CHILDREN)
                actual_cpu = (child_usage.ru_utime+child_usage.ru_stime
                              -children_before.ru_utime-children_before.ru_stime)
                maximum_rss = max(maximum_rss, child_usage.ru_maxrss*1024)
                maximum_aggregate_rss = max(maximum_aggregate_rss,
                    maximum_rss + process_observation(os.getpid())['RSS_bytes'])
                if maximum_aggregate_rss >= a.LIMITS['RSS_bytes']:
                    raise RuntimeError('OBSERVED_EXIT_WORKER_AGGREGATE_RSS_CAP_STOP')
                if actual_cpu >= a.LIMITS['CPU_seconds']:
                    raise RuntimeError('OBSERVED_EXIT_WORKER_CPU_CAP_STOP')
                if actual_cpu + time.process_time() >= a.LIMITS['CPU_seconds']:
                    raise RuntimeError('OBSERVED_EXIT_COMBINED_CPU_CAP_STOP')
                return dict(schema='ACTUALLY_OBSERVED_OWNED_CONTINUOUS_SHELL_EXIT_V1',
                            worker_PID=process.pid, worker_start_ticks=owned_ticks,
                            controller_PID=os.getpid(), actual_shell_exit_code=code,
                            actual_shell_exit_observed=True, total_wall_seconds=time.monotonic()-began,
                            max_RSS_bytes=maximum_rss, max_aggregate_RSS_bytes=maximum_aggregate_rss,
                            max_CPU_seconds=max(maximum_cpu, actual_cpu), actual_worker_CPU_seconds=actual_cpu,
                            stop_reason=None, stdout_log=log_path.name, resource_limits=a.LIMITS)
            time.sleep(POLL_SECONDS)
    except BaseException as error:
        stop_reason = type(error).__name__ + ':' + str(error)[:1000]
        if process is not None and owned_ticks is not None:
            stop_owned(process, owned_ticks)
        # Small interruption only. Never allocate an account audit on failure.
        try:
            save(cohort / 'SUPERVISOR_INTERRUPTION.json', dict(
                schema='CONTINUOUS_OPERATIONAL_INTERRUPTION_NOT_ECONOMIC_TERMINAL_V1',
                reason=stop_reason, worker_PID=None if process is None else process.pid,
                worker_start_ticks=owned_ticks, actual_shell_exit_code=None if process is None else process.poll(),
                financial_terminal=False, automatic_retry=False, prefix_preserved=True), cohort=cohort)
        except (OSError, RuntimeError):
            pass
        raise
    finally:
        if process is not None and process.stdout is not None:
            process.stdout.close()
        os.fsync(log_fd)
        os.close(log_fd)


def read_wires(args):
    go_raw = ordinary(args.go).read_bytes()
    review_raw = ordinary(args.review).read_bytes()
    go, prep = admission().validate_wire(go_raw, args.go_sha, review_raw, args.review_sha)
    if args.cpu != go['CPU'] or args.cpu not in (4, 5):
        raise ValueError('EXACT_ROOT_RELEASED_CPU4_OR_CPU5_REQUIRED')
    return go_raw, review_raw, go, prep


def worker_ownership(args, go, claim_raw):
    require_parent()
    fds = lease_fds_from_environment()
    directory = ordinary(args.case_output)
    claim = json.loads(claim_raw)
    owner = json.loads((directory / 'PROCESS_OWNERSHIP.json').read_bytes())
    boot = json.loads((directory / 'BOOTSTRAP_READY.json').read_bytes())
    observed = process_observation(os.getpid())
    limits = {name: list(resource.getrlimit(which)) for name, which in
              (('CPU', resource.RLIMIT_CPU), ('AS', resource.RLIMIT_AS), ('RSS', resource.RLIMIT_RSS))}
    if (directory != ordinary(go['controller_output']) / admission().CELLS[0]
            or owner.get('PID') != os.getpid() or owner.get('process_start_ticks') != observed['process_start_ticks']
            or owner.get('controller_PID') != os.getppid() or owner.get('CPU') != args.cpu
            or owner.get('claim_SHA256') != sha(claim_raw)
            or boot.get('PID') != os.getpid() or boot.get('process_start_ticks') != observed['process_start_ticks']
            or boot.get('requested_CPU') != args.cpu or boot.get('actual_affinity') != [args.cpu]
            or boot.get('limits') != limits or boot.get('thread_environment') != {key: '1' for key in THREAD_ENV}
            or boot.get('claim_SHA256') != sha(claim_raw) or claim.get('CPU') != args.cpu
            or claim.get('case_output') != str(directory) or claim.get('controller_PID') != os.getppid()
            or claim.get('controller_start_ticks') != require_parent()['process_start_ticks']
            or observed['CPU_affinity'] != [args.cpu]
            or any(t['CPU_affinity'] != [args.cpu] for t in observed['tasks'])):
        raise ValueError('EXACT_PRENUMERICAL_BOOTSTRAP_CLAIM_PROCESS_BINDING_REQUIRED')
    a = admission()
    expected_limits = dict(CPU=[a.LIMITS['CPU_seconds']]*2, AS=[a.LIMITS['AS_bytes']]*2,
                           RSS=[a.LIMITS['RSS_bytes']]*2)
    if limits != expected_limits or any(os.environ.get(key) != '1' for key in THREAD_ENV):
        raise ValueError('EXACT_ACCEPTED_CONTINUOUS_NUMERICAL_LIMITS_REQUIRED')
    return directory, fds, owner


def worker_checkpoint(directory, stage):
    require_parent()
    a = admission()
    observed = process_observation(os.getpid())
    if observed['RSS_bytes'] >= a.LIMITS['RSS_bytes'] or observed['CPU_seconds'] >= a.LIMITS['CPU_seconds']:
        raise RuntimeError('WORKER_RESOURCE_CHECKPOINT_STOP:' + stage)
    log = directory.parent / (directory.name + '.stdout.log')
    if own_bytes(directory) + (log.stat().st_size if log.exists() else 0) > a.LIMITS['case_output_bytes']:
        raise RuntimeError('WORKER_CASE_OUTPUT_CHECKPOINT_STOP:' + stage)
    if own_bytes(directory.parent) > a.LIMITS['cohort_output_bytes']:
        raise RuntimeError('WORKER_COHORT_OUTPUT_CHECKPOINT_STOP:' + stage)
    if shutil.disk_usage(directory).free < a.LIMITS['free_disk_floor_bytes']:
        raise RuntimeError('WORKER_DISK_FLOOR_CHECKPOINT_STOP:' + stage)


def classify_terminal(audit, result, *, calendar, completed_minutes, stop_us):
    """Shared saved-only wrapper preserves honest economic residuals/halts."""
    from continuous_terminal import classify_saved
    return classify_saved(audit, result, calendar=calendar,
                          completed_minutes=completed_minutes, stop_us=stop_us)


def held_risk(values, columns, inputs, scope, guard, native):
    import numpy as np
    import annual_reporting
    arr = np.asarray(values)
    names = list(columns)
    if not len(arr):
        return dict(status='NOT_EVALUABLE_NO_COMPLETED_NATIVE_MINUTES', observation_count=0)
    bad = np.flatnonzero(arr[:, names.index('nav')] <= 0)
    count = int(bad[0]) if len(bad) else len(arr)
    if count == 0:
        return dict(status='NOT_EVALUABLE_NONPOSITIVE_NAV', observation_count=0,
                    omitted_nonpositive_or_later_minutes=len(arr))
    report = annual_reporting.risk_diagnostics(arr[:count], names, inputs['arrays']['decision_us'],
              inputs['arrays']['annual_covariance'], inputs['target'], scope.tier_name, guard.receipts)
    weights = np.column_stack([arr[:count, names.index(s + '_signed_weight')] for s in native.S])
    net = weights.sum(axis=1)
    daily = arr[np.arange(1439, count, 1440), names.index('nav')]
    returns = np.diff(np.r_[10000., daily]) / np.r_[10000., daily][:-1]
    report.update(status='ACTUAL_HELD_MINUTE_OBSERVATIONS' if count == len(arr) else 'POSITIVE_NAV_PREFIX_ONLY',
        omitted_nonpositive_or_later_minutes=len(arr)-count,
        actual_net_signed_weight_min=float(net.min()), actual_net_signed_weight_max=float(net.max()),
        actual_net_signed_weight_mean=float(net.mean()),
        actual_absolute_weight_max_by_symbol=dict(zip(native.S, np.abs(weights).max(axis=0).tolist())),
        daily_NAV=daily.tolist(), daily_simple_returns=returns.tolist(),
        daily_sample_sigma=float(np.std(returns, ddof=1)) if len(returns)>1 else None,
        forecast_covariance_phase='BEFORE_SAME_CLOCK_DAILY_DECISION', continuous_wallet=True,
        generated_only=False, adaptive_DEV_only=True,
        nominal_tier_is_not_exact_realized_risk_matching=True,
        funding_publication_certified=False, native_venue_execution_certified=False)
    return report


@contextmanager
def validation_envelope(cpu, worker_exit):
    """Saved validation shares the remaining pilot CPU/wall and RSS envelope."""
    a = admission()
    for key in THREAD_ENV:
        os.environ[key] = '1'
    os.sched_setaffinity(0, {cpu})
    for task in Path('/proc/self/task').iterdir():
        try:
            os.sched_setaffinity(int(task.name), {cpu})
        except ProcessLookupError:
            pass
    worker_cpu = worker_exit['actual_worker_CPU_seconds']
    remaining_cpu = a.LIMITS['CPU_seconds'] - worker_cpu - time.process_time()
    remaining_wall = a.LIMITS['wall_seconds'] - worker_exit['total_wall_seconds']
    if remaining_cpu <= 0 or remaining_wall <= 0:
        raise RuntimeError('NO_REMAINING_PILOT_BUDGET_FOR_SAVED_VALIDATION')
    # RLIMIT_CPU applies to this controller's lifetime CPU, including preflight.
    for which, requested in ((resource.RLIMIT_AS, a.LIMITS['AS_bytes']),
                             (resource.RLIMIT_RSS, a.LIMITS['RSS_bytes']),
                             (resource.RLIMIT_CPU, math.ceil(a.LIMITS['CPU_seconds']-worker_cpu))):
        soft, hard = resource.getrlimit(which)
        limit = requested if hard == resource.RLIM_INFINITY else min(requested, hard)
        resource.setrlimit(which, (limit, limit))
    began = time.monotonic()
    report = dict(schema='OBSERVED_BOUNDED_PARENT_SAVED_VALIDATION_RESOURCES_V1',
                  remaining_CPU_seconds_at_entry=remaining_cpu, remaining_wall_seconds_at_entry=remaining_wall,
                  max_RSS_bytes=0, CPU=cpu, all_numerical_environment_one=True)
    stop = threading.Event()
    failure = []
    previous = signal.getsignal(signal.SIGUSR1)

    def check():
        observed = process_observation(os.getpid())
        report['max_RSS_bytes'] = max(report['max_RSS_bytes'], observed['RSS_bytes'])
        if observed['RSS_bytes'] >= a.LIMITS['RSS_bytes']:
            return 'SAVED_VALIDATION_PARENT_RSS_CAP_STOP'
        if time.process_time() + worker_cpu >= a.LIMITS['CPU_seconds']:
            return 'SAVED_VALIDATION_COMBINED_CPU_CAP_STOP'
        if time.monotonic()-began >= remaining_wall:
            return 'SAVED_VALIDATION_REMAINING_WALL_CAP_STOP'
        if (observed['CPU_affinity'] != [cpu]
                or any(task['CPU_affinity'] != [cpu] for task in observed['tasks'])):
            return 'SAVED_VALIDATION_NUMERICAL_THREAD_AFFINITY_ESCAPED'
        return None

    def interrupted(signum, frame):
        raise RuntimeError(failure[0] if failure else 'SAVED_VALIDATION_RESOURCE_STOP')

    def watch():
        while not stop.wait(POLL_SECONDS):
            reason = check()
            if reason:
                failure.append(reason)
                os.kill(os.getpid(), signal.SIGUSR1)
                return

    signal.signal(signal.SIGUSR1, interrupted)
    watcher = threading.Thread(target=watch, name='saved-resource-observer', daemon=True)
    watcher.start()
    try:
        reason = check()
        if reason:
            raise RuntimeError(reason)
        yield report
        reason = check()
        if reason:
            raise RuntimeError(reason)
        report.update(wall_seconds=time.monotonic()-began,
                      combined_CPU_seconds=time.process_time()+worker_cpu,
                      all_observed_resources_within_envelope=True)
    finally:
        stop.set()
        watcher.join(timeout=1)
        signal.signal(signal.SIGUSR1, previous)


@contextmanager
def loaded_input_scope(binding):
    """Revoke sealed inputs before their owning WorkerBinding is revoked."""
    import continuous_inputs
    value = continuous_inputs.load_inputs(binding)
    try:
        yield value
    finally:
        continuous_inputs.revoke_inputs(value)


def small_halt_observation(sim):
    """Preserve an observed economic halt without allocating a failure audit."""
    if sim is None or sim.account.status not in ('LIQUIDATION_REQUIRED_HALT', 'BANKRUPT_HALT'):
        return dict(economic_halt_observed=False)

    def bounded(value, depth=0):
        if depth > 4:
            return 'BOUNDED_HALT_WITNESS_DEPTH'
        if isinstance(value, Mapping):
            return {str(key)[:128]: bounded(item, depth+1)
                    for key, item in islice(value.items(), 32)}
        if isinstance(value, (list, tuple)):
            return [bounded(item, depth+1) for item in value[:32]]
        if value is None or type(value) in (bool, int, float):
            return value
        return str(value)[:512]

    account = sim.account
    return dict(economic_halt_observed=True, account_status=account.status,
                stop_us=sim.stop if sim.stop is not None else account.clock_us,
                halt_witness=bounded(account.halt_witness), NAV=str(account.nav()),
                debt=str(account.unpaid_liability), rowswritten=sim.rows_written,
                economic_halt_is_not_a_validated_terminal=True)


def worker(args):
    a = admission()
    install_parent_death_guard()
    go_raw, review_raw, go, prep = read_wires(args)
    claim_raw = ordinary(a.CLAIMS / (a.CELLS[0] + '.json')).read_bytes()
    if sha(claim_raw) != args.claim_sha:
        raise ValueError('EXTERNAL_PERMANENT_CLAIM_HASH_REQUIRED')
    directory, fds, owner = worker_ownership(args, go, claim_raw)
    if (directory / 'LAUNCH_CLAIM.json').read_bytes() != claim_raw:
        raise ValueError('EXACT_BOOTSTRAP_AND_CANONICAL_CLAIM_REQUIRED')
    began = time.monotonic()
    inputs = None
    writer = None
    receipt = None
    classification = None
    sim = None
    try:
        with a.admit_worker(go_raw, args.go_sha, review_raw, args.review_sha,
                            claim_raw=claim_raw, claim_sha=args.claim_sha, lease_fds=fds) as binding, \
                            loaded_input_scope(binding) as inputs:
            # Source recapture and immutable saved-array comparison happen under
            # the exact read-only guard. Native classes are imported afterward.
            source_receipt = inputs['source_guard_receipt']
            if inputs['source_scopes_revoked'] is not True:
                raise ValueError('SOURCE_BODY_SCOPES_MUST_BE_REVOKED_BEFORE_NATIVE_IMPORT')
            save(directory / 'SOURCE_RECAPTURE_GUARD_RECEIPT.json', source_receipt,
                 cohort=directory.parent, case=directory)
            save(directory / 'SOURCE_ACCEPTED_BEFORE_ACCOUNT.json', dict(
                schema='CONTINUOUS_SOURCE_ACCEPTED_BEFORE_ACCOUNT_V1',
                phase='SOURCE_RECAPTURE_AND_SAVED_ARRAYS_ACCEPTED_GUARD_EXITED',
                cell_id=binding.cell_id, root_GO_SHA256=args.go_sha, claim_SHA256=args.claim_sha,
                code_manifest_SHA256=go['code_manifest_SHA256'], source_identity=prep['source_identity'],
                PID=os.getpid(), source_scopes_revoked=True, source_guard_exited=True,
                arrays_rebuilt=False, accounts_constructed=0,
                source_guard_receipt_SHA256=sha((directory / 'SOURCE_RECAPTURE_GUARD_RECEIPT.json').read_bytes())),
                cohort=directory.parent, case=directory)
            worker_checkpoint(directory, 'SOURCE_ACCEPTED_BEFORE_NATIVE_IMPORT')
            import native_adapter as native
            import continuous_output as output
            import numpy as np
            checker = native.generated.source.checked_reference(
                'bounded_native_continuation_guard50_exit_expansion_20261015/saved_native_reconciliation.py')
            if str(checker.parent) not in sys.path:
                sys.path.insert(0, str(checker.parent))
            from saved_native_reconciliation import reconcile_saved_native, checker_sha256
            native.generated.source.checked_reference('traditional_three_tier_freeze_20261015/annual_reporting.py')
            if str(ROOT / 'traditional_three_tier_freeze_20261015') not in sys.path:
                sys.path.insert(0, str(ROOT / 'traditional_three_tier_freeze_20261015'))
            with a.admit_execution(binding, inputs) as scope:
                writer = output.make_writer(scope, directory, start=a.START, end=a.END, cohort=directory.parent)
                sim, guard = native.construct_case(inputs['window'], inputs['rows'], inputs['decisions'],
                                                   inputs['target'], historical_scope=scope)
                while sim.cursor < sim.end and sim.stop is None:
                    worker_checkpoint(directory, 'BEFORE_NATIVE_DAY')
                    before = sim.rows_written
                    sim.advance_day()
                    boundary = (sim.cursor < sim.end and time.gmtime(sim.cursor // 1_000_000).tm_mon == 1
                                and time.gmtime(sim.cursor // 1_000_000).tm_mday == 1)
                    if sim.rows_written > before:
                        state = output.original.annual_marker(sim) if boundary else output.original.observed_state(sim)
                        writer.append(sim.minute_chunks[-1], end_us=sim.start + sim.rows_written*a.MINUTE,
                                      state=state, boundary=boundary)
                    print(json.dumps(dict(event='NATIVE_DAY_COMPLETE', cell_id=scope.cell_id,
                          completed_minutes=sim.rows_written, stop_us=sim.stop, UTC=utc())), flush=True)
                worker_checkpoint(directory, 'BEFORE_NATIVE_RESULT_EXPORT')
                result = native.case_result(sim, guard)
                minute = result.pop('minute')
                values, columns = minute.to_numpy(), minute.columns
                result['targets'] = result['targets'].to_dicts()
                worker_checkpoint(directory, 'BEFORE_NATIVE40_AUDIT_EXPORT')
                audit = native.V2.OWNED.export_tree(sim.account.snapshot())
                result = native.V2.OWNED.export_tree(result)
                proof = reconcile_saved_native(audit, result, expected_continuation_version=native.VERSION)
                if proof.get('passed') is not True:
                    raise ValueError('AUTHORITATIVE_NATIVE40_RECONSTRUCTION_MUST_PASS')
                classification = classify_terminal(audit, result, calendar=[a.START, a.END],
                                                    completed_minutes=sim.rows_written, stop_us=sim.stop)
                risk = held_risk(values, columns, inputs, scope, guard, native)
                from decimal import Decimal, localcontext
                subperiods = []
                prior_clock, prior_nav = sim.start, Decimal('10000')
                terminal_clock = sim.stop if sim.stop is not None else a.START + sim.rows_written*a.MINUTE
                checkpoints = [(m['boundary_us'], m['state']['NAV']) for m in writer.boundaries]
                if not checkpoints or checkpoints[-1][0] != terminal_clock:
                    checkpoints.append((terminal_clock, str(sim.account.nav())))
                for at, nav_text in checkpoints:
                    nav = Decimal(nav_text)
                    with localcontext() as ctx:
                        ctx.prec = 40
                        change = str(nav/prior_nav-1) if prior_nav > 0 else None
                    phase = ('NATIVE_HALT_ACCOUNT_STATE_AT_STOP_CLOCK_AFTER_LAST_COMPLETED_MINUTE'
                             if sim.stop is not None and at == sim.stop else output.original.PHASE)
                    subperiods.append(dict(calendar=[prior_clock, at], start_NAV=str(prior_nav), end_NAV=str(nav),
                        marked_wallet_change_fraction=change, phase=phase,
                        carried_wallet=True, fresh_wallet_return=False, annualized=False, generated_only=False))
                    prior_clock, prior_nav = at, nav
                quality = guard.causal_mark_quality_guard
                bulky = {
                    'ACCOUNT_FINANCIAL_AUDIT.json.gz': audit,
                    'NATIVE_RESULT.json.gz': result,
                    'NATIVE40_RECONSTRUCTION_PROOF.json.gz': proof,
                    'LEGACY_PRIMARY_FINANCIAL_RECONCILIATION.json.gz': result['primary_financial_reconciliation'],
                    'ACTUAL_HELD_RISK_REPORT.json.gz': risk,
                    'GUARD_RECEIPTS.json.gz': native.V2.OWNED.export_tree(guard.receipts),
                    'CAUSAL_MARK_QUALITY.json.gz': dict(identity=quality.identity, policy_SHA256=quality.policy_sha256,
                        receipts=native.V2.OWNED.export_tree(quality.receipts), original_interpolated_mark_execution_admitted=False),
                    'ANNUAL_MARKED_SUBPERIODS.json.gz': subperiods,
                    'ANNUAL_BOUNDARIES.json.gz': writer.boundaries}
                pins = {}
                for name, value in bulky.items():
                    worker_checkpoint(directory, 'BEFORE_COMPRESSED_EXPORT:' + name)
                    pins[name] = writer.budget.gzip(directory / name, value)
                writer.budget.save(directory / 'COMPRESSED_JSON_PINS.json', pins)
                chunks = writer.validate(require_full=sim.stop is None)
                offset = 0
                for row in writer.records:
                    with np.load(directory / row['name'], allow_pickle=False) as chunk:
                        actual = chunk['values']
                        if actual.tobytes() != values[offset:offset+len(actual), :len(output.original.COLUMNS)].tobytes():
                            raise ValueError('DURABLE_CHUNK_NATIVE_FINAL_EXPORT_BIT_PARITY_REQUIRED')
                        offset += len(actual)
                a.require_execution_scope(scope)
                receipt = dict(schema='ACTUAL_CONTINUOUS_FIRST_OF_SIX_PILOT_CASE_V1',
                    cell_id=scope.cell_id, recipe=scope.recipe, tier=scope.tier_name, status=classification,
                    calendar=[a.START, a.END], completed_minutes=sim.rows_written,
                    required_minutes=(a.END-a.START)//a.MINUTE, account_stop_us=sim.stop,
                    terminal_signal_us=sim.terminal_signal_us,
                    root_GO_SHA256=args.go_sha, independent_review_SHA256=args.review_sha,
                    code_manifest_SHA256=go['code_manifest_SHA256'], source_identity=scope.source_identity,
                    claim_SHA256=args.claim_sha, prepared_source=go['prepared_source'],
                    prepared_source_audit=go['prepared_source_audit'],
                    CPU=args.cpu, PID=os.getpid(), worker_PID=os.getpid(),
                    process_start_ticks=owner['process_start_ticks'], worker_start_ticks=owner['process_start_ticks'],
                    controller_PID=os.getppid(), checker_SHA256=checker_sha256(),
                    native40_proof_passed=True, source_guard_exited_before_native_import=True,
                    one_initial_10000_wallet=True, one_account_constructor=sim.account._continuous_constructions == 1,
                    provider_iterations=inputs['provider'].iterations, annual_wallet_reset=False,
                    exact_chunk_final_export_parity=True, chunks=chunks, generated_only=False,
                    total_wall_seconds=time.monotonic()-began, CPU_seconds=time.process_time(),
                    max_RSS_bytes=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss*1024,
                    limits=a.LIMITS, financial_snapshot_resume=False, automatic_retry=False,
                    financial_terminal_admitted=False, first_account_counts_once=True)
        if a._LIVE or a._BINDINGS:
            raise ValueError('ALL_FINANCIAL_WORKER_CAPABILITIES_MUST_BE_REVOKED_BEFORE_CANDIDATE')
        receipt.update(execution_scopes_revoked=True, inputs_revoked=True, worker_binding_revoked=True)
        writer.budget.save(directory / 'CASE_RECEIPT.json', receipt)
        worker_checkpoint(directory, 'BEFORE_WORKER_CANDIDATE')
        files = {p.name: dict(SHA256=sha(p.read_bytes()), bytes=p.stat().st_size)
                 for p in sorted(directory.iterdir()) if p.is_file()}
        writer.budget.save(directory / 'WORKER_COMPLETE_NOT_TERMINAL.json', dict(
            schema='CONTINUOUS_WORKER_CANDIDATE_V1', cell_id=a.CELLS[0], files=files,
            classification=classification, native40_proof_passed=True,
            execution_scopes_revoked=True, inputs_revoked=True, worker_binding_revoked=True,
            financial_terminal_admitted=False, actual_shell_exit_not_yet_observed=True,
            automatic_retry=False, financial_snapshot_resume=False))
    except BaseException as error:
        try:
            interruption = dict(
                schema='CONTINUOUS_OPERATIONAL_INTERRUPTION_NOT_ECONOMIC_TERMINAL_V1',
                error=type(error).__name__ + ':' + str(error)[:1000], UTC=utc(),
                financial_terminal=False, automatic_retry=False, prefix_preserved=True,
                evidence_export_interruption=True)
            interruption.update(small_halt_observation(sim))
            save(directory / 'WORKER_INTERRUPTION.json', interruption,
                 cohort=directory.parent, case=directory)
        except (OSError, RuntimeError, MemoryError):
            pass
        raise


def controller(args):
    a = admission()
    go_raw, review_raw, go, prep = read_wires(args)
    output = ordinary(args.output)
    if (output.parent != HERE / 'financial_attempts' or output.exists()
            or str(output) != go['controller_output']
            or not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_.-]{0,100}', output.name)):
        raise ValueError('FRESH_ROOT_BOUND_CONTINUOUS_CONTROLLER_DIRECTORY_REQUIRED_NO_RESUME')
    initial = require_launch_resources(args.cpu)
    output.parent.mkdir(exist_ok=True)
    with controller_leases() as fds:
        # An existing permanent claim pauses without creating an apparent retry.
        if (a.CLAIMS / (a.CELLS[0] + '.json')).exists():
            raise RuntimeError('PERMANENT_CONTINUOUS_CELL_CLAIM_EXISTS_NO_DUPLICATE_LAUNCH')
        output.mkdir(exist_ok=False)
        try:
            atomic(output / 'ADMISSION_GO.json', go_raw, cohort=output)
            atomic(output / 'ADMISSION_REVIEW.json', review_raw, cohort=output)
            save(output / 'PRELAUNCH_RESOURCES.json', initial, cohort=output)
            # Revalidate exact authority and resources immediately before the
            # irreversible claim. No source body or numerical import is needed.
            read_wires(args)
            require_launch_resources(args.cpu)
            case = output / a.CELLS[0]
            claim_raw = reserve_claim(go, prep, args, case)
            case.mkdir(exist_ok=False)
            atomic(case / 'LAUNCH_CLAIM.json', claim_raw, cohort=output, case=case)
            child = [str(PYTHON), '-B', str(HERE / 'run_continuous.py'), '--case',
                     '--case-output', str(case), '--cpu', str(args.cpu), '--claim-sha', sha(claim_raw),
                     '--go', str(ordinary(args.go)), '--go-sha', args.go_sha,
                     '--review', str(ordinary(args.review)), '--review-sha', args.review_sha]
            command = [str(PYTHON), '-B', str(HERE / 'run_continuous.py'),
                       '--bootstrap', str(args.cpu), str(case), '--'] + child
            observed = supervise(command, case, cohort=output, cpu=args.cpu,
                                  lease_fds=fds, claim_sha=sha(claim_raw))
            save(output / 'OWNED_SHELL_EXIT.json', observed, cohort=output)
            if observed['actual_shell_exit_code'] != 0:
                raise RuntimeError('OWNED_WORKER_NONZERO_SHELL_EXIT_PAUSE_NO_RETRY')
            expected = dict(cell_id=a.CELLS[0], root_GO_SHA256=args.go_sha,
                code_manifest_SHA256=go['code_manifest_SHA256'], source_identity=prep['source_identity'],
                claim_SHA256=sha(claim_raw), CPU=args.cpu, worker_PID=observed['worker_PID'],
                worker_start_ticks=observed['worker_start_ticks'], controller_PID=os.getpid(),
                actual_shell_exit_code=observed['actual_shell_exit_code'],
                quality_sidecar_SHA256=prep['artifacts']['SOURCE_QUALITY.json']['SHA256'],
                quality_cell_count=27, later_interval_anchor=1723456920000000)
            with validation_envelope(args.cpu, observed) as validation_resources:
                from continuous_terminal import validate_saved_terminal
                validated = validate_saved_terminal(case, expected=expected)
            validated['saved_validation_resources'] = validation_resources
            save(case / 'TERMINAL_CHECKPOINT.json', dict(
                schema='SUPERVISOR_ADMITTED_CONTINUOUS_FINANCIAL_TERMINAL_V1',
                expected=expected, actual_owned_shell_exit=observed, saved_validation=validated,
                worker_candidate_SHA256=sha((case / 'WORKER_COMPLETE_NOT_TERMINAL.json').read_bytes()),
                fresh_financial_scopes_revoked=True, financial_snapshot_resume=False,
                automatic_retry=False, first_account_counts_once=True), cohort=output, case=case,
                log=output / (case.name + '.stdout.log'))
            save(output / 'PILOT_CONTROLLER_RECEIPT.json', dict(
                status='FIRST_PREDECLARED_ACCOUNT_SAVED_AND_SHELL_VALIDATED_STOP_BEFORE_ACCOUNT_TWO',
                launched_cells=[a.CELLS[0]], ordered_cohort=list(a.CELLS),
                financial_accounts_constructed=1, first_account_counts_once=True,
                remaining_cells_require_fresh_root_release=list(a.CELLS[1:]),
                saved_validation=validated, automatic_retry=False, queue_stopped=True), cohort=output)
            return validated
        except BaseException as error:
            try:
                save(output / 'CONTROLLER_PAUSE.json', dict(
                    status='CONTINUOUS_PILOT_PAUSED_NO_NEXT_ACCOUNT',
                    error=type(error).__name__ + ':' + str(error)[:1000], UTC=utc(),
                    economic_outcome_not_relabelled=True, automatic_retry=False,
                    financial_snapshot_resume=False, preserved_all_evidence=True), cohort=output)
            except (OSError, RuntimeError):
                pass
            raise


def main():
    if len(sys.argv) > 1 and sys.argv[1] == '--bootstrap':
        if len(sys.argv) < 8 or sys.argv[4] != '--':
            raise SystemExit('EXACT_STDLIB_BOOTSTRAP_ARGUMENTS_REQUIRED')
        bootstrap(int(sys.argv[2]), sys.argv[3], sys.argv[5:])
        return
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--case', action='store_true')
    for name in ('go', 'go-sha', 'review', 'review-sha'):
        parser.add_argument('--' + name, required=True)
    parser.add_argument('--cpu', type=int, choices=(4, 5), required=True)
    parser.add_argument('--output')
    parser.add_argument('--case-output')
    parser.add_argument('--claim-sha')
    args = parser.parse_args()
    if args.case:
        if not args.case_output or not args.claim_sha or args.output:
            parser.error('Worker requires exact case-output and external claim-sha only.')
        worker(args)
    else:
        if not args.output or args.case_output or args.claim_sha:
            parser.error('Controller requires one fresh output; no case/recovery arguments.')
        controller(args)


if __name__ == '__main__':
    main()
