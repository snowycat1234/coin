            or claim.get('calendar')!=[START,END] or claim.get('independent_review_SHA256')!=review_sha
            or claim.get('prepared_source')!=go['prepared_source'] or claim.get('prepared_source_audit')!=go['prepared_source_audit']
            or claim.get('array_identities_SHA256')!=digest(prep['array_identities'])
            or claim.get('controller_PID')!=os.getppid() or claim.get('automatic_retry') is not False
            or claim.get('snapshot_resume') is not False or claim.get('first_account_counts_once') is not True or claim.get('pilot_never_rerun') is not True
            or pinned(dict(path=str((CLAIMS/(cell+'.json')).relative_to(ROOT)),SHA256=claim_sha,bytes=len(claim_raw)))!=claim_raw):
        raise ValueError('EXACT_CANONICAL_PERMANENT_CONTINUOUS_CELL_CLAIM_REQUIRED')
