    for symbol,at in sorted(points):recoveries.append(dict(symbol=symbol,minute_open_us=at,completed_us=at+p.MINUTE,
        modeled_available_us=at+p.MINUTE,source_file_SHA256='c'*64,native_mark_float64_SHA256='d'*64,is_genuine=True,
        actual_publication_arrival_installation='UNKNOWN_NOT_CERTIFIED'))
    for year in e.YEARS:
        rec=catalog['years'][str(year)];start,end=rec['calendar'];days=(end-start)//p.DAY
        t=p.frozen(np.arange(start-199*p.DAY,end,p.DAY,dtype='<i8'),'<i8');close=p.frozen(price(t));d=p.frozen(np.arange(start,end,p.DAY,dtype='<i8'),'<i8')
        sid=p.digest(dict(scope='INVENTED_SOURCE_TABLES_ONLY',year=year));rec['source_identity']=sid;rec['contract']['source_identity']=sid
        events=[dict(symbol=s,event_us=int(at),raw_rate=float((j+1)*.000013*(-1 if i%2 else 1)),reported_interval_hours=8.)
            for i,at in enumerate(range(start,end,8*60*p.MINUTE)) for j,s in enumerate(p.SYMBOLS)]
        if year==2022:
            events.extend(dict(symbol=s,event_us=start+k*p.DAY+4*60*p.MINUTE,raw_rate=float((j+1)*.000017),
                reported_interval_hours=float((2,4,8,2,8)[j])) for k in range(15) for j,s in enumerate(p.SYMBOLS))
