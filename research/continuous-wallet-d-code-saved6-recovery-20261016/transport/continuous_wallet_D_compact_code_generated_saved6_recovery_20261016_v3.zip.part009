                chunks=chunks,stages=stages,output_bytes=sum(p.stat().st_size for p in writer.directory.iterdir() if p.is_file()),
                PID=os.getpid(),parent_PID=os.getppid(),CPU_affinity=sorted(os.sched_getaffinity(0)),
                all_TID_affinities=[sorted(os.sched_getaffinity(int(t))) for t in os.listdir('/proc/self/task')],
                thread_environment={k:os.environ[k] for k in THREAD_ENV},
                bulky_JSON_compressed_with_exact_roundtrip=True,duplicate_whole_minute_archive_written=False,
                code_files={p.name:dict(SHA256=__import__('hashlib').sha256(p.read_bytes()).hexdigest(),bytes=p.stat().st_size) for p in HERE.glob('*.py')},
                free_disk_floor_bytes=saved.FREE_DISK_FLOOR_BYTES,free_disk_after_bytes=__import__('shutil').disk_usage(writer.directory).free,
                full_horizon_resource_admitted=False,projection_is_not_a_resource_guarantee=True,
                full_horizon_native_rows=s.HISTORICAL_DAYS*1440,
